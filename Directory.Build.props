<Project>
  <PropertyGroup>
    <Copyright>Copyright (c) .NET Foundation and Contributors. Copyright (c) 2026 Justin Wojciechowski.</Copyright>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <LangVersion>Latest</LangVersion>
    <IsPackable>true</IsPackable>

    <!-- Single source of truth for the shipped NuGet package versions. The pack pipeline
         overrides these via -p: (the release/gate version); the 0.0.0-dev default is the
         in-tree sentinel that routes generated bindings to local ProjectReferences instead of
         published packages. The 4 package csprojs read these for <PackageVersion>; Sdk.props,
         template.json, and the generator's DefaultSwiftRuntimeVersion constant are baked from
         the same value at pack time (they ship verbatim and cannot read the property). Nothing
         mutates a source file to carry a version any more. -->
    <SwiftBindingsSdkVersion Condition="'$(SwiftBindingsSdkVersion)' == ''">0.0.0-dev</SwiftBindingsSdkVersion>
    <SwiftBindingsAppleVersion Condition="'$(SwiftBindingsAppleVersion)' == ''">0.0.0-dev</SwiftBindingsAppleVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <TestCaptureOutput>false</TestCaptureOutput>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
