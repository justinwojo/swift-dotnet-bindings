<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.swiftbindings.nativeaot.device</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

    <!-- NativeAOT settings -->
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <TrimMode>partial</TrimMode>

    <!-- Code signing -->
    <CodesignKey>Apple Development: Justin Wojciechowski (KBKS29A36Q)</CodesignKey>
    <CodesignProvision>Wildcard Dev</CodesignProvision>
    <TeamIdentifierPrefix>TL2K6QUQEH</TeamIdentifierPrefix>

    <!-- Suppress warnings -->
    <!-- SB0001: Mono JIT crash risk warnings (test code calls these methods under NativeAOT) -->
    <!-- CS0169: Buffer struct fields reserved for layout -->
    <!-- IL2026/IL2087/IL2091: Trim analysis (SwiftMarshal tuple reflection) -->
    <!-- IL3050: RequiresDynamicCode (tuple metadata MakeGenericMethod) -->
    <NoWarn>CS0169;SB0001;SB0002;IL2026;IL2087;IL2091;IL3050</NoWarn>

    <!-- Avoid InstallNameTool failure with libSwiftBindingsRuntime.dylib.tmp -->
    <IncludeSwiftBindingsRuntimeNative>false</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Info.plist" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Runtime/src/Swift.Runtime.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
  </ItemGroup>

  <!-- Include TestFramework bindings -->
  <ItemGroup>
    <Compile Include="../output/Swift.SwiftBindingsTestLib.cs" />
  </ItemGroup>

  <!-- Include SwiftBindingsTestLib xcframework (must have ios-arm64 device slice) -->
  <ItemGroup>
    <NativeReference Include="../.build/SwiftBindingsTestLib.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include SwiftBindings wrapper framework (async wrappers) -->
  <ItemGroup>
    <NativeReference Include="../output/SwiftBindings.xcframework" Condition="Exists('../output/SwiftBindings.xcframework')">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
</Project>
