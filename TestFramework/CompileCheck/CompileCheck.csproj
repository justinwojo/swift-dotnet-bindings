<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- CS0169: unused private field (generated backing fields) -->
    <!-- CA1420: using features that require runtime marshalling (LibraryImport with Swift types) -->
    <!-- CS0169: unused private field (generated backing fields) -->
    <!-- CA1420: using features that require runtime marshalling (LibraryImport with Swift types) -->
    <!-- CS0108/CS0109: member hiding in class hierarchies (intentional for ISwiftObject re-impl, awaiting Session I4 dedup) -->
    <NoWarn>0169;CA1420;CS0108;CS0109</NoWarn>
  </PropertyGroup>
  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types (SwiftSelf, SwiftError, etc.) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Runtime/src/Swift.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../output/Swift.SwiftBindingsTestLib.cs" />
    <Compile Include="../output/Swift.SwiftBindingsTestLib.SwiftUIBridge.cs"
             Condition="Exists('../output/Swift.SwiftBindingsTestLib.SwiftUIBridge.cs')" />
  </ItemGroup>
</Project>
