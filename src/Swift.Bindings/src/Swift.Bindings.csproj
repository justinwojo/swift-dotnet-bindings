<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <ToolCommandName>swiftbindings</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Swift.Runtime/src/Swift.Runtime.csproj" SetTargetFramework="TargetFramework=net10.0">
      <ReferenceSourceTarget></ReferenceSourceTarget>
    </ProjectReference>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Roslyn: parses/compiles the emitted C# in the in-process verification probe. Pinned to
         the newest released package; the SDK's own compiler is a newer preview Roslyn, so the probe
         is deliberately a heuristic and the real MSBuild build is the publication gate. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.3" />
    <!-- Metadata-only reflection over the installed Microsoft.iOS reference assembly, to verify
         synthesized Apple-type names/shapes against the real binding surface. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
    <None Include="../../../README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Data/apple-frameworks.json" />
    <EmbeddedResource Include="Data/objc-type-mappings.json" />
    <EmbeddedResource Include="Data/specialization-hints.json" />
    <EmbeddedResource Include="Data/stdlib-conformances.json" />
    <!-- Apple-types manifest lives in the SDK tree so generator + SDK consumers share
         a single file. Embedding it here (via LogicalName to keep the resource key
         stable) lets AppleSupplementResolver map Swift identities to managed
         projections without any runtime filesystem dependency. -->
    <EmbeddedResource Include="..\..\Swift.Bindings.Sdk\tools\apple-types-manifest\manifest.json"
                      LogicalName="Swift.Bindings.apple-types-manifest.json" />
  </ItemGroup>

  <!-- Single-source the generator's DefaultSwiftRuntimeVersion constant from
       $(SwiftBindingsSdkVersion) (Directory.Build.props default 0.0.0-dev; overridden via -p: at
       pack/publish time). Emitting it into obj/ (never committed) replaces the former regex-stamp
       of a literal into BindingProjectEmitter.cs source: the published generator embeds the real
       shipped version while the working tree stays clean. WriteOnlyWhenDifferent keeps an
       unchanged version from forcing a recompile; the file lives under $(IntermediateOutputPath)
       so the SDK's default Compile glob already excludes it (no duplicate-item error). -->
  <Target Name="_GenerateSwiftBindingsVersionConstant" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_GeneratedVersionFile>$(IntermediateOutputPath)GeneratedVersion.cs</_GeneratedVersionFile>
    </PropertyGroup>
    <ItemGroup>
      <_GeneratedVersionLine Include="// &lt;auto-generated&gt; Single-sourced version constant. Do not edit." />
      <_GeneratedVersionLine Include="namespace BindingsGeneration" />
      <_GeneratedVersionLine Include="{" />
      <_GeneratedVersionLine Include="    public static partial class BindingProjectEmitter" />
      <_GeneratedVersionLine Include="    {" />
      <_GeneratedVersionLine Include="        internal const string DefaultSwiftRuntimeVersion = &quot;$(SwiftBindingsSdkVersion)&quot;%3B" />
      <_GeneratedVersionLine Include="    }" />
      <_GeneratedVersionLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_GeneratedVersionFile)" Lines="@(_GeneratedVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_GeneratedVersionFile)" />
      <FileWrites Include="$(_GeneratedVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
