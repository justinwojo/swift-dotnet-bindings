<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Bindings.csproj">
      <ReferenceSourceTarget></ReferenceSourceTarget>
    </ProjectReference>
    <!-- Plain (non-analyzer) reference to the TestDiscovery source generator so its
         SBTD001/002/003 near-miss diagnostics can be driven directly via
         CSharpGeneratorDriver in TestDiscoveryDiagnosticsTests. PrivateAssets=all on the
         generator's own Roslyn refs means they don't flow; the Microsoft.CodeAnalysis.CSharp
         package below (matching the generator's compile-time Roslyn) supplies them. -->
    <ProjectReference Include="../../../SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <!-- Reflection-only metadata reader for the ObjC-rooted NSObject-property drift test
         (ObjCRootedInheritedPropertyDriftTests): it loads the installed Microsoft.iOS ref
         assembly without executing it, so the curated collision set in NameProvider can be
         checked against the real Foundation.NSObject surface and SDK drift surfaces loudly.
         Metadata-only (no code execution), used only in tests. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

  <!-- Link-compile the parity-gate logic from the Nuke build assembly so its pure
       parsing/diffing is unit-tested here without a project reference to _build
       (which would drag in Nuke). The file is self-contained (BCL only, #nullable
       enable, source-gen JSON) so it compiles cleanly under this project's
       Nullable=disable + IsAotCompatible + warnings-as-errors. -->
  <ItemGroup>
    <Compile Include="../../../../build/Helpers/ArtifactParityGate.cs" Link="Parity/ArtifactParityGate.cs" />
    <!-- Link-compile the build-side Mach-O reader so the appstore-hygiene gate's install_name reader
         (Finding 61, replacing the otool scrape) is unit-tested against hand-built Mach-O fixtures
         that run in `nuke test`, independent of a signing host. Same pattern as ArtifactParityGate. -->
    <Compile Include="../../../../build/Helpers/MachOReader.cs" Link="MachO/MachOReader.cs" />
    <!-- Link-compile the per-test-identity runtime baseline model so its pure Compare/FromResults
         ratchet logic (Finding 28) is unit-tested here without a project reference to _build. The
         model is BCL-only with source-generated JSON (RuntimeIdentityBaselineJsonContext), so it
         compiles AOT-clean under this project's IsAotCompatible + warnings-as-errors. -->
    <Compile Include="../../../../build/Models/RuntimeIdentityBaseline.cs" Link="Models/RuntimeIdentityBaseline.cs" />
    <!-- Link-compile the API-manifest ABI-contract baseline so its pure Compare ratchet
         (retarget = fail, add/remove = info) is unit-tested here without a project reference to
         _build. BCL-only with source-generated JSON (ApiManifestBaselineJsonContext), so it
         compiles AOT-clean under this project's IsAotCompatible + warnings-as-errors. -->
    <Compile Include="../../../../build/Models/ApiManifestBaseline.cs" Link="Models/ApiManifestBaseline.cs" />
    <!-- Link-compile the skip-surface trend baseline for the same reason: its Compare carries the
         "a falling skip count may mean the surface was amputated, not fixed" cross-reference, which
         is exactly the logic worth pinning with unit tests. BCL-only with source-generated JSON
         (SkipSurfaceBaselineJsonContext), so it compiles AOT-clean here. -->
    <Compile Include="../../../../build/Models/SkipSurfaceBaseline.cs" Link="Models/SkipSurfaceBaseline.cs" />
    <!-- Link-compile the JSONL crash-recovery model so its pure console-fallback parsing
         (ParseClassesFromConsole / AddConsoleFailure) is unit-tested here without a project
         reference to _build. BCL-only (JsonDocument DOM read, no reflection serialization), so it
         compiles AOT-clean under this project's IsAotCompatible + warnings-as-errors.
         TestClassInventory rides along because JsonlTestResults names it as a parameter type. -->
    <Compile Include="../../../../build/Models/JsonlTestResults.cs" Link="Models/JsonlTestResults.cs" />
    <Compile Include="../../../../build/Models/TestClassInventory.cs" Link="Models/TestClassInventory.cs" />
    <!-- Link-compile the MSBuild command-line property escaper so its pure Escape (the MSB1006
         comma/semicolon/percent hazard for the [X.Y.Z,) version floor range) is unit-tested here
         without a project reference to _build. BCL-only string work, so it compiles AOT-clean under
         this project's IsAotCompatible + warnings-as-errors. -->
    <Compile Include="../../../../build/Models/MsBuildPropertyValue.cs" Link="Models/MsBuildPropertyValue.cs" />
    <!-- Link-compile the release-gates result manifest so its pure serialization / leg aggregation
         (skip != pass, any-fail => non-zero exit) and fail-closed catalog integrity (Validate) are
         unit-tested here without a project reference to _build. BCL-only with source-generated JSON
         (ReleaseGatesManifestJsonContext) + #nullable enable, so it compiles AOT-clean under this
         project's IsAotCompatible + warnings-as-errors + Nullable=disable. -->
    <Compile Include="../../../../build/Models/ReleaseGatesManifest.cs" Link="Models/ReleaseGatesManifest.cs" />
    <!-- Link-compile the PartialSuccessKitchen skip-budget model so its pure report parsing
         (KitchenReportProjection.ParseReport), design-floor evaluation (CheckFloors), and exact
         drift diff (Compare) are unit-tested here without a project reference to _build. BCL-only
         with source-generated JSON (PartialSuccessKitchenBaselineJsonContext), so it compiles
         AOT-clean under this project's IsAotCompatible + warnings-as-errors. -->
    <Compile Include="../../../../build/Models/PartialSuccessKitchenBaseline.cs" Link="Models/PartialSuccessKitchenBaseline.cs" />
    <!-- Link-compile the launch-outcome discriminator so its pure "did the launcher ever start the
         app?" classification is unit-tested here without a project reference to _build. This is the
         predicate the one-shot mixed consumer gates use to tell a devicectl/simctl abort (no product
         signal at all) apart from a real binding regression, so its conservatism — any app output,
         or any launcher start confirmation, means "product result, do not retry" — is exactly what
         must not silently drift. BCL-only string work, so it compiles AOT-clean under this project's
         IsAotCompatible + warnings-as-errors. TestResult.cs rides along for the enum + LaunchResult. -->
    <Compile Include="../../../../build/Models/LaunchDiagnostics.cs" Link="Models/LaunchDiagnostics.cs" />
    <Compile Include="../../../../build/Models/TestResult.cs" Link="Models/TestResult.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- xunit 2.9.x lacks Assert.Skip (added in xunit3); SkippableFact provides
         [SkippableFact]/[SkippableTheory] + Xunit.Skip.IfNot for runtime skips.
         Used by SwiftSyntaxInterfaceFactsProducerTests (skips when the
         SwiftInterfaceParser host binary isn't built) and other host/toolchain-gated
         tests. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>
</Project>

