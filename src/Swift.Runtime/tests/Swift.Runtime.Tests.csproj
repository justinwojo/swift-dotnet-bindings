<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Swift.Runtime.csproj">
      <ReferenceSourceTarget></ReferenceSourceTarget>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy the SwiftBindingsRuntime native binary so SwiftString tests can run on macOS.
       Without it, Create/ToString/Length fail because CallConvSwift fallbacks are removed.
       The runtime ships as SwiftBindingsRuntime.xcframework (Apple TN2435; see
       the runtime-framework packaging note in CLAUDE.md Known Issues); we copy the universal macos slice's
       framework binary under the loose libSwiftBindingsRuntime.dylib name the resolver
       probes via @executable_path on a console test host. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework/macos-arm64_x86_64/SwiftBindingsRuntime.framework/SwiftBindingsRuntime')">
    <Content Include="$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework/macos-arm64_x86_64/SwiftBindingsRuntime.framework/SwiftBindingsRuntime">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
