        </entity>
        <entity managedNameSpace="SwiftUI" managedTypeName="Text">
            <typedeclaration kind="struct" name="Text" module="SwiftUI" frozen="false" requiresMemoryManagement="true" />
        </entity>
        <entity managedNameSpace="SwiftUI" managedTypeName="AnyView">
