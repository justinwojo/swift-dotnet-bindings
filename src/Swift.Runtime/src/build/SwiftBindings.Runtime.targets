<!-- SwiftBindings.Runtime NuGet package: conditional native dylib injection.
     Replicates the ProjectReference dylib logic for NuGet consumers.
     Placed in buildTransitive/ so it flows to transitive dependents. -->
<Project>

  <PropertyGroup>
    <IncludeSwiftBindingsRuntimeNative Condition="'$(IncludeSwiftBindingsRuntimeNative)' == ''">true</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <!-- macOS: TFM contains 'macos' but NOT 'maccatalyst' -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND $(TargetFramework.Contains('macos'))
                         AND !$(TargetFramework.Contains('maccatalyst'))
                         AND Exists('$(MSBuildThisFileDirectory)../native/macos/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/macos/libSwiftBindingsRuntime.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>

  <!-- iOS device: TFM contains 'ios', RID is non-empty and starts with 'ios-' (not 'iossimulator-') -->
  <!-- On iOS, @rpath resolves to .app/Frameworks/, so the dylib must be placed there. -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND $(TargetFramework.Contains('ios'))
                         AND '$(RuntimeIdentifier)' != ''
                         AND $(RuntimeIdentifier.StartsWith('ios-'))
                         AND Exists('$(MSBuildThisFileDirectory)../native/ios/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/ios/libSwiftBindingsRuntime.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>

  <!-- iOS simulator: TFM contains 'ios', RID is non-empty and starts with 'iossimulator-' -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND $(TargetFramework.Contains('ios'))
                         AND '$(RuntimeIdentifier)' != ''
                         AND $(RuntimeIdentifier.StartsWith('iossimulator-'))
                         AND Exists('$(MSBuildThisFileDirectory)../native/iossimulator/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/iossimulator/libSwiftBindingsRuntime.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>

  <!-- Mac Catalyst: TFM contains 'maccatalyst' -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND $(TargetFramework.Contains('maccatalyst'))
                         AND Exists('$(MSBuildThisFileDirectory)../native/maccatalyst/libSwiftBindingsRuntime.dylib')">
    <NativeReference Include="$(MSBuildThisFileDirectory)../native/maccatalyst/libSwiftBindingsRuntime.dylib">
      <Kind>Dynamic</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- tvOS device: TFM contains 'tvos', RID starts with 'tvos-' -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND $(TargetFramework.Contains('tvos'))
                         AND '$(RuntimeIdentifier)' != ''
                         AND $(RuntimeIdentifier.StartsWith('tvos-'))
                         AND Exists('$(MSBuildThisFileDirectory)../native/tvos/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/tvos/libSwiftBindingsRuntime.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>

  <!-- tvOS simulator: TFM contains 'tvos', RID starts with 'tvossimulator-' -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND $(TargetFramework.Contains('tvos'))
                         AND '$(RuntimeIdentifier)' != ''
                         AND $(RuntimeIdentifier.StartsWith('tvossimulator-'))
                         AND Exists('$(MSBuildThisFileDirectory)../native/tvossimulator/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/tvossimulator/libSwiftBindingsRuntime.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>

  <!-- NativeAOT trimmer descriptor wiring.
       Swift.Runtime ships ILLink.Descriptors.xml as an EmbeddedResource for the IL trimmer's
       auto-discovery path. ILC (NativeAOT) does not auto-discover embedded descriptors from
       referenced assemblies; it only honors descriptors passed via the IlcArg descriptor flag.
       Without this injection, NativeAOT consumers silently strip ValueTuple constructors
       and core Swift.Runtime types (existential containers, protocol witness tables, factory
       dispatchers) that the embedded descriptor was pinning, surfacing as MissingMethodException
       or AOT runtime errors deep inside Swift.Runtime, opaque from the consumer's POV.
       Belt-and-suspenders on both items mirrors the in-tree workaround in
       BindingTests/RuntimeTestsApp.csproj that was the model for this packaging contract. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' AND Exists('$(MSBuildThisFileDirectory)ILLink.Descriptors.xml')">
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
    <IlcArg Include="--descriptor:$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- App Store SwiftSupport folder injection (issue #42)                     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Apple requires a top-level SwiftSupport/ folder inside the .ipa (sibling
       of Payload/) whenever the app ships Swift. Xcode populates it during
       "Distribute App"; the .NET / MAUI build zips the .ipa directly and never
       runs that pass, so App Store Connect rejects the upload with ITMS-90426
       ("the SwiftSupport folder is missing"). Our binding is what pulls a Swift
       framework into the consumer app, so closing this gap belongs here in the
       Runtime package's buildTransitive targets — already imported by every
       consumer (PackageReference and, transitively, SDK-direct).

       Strategy B (post-process the finished IPA): AfterTargets="CreateIpa" runs
       after _CoreCreateIpa + _ZipIpa, so $(IpaPackagePath) is the finished .ipa.
       The script unzips it to scan the app's Mach-Os, builds SwiftSupport/<platform>
       from the Apple-signed back-deployment copies of the referenced /usr/lib/swift
       libswift* dylibs, then grow-appends that folder onto a scratch copy of the IPA
       and swaps it over the original atomically (Payload/ and any other top-level
       members stay byte-for-byte untouched). We depend only on the public-ish
       $(IpaPackagePath) + the CreateIpa target name — far more robust to workload
       churn than reaching into the internal _ZipIpa / _IpaPackageSource item
       (Strategy A). The opt-in swiftsupport binding-tests gate guards this
       against a workload bump silently breaking the hook.

       Gating: only on a device IPA publish ($(BuildIpa) == 'true', which the
       workload sets for device iOS/tvOS publish — never sim, never a plain
       `dotnet build`). Consumers opt out with
       <EnableSwiftSupportFolder>false</EnableSwiftSupportFolder>. The script is a
       no-op (exit 0, IPA untouched) when no embeddable Swift dylibs are
       referenced, so a consumer that references the Runtime without actually
       linking Swift is unaffected. -->
  <PropertyGroup>
    <EnableSwiftSupportFolder Condition="'$(EnableSwiftSupportFolder)' == ''">true</EnableSwiftSupportFolder>
  </PropertyGroup>

  <Target Name="_SwiftBindingsAddSwiftSupportFolder"
          AfterTargets="CreateIpa"
          Condition="'$(BuildIpa)' == 'true'
                     AND '$(EnableSwiftSupportFolder)' == 'true'
                     AND !$(RuntimeIdentifier.Contains('simulator'))
                     AND ($(TargetFramework.Contains('ios')) OR $(TargetFramework.Contains('tvos')))
                     AND !$(TargetFramework.Contains('maccatalyst'))">

    <!-- SwiftSupport platform subdir: iphoneos for iOS, appletvos for tvOS.
         (maccatalyst is excluded above; macOS never sets BuildIpa.) -->
    <PropertyGroup>
      <_SwiftSupportPlatformDir Condition="$(TargetFramework.Contains('tvos'))">appletvos</_SwiftSupportPlatformDir>
      <_SwiftSupportPlatformDir Condition="'$(_SwiftSupportPlatformDir)' == '' AND $(TargetFramework.Contains('ios'))">iphoneos</_SwiftSupportPlatformDir>
    </PropertyGroup>

    <Warning Condition="'$(IpaPackagePath)' == '' OR !Exists('$(IpaPackagePath)')"
             Text="SwiftBindings: BuildIpa is true but the finished IPA was not found at IpaPackagePath ('$(IpaPackagePath)') — skipping SwiftSupport injection. The App Store may reject the upload (ITMS-90426)." />

    <!-- $(_SdkDevPath) is the active Xcode developer dir resolved by the .NET iOS
         workload; the script falls back to `xcode-select -p` if it is empty. -->
    <Exec Condition="'$(IpaPackagePath)' != '' AND Exists('$(IpaPackagePath)') AND '$(_SwiftSupportPlatformDir)' != ''"
          Command="bash &quot;$(MSBuildThisFileDirectory)add-swiftsupport-folder.sh&quot; &quot;$(IpaPackagePath)&quot; &quot;$(_SwiftSupportPlatformDir)&quot; &quot;$(_SdkDevPath)&quot;"
          StandardOutputImportance="high"
          StandardErrorImportance="high" />
  </Target>

</Project>
