<!-- SwiftBindings.Runtime NuGet package: conditional native dylib injection.
     Replicates the ProjectReference dylib logic for NuGet consumers.
     Placed in buildTransitive/ so it flows to transitive dependents. -->
<Project>

  <PropertyGroup>
    <IncludeSwiftBindingsRuntimeNative Condition="'$(IncludeSwiftBindingsRuntimeNative)' == ''">true</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <!-- Mac App Store framework anatomy for the app bundle's embedded frameworks.

       Deliberately NOT gated on IncludeSwiftBindingsRuntimeNative: that switch decides whether
       THIS package contributes its own native framework, while the anatomy step works on
       whatever the app bundle ended up containing — the Apple supplement, a binding's wrapper,
       a vendor framework. A consumer that turns the runtime's native off still embeds those, and
       still needs them in the right shape. Importing it from here means a runtime patch reaches
       every consumer of every already-published binding package, since they all resolve the
       runtime through their own dependency. -->
  <Import Project="$(MSBuildThisFileDirectory)SwiftBindings.MacFrameworkAnatomy.targets"
          Condition="'$(_SwiftBindingsMacFrameworkAnatomyImported)' != 'true'
                     AND Exists('$(MSBuildThisFileDirectory)SwiftBindings.MacFrameworkAnatomy.targets')" />

  <!-- Final-app engine identity, independent of SwiftBindingsInteropMode.
       RC2 integration contract (recheck for the shipping workload):
       dotnet/macios tag dotnet-11.0.1xx-rc2-12212,
       dotnet/targets/Xamarin.Shared.Sdk.props lines 37-47 resolves _UseNativeAot
       from PublishAot AND _IsPublishing and defaults UseMonoRuntime=false.
       Both are resolved at evaluation, before GenerateBuildRuntimeConfigurationFiles.
       The same hook feeds CoreCLR's merged runtimeconfig and NativeAOT feature switches.
       Never stamp a library producer's engine into reusable binding assemblies. -->
  <Target Name="_SwiftBindingsInjectRuntimeFlavorSwitch"
          BeforeTargets="GenerateBuildRuntimeConfigurationFiles;GenerateRuntimeConfigurationFiles"
          Condition="'$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe' OR '$(IsAppExtension)' == 'true'">
    <PropertyGroup>
      <_SwiftRuntimeAppleApp>false</_SwiftRuntimeAppleApp>
      <_SwiftRuntimeAppleApp Condition="$(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('-tvos')) OR $(TargetFramework.Contains('-maccatalyst')) OR $(TargetFramework.Contains('-macos'))">true</_SwiftRuntimeAppleApp>
    </PropertyGroup>
    <Error Code="SWIFTBIND124"
           Condition="'$(_SwiftRuntimeAppleApp)' == 'true' AND '$(UseMonoRuntime)' != 'true' AND '$(UseMonoRuntime)' != 'false'"
           Text="Swift.Runtime engine is unresolved: the final Apple app must resolve UseMonoRuntime through its workload before runtime configuration generation." />
    <Error Code="SWIFTBIND125"
           Condition="'$(_SwiftRuntimeAppleApp)' == 'true' AND '$(UseMonoRuntime)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), '11.0'))"
           Text="Swift.Runtime engine conflict: UseMonoRuntime=true is unsupported on .NET 11 Apple apps (NETSDK1242)." />
    <Error Code="SWIFTBIND126"
           Condition="('$(_UseNativeAot)' == 'true' AND ('$(PublishAot)' != 'true' OR '$(_IsPublishing)' != 'true' OR '$(UseMonoRuntime)' == 'true')) OR ('$(_SwiftRuntimeAppleApp)' == 'true' AND '$(PublishAot)' == 'true' AND '$(_IsPublishing)' == 'true' AND '$(_UseNativeAot)' != 'true')"
           Text="Swift.Runtime engine conflict: resolved _UseNativeAot disagrees with PublishAot, _IsPublishing or UseMonoRuntime. Use the supported workload build/publish entry point." />
    <PropertyGroup>
      <_SwiftRuntimeIsNativeAot>false</_SwiftRuntimeIsNativeAot>
      <_SwiftRuntimeIsNativeAot Condition="'$(_UseNativeAot)' == 'true' OR ('$(_SwiftRuntimeAppleApp)' != 'true' AND '$(PublishAot)' == 'true' AND '$(_IsPublishing)' == 'true')">true</_SwiftRuntimeIsNativeAot>
      <_SwiftRuntimeIsMono>false</_SwiftRuntimeIsMono>
      <_SwiftRuntimeIsMono Condition="'$(UseMonoRuntime)' == 'true'">true</_SwiftRuntimeIsMono>
      <_SwiftRuntimeIsCoreClr>false</_SwiftRuntimeIsCoreClr>
      <_SwiftRuntimeIsCoreClr Condition="'$(_SwiftRuntimeIsNativeAot)' != 'true' AND '$(_SwiftRuntimeIsMono)' != 'true'">true</_SwiftRuntimeIsCoreClr>
    </PropertyGroup>
    <Error Code="SWIFTBIND126"
           Condition="'$(_SwiftRuntimeIsNativeAot)' == 'true' AND '$(_SwiftRuntimeIsMono)' == 'true'"
           Text="Swift.Runtime engine conflict: Mono and NativeAOT cannot both be selected for the final app." />
    <!-- Apple deliberately disables the SDK's generic NativeCompile publish hook,
         then invokes IlcCompile from _CompileNativeExecutable instead. This contract
         applies to both .NET 10 and .NET 11 (Xamarin.Shared.Sdk.props/targets).
         Only the resolved Apple workload/runtime-pack path supplies that replacement;
         elsewhere disabling native compilation still contradicts an AOT identity. -->
    <Error Code="SWIFTBIND126"
           Condition="'$(_SwiftRuntimeIsNativeAot)' == 'true' AND '$(NativeCompilationDuringPublish)' == 'false' AND ('$(_SwiftRuntimeAppleApp)' != 'true' OR '$(UsingAppleNETSdk)' != 'true' OR '$(PublishAotUsingRuntimePack)' != 'true')"
           Text="Swift.Runtime engine is unresolved: NativeCompilationDuringPublish=false suppresses native compilation without a resolved Apple workload runtime-pack AOT path." />
    <ItemGroup>
      <!-- Replace any legacy policy-derived input; engine switches are reserved for
           this integration layer so duplicate user-authored facts cannot silently win. -->
      <_SwiftRuntimeExistingEngine Include="@(RuntimeHostConfigurationOption)"
          Condition="'%(Identity)' == 'Swift.Runtime.Engine.Mono' OR '%(Identity)' == 'Swift.Runtime.Engine.CoreCLR' OR '%(Identity)' == 'Swift.Runtime.Engine.NativeAOT'" />
    </ItemGroup>
    <Error Code="SWIFTBIND127" Condition="'@(_SwiftRuntimeExistingEngine)' != ''"
           Text="Swift.Runtime engine switches are reserved for resolved final-app identity; remove manually supplied Swift.Runtime.Engine.* RuntimeHostConfigurationOption items." />
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="Swift.Runtime.IsNativeAot" />
      <RuntimeHostConfigurationOption Include="Swift.Runtime.IsNativeAot" Value="$(_SwiftRuntimeIsNativeAot)" />
      <RuntimeHostConfigurationOption Include="Swift.Runtime.Engine.Mono" Value="$(_SwiftRuntimeIsMono)" />
      <RuntimeHostConfigurationOption Include="Swift.Runtime.Engine.CoreCLR" Value="$(_SwiftRuntimeIsCoreClr)" />
      <RuntimeHostConfigurationOption Include="Swift.Runtime.Engine.NativeAOT" Value="$(_SwiftRuntimeIsNativeAot)" />
    </ItemGroup>
  </Target>

  <!-- Native runtime, embedded as a signed dynamic framework via a single
       <NativeReference Kind="Framework"> to the committed xcframework. The .NET Apple
       workload picks the right per-platform/-arch slice, embeds the .framework into the
       consumer app bundle's Frameworks/, and re-signs it — the TN2435-compliant shape that
       replaced the loose-dylib <Content> injection that App Store review rejected
       (ITMS-90426/90429, issue #42). One item is correct on every Apple TFM (iOS device +
       simulator, tvOS device + simulator, macOS, Mac Catalyst); the workload's xcframework
       handling resolves the slice from $(RuntimeIdentifier) at publish time, so no per-RID
       or per-platform item is needed. Mirrors SwiftBindings.Apple.targets and every
       generated binding's emitted ConsumerTargets.

       The Apple-TFM guard is load-bearing here (more than in the authoring csproj): this
       file ships in buildTransitive/ and is imported by EVERY leg of a consumer that
       references the Runtime package — including the non-Apple legs (plain net10.0, and a
       MAUI/multi-targeted app's net10.0-android / net10.0-windows legs, which resolve the
       package's net10.0 lib asset). A <NativeReference> is invalid outside an Apple TFM, so
       the item must self-restrict; without the guard a multi-targeted consumer's non-Apple
       leg gets an invalid NativeReference. -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND ($(TargetFramework.Contains('ios')) OR $(TargetFramework.Contains('macos')) OR $(TargetFramework.Contains('maccatalyst')) OR $(TargetFramework.Contains('tvos')))
                         AND Exists('$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework')">
    <NativeReference Include="$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Finding 61: positive embed stamp (App Store hygiene tripwire)            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- The appstore-hygiene binding-tests gate proves the runtime framework actually embedded by
       inspecting the produced .ipa. But "an .ipa exists" is an inference: if a future .NET Apple
       workload renames or removes the target that copies <NativeReference Kind="Framework"> dirs into
       the app bundle, the framework could silently stop embedding while a publish still "succeeds".
       This target writes a positive sentinel AFTER the workload's framework-embed step actually runs
       — _CopyDirectoriesToBundle (Xamarin.Shared.Sdk.targets), the `ditto` copy of the .framework
       directories into <App>.app/Frameworks/ — under the SAME conditions the runtime NativeReference
       is emitted (IncludeSwiftBindingsRuntimeNative + an Apple TFM). The gate asserts this sentinel
       post-publish: if the embed target is renamed/removed, AfterTargets binds to nothing, the sentinel
       is absent, and the gate fails with a named diagnostic instead of silently passing. The sentinel
       is written into $(IntermediateOutputPath) (obj/) — never into the app bundle or .ipa, so it
       cannot itself become stray-file litter the hygiene checks would flag. Sibling of the wiring
       tripwire the review asked for; mirrors the embed conditions of the NativeReference above. -->
  <Target Name="_StampSwiftRuntimeEmbed"
          AfterTargets="_CopyDirectoriesToBundle"
          Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                     AND ($(TargetFramework.Contains('ios')) OR $(TargetFramework.Contains('macos')) OR $(TargetFramework.Contains('maccatalyst')) OR $(TargetFramework.Contains('tvos')))
                     AND Exists('$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework')">
    <WriteLinesToFile File="$(IntermediateOutputPath)swiftbindings-runtime-embed.stamp"
                      Lines="SwiftBindingsRuntime framework embed hook fired after _CopyDirectoriesToBundle"
                      Overwrite="true" />
  </Target>

  <!-- tvOS Mono apps resolve P/Invokes the way iOS apps do.
       The workload's bundler decides per assembly whether Mono's AOT compiler binds a P/Invoke
       through dlsym at run time or as a direct reference the app's link must satisfy
       (dotnet-linker Application.UseDlsym). On iOS every non-SDK assembly gets dlsym, on Mac
       Catalyst every assembly does, and on tvOS none does. Swift.Runtime, the Apple supplement
       and generated bindings P/Invoke into /usr/lib/swift and system Swift frameworks that the
       app's executable does not link, so an AOT-compiled tvOS app fails to link
       ("Swift.Array.init() -> [A]", referenced from wrapper_managed_to_native_...). Name every
       non-SDK assembly, as iOS's default does, so the same assemblies bind the same way on both
       platforms. The bundler checks each named assembly before the platform default and the
       first match wins.
       _BundlerDlsym holds the dlsym options the workload parsed from MtouchExtraArgs; an app that
       passed any keeps exactly those. The items are added just before _ComputeLinkerInputs writes
       them into the linker's options, a build-only step that runs after references resolve.
       _ParseBundlerArguments is no hook for this: a Rebuild runs it once, during Clean, before
       any reference is known. The interpreter, NativeAOT and .NET 11's CoreCLR do not use this
       choice. -->
  <Target Name="_SwiftBindingsTvosDlsym"
          BeforeTargets="_ComputeLinkerInputs"
          Condition="$(TargetFramework.Contains('-tvos'))
                     AND '$(UseMonoRuntime)' == 'true'
                     AND ('$(OutputType)' == 'Exe' OR '$(IsAppExtension)' == 'true')">
    <ItemGroup Condition="'@(_BundlerDlsym)' == ''">
      <_BundlerDlsym Include="@(ReferencePath->'+%(Filename).dll')" Condition="'%(ReferencePath.FrameworkReferenceName)' == ''" />
      <_BundlerDlsym Include="+$(AssemblyName).dll" />
    </ItemGroup>
  </Target>

  <!-- NativeAOT trimmer descriptor wiring.
       Swift.Runtime ships ILLink.Descriptors.xml as an EmbeddedResource for the IL trimmer's
       auto-discovery path. ILC (NativeAOT) does not auto-discover embedded descriptors from
       referenced assemblies; it only honors descriptors passed via the IlcArg descriptor flag.
       Without this injection, NativeAOT consumers silently strip ValueTuple constructors
       and core Swift.Runtime types (existential containers, protocol witness tables, factory
       dispatchers) that the embedded descriptor was pinning, surfacing as MissingMethodException
       or AOT runtime errors deep inside Swift.Runtime, opaque from the consumer's POV.
       Belt-and-suspenders on both items mirrors the in-tree workaround in
       BindingTests/RuntimeTestsApp.csproj that was the model for this packaging contract. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' AND Exists('$(MSBuildThisFileDirectory)ILLink.Descriptors.xml')">
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
    <IlcArg Include="--descriptor:$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Consumer transition check (SWIFTBIND132)                                 -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- A binding generated by the current SDK protects itself: an unsafe Swift transition goes
       through a thunk, the @_cdecl wrapper or an evidence-authorized bridge, and what cannot be
       routed is refused at member level. A binding compiled earlier, or packed elsewhere, cannot.
       This step reads every resolved reference that can make a Swift transition (package,
       project and plain references, direct or transitive) and refuses the build when one carries a
       transition this app's engine cannot be shown to run safely: no transition manifest beside a
       transition that is not a primitive-only call, a manifest that is tampered with or does not
       describe its assembly, or a valid manifest whose transitions fail the transition gate's
       rules, or whose native image does not hold its hash and bridges. A binding without a
       manifest whose Swift calls are all primitive-only passes.

       It runs in final apps only (the engine is the app's), after reference resolution, on the
       engines that mishandle such transitions: Mono on iOS, tvOS and Mac Catalyst (.NET 10's
       simulator, Catalyst and device Mono AOT apps) and every non-NativeAOT .NET 11 app on those
       platforms, Debug (the CoreCLR interpreter) and Release (ReadyToRun leaves methods to the
       interpreter). NativeAOT and macOS are not checked. Results are cached by MVID under obj/.

       <SwiftBindingsTransitionSuppress Include="PackageId" /> downgrades one package's error to a
       warning (for a project or plain reference, name its assembly). There is no switch that turns
       the check off. See src/docs/Design/consumer-transition-check.md. -->
  <PropertyGroup>
    <_SwiftBindingsTasksAssembly Condition="'$(_SwiftBindingsTasksAssembly)' == ''">$(MSBuildThisFileDirectory)tasks/net10.0/SwiftBindings.Tasks.dll</_SwiftBindingsTasksAssembly>
  </PropertyGroup>
  <UsingTask TaskName="SwiftBindings.Tasks.SwiftTransitionConsumerCheck" AssemblyFile="$(_SwiftBindingsTasksAssembly)" />

  <Target Name="_SwiftBindingsResolveTransitionCheckEngine">
    <PropertyGroup>
      <_SwiftTransitionCheckApp>false</_SwiftTransitionCheckApp>
      <_SwiftTransitionCheckApp Condition="'$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe' OR '$(IsAppExtension)' == 'true'">true</_SwiftTransitionCheckApp>
      <_SwiftTransitionCheckPlatform>false</_SwiftTransitionCheckPlatform>
      <_SwiftTransitionCheckPlatform Condition="$(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('-tvos')) OR $(TargetFramework.Contains('-maccatalyst'))">true</_SwiftTransitionCheckPlatform>
      <_SwiftTransitionCheckNet11>false</_SwiftTransitionCheckNet11>
      <_SwiftTransitionCheckNet11 Condition="'$(_SwiftTransitionCheckPlatform)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), '11.0'))">true</_SwiftTransitionCheckNet11>
      <_SwiftTransitionCheckEngine></_SwiftTransitionCheckEngine>
      <_SwiftTransitionCheckEngine Condition="'$(_SwiftTransitionCheckNet11)' == 'true' AND '$(Configuration)' == 'Debug'">the .NET 11 CoreCLR interpreter (Debug)</_SwiftTransitionCheckEngine>
      <_SwiftTransitionCheckEngine Condition="'$(_SwiftTransitionCheckNet11)' == 'true' AND '$(Configuration)' != 'Debug'">.NET 11 CoreCLR ($(Configuration))</_SwiftTransitionCheckEngine>
      <_SwiftTransitionCheckEngine Condition="'$(_SwiftTransitionCheckNet11)' != 'true' AND '$(_SwiftTransitionCheckPlatform)' == 'true' AND '$(UseMonoRuntime)' == 'true'">Mono</_SwiftTransitionCheckEngine>
      <_SwiftTransitionCheckEngine Condition="'$(_UseNativeAot)' == 'true' OR '$(_SwiftTransitionCheckApp)' != 'true' OR '$(DesignTimeBuild)' == 'true'"></_SwiftTransitionCheckEngine>
    </PropertyGroup>
  </Target>

  <Target Name="_SwiftBindingsCheckReferenceTransitions"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveAssemblyReferences;_SwiftBindingsResolveTransitionCheckEngine"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Code="SWIFTBIND132"
           Condition="'$(_SwiftTransitionCheckEngine)' != '' AND !Exists('$(_SwiftBindingsTasksAssembly)')"
           Text="The Swift transition check task $(_SwiftBindingsTasksAssembly) is missing, so this app's Swift bindings cannot be checked for transitions $(_SwiftTransitionCheckEngine) cannot run safely. Restore SwiftBindings.Runtime again; an in-tree app that imports this file from source builds src/Swift.Runtime/tasks and sets _SwiftBindingsTasksAssembly." />
    <SwiftTransitionConsumerCheck
        Condition="'$(_SwiftTransitionCheckEngine)' != ''"
        CompileReferences="@(ReferencePath)"
        RuntimeReferences="@(ReferenceCopyLocalPaths)"
        NativeReferences="@(NativeReference)"
        Suppressions="@(SwiftBindingsTransitionSuppress)"
        Engine="$(_SwiftTransitionCheckEngine)"
        CacheFile="$(IntermediateOutputPath)swiftbindings-transition-check.json"
        ScratchDirectory="$(IntermediateOutputPath)swiftbindings-transition-check">
      <Output TaskParameter="Checked" ItemName="_SwiftTransitionChecked" />
    </SwiftTransitionConsumerCheck>
    <ItemGroup Condition="'$(_SwiftTransitionCheckEngine)' != ''">
      <FileWrites Include="$(IntermediateOutputPath)swiftbindings-transition-check.json" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Pack-time transition check of a standalone binding (SWIFTBIND133)       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- SwiftBindings.Sdk checks every package it packs (_SwiftBindingsCheckPackedTransitions). A
       project the generator emits for the standalone path builds on Microsoft.NET.Sdk instead and
       imports only this file, through its SwiftBindings.Runtime reference, so it opts in with
       <SwiftBindingsCheckPackedTransitions>true</SwiftBindingsCheckPackedTransitions> and gets the
       same check of the package `dotnet pack` just wrote: a package its consumers would refuse
       (SWIFTBIND132), a wrapper identity included, is deleted. Other projects that reference the
       runtime are not checked.

       The marker property tells such a project that this file runs the check. A project the
       generator emits refuses to pack (SWIFTBIND133) under a Runtime whose targets do not set it,
       since its opt-in would otherwise pack unchecked. Keep the name: published binding projects
       read it. -->
  <PropertyGroup>
    <_SwiftBindingsStandalonePackCheckAvailable>true</_SwiftBindingsStandalonePackCheckAvailable>
  </PropertyGroup>
  <UsingTask TaskName="SwiftBindings.Tasks.SwiftTransitionPackageCheck" AssemblyFile="$(_SwiftBindingsTasksAssembly)" />

  <!-- The packed assemblies' resolved references for one target framework. The check asks with
       BuildProjectReferences=false, as NuGet's pack asks its own per-framework questions, so a
       ProjectReference contributes the output it already has and is never built: building it under
       `dotnet pack` with the no-build switch fails NETSDK1085. -->
  <Target Name="_SwiftBindingsStandalonePackReferenceDirectories"
          DependsOnTargets="ResolveAssemblyReferences"
          Returns="@(_SwiftBindingsStandalonePackReferenceDirectory->Distinct())">
    <ItemGroup>
      <_SwiftBindingsStandalonePackReferenceDirectory Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
    </ItemGroup>
  </Target>

  <Target Name="_SwiftBindingsCheckStandalonePackedTransitions"
          AfterTargets="Pack"
          Condition="'$(SwiftBindingsCheckPackedTransitions)' == 'true' AND '$(IsPackable)' != 'false'">
    <Error Code="SWIFTBIND133"
           Condition="!Exists('$(_SwiftBindingsTasksAssembly)')"
           Text="The Swift transition check task $(_SwiftBindingsTasksAssembly) is missing, so the package cannot be checked before it ships. Restore SwiftBindings.Runtime again." />
    <ItemGroup>
      <_SwiftBindingsStandalonePackTfm Include="$(TargetFrameworks)" Condition="'$(TargetFrameworks)' != ''" />
      <_SwiftBindingsStandalonePackTfm Include="$(TargetFramework)" Condition="'$(TargetFrameworks)' == ''" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="_SwiftBindingsStandalonePackReferenceDirectories"
             Properties="TargetFramework=%(_SwiftBindingsStandalonePackTfm.Identity);BuildProjectReferences=false">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftBindingsStandalonePackReference" />
    </MSBuild>
    <SwiftTransitionPackageCheck Packages="@(NuGetPackOutput)"
                                 ReferenceDirectories="@(_SwiftBindingsStandalonePackReference->Distinct())"
                                 ScratchDirectory="$(BaseIntermediateOutputPath)swift-transition-pack-check" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Package copy check (SWIFTBIND136, SWIFTBIND139)                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- A binding package carries one copy per toolchain, keyed by its full pack TFM: lib/<tfm>/,
       buildTransitive/<tfm>/ and native/<tfm>/, and each copy's buildTransitive/<tfm>/<Id>.props
       declares it (@(SwiftBindingPackageCopy)). NuGet picks lib/ and buildTransitive/ separately by
       the same nearest-framework rule, so the build must resolve the binding assembly from the
       lib/ copy whose consumer targets (and natives) NuGet chose; otherwise it fails (SWIFTBIND136)
       before compiling. Each package's selected copy is announced in the build log. A copy built
       for an older .NET or platform SDK than the build's own toolchain is reported (SWIFTBIND139);
       <SwiftBindingsRequireExactCopy>true</SwiftBindingsRequireExactCopy> makes that an error.
       Runs in every build that resolves references (apps and libraries), not in design-time builds. -->
  <UsingTask TaskName="SwiftBindings.Tasks.SwiftBindingCopyCheck" AssemblyFile="$(_SwiftBindingsTasksAssembly)" />

  <Target Name="_SwiftBindingsCheckPackageCopies"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Code="SWIFTBIND136"
           Condition="'@(SwiftBindingPackageCopy)' != '' AND !Exists('$(_SwiftBindingsTasksAssembly)')"
           Text="The SwiftBindings copy check task $(_SwiftBindingsTasksAssembly) is missing, so this build cannot show that each binding package's managed and native copies match. Restore SwiftBindings.Runtime again." />
    <SwiftBindingCopyCheck
        Condition="Exists('$(_SwiftBindingsTasksAssembly)')"
        Copies="@(SwiftBindingPackageCopy)"
        References="@(ReferencePath)"
        TargetFramework="$(TargetFramework)"
        TargetPlatformVersion="$(TargetPlatformVersion)"
        RequireExactCopy="$([MSBuild]::ValueOrDefault('$(SwiftBindingsRequireExactCopy)', 'false'))" />
  </Target>

  <!-- NOTE: there is deliberately no SwiftSupport-folder injection here. Apple's
       SwiftSupport/ requirement (ITMS-90426) applies to apps that embed loose
       /usr/lib/swift back-deployment dylibs. This runtime now ships as a signed dynamic
       framework inside an xcframework and links the OS-resident stable Swift ABI
       (/usr/lib/swift), so a compliant app embeds zero libswift*.dylib and needs no
       SwiftSupport/ folder. Re-introducing the injector would re-create the bloat the
       reporter saw (issue #42: .xcarchive 138MB → 185MB) for no benefit. The
       appstore-hygiene binding-tests gate asserts this hygiene holds. -->

</Project>
