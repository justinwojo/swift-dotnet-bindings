<!-- SwiftBindings.Runtime NuGet package: conditional native dylib injection.
     Replicates the ProjectReference dylib logic for NuGet consumers.
     Placed in buildTransitive/ so it flows to transitive dependents. -->
<Project>

  <PropertyGroup>
    <IncludeSwiftBindingsRuntimeNative Condition="'$(IncludeSwiftBindingsRuntimeNative)' == ''">true</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <!-- Mac App Store framework anatomy for the app bundle's embedded frameworks.

       Deliberately NOT gated on IncludeSwiftBindingsRuntimeNative: that switch decides whether
       THIS package contributes its own native framework, while the anatomy step works on
       whatever the app bundle ended up containing — the Apple supplement, a binding's wrapper,
       a vendor framework. A consumer that turns the runtime's native off still embeds those, and
       still needs them in the right shape. Importing it from here means a runtime patch reaches
       every consumer of every already-published binding package, since they all resolve the
       runtime through their own dependency. -->
  <Import Project="$(MSBuildThisFileDirectory)SwiftBindings.MacFrameworkAnatomy.targets"
          Condition="'$(_SwiftBindingsMacFrameworkAnatomyImported)' != 'true'
                     AND Exists('$(MSBuildThisFileDirectory)SwiftBindings.MacFrameworkAnatomy.targets')" />

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Defect H: build-time runtime-flavor switch for SwiftRuntimeInfo         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- The managed heuristic in SwiftRuntimeInfo cannot distinguish Mono full-AOT
       on an iOS *device* (rid 'ios-arm64', no PublishAot, SwiftBindingsInteropMode=Safe)
       from NativeAOT: both report IsDynamicCodeSupported=false and neither exposes the
       'Mono.Runtime' type. Misclassifying the supported device-Mono build as NativeAOT
       enables direct static-virtual generic dispatch, which aborts Mono (jit-info.c:918).
       We inject the build-time truth as an AppContext switch read by SwiftRuntimeInfo:
       true iff the binding is built for the NativeAOT (Direct) interop contract, false for
       Mono/CoreCLR (Safe). The switch is authoritative; the heuristic is only a fallback
       when it is absent — so injecting it for *every* config (Direct and Safe alike) is
       what actually closes the hole.

       This lives in the Runtime package's buildTransitive targets because that file is
       imported by every consumer (PackageReference bindings, SDK-direct apps, and pure
       Runtime consumers), giving a single injection point with no resolution-logic drift.

       The value is computed inside a target that runs just before the runtimeconfig.json
       generation so SwiftBindingsInteropMode/PublishAot are fully resolved regardless of
       import order (Grok flagged top-level-property ordering as the main risk). The
       resolution mirrors the SDK / ConsumerTargetsEmitter twin: explicit Direct/Safe wins;
       otherwise Direct iff PublishAot. The PublishAot fallback also yields the correct
       answer when SwiftBindingsInteropMode is unset (pure Runtime consumer) or still 'Auto'. -->
  <Target Name="_SwiftBindingsInjectRuntimeFlavorSwitch"
          BeforeTargets="GenerateBuildRuntimeConfigurationFiles;GenerateRuntimeConfigurationFiles">
    <PropertyGroup>
      <_SwiftRuntimeIsNativeAot Condition="'$(SwiftBindingsInteropMode)' == 'Direct'">true</_SwiftRuntimeIsNativeAot>
      <_SwiftRuntimeIsNativeAot Condition="'$(SwiftBindingsInteropMode)' == 'Safe'">false</_SwiftRuntimeIsNativeAot>
      <_SwiftRuntimeIsNativeAot Condition="'$(_SwiftRuntimeIsNativeAot)' == '' AND '$(PublishAot)' == 'true'">true</_SwiftRuntimeIsNativeAot>
      <_SwiftRuntimeIsNativeAot Condition="'$(_SwiftRuntimeIsNativeAot)' == ''">false</_SwiftRuntimeIsNativeAot>
    </PropertyGroup>
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="Swift.Runtime.IsNativeAot"
                                      Value="$(_SwiftRuntimeIsNativeAot)" />
    </ItemGroup>
  </Target>

  <!-- Native runtime, embedded as a signed dynamic framework via a single
       <NativeReference Kind="Framework"> to the committed xcframework. The .NET Apple
       workload picks the right per-platform/-arch slice, embeds the .framework into the
       consumer app bundle's Frameworks/, and re-signs it — the TN2435-compliant shape that
       replaced the loose-dylib <Content> injection that App Store review rejected
       (ITMS-90426/90429, issue #42). One item is correct on every Apple TFM (iOS device +
       simulator, tvOS device + simulator, macOS, Mac Catalyst); the workload's xcframework
       handling resolves the slice from $(RuntimeIdentifier) at publish time, so no per-RID
       or per-platform item is needed. Mirrors SwiftBindings.Apple.targets and every
       generated binding's emitted ConsumerTargets.

       The Apple-TFM guard is load-bearing here (more than in the authoring csproj): this
       file ships in buildTransitive/ and is imported by EVERY leg of a consumer that
       references the Runtime package — including the non-Apple legs (plain net10.0, and a
       MAUI/multi-targeted app's net10.0-android / net10.0-windows legs, which resolve the
       package's net10.0 lib asset). A <NativeReference> is invalid outside an Apple TFM, so
       the item must self-restrict; without the guard a multi-targeted consumer's non-Apple
       leg gets an invalid NativeReference. -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                         AND ($(TargetFramework.Contains('ios')) OR $(TargetFramework.Contains('macos')) OR $(TargetFramework.Contains('maccatalyst')) OR $(TargetFramework.Contains('tvos')))
                         AND Exists('$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework')">
    <NativeReference Include="$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Finding 61: positive embed stamp (App Store hygiene tripwire)            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- The appstore-hygiene binding-tests gate proves the runtime framework actually embedded by
       inspecting the produced .ipa. But "an .ipa exists" is an inference: if a future .NET Apple
       workload renames or removes the target that copies <NativeReference Kind="Framework"> dirs into
       the app bundle, the framework could silently stop embedding while a publish still "succeeds".
       This target writes a positive sentinel AFTER the workload's framework-embed step actually runs
       — _CopyDirectoriesToBundle (Xamarin.Shared.Sdk.targets), the `ditto` copy of the .framework
       directories into <App>.app/Frameworks/ — under the SAME conditions the runtime NativeReference
       is emitted (IncludeSwiftBindingsRuntimeNative + an Apple TFM). The gate asserts this sentinel
       post-publish: if the embed target is renamed/removed, AfterTargets binds to nothing, the sentinel
       is absent, and the gate fails with a named diagnostic instead of silently passing. The sentinel
       is written into $(IntermediateOutputPath) (obj/) — never into the app bundle or .ipa, so it
       cannot itself become stray-file litter the hygiene checks would flag. Sibling of the wiring
       tripwire the review asked for; mirrors the embed conditions of the NativeReference above. -->
  <Target Name="_StampSwiftRuntimeEmbed"
          AfterTargets="_CopyDirectoriesToBundle"
          Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                     AND ($(TargetFramework.Contains('ios')) OR $(TargetFramework.Contains('macos')) OR $(TargetFramework.Contains('maccatalyst')) OR $(TargetFramework.Contains('tvos')))
                     AND Exists('$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework')">
    <WriteLinesToFile File="$(IntermediateOutputPath)swiftbindings-runtime-embed.stamp"
                      Lines="SwiftBindingsRuntime framework embed hook fired after _CopyDirectoriesToBundle"
                      Overwrite="true" />
  </Target>

  <!-- NativeAOT trimmer descriptor wiring.
       Swift.Runtime ships ILLink.Descriptors.xml as an EmbeddedResource for the IL trimmer's
       auto-discovery path. ILC (NativeAOT) does not auto-discover embedded descriptors from
       referenced assemblies; it only honors descriptors passed via the IlcArg descriptor flag.
       Without this injection, NativeAOT consumers silently strip ValueTuple constructors
       and core Swift.Runtime types (existential containers, protocol witness tables, factory
       dispatchers) that the embedded descriptor was pinning, surfacing as MissingMethodException
       or AOT runtime errors deep inside Swift.Runtime, opaque from the consumer's POV.
       Belt-and-suspenders on both items mirrors the in-tree workaround in
       BindingTests/RuntimeTestsApp.csproj that was the model for this packaging contract. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' AND Exists('$(MSBuildThisFileDirectory)ILLink.Descriptors.xml')">
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
    <IlcArg Include="--descriptor:$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- NOTE: there is deliberately no SwiftSupport-folder injection here. Apple's
       SwiftSupport/ requirement (ITMS-90426) applies to apps that embed loose
       /usr/lib/swift back-deployment dylibs. This runtime now ships as a signed dynamic
       framework inside an xcframework and links the OS-resident stable Swift ABI
       (/usr/lib/swift), so a compliant app embeds zero libswift*.dylib and needs no
       SwiftSupport/ folder. Re-introducing the injector would re-create the bloat the
       reporter saw (issue #42: .xcarchive 138MB → 185MB) for no benefit. The
       appstore-hygiene binding-tests gate asserts this hygiene holds. -->

</Project>
