<!-- Embedded linker descriptor for NativeAOT trimming.
     Automatically applied when consumers reference SwiftBindings.Runtime.
     Preserves methods needed for reflection-based factory lookup (NewFromPayload,
     GetTypeMetadata) on core Swift.Runtime wrapper types.

     NOTE: Types with CallConvSwift P/Invoke members (DispatchQueue, URL, UIImage, etc.)
     are intentionally excluded — preserve="methods" on them crashes ILC.
     Those types self-register their factories via SwiftFrameworkResolver.InitializeRuntime(). -->
<linker>
  <assembly fullname="Swift.Runtime">
    <!-- Core collection/wrapper types — preserve="all" ensures explicit interface
         implementations (NewFromPayload, GetTypeMetadata) are discoverable via reflection
         on NativeAOT. preserve="methods" alone may not preserve reflection metadata for
         private explicit implementations that the trimmer considers unreachable. -->
    <type fullname="Swift.SwiftString" preserve="all" />
    <type fullname="Swift.SwiftArray`1" preserve="all" />
    <type fullname="Swift.SwiftOptional`1" preserve="all" />
    <type fullname="Swift.SwiftResult`2" preserve="all" />
    <type fullname="Swift.SwiftDictionary`2" preserve="all" />
    <type fullname="Swift.SwiftSet`1" preserve="all" />
    <type fullname="Swift.AnyHashable" preserve="all" />
    <!-- Existential containers -->
    <type fullname="Swift.Runtime.ExistentialContainer0" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer1" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer2" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer3" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer4" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer5" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer6" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer7" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer8" preserve="methods" />
    <!-- Existential container factory: generic Create/GetOrCreate methods used by
         generated BoxAsExistential1<TProtocol>() calls through IExistentialBoxable -->
    <type fullname="Swift.Runtime.ExistentialContainerFactory" preserve="methods" />
    <!-- Protocol conformance resolution: witness table lookup via swift_getWitnessTable -->
    <type fullname="Swift.Runtime.ProtocolWitnessTable" preserve="methods" />
    <type fullname="Swift.Runtime.ProtocolConformanceDescriptor" preserve="methods" />
    <!-- Infrastructure types used by reflection-based marshalling -->
    <type fullname="Swift.Runtime.InteropServices.NewFromPayloadDispatcher" preserve="methods" />
    <type fullname="Swift.Runtime.SwiftObjectReflectionHelper" preserve="methods" />
    <!-- Closure callback support: generated callbacks call GetDelegateFromContext<T> -->
    <type fullname="Swift.Runtime.SwiftClosureMarshaller" preserve="methods" />
  </assembly>
  <!-- ValueTuple constructors/fields for tuple marshalling on NativeAOT.
       SwiftMarshal.MarshalTupleFromSwift<T> reflectively invokes the closed
       ValueTuple<...>(T1, T2, ...) constructor when materializing tuples
       returned through Optional<(SwiftString, IntPtr)> and similar shapes.
       Inline [DynamicallyAccessedMembers] annotations on the T type
       parameter do not propagate strongly enough through typeof(T) → Type to
       keep the matching ctor overload alive on every closed instantiation
       under ILC trimming; preserve="all" pins constructors + fields together
       so the reflective path stays valid uniformly across instantiations.
       Effectiveness caveat: the IL trimmer (any consumer that publishes
       trimmed, e.g. PublishTrimmed=true or IsTrimmable=true on a library)
       discovers this embedded descriptor automatically. ILC (NativeAOT)
       does NOT auto-discover embedded descriptors from referenced
       assemblies; a NativeAOT consumer must additionally pass the
       descriptor explicitly to ILC by adding an IlcArg item that
       references this file via the ILC descriptor command-line option.
       BindingTests/RuntimeTestsApp does this with TrimmerRoots.xml plus an
       explicit IlcArg in its csproj for the device/NativeAOT path; the
       iOS simulator path in this repo runs with MtouchLink=None (no
       trimming) so neither mechanism is active there. Wiring the same
       path for NuGet consumers via buildTransitive is a followup tracked
       in src/docs/roadmap.md. -->
  <assembly fullname="System.Private.CoreLib">
    <type fullname="System.ValueTuple`1" preserve="all" />
    <type fullname="System.ValueTuple`2" preserve="all" />
    <type fullname="System.ValueTuple`3" preserve="all" />
    <type fullname="System.ValueTuple`4" preserve="all" />
    <type fullname="System.ValueTuple`5" preserve="all" />
    <type fullname="System.ValueTuple`6" preserve="all" />
    <type fullname="System.ValueTuple`7" preserve="all" />
    <type fullname="System.ValueTuple`8" preserve="all" />
  </assembly>
</linker>
