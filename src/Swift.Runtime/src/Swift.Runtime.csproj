<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Multi-target to support platform-specific conditional compilation -->
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-macos;net10.0-maccatalyst;net10.0-tvos</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SB1001: The runtime itself manages ISwiftObject lifetimes; suppress its own analyzer -->
    <!-- CS1591: Missing XML comment for publicly visible type or member — not adding XML docs to all public APIs -->
    <NoWarn>$(NoWarn);SB1001;CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Runtime</PackageId>
    <PackageVersion>0.0.0-dev</PackageVersion>
    <Description>Runtime library for Swift/.NET interop. Provides SwiftString, SwiftArray, SwiftOptional, ARC memory management, protocol witness tables, and type metadata for generated Swift bindings.</Description>
    <Authors>Justin Wojciechowski</Authors>
    <PackageTags>swift;interop;bindings;dotnet;ios;macos</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Minimum OS versions -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('macos'))">12.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('tvos'))">15.0</SupportedOSPlatformVersion>
    <!-- Allow app projects to opt out of packaging the optional concurrency native runtime. -->
    <IncludeSwiftBindingsRuntimeNative>true</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Swift/**/*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Include pre-built native runtime library when available.
       iOS device vs simulator is distinguished by RuntimeIdentifier, not TargetFramework
       (both use net10.0-ios). Device condition excludes simulator RIDs to prevent
       duplicate content items. -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true' AND Exists('$(MSBuildThisFileDirectory)../native/macos/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/macos/libSwiftBindingsRuntime.dylib"
             Condition="$(TargetFramework.Contains('macos')) AND !$(TargetFramework.Contains('maccatalyst'))"
             Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true' AND Exists('$(MSBuildThisFileDirectory)../native/ios/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/ios/libSwiftBindingsRuntime.dylib"
             Condition="$(TargetFramework.Contains('ios')) AND !$(RuntimeIdentifier.Contains('simulator'))"
             Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true' AND Exists('$(MSBuildThisFileDirectory)../native/iossimulator/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/iossimulator/libSwiftBindingsRuntime.dylib"
             Condition="$(TargetFramework.Contains('ios')) AND $(RuntimeIdentifier.Contains('simulator'))"
             Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>
  <!-- Mac Catalyst: maccatalyst TFM -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true' AND Exists('$(MSBuildThisFileDirectory)../native/maccatalyst/libSwiftBindingsRuntime.dylib')">
    <NativeReference Include="$(MSBuildThisFileDirectory)../native/maccatalyst/libSwiftBindingsRuntime.dylib"
                     Condition="$(TargetFramework.Contains('maccatalyst'))"
                     Pack="false">
      <Kind>Dynamic</Kind>
    </NativeReference>
  </ItemGroup>
  <!-- tvOS device -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true' AND Exists('$(MSBuildThisFileDirectory)../native/tvos/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/tvos/libSwiftBindingsRuntime.dylib"
             Condition="$(TargetFramework.Contains('tvos')) AND !$(RuntimeIdentifier.Contains('simulator'))"
             Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>
  <!-- tvOS simulator -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true' AND Exists('$(MSBuildThisFileDirectory)../native/tvossimulator/libSwiftBindingsRuntime.dylib')">
    <Content Include="$(MSBuildThisFileDirectory)../native/tvossimulator/libSwiftBindingsRuntime.dylib"
             Condition="$(TargetFramework.Contains('tvos')) AND $(RuntimeIdentifier.Contains('simulator'))"
             Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Frameworks/libSwiftBindingsRuntime.dylib</Link>
    </Content>
  </ItemGroup>

  <!-- Roslyn analyzer: build as analyzer, pack into NuGet for consumers.
       The ProjectReference builds the analyzer alongside Swift.Runtime.
       The target below resolves the actual output path from MSBuild properties
       so we don't hardcode bin/$(Configuration)/netstandard2.0/. -->
  <ItemGroup>
    <ProjectReference Include="../../Swift.Analyzers/Swift.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>
  <Target Name="_AddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../../Swift.Analyzers/Swift.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerOutput" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AnalyzerOutput)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Embedded linker descriptor: preserves core types for NativeAOT trimming.
       Automatically applied to consumer projects that reference this assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NuGet pack items: native dylibs, .targets, and README -->
  <ItemGroup>
    <None Include="../native/macos/libSwiftBindingsRuntime.dylib" Pack="true" PackagePath="native/macos" />
    <None Include="../native/ios/libSwiftBindingsRuntime.dylib" Pack="true" PackagePath="native/ios" />
    <None Include="../native/iossimulator/libSwiftBindingsRuntime.dylib" Pack="true" PackagePath="native/iossimulator" />
    <None Include="../native/maccatalyst/libSwiftBindingsRuntime.dylib" Pack="true" PackagePath="native/maccatalyst" />
    <None Include="../native/tvos/libSwiftBindingsRuntime.dylib" Pack="true" PackagePath="native/tvos" />
    <None Include="../native/tvossimulator/libSwiftBindingsRuntime.dylib" Pack="true" PackagePath="native/tvossimulator" />
    <None Include="build/SwiftBindings.Runtime.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="../../../README.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
