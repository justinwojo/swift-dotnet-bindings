<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Multi-target to support platform-specific conditional compilation -->
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-macos;net10.0-maccatalyst;net10.0-tvos</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SB1001: The runtime itself manages ISwiftObject lifetimes; suppress its own analyzer -->
    <!-- CS1591: Missing XML comment for publicly visible type or member — not adding XML docs to all public APIs -->
    <NoWarn>$(NoWarn);SB1001;CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Enforce package self-consistency at pack time. EnablePackageValidation runs NuGet's
         compatible-framework / compatible-RID validators over the produced .nupkg — they fire
         offline, need no network, and catch a TFM or RID asset that would leave a consumer
         without a compatible compile/runtime asset (a class of packaging break no current gate
         observes). It is the first half of Finding 51's fix: the patch-additivity contract in
         RuntimeVersionRange.Build's <remarks> previously had ZERO enforcement.
         The SECOND half — PackageValidationBaselineVersion, which ApiCompat-diffs this pack
         against the last shipped version to fail a non-additive patch — is deliberately NOT set
         here. A baseline forces NuGet to PackageDownload that baseline nupkg, which breaks
         offline and `release/**-dryrun.N` packs, and pinning the baseline IS the version-window
         end-state decision reserved for the project owner. The written contract of record is
         RuntimeVersionRange's <remarks> in
         the generator; this property is the enforcement seam the baseline will later plug into. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Runtime</PackageId>
    <PackageVersion>0.0.0-dev</PackageVersion>
    <Description>Runtime library for Swift/.NET interop. Provides SwiftString, SwiftArray, SwiftOptional, ARC memory management, protocol witness tables, and type metadata for generated Swift bindings.</Description>
    <Authors>Justin Wojciechowski</Authors>
    <PackageTags>swift;interop;bindings;dotnet;ios;macos</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Minimum OS versions -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('macos'))">12.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('tvos'))">15.0</SupportedOSPlatformVersion>
    <!-- Allow app projects to opt out of packaging the optional concurrency native runtime. -->
    <IncludeSwiftBindingsRuntimeNative>true</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Swift/**/*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Embed the pre-built native runtime as a signed dynamic framework via a single
       <NativeReference Kind="Framework"> to the committed xcframework. The .NET Apple
       workload selects the right per-platform/-arch slice, embeds the .framework into the
       consumer app bundle, and re-signs it — the TN2435-compliant shape. (A loose runtime
       dylib dropped into App.app/Frameworks/ is rejected on iOS/tvOS, which was the root
       cause of the App Store ITMS-90426/90429 rejections in issue #42.)
       Gated to Apple TFMs (NativeReference is invalid on the base net10.0 TFM) and to the
       artifact's existence. No RuntimeIdentifier gate is needed: unlike a <Content> dylib,
       a framework NativeReference is NOT baked into the managed DLL as a BundleResource —
       the workload defers slice selection to publish time. Mirrors SBApple.targets and
       every generated binding's ConsumerTargets emission. NativeReference does not
       propagate across ProjectReference; in-tree ProjectReference consumers set
       IncludeSwiftBindingsRuntimeNative=false and inject the framework themselves. -->
  <ItemGroup Condition="'$(IncludeSwiftBindingsRuntimeNative)' == 'true'
                        AND ($(TargetFramework.Contains('ios')) OR $(TargetFramework.Contains('macos')) OR $(TargetFramework.Contains('maccatalyst')) OR $(TargetFramework.Contains('tvos')))
                        AND Exists('$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework')">
    <NativeReference Include="$(MSBuildThisFileDirectory)../native/SwiftBindingsRuntime.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Roslyn analyzer: build as analyzer, pack into NuGet for consumers.
       The ProjectReference builds the analyzer alongside Swift.Runtime.
       The target below resolves the actual output path from MSBuild properties
       so we don't hardcode bin/$(Configuration)/netstandard2.0/. -->
  <ItemGroup>
    <ProjectReference Include="../../Swift.Analyzers/Swift.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>
  <Target Name="_AddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../../Swift.Analyzers/Swift.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerOutput" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AnalyzerOutput)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Embedded linker descriptor: preserves core types for NativeAOT trimming.
       Automatically applied to consumer projects that reference this assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NuGet pack items: native runtime xcframework, .targets, and README -->
  <ItemGroup>
    <!-- Pack the whole framework xcframework recursively, preserving its directory tree
         (slice dirs, each .framework's binary + Info.plist + _CodeSignature). PackagePath is the
         fixed destination FOLDER (trailing slash, no %(RecursiveDir) token): NuGet appends each
         source file's own %(RecursiveDir)%(Filename)%(Extension) under it, reproducing the tree.
         Do NOT fold %(RecursiveDir) (or an explicit filename) into PackagePath — NuGet treats any
         PackagePath ending in a separator, OR one with no file extension, as a folder and then
         re-appends the source's recursive path, doubling every segment
         (".../ios-arm64.../SwiftBindingsRuntime.framework/ios-arm64.../SwiftBindingsRuntime.framework/...")
         and failing the pack with NU5123 (path too long). The explicit-filename form fails the same
         way for the xcframework's extensionless members (the Mach-O binary, _CodeSignature/CodeResources),
         which NuGet still classifies as folders. buildTransitive/SwiftBindings.Runtime.targets
         resolves the slice from this location via a single <NativeReference Kind="Framework">. -->
    <None Include="../native/SwiftBindingsRuntime.xcframework/**/*"
          Pack="true"
          PackagePath="native/SwiftBindingsRuntime.xcframework/" />
    <None Include="build/SwiftBindings.Runtime.targets" Pack="true" PackagePath="buildTransitive" />
    <!-- Pack the descriptor adjacent to the targets file so consumer projects can resolve
         it via $(MSBuildThisFileDirectory)ILLink.Descriptors.xml. The same file is also
         consumed as <EmbeddedResource> above for the IL trimmer's auto-discovery path —
         single source on disk, two consumption modes (embedded for IL trimmer, packed
         file for ILC/NativeAOT). -->
    <None Include="ILLink.Descriptors.xml" Pack="true" PackagePath="buildTransitive" />
    <None Include="../../../README.md" Pack="true" PackagePath="" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../legal/NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
