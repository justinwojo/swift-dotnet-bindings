<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SwiftBindings.Sdk</PackageId>
    <!-- Single-sourced from Directory.Build.props (overridden via -p: at pack time). -->
    <PackageVersion>$(SwiftBindingsSdkVersion)</PackageVersion>
    <!-- Sdk.props ships verbatim and is consumed at end-user build time, so it cannot read our
         repo properties; the pack pipeline bakes a version-stamped copy and points this property
         at it. Defaults to the source file for a plain `dotnet pack`. -->
    <SwiftBindingsSdkPropsToPack Condition="'$(SwiftBindingsSdkPropsToPack)' == ''">Sdk/Sdk.props</SwiftBindingsSdkPropsToPack>
    <Description>MSBuild SDK for generating C# bindings from Swift xcframeworks. Drop an xcframework into your project and run dotnet build.</Description>
    <Authors>Justin Wojciechowski</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>swift;dotnet;bindings;interop;ios;msbuild-sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageType>MSBuildSdk</PackageType>
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- SDK packages don't build or include their own assembly -->
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <!-- Suppress warning about no lib/ref assemblies -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- Pack Sdk.props and Sdk.targets into Sdk/ (MSBuild SDK convention) -->
  <ItemGroup>
    <None Include="$(SwiftBindingsSdkPropsToPack)" Pack="true" PackagePath="Sdk/Sdk.props" />
    <None Include="Sdk/Sdk.targets" Pack="true" PackagePath="Sdk/" />
    <None Include="Sdk/scripts/*.sh" Pack="true" PackagePath="Sdk/scripts/" />

    <!-- Mac framework-anatomy backstop for SDK-direct apps that opt out of the implicit runtime
         package reference (Sdk.targets imports these when the runtime's own copy is absent).
         Packed straight from the runtime's source files rather than duplicated in this folder,
         so the two packages can never carry divergent versions of the same step. -->
    <None Include="../Swift.Runtime/src/build/SwiftBindings.MacFrameworkAnatomy.targets" Pack="true" PackagePath="Sdk/" />
    <None Include="../Swift.Runtime/src/build/deepen-mac-framework.sh" Pack="true" PackagePath="Sdk/" />
  </ItemGroup>

  <!-- Pack the published generator into tools/ -->
  <!-- Also packs tools/apple-types-manifest/ — the Apple Swift-only type metadata manifest
       rides inside the SDK package today to keep the NuGet coordination surface down to one
       artifact. The manifest format is designed so a later move to a standalone
       SwiftBindings.Apple.Metadata data package is a relocation, not a reformat. -->
  <ItemGroup>
    <None Include="tools/**/*" Pack="true" PackagePath="tools/" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../legal/NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
