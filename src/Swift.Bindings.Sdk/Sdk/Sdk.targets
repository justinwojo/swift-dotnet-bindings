<Project>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Intermediate dir must be defined in .targets (not .props) so that
       $(IntermediateOutputPath) is fully resolved (e.g. obj/Debug/net10.0-ios/).
       In .props it evaluates to empty, causing output to land in project root. -->
  <PropertyGroup>
    <_SwiftBindingIntermediateDir>$(IntermediateOutputPath)swift-binding/</_SwiftBindingIntermediateDir>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 0: Validate no SwiftPackage items (v2 stub)                     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftPackageItems" BeforeTargets="_DiscoverSwiftFrameworks">
    <Error Condition="'$(_SwiftBindingPlatformUnsupported)' == 'true'"
           Code="SWIFTBIND010"
           Text="Unsupported TargetFramework '$(TargetFramework)' for Swift bindings. Use an Apple platform TFM: net10.0-ios, net10.0-macos, net10.0-tvos, or net10.0-maccatalyst." />
    <Error Condition="'@(SwiftPackage)' != ''"
           Code="SWIFTBIND100"
           Text="SwiftPackage items are not yet supported. Use SwiftFramework items with a pre-built xcframework." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 1: Auto-discover xcframeworks (in .targets, not .props)         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_DiscoverSwiftFrameworks" BeforeTargets="_ComputeSwiftFingerprint">
    <!-- Auto-discover only if user hasn't declared any.
         Uses find -type d because *.xcframework are directories, not files,
         and MSBuild glob patterns only match files. -->
    <Exec Condition="'@(SwiftFramework)' == ''"
          Command="find &quot;$(MSBuildProjectDirectory)&quot; -maxdepth 1 -type d -name '*.xcframework' 2>/dev/null || true"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="SwiftFramework" />
    </Exec>

    <!-- Validation: no frameworks found -->
    <Error Condition="'@(SwiftFramework)' == ''"
           Code="SWIFTBIND001"
           Text="No xcframework found. Copy an xcframework into the project directory or add &lt;SwiftFramework Include=&quot;path/to/Library.xcframework&quot; /&gt;." />

    <!-- Validation: multiple auto-discovered frameworks (v1 supports one per project) -->
    <Error Condition="@(SwiftFramework->Count()) &gt; 1"
           Code="SWIFTBIND002"
           Text="The SDK supports one xcframework per project. Found: @(SwiftFramework, ', '). Create separate binding projects for each xcframework." />

    <!-- Validation: xcframework path exists -->
    <Error Condition="!Exists('%(SwiftFramework.Identity)')"
           Code="SWIFTBIND003"
           Text="xcframework not found: '%(SwiftFramework.Identity)'." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 1b: Auto-discover xcframeworks from ProjectReference dirs       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- For multi-framework libraries, users declare ProjectReference to sibling
       binding projects. This target discovers the xcframeworks in those project
       directories so the generator can resolve cross-module types without
       requiring redundant SwiftFrameworkDependency declarations.
       Uses find -type d because *.xcframework are directories, not files.
       Deduplicates against explicit SwiftFrameworkDependency items by name.

       Also captures user-authored ProjectReference items into _UserProjectReference
       at this early stage — before _ResolveSwiftAutoDetectedDependencies or
       _InjectMixedObjCProjectReference inject additional ProjectReferences — so
       downstream targets can distinguish user intent from auto-injected refs. -->
  <Target Name="_DiscoverProjectReferenceDependencies"
          BeforeTargets="_ComputeSwiftFingerprint"
          DependsOnTargets="_DiscoverSwiftFrameworks"
          Condition="'@(ProjectReference)' != ''">

    <!-- Capture user-authored refs before any other target mutates @(ProjectReference).
         Exclude ObjC refs (the '.ObjC.' naming convention is generated by
         _InjectMixedObjCProjectReference, but a user might also name one that way). -->
    <ItemGroup>
      <_UserProjectReference Include="@(ProjectReference)"
                             Condition="!$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>

    <!-- Shell variables use %24 (MSBuild percent-escape for $) to avoid
         MSBuild property evaluation of $VAR patterns. Same pattern as
         _ResolveSwiftAutoDetectedDependencies. -->
    <Exec Command="EXPLICIT=&quot;@(SwiftFrameworkDependency->'%(Filename)', ';')&quot;; \
echo &quot;@(_UserProjectReference->'%(RootDir)%(Directory)', '%0A')&quot; | while IFS= read -r DIR; do \
  [ -z &quot;%24DIR&quot; ] &amp;&amp; continue; \
  find &quot;%24DIR&quot; -maxdepth 1 -type d -name '*.xcframework' 2>/dev/null | while IFS= read -r XCF; do \
    NAME=`basename &quot;%24XCF&quot; .xcframework`; \
    case &quot;;%24EXPLICIT;&quot; in *&quot;;%24NAME;&quot;*) continue ;; esac; \
    echo &quot;%24XCF&quot;; \
  done; \
done; true"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_AutoFrameworkDependency" />
    </Exec>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2: Fingerprint-based incremental build                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ComputeSwiftFingerprint">
    <PropertyGroup>
      <_SwiftStampFile>$(_SwiftBindingIntermediateDir)swift-binding.stamp</_SwiftStampFile>
    </PropertyGroup>
    <MakeDir Directories="$(_SwiftBindingIntermediateDir)" />

    <!--
      Compute fingerprint by hashing:
      1. Outer Info.plist (slice metadata changes)
      2. All framework binaries (extensionless Mach-O inside *.framework/)
      3. All public .swiftinterface files (API surface changes)
      4. Optional supplementary inputs: SymbolGraph, BridgeHints, SwiftInterface files
      5. All generation-affecting properties (SDK version, platform, architecture, namespace, package ID)
      6. Dependency xcframework contents (Info.plist + binaries)
      Shell pipeline because framework binaries have no extension (*.dylib glob misses them).
      Sorted for deterministic output regardless of filesystem traversal order.
    -->
    <Exec Command="(
      find &quot;%(SwiftFramework.Identity)&quot; \( \
        -name &quot;Info.plist&quot; -o \
        -name &quot;*.swiftinterface&quot; -not -name &quot;*.private.swiftinterface&quot; \
      \) -type f -exec shasum -a 256 {} \; &amp;&amp; \
      find &quot;%(SwiftFramework.Identity)&quot; -path &quot;*.framework/*&quot; \
        -not -name &quot;Info.plist&quot; -not -path &quot;*/Modules/*&quot; \
        -not -path &quot;*/_CodeSignature/*&quot; -type f -exec shasum -a 256 {} \; &amp;&amp; \
      for f in &quot;%(SwiftFramework.SymbolGraph)&quot; &quot;%(SwiftFramework.BridgeHints)&quot; &quot;%(SwiftFramework.SwiftInterface)&quot;; do \
        if [ -n &quot;%24f&quot; ] &amp;&amp; [ -e &quot;%24f&quot; ]; then shasum -a 256 &quot;%24f&quot;; fi; \
      done; \
      echo &quot;@(SwiftFrameworkDependency, '%0A')&quot; | while IFS= read -r dep; do \
        if [ -n &quot;%24dep&quot; ] &amp;&amp; [ -d &quot;%24dep&quot; ]; then \
          find &quot;%24dep&quot; \( -name &quot;Info.plist&quot; -o -name &quot;*.swiftinterface&quot; -not -name &quot;*.private.swiftinterface&quot; \) -type f -exec shasum -a 256 {} \; ; \
          find &quot;%24dep&quot; -path &quot;*.framework/*&quot; -not -name &quot;Info.plist&quot; -not -path &quot;*/Modules/*&quot; -not -path &quot;*/_CodeSignature/*&quot; -type f -exec shasum -a 256 {} \; ; \
        fi; \
      done; \
      echo &quot;@(_AutoFrameworkDependency, '%0A')&quot; | while IFS= read -r dep; do \
        if [ -n &quot;%24dep&quot; ] &amp;&amp; [ -d &quot;%24dep&quot; ]; then \
          find &quot;%24dep&quot; \( -name &quot;Info.plist&quot; -o -name &quot;*.swiftinterface&quot; -not -name &quot;*.private.swiftinterface&quot; \) -type f -exec shasum -a 256 {} \; ; \
          find &quot;%24dep&quot; -path &quot;*.framework/*&quot; -not -name &quot;Info.plist&quot; -not -path &quot;*/Modules/*&quot; -not -path &quot;*/_CodeSignature/*&quot; -type f -exec shasum -a 256 {} \; ; \
        fi; \
      done; \
      echo &quot;@(SwiftModuleDatabase, '%0A')&quot; | while IFS= read -r db; do \
        if [ -n &quot;%24db&quot; ] &amp;&amp; [ -f &quot;%24db&quot; ]; then shasum -a 256 &quot;%24db&quot;; fi; \
      done; \
      echo &quot;@(SwiftFrameworkDependency->'%(ModuleDatabasePath)', '%0A')&quot; | while IFS= read -r db; do \
        if [ -n &quot;%24db&quot; ] &amp;&amp; [ -f &quot;%24db&quot; ]; then shasum -a 256 &quot;%24db&quot;; fi; \
      done; \
      echo &quot;$(_SwiftBindingSdkVersion) $(_SwiftBindingPlatform) $(SwiftPlatformTarget) $(SwiftWrapperArchitectures) %(SwiftFramework.NamespacePattern) $(PackageId) %(SwiftFramework.SymbolGraph) %(SwiftFramework.BridgeHints) %(SwiftFramework.SwiftInterface) $(SwiftGenerateDocComments) $(SwiftAutoDetectDependencies) @(SwiftFrameworkDependency, '|') @(_AutoFrameworkDependency, '|')&quot; \
    ) | sort | shasum -a 256 | cut -d' ' -f1"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftNewFingerprint" />
    </Exec>

    <!-- Read existing stamp and compare -->
    <ReadLinesFromFile File="$(_SwiftStampFile)"
                       Condition="Exists('$(_SwiftStampFile)')">
      <Output TaskParameter="Lines" ItemName="_SwiftOldFingerprintLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_SwiftBindingUpToDate
          Condition="'$(_SwiftNewFingerprint)' == '@(_SwiftOldFingerprintLines)'">true</_SwiftBindingUpToDate>
    </PropertyGroup>

    <!-- Update stamp if fingerprint changed -->
    <WriteLinesToFile File="$(_SwiftStampFile)"
                      Lines="$(_SwiftNewFingerprint)"
                      Overwrite="true"
                      Condition="'$(_SwiftBindingUpToDate)' != 'true'" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2b: Collect module databases for cross-module resolution        -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_CollectSwiftModuleDatabases"
          BeforeTargets="_GenerateSwiftBindings"
          DependsOnTargets="_ComputeSwiftFingerprint">

    <!-- Source 1: NuGet-provided SwiftModuleDatabase items (from consumed package .targets) -->
    <ItemGroup Condition="'@(SwiftModuleDatabase)' != ''">
      <_SwiftModuleDatabaseFile Include="@(SwiftModuleDatabase)"
                                Condition="Exists('%(Identity)')" />
    </ItemGroup>

    <!-- Source 2: Local SwiftFrameworkDependency items with explicit ModuleDatabasePath -->
    <ItemGroup Condition="'@(SwiftFrameworkDependency)' != ''">
      <_SwiftModuleDatabaseFile Include="%(SwiftFrameworkDependency.ModuleDatabasePath)"
                                Condition="'%(SwiftFrameworkDependency.ModuleDatabasePath)' != ''
                                           AND Exists('%(SwiftFrameworkDependency.ModuleDatabasePath)')" />
    </ItemGroup>

    <!-- Source 3: Module databases from ProjectReference intermediate dirs (incremental builds).
         On clean builds these don't exist yet (generated during dependency build), but on
         incremental builds they provide cross-module type resolution automatically.
         Honors per-reference SetConfiguration/SetTargetFramework metadata, falling back
         to the consumer's $(Configuration)/$(TargetFramework) when unset. -->
    <Exec Condition="'@(ProjectReference)' != ''"
          Command="echo &quot;@(ProjectReference->'%(RootDir)%(Directory)|%(SetConfiguration)|%(SetTargetFramework)', '%0A')&quot; | while IFS='|' read -r PROJDIR PR_CFG PR_TFM; do \
  [ -z &quot;%24PROJDIR&quot; ] &amp;&amp; continue; \
  CFG=&quot;%24{PR_CFG:-$(Configuration)}&quot;; \
  TFM=&quot;%24{PR_TFM:-$(TargetFramework)}&quot;; \
  DIR=&quot;%24{PROJDIR}obj/%24{CFG}/%24{TFM}/swift-binding/&quot;; \
  [ ! -d &quot;%24DIR&quot; ] &amp;&amp; continue; \
  find &quot;%24DIR&quot; -maxdepth 1 -name '*Database.xml' -type f 2>/dev/null; \
done; true"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SwiftModuleDatabaseFile" />
    </Exec>

    <!-- Deduplicate: Remove duplicate paths (diamond dependency, same DB from multiple sources) -->
    <RemoveDuplicates Inputs="@(_SwiftModuleDatabaseFile)">
      <Output TaskParameter="Filtered" ItemName="_SwiftModuleDatabaseFileDeduped" />
    </RemoveDuplicates>
    <ItemGroup>
      <_SwiftModuleDatabaseFile Remove="@(_SwiftModuleDatabaseFile)" />
      <_SwiftModuleDatabaseFile Include="@(_SwiftModuleDatabaseFileDeduped)" />
    </ItemGroup>

    <!-- Warn for explicit ModuleDatabasePath that doesn't exist -->
    <Warning Condition="'%(SwiftFrameworkDependency.ModuleDatabasePath)' != ''
                        AND !Exists('%(SwiftFrameworkDependency.ModuleDatabasePath)')"
             Code="SWIFTBIND073"
             Text="Module database not found: '%(SwiftFrameworkDependency.ModuleDatabasePath)'. Cross-module type resolution will be incomplete for '%(SwiftFrameworkDependency.Identity)'. Build the dependency project first, or remove the ModuleDatabasePath metadata." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 3: Invoke generator (gated on fingerprint)                      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_GenerateSwiftBindings"
          BeforeTargets="ResolveProjectReferences"
          DependsOnTargets="_ComputeSwiftFingerprint">
    <!--
      No Target-level Condition on @(SwiftFramework): MSBuild evaluates Target
      Conditions at evaluation time, but SwiftFramework items may only exist at
      execution time (populated by _DiscoverSwiftFrameworks). A Target Condition
      would prevent the DependsOnTargets chain from firing, so discovery would
      never run. Instead, gate the tasks inside on @(SwiftFramework).

      Similarly, the fingerprint gate is on tasks, not the Target, because
      MSBuild evaluates Target Conditions using evaluation-phase property values.
      Properties set during execution (in _ComputeSwiftFingerprint) are only
      visible to task-level Conditions, not target-level Conditions.
    -->
    <PropertyGroup Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBindingUpToDate)' != 'true'">
      <_SwiftGenCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --xcframework "%(SwiftFramework.Identity)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --platform $(_SwiftBindingPlatform)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftGenCmd) --platform-target $(SwiftPlatformTarget)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --sdk-mode -v $(SwiftGeneratorVerbosity)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(PackageId)' != ''">$(_SwiftGenCmd) --package-id "$(PackageId)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.NamespacePattern)' != ''">$(_SwiftGenCmd) --namespace-pattern "%(SwiftFramework.NamespacePattern)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.SymbolGraph)' != ''">$(_SwiftGenCmd) --symbolgraph "%(SwiftFramework.SymbolGraph)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.BridgeHints)' != ''">$(_SwiftGenCmd) --bridge-hints "%(SwiftFramework.BridgeHints)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.SwiftInterface)' != ''">$(_SwiftGenCmd) -s "%(SwiftFramework.SwiftInterface)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="!$([System.String]::Equals('$(SwiftGenerateDocComments)', 'true', StringComparison.OrdinalIgnoreCase))">$(_SwiftGenCmd) --no-docs</_SwiftGenCmd>
      <_SwiftGenCmd Condition="!$([System.String]::Equals('$(SwiftAutoDetectDependencies)', 'true', StringComparison.OrdinalIgnoreCase))">$(_SwiftGenCmd) --no-auto-detect</_SwiftGenCmd>
      <!-- Append framework dependency flags for each SwiftFrameworkDependency item -->
      <_SwiftGenCmd Condition="'@(SwiftFrameworkDependency)' != ''">$(_SwiftGenCmd) @(SwiftFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Auto-discovered dependency frameworks from ProjectReference directories -->
      <_SwiftGenCmd Condition="'@(_AutoFrameworkDependency)' != ''">$(_SwiftGenCmd) @(_AutoFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Pass collected module databases for cross-module type resolution -->
      <_SwiftGenCmd Condition="'@(_SwiftModuleDatabaseFile)' != ''">$(_SwiftGenCmd) @(_SwiftModuleDatabaseFile->' --module-database "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Force ObjC pipeline for ObjC-only framework type -->
      <_SwiftGenCmd Condition="'$(SwiftFrameworkType)' == 'ObjC'">$(_SwiftGenCmd) --objc</_SwiftGenCmd>
      <!-- Skip wrapper compilation — deferred to _CompileSwiftWrapper after ResolveProjectReferences -->
      <_SwiftGenCmd>$(_SwiftGenCmd) --skip-wrapper-compilation</_SwiftGenCmd>
    </PropertyGroup>

    <Exec Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBindingUpToDate)' != 'true'"
          Command="$(_SwiftGenCmd)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4: Import binding metadata from generated props file            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ImportSwiftBindingMetadata"
          AfterTargets="_GenerateSwiftBindings"
          Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingPackageVersion/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingPackageVersion" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingMinimumOSVersion/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingMinimumOSVersion" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingModuleName/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingModuleName" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingIsVersionPlaceholder/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingIsVersionPlaceholder" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasWrapperXCFramework/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasWrapperXCFramework" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperModuleName/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingWrapperModuleName" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperSliceCount/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingWrapperSliceCount" />
    </XmlPeek>

    <!-- Read bridge metadata (may be absent for libraries without SwiftUI views) -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeSwift/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeSwift" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeModuleName" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeXCFramework" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeSliceCount/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeSliceCount" />
    </XmlPeek>

    <!-- Set PackageVersion from metadata (user can override) -->
    <PropertyGroup>
      <PackageVersion Condition="'$(PackageVersion)' == ''">$(_SwiftBindingPackageVersion)</PackageVersion>
      <SupportedOSPlatformVersion Condition="'$(SupportedOSPlatformVersion)' == ''">$(_SwiftBindingMinimumOSVersion)</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- Read auto-detected dependency metadata (may be absent for no-dep libraries) -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingDependencies/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingDependencies" />
    </XmlPeek>

    <!-- Warn on version placeholder (SWIFTBIND020) — only when user hasn't overridden PackageVersion -->
    <Warning Condition="'$(_SwiftBindingIsVersionPlaceholder)' == 'True' AND '$(PackageVersion)' == '$(_SwiftBindingPackageVersion)'"
             Code="SWIFTBIND020"
             Text="The xcframework version (1.0) appears to be an Xcode placeholder. Set &lt;PackageVersion&gt; explicitly in your project file." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4b: Surface binding report skip counts as MSBuild warnings      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ReportSwiftBindingCoverage"
          AfterTargets="_ImportSwiftBindingMetadata"
          Condition="Exists('$(_SwiftBindingIntermediateDir)binding-report.json')">

    <!-- Parse skip counts from the JSON report.
         The report is always pretty-printed (Newtonsoft Formatting.Indented),
         so each key-value pair is on its own line. awk extracts the numeric
         value via field splitting + numeric coercion ($2+0 strips trailing comma).
         Fallback to 0 if the key is absent. -->
    <Exec Command="awk '/&quot;SkippedTypes&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingSkippedTypes" />
    </Exec>
    <Exec Command="awk '/&quot;TotalTypes&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingTotalTypes" />
    </Exec>
    <Exec Command="awk '/&quot;SkippedMembers&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingSkippedMembers" />
    </Exec>
    <Exec Command="awk '/&quot;TotalMembers&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingTotalMembers" />
    </Exec>

    <Warning Condition="'$(_SwiftBindingSkippedTypes)' != '0'"
             Code="SWIFTBIND060"
             Text="$(_SwiftBindingSkippedTypes) of $(_SwiftBindingTotalTypes) Swift types were skipped during binding generation. See $([System.IO.Path]::GetFullPath('$(_SwiftBindingIntermediateDir)binding-report.json', '$(MSBuildProjectDirectory)')) for details and workaround suggestions." />

    <Warning Condition="'$(_SwiftBindingSkippedMembers)' != '0'"
             Code="SWIFTBIND061"
             Text="$(_SwiftBindingSkippedMembers) of $(_SwiftBindingTotalMembers) Swift members were skipped during binding generation. See $([System.IO.Path]::GetFullPath('$(_SwiftBindingIntermediateDir)binding-report.json', '$(MSBuildProjectDirectory)')) for per-item skip reasons." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4a: Validate wrapper compilation result                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftWrapperCompilation"
          AfterTargets="_UpdateSwiftWrapperMetadata"
          Condition="'$(_SwiftBindingWrapperModuleName)' != '' AND '$(SwiftFrameworkType)' != 'ObjC'">

    <!-- Wrapper was expected but compilation failed: promote to error when SwiftWrapperRequired=true -->
    <Error Condition="$([System.String]::Equals('$(SwiftWrapperRequired)', 'true', StringComparison.OrdinalIgnoreCase))
                      AND '$(_SwiftBindingHasWrapperXCFramework)' != 'True'"
           Code="SWIFTBIND051"
           Text="Swift wrapper compilation failed for '$(_SwiftBindingWrapperModuleName)'. Constructor, destroy, and async wrappers will not be available — APIs that depend on them will throw DllNotFoundException at runtime. Check build output for SWIFTBIND050 details. To suppress this error, set &lt;SwiftWrapperRequired&gt;false&lt;/SwiftWrapperRequired&gt; in your project file." />

    <!-- When SwiftWrapperRequired=false, still warn so the failure is visible -->
    <Warning Condition="!$([System.String]::Equals('$(SwiftWrapperRequired)', 'true', StringComparison.OrdinalIgnoreCase))
                        AND '$(_SwiftBindingHasWrapperXCFramework)' != 'True'"
             Code="SWIFTBIND051"
             Text="Swift wrapper compilation failed for '$(_SwiftBindingWrapperModuleName)'. Constructor, destroy, and async wrappers will not be available — APIs that depend on them will throw DllNotFoundException at runtime. Set &lt;SwiftWrapperRequired&gt;true&lt;/SwiftWrapperRequired&gt; to promote this to a build error." />

    <!-- When wrapper failed and user-authored ProjectReferences exist, provide
         two-pass build guidance. Uses _UserProjectReference (captured early in
         _DiscoverProjectReferenceDependencies) to avoid firing for auto-injected
         or ObjC refs where the hint is not relevant. -->
    <Message Condition="'$(_SwiftBindingHasWrapperXCFramework)' != 'True'
                        AND '@(_UserProjectReference)' != ''"
             Importance="high"
             Text="Hint: For multi-framework libraries, wrapper compilation may fail on the first build when dependency projects haven't been built yet. Build dependency projects first, then rebuild this project. See https://github.com/justinwojo/swift-dotnet-bindings/wiki/Multi-Framework-Libraries" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4b: Auto-resolve cross-module dependencies via ProjectReference -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ResolveSwiftAutoDetectedDependencies"
          AfterTargets="_ImportSwiftBindingMetadata"
          BeforeTargets="ResolveProjectReferences">

    <!--
      No Target-level Condition on $(_SwiftBindingDependencies): MSBuild evaluates
      Target Conditions at evaluation time, but _SwiftBindingDependencies is set at
      execution time by XmlPeek in _ImportSwiftBindingMetadata. Task-level Conditions
      see the execution-time value. Same pattern as _GenerateSwiftBindings fingerprint gate.

      Parse the semicolon-delimited _SwiftBindingDependencies property.
      Each entry: ModuleName|PackageId|Version|XCFrameworkPath
      Dedup against explicit SwiftFrameworkDependency items (by framework name).
      Search for sibling .csproj files and inject ProjectReference for found projects.
      Emit SWIFTBIND080 warning with guidance for unresolved dependencies.
    -->
    <!-- POSIX sh: echo | tr | while read (no bash arrays or here-strings).
         Shell variables use %24 (MSBuild percent-escape for $) to avoid
         MSBuild property evaluation of $VAR patterns.
         Uses \ line continuations (single logical line) like the fingerprint Exec. -->
    <Exec Condition="'$(_SwiftBindingDependencies)' != ''"
          Command="pctdec() { echo &quot;%241&quot; | sed 's/%7C/|/g;s/%3B/;/g;s/%25/%/g'; }; \
EXPLICIT_DEPS=&quot;@(SwiftFrameworkDependency->'%(Filename)', ';')&quot;; \
echo &quot;$(_SwiftBindingDependencies)&quot; | tr ';' '\n' | while IFS='|' read -r MOD_NAME PKG_ID PKG_VER XCFW_PATH; do \
  [ -z &quot;%24MOD_NAME&quot; ] &amp;&amp; continue; \
  RAW_MOD=&quot;%24MOD_NAME&quot;; RAW_PKG=&quot;%24PKG_ID&quot;; RAW_VER=&quot;%24PKG_VER&quot;; RAW_XCFW=&quot;%24XCFW_PATH&quot;; \
  MOD_NAME=`pctdec &quot;%24RAW_MOD&quot;`; \
  PKG_ID=`pctdec &quot;%24RAW_PKG&quot;`; \
  PKG_VER=`pctdec &quot;%24RAW_VER&quot;`; \
  XCFW_PATH=`pctdec &quot;%24RAW_XCFW&quot;`; \
  case &quot;;%24EXPLICIT_DEPS;&quot; in *&quot;;%24MOD_NAME;&quot;*) continue ;; esac; \
  FOUND=&quot;&quot;; \
  XCFW_PARENT=`dirname &quot;%24XCFW_PATH&quot;`; \
  XCFW_GRANDPARENT=`dirname &quot;%24XCFW_PARENT&quot;`; \
  if [ -f &quot;%24XCFW_PARENT/%24PKG_ID.csproj&quot; ]; then \
    FOUND=&quot;%24XCFW_PARENT/%24PKG_ID.csproj&quot;; \
  elif [ -f &quot;%24XCFW_GRANDPARENT/%24PKG_ID/%24PKG_ID.csproj&quot; ]; then \
    FOUND=&quot;%24XCFW_GRANDPARENT/%24PKG_ID/%24PKG_ID.csproj&quot;; \
  elif [ -f &quot;%24XCFW_GRANDPARENT/%24MOD_NAME/%24PKG_ID.csproj&quot; ]; then \
    FOUND=&quot;%24XCFW_GRANDPARENT/%24MOD_NAME/%24PKG_ID.csproj&quot;; \
  elif [ -f &quot;%24XCFW_GRANDPARENT/%24PKG_ID.csproj&quot; ]; then \
    FOUND=&quot;%24XCFW_GRANDPARENT/%24PKG_ID.csproj&quot;; \
  fi; \
  if [ -n &quot;%24FOUND&quot; ]; then \
    FOUND_DIR=`dirname &quot;%24FOUND&quot;`; \
    FOUND_BASE=`basename &quot;%24FOUND&quot;`; \
    FOUND_ABS=`cd &quot;%24FOUND_DIR&quot; &amp;&amp; pwd`; \
    echo &quot;PROJREF|%24FOUND_ABS/%24FOUND_BASE&quot;; \
  else \
    echo &quot;WARN|%24RAW_MOD|%24RAW_PKG|%24RAW_VER|%24RAW_XCFW&quot;; \
  fi; \
done"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SwiftAutoDepResult" />
    </Exec>

    <!-- Inject ProjectReference for each resolved sibling project -->
    <ItemGroup Condition="'$(_SwiftBindingDependencies)' != ''">
      <ProjectReference Include="$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Substring(8))"
                         Condition="$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').StartsWith('PROJREF|'))" />
    </ItemGroup>

    <!-- Emit SWIFTBIND080 warnings for unresolved dependencies -->
    <!-- WARN fields are pipe-delimited: WARN|module|packageId|version|xcframeworkPath -->
    <Warning Condition="'$(_SwiftBindingDependencies)' != '' AND $([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').StartsWith('WARN|'))"
             Code="SWIFTBIND080"
             Text="Cross-module dependency detected but no sibling binding project found. To resolve, add one of:%0A%0A  For local source builds:%0A    &lt;ProjectReference Include=&quot;../$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[2])/$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[2]).csproj&quot; /&gt;%0A%0A  For NuGet package consumption:%0A    &lt;SwiftFrameworkDependency Include=&quot;$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[4])&quot;%0A                              PackageId=&quot;$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[2])&quot; PackageVersion=&quot;$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[3])&quot; /&gt;" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4c: Inject mixed framework ObjC ProjectReference               -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_InjectMixedObjCProjectReference"
          AfterTargets="_ImportSwiftBindingMetadata"
          BeforeTargets="ResolveProjectReferences">

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingFrameworkType/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingFrameworkType" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingObjCProjectName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingObjCProjectName" />
    </XmlPeek>

    <ItemGroup Condition="'$(_SwiftBindingFrameworkType)' == 'Mixed'
                           AND '$(_SwiftBindingObjCProjectName)' != ''
                           AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingObjCProjectName)')">
      <ProjectReference Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingObjCProjectName)" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4d: Protocol target for dependency xcframework search paths     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Exposes this project's xcframework paths so that dependent projects
       can discover them via MSBuild task during _CompileSwiftWrapper. -->
  <Target Name="GetSwiftFrameworkSearchPaths"
          DependsOnTargets="_DiscoverSwiftFrameworks;_ImportSwiftBindingMetadata"
          Returns="@(_SwiftBindingFrameworkSearchPath)">
    <ItemGroup>
      <_SwiftBindingFrameworkSearchPath Include="%(SwiftFramework.Identity)" />
      <_SwiftBindingFrameworkSearchPath Include="$(MSBuildProjectDirectory)/$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework"
                                        Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True'" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4e: Compile Swift wrapper after dependencies are built          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Runs AFTER ResolveProjectReferences so dependency wrapper xcframeworks
       are available on the -F search path. Uses compile-wrapper-only mode
       which skips parsing/generation and only compiles existing .swift files. -->
  <Target Name="_CompileSwiftWrapper"
          AfterTargets="ResolveProjectReferences"
          DependsOnTargets="_ImportSwiftBindingMetadata"
          Condition="'$(_SwiftBindingWrapperModuleName)' != '' AND '$(SwiftFrameworkType)' != 'ObjC'">

    <!--
      Wrapper compilation skip logic:
      * No ProjectReferences: safe to use source fingerprint (_SwiftBindingUpToDate)
      * Has ProjectReferences: always recompile, because dependency wrapper outputs
        are not included in the source fingerprint and may have changed.
        Wrapper compilation is fast (~2-5s) so this is acceptable.
    -->
    <PropertyGroup>
      <_SwiftWrapperSkip Condition="'$(_SwiftBindingUpToDate)' == 'true' AND '@(ProjectReference)' == ''">true</_SwiftWrapperSkip>
    </PropertyGroup>

    <!-- Filter out ObjC ProjectReferences (e.g. BlinkID.ObjC.iOS.csproj) which use
         Microsoft.NET.Sdk and don't have GetSwiftFrameworkSearchPaths target.
         The '.ObjC.' naming convention is generated by _InjectMixedObjCProjectReference
         (from _SwiftBindingObjCProjectName in binding-metadata.props), not user-chosen. -->
    <ItemGroup Condition="'@(ProjectReference)' != '' AND '$(_SwiftWrapperSkip)' != 'true'">
      <_SwiftBindingProjectReference Include="@(ProjectReference)"
          Condition="!$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>

    <!-- Collect dependency xcframework paths from ProjectReferences -->
    <MSBuild Projects="@(_SwiftBindingProjectReference)"
             Targets="GetSwiftFrameworkSearchPaths"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftBindingProjectReference)' != '' AND '$(_SwiftWrapperSkip)' != 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_ResolvedDepXCFramework" />
    </MSBuild>

    <!-- Build the compile-wrapper-only command -->
    <PropertyGroup Condition="'@(SwiftFramework)' != '' AND '$(_SwiftWrapperSkip)' != 'true'">
      <_SwiftWrapperCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --compile-wrapper-only</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --xcframework "%(SwiftFramework.Identity)"</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --platform $(_SwiftBindingPlatform)</_SwiftWrapperCmd>
      <_SwiftWrapperCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftWrapperCmd) --platform-target $(SwiftPlatformTarget)</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) -v $(SwiftGeneratorVerbosity)</_SwiftWrapperCmd>
      <!-- Resolved ProjectReference dependency xcframework paths (preferred, absolute) -->
      <_SwiftWrapperCmd Condition="'@(_ResolvedDepXCFramework)' != ''">$(_SwiftWrapperCmd) @(_ResolvedDepXCFramework->' --framework-dependency "%(Identity)"', '')</_SwiftWrapperCmd>
      <!-- Explicit SwiftFrameworkDependency search paths — always included alongside ProjectReference deps.
           Frameworks like Stripe3DS2 may not have a binding project but are still required on the -F search path
           for wrapper compilation. Duplicates with _ResolvedDepXCFramework are harmless (just extra -F flags). -->
      <_SwiftWrapperCmd Condition="'@(SwiftFrameworkDependency)' != ''">$(_SwiftWrapperCmd) @(SwiftFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftWrapperCmd>
    </PropertyGroup>

    <Exec Condition="'@(SwiftFramework)' != '' AND '$(_SwiftWrapperSkip)' != 'true'"
          Command="$(_SwiftWrapperCmd)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4f: Re-read wrapper metadata after compilation                  -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- _CompileSwiftWrapper updates binding-metadata.props via
       UpdateMetadataPropsWrapperStatus. Re-read the updated values so
       downstream targets (_ValidateSwiftWrapperCompilation, _ResolveSwiftNativeReferences)
       see the correct wrapper status. -->
  <Target Name="_UpdateSwiftWrapperMetadata"
          AfterTargets="_CompileSwiftWrapper">
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasWrapperXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasWrapperXCFramework" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperSliceCount/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingWrapperSliceCount" />
    </XmlPeek>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4g: Compile SwiftUI bridge after wrapper                        -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Compiles *.SwiftUIBridge.swift files into {Module}Bridge.xcframework.
       Bridge compilation is simpler than wrapper: no post-processing, no thunks.
       Failure is non-fatal (SWIFTBIND052 warning) — main bindings still work. -->
  <Target Name="_CompileSwiftUIBridge"
          AfterTargets="_UpdateSwiftWrapperMetadata"
          DependsOnTargets="_ImportSwiftBindingMetadata">

    <!-- Read bridge metadata from props (set during generation) -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeSwift/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeSwift" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeModuleName" />
    </XmlPeek>

    <!-- Bridge compilation skip: same logic as wrapper — skip if fingerprint unchanged and no ProjectReferences -->
    <PropertyGroup>
      <_SwiftBridgeSkip Condition="'$(_SwiftBindingHasBridgeSwift)' != 'True'">true</_SwiftBridgeSkip>
      <_SwiftBridgeSkip Condition="'$(SwiftFrameworkType)' == 'ObjC'">true</_SwiftBridgeSkip>
      <_SwiftBridgeSkip Condition="'$(_SwiftBridgeSkip)' != 'true' AND '$(_SwiftBindingUpToDate)' == 'true' AND '@(ProjectReference)' == ''">true</_SwiftBridgeSkip>
    </PropertyGroup>

    <!-- Build the compile-bridge-only command -->
    <PropertyGroup Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBridgeSkip)' != 'true'">
      <_SwiftBridgeCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --compile-bridge-only</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --xcframework "%(SwiftFramework.Identity)"</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --platform $(_SwiftBindingPlatform)</_SwiftBridgeCmd>
      <_SwiftBridgeCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftBridgeCmd) --platform-target $(SwiftPlatformTarget)</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) -v $(SwiftGeneratorVerbosity)</_SwiftBridgeCmd>
      <!-- Dependency framework search paths (same as wrapper) -->
      <_SwiftBridgeCmd Condition="'@(_ResolvedDepXCFramework)' != ''">$(_SwiftBridgeCmd) @(_ResolvedDepXCFramework->' --framework-dependency "%(Identity)"', '')</_SwiftBridgeCmd>
      <_SwiftBridgeCmd Condition="'@(SwiftFrameworkDependency)' != '' AND '@(_ResolvedDepXCFramework)' == ''">$(_SwiftBridgeCmd) @(SwiftFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftBridgeCmd>
    </PropertyGroup>

    <Exec Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBridgeSkip)' != 'true'"
          Command="$(_SwiftBridgeCmd)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4h: Re-read bridge metadata after compilation                   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_UpdateSwiftBridgeMetadata"
          AfterTargets="_CompileSwiftUIBridge">
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeXCFramework" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeSliceCount/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeSliceCount" />
    </XmlPeek>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4i: Validate bridge compilation result                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftBridgeCompilation"
          AfterTargets="_UpdateSwiftBridgeMetadata"
          Condition="'$(_SwiftBindingHasBridgeSwift)' == 'True' AND '$(SwiftFrameworkType)' != 'ObjC'">

    <Warning Condition="'$(_SwiftBindingHasBridgeXCFramework)' != 'True'"
             Code="SWIFTBIND052"
             Text="SwiftUI bridge compilation failed for '$(_SwiftBindingBridgeModuleName)'. Bridge views will throw DllNotFoundException at runtime. The main bindings are unaffected." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 5: Include generated .cs files in compilation                   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_IncludeGeneratedSwiftBindings"
          AfterTargets="_ImportSwiftBindingMetadata"
          Condition="Exists('$(_SwiftBindingIntermediateDir)')">

    <!-- Swift/Mixed: include generated C# files, excluding ObjC binding definitions
         which belong to the separate ObjC binding project (.csproj with IsBindingProject) -->
    <ItemGroup Condition="'$(SwiftFrameworkType)' != 'ObjC'">
      <Compile Include="$(_SwiftBindingIntermediateDir)*.cs"
               Exclude="$(_SwiftBindingIntermediateDir)ApiDefinition.cs;$(_SwiftBindingIntermediateDir)StructsAndEnums.cs" />
    </ItemGroup>

    <!-- ObjC-only: include as binding items instead of Compile -->
    <ItemGroup Condition="'$(SwiftFrameworkType)' == 'ObjC'">
      <ObjcBindingApiDefinition Include="$(_SwiftBindingIntermediateDir)ApiDefinition.cs"
                                 Condition="Exists('$(_SwiftBindingIntermediateDir)ApiDefinition.cs')" />
      <ObjcBindingCoreSource Include="$(_SwiftBindingIntermediateDir)StructsAndEnums.cs"
                              Condition="Exists('$(_SwiftBindingIntermediateDir)StructsAndEnums.cs')" />
      <ObjcBindingCoreSource Include="$(_SwiftBindingIntermediateDir)BgenDelegates.cs"
                              Condition="Exists('$(_SwiftBindingIntermediateDir)BgenDelegates.cs')" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 5b: Include SPM resource bundle stubs in app bundle             -->
  <!-- SPM-generated resource_bundle_accessor.swift searches Bundle.main for  -->
  <!-- named bundles. Empty stub directories prevent fatalError at runtime.   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_IncludeSwiftResourceBundleStubs"
          AfterTargets="_IncludeGeneratedSwiftBindings"
          Condition="Exists('$(_SwiftBindingIntermediateDir)_resource-bundles.txt')">

    <ReadLinesFromFile File="$(_SwiftBindingIntermediateDir)_resource-bundles.txt">
      <Output TaskParameter="Lines" ItemName="_SwiftResourceBundleName" />
    </ReadLinesFromFile>

    <ItemGroup>
      <BundleResource Include="$(_SwiftBindingIntermediateDir)%(_SwiftResourceBundleName.Identity).bundle/**"
                      LinkBase="%(_SwiftResourceBundleName.Identity).bundle"
                      Condition="'%(_SwiftResourceBundleName.Identity)' != ''" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Remove BgenDelegates.cs from Compile — it is only for bgen input       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_RemoveBgenDelegatesFromCompile"
          BeforeTargets="CoreCompile"
          Condition="'$(SwiftFrameworkType)' == 'ObjC'">
    <ItemGroup>
      <Compile Remove="$(_SwiftBindingIntermediateDir)BgenDelegates.cs" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 6: Inject NativeReference items for the xcframeworks            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ResolveSwiftNativeReferences"
          BeforeTargets="ResolveNativeReferences"
          DependsOnTargets="_DiscoverSwiftFrameworks;_UpdateSwiftWrapperMetadata;_UpdateSwiftBridgeMetadata">

    <ItemGroup Condition="'@(SwiftFramework)' != ''">
      <NativeReference Include="%(SwiftFramework.Identity)">
        <Kind>Framework</Kind>
      </NativeReference>
      <NativeReference Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework"
                       Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                  AND '$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                                  AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
      <NativeReference Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework"
                       Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                  AND '$(_SwiftBindingHasBridgeXCFramework)' == 'True'
                                  AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
    </ItemGroup>

    <!-- Add NativeReference for each dependency xcframework (local build only) -->
    <ItemGroup Condition="'@(SwiftFrameworkDependency)' != ''">
      <NativeReference Include="%(SwiftFrameworkDependency.Identity)"
                       Condition="Exists('%(SwiftFrameworkDependency.Identity)')">
        <Kind>Framework</Kind>
      </NativeReference>
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 6a: GetNativeManifest — propagate NativeReference through       -->
  <!--            ProjectReference for consuming projects                     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- MSBuild's ResolveProjectReferences calls GetNativeManifest on each
       ProjectReference and captures the output into the consumer's
       NativeReference items. This is the built-in .NET iOS mechanism for
       transitive native framework propagation.

       Without this, consuming projects that use <ProjectReference> (instead
       of NuGet) must manually add NativeReference items for the source and
       wrapper xcframeworks — which is fragile (silent omission on clean
       builds if using static ItemGroup with Exists() conditions).

       This target reads metadata directly from binding-metadata.props
       (which was written during the Build that completed before this call)
       rather than depending on _ImportSwiftBindingMetadata, which would
       pull in the entire generator pipeline. -->
  <Target Name="GetNativeManifest"
          DependsOnTargets="_DiscoverSwiftFrameworks"
          Returns="@(_SwiftBindingNativeManifest)">

    <!-- Read wrapper metadata from the props file generated during Build -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasWrapperXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_HasWrapper" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_WrapperModule" />
    </XmlPeek>

    <!-- Read bridge metadata -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_HasBridge" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_BridgeModule" />
    </XmlPeek>

    <!-- All paths must be absolute — relative paths resolve against the CONSUMER
         project, not this library project, when flowing through GetNativeManifest. -->
    <ItemGroup>
      <!-- Source xcframework -->
      <_SwiftBindingNativeManifest Include="$([System.IO.Path]::GetFullPath('%(SwiftFramework.Identity)'))">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>

      <!-- Wrapper xcframework (generated during Build) -->
      <_SwiftBindingNativeManifest Include="$(MSBuildProjectDirectory)/$(_SwiftBindingIntermediateDir)$(_GNM_WrapperModule).xcframework"
                                   Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                              AND '$(_GNM_HasWrapper)' == 'True'
                                              AND Exists('$(_SwiftBindingIntermediateDir)$(_GNM_WrapperModule).xcframework')">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>

      <!-- Bridge xcframework (generated during Build) -->
      <_SwiftBindingNativeManifest Include="$(MSBuildProjectDirectory)/$(_SwiftBindingIntermediateDir)$(_GNM_BridgeModule).xcframework"
                                   Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                              AND '$(_GNM_HasBridge)' == 'True'
                                              AND Exists('$(_SwiftBindingIntermediateDir)$(_GNM_BridgeModule).xcframework')">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>

      <!-- Dependency xcframeworks -->
      <_SwiftBindingNativeManifest Include="$([System.IO.Path]::GetFullPath('%(SwiftFrameworkDependency.Identity)'))"
                                   Condition="'@(SwiftFrameworkDependency)' != '' AND Exists('%(SwiftFrameworkDependency.Identity)')">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 6b: Validate dependency metadata before pack                    -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftDependencyMetadata"
          BeforeTargets="_ConfigureSwiftBindingPack"
          Condition="'$(IsPackable)' == 'true' AND '@(SwiftFrameworkDependency)' != ''">

    <Warning Condition="'%(SwiftFrameworkDependency.PackageId)' == '' OR '%(SwiftFrameworkDependency.PackageVersion)' == ''"
             Code="SWIFTBIND040"
             Text="SwiftFrameworkDependency '%(SwiftFrameworkDependency.Identity)' is missing PackageId or PackageVersion metadata. The NuGet package will not declare this dependency. Add PackageId and PackageVersion metadata for correct NuGet dependency propagation." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7a: Validate wrapper slices before pack                         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftBindingPackSlices"
          BeforeTargets="_ConfigureSwiftBindingPack"
          Condition="'$(IsPackable)' == 'true' AND '@(SwiftFramework)' != '' AND '$(SwiftFrameworkType)' != 'ObjC'">

    <!-- Guard 1: property check (only for platforms with simulator + device slices) -->
    <Error Condition="'$(SwiftWrapperArchitectures)' != 'all' AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'"
           Code="SWIFTBIND030"
           Text="NuGet packages require both device and simulator wrapper slices. Remove &lt;SwiftWrapperArchitectures&gt;simulator&lt;/SwiftWrapperArchitectures&gt; or set it to 'all' before packing." />

    <!-- Guard 2a: artifact check for platforms with simulator — verify both slice directories exist -->
    <Error Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                      AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'
                      AND (!Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingSimulatorSliceId)/')
                           OR !Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingDeviceSliceId)/'))"
           Code="SWIFTBIND031"
           Text="Wrapper xcframework is missing device or simulator slice. The source xcframework may not contain both platform slices. Verify your xcframework includes both device ($(_SwiftBindingDeviceSliceId)) and simulator ($(_SwiftBindingSimulatorSliceId)) slices, or set &lt;IsPackable&gt;false&lt;/IsPackable&gt; for local-only use." />

    <!-- Guard 2b: artifact check for single-slice platforms — verify device slice exists -->
    <Error Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                      AND '$(_SwiftBindingHasSimulatorSlice)' != 'true'
                      AND !Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingDeviceSliceId)/')"
           Code="SWIFTBIND031"
           Text="Wrapper xcframework is missing the $(_SwiftBindingDeviceSliceId) slice. Verify your xcframework includes the correct platform slice, or set &lt;IsPackable&gt;false&lt;/IsPackable&gt; for local-only use." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7b: Configure NuGet pack layout                                 -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ConfigureSwiftBindingPack"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="_ImportSwiftBindingMetadata"
          Condition="'$(IsPackable)' == 'true' AND '@(SwiftFramework)' != ''">

    <!--
      Compute a version-qualified TFM for NuGet pack paths.
      NuGet NU1012 requires platform version in framework-specific PackagePath entries
      (e.g. buildTransitive/net10.0-ios26.0/, not buildTransitive/net10.0-ios/).
      If the user specified a versionless TFM (e.g. net10.0-ios), the .NET SDK still
      resolves $(TargetPlatformVersion) from the installed workload. We detect the
      versionless form by checking if $(TargetFramework) ends with the bare platform
      identifier, and append the resolved version if so.
    -->
    <PropertyGroup>
      <_SwiftBindingPackTfm>$(TargetFramework)</_SwiftBindingPackTfm>
      <_SwiftBindingPackTfm
          Condition="'$(TargetPlatformVersion)' != ''
                     AND $(TargetFramework.EndsWith('$(_SwiftBindingPlatform)'))">$(TargetFramework)$(TargetPlatformVersion)</_SwiftBindingPackTfm>
    </PropertyGroup>

    <!-- Fail fast if we can't resolve a versioned TFM for pack -->
    <Error Condition="$(TargetFramework.EndsWith('$(_SwiftBindingPlatform)'))
                      AND '$(TargetPlatformVersion)' == ''"
           Code="SWIFTBIND035"
           Text="Cannot resolve platform version for NuGet pack. Specify a versioned TargetFramework (e.g. net10.0-ios26.0) or install the corresponding platform workload." />

    <!-- Arrange NuGet pack layout -->
    <ItemGroup>
      <None Include="$(_SwiftBindingIntermediateDir)$(PackageId).targets"
            Pack="true" PackagePath="buildTransitive/$(_SwiftBindingPackTfm)/"
            Condition="Exists('$(_SwiftBindingIntermediateDir)$(PackageId).targets')" />
      <None Include="%(SwiftFramework.Identity)/**"
            Pack="true"
            PackagePath="runtimes/$(_SwiftBindingNuGetRid)/native/$([System.IO.Path]::GetFileName('%(SwiftFramework.Identity)'))/" />
      <None Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/**"
            Pack="true"
            PackagePath="runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingWrapperModuleName).xcframework/"
            Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True'" />
      <None Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework/**"
            Pack="true"
            PackagePath="runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingBridgeModuleName).xcframework/"
            Condition="'$(_SwiftBindingHasBridgeXCFramework)' == 'True'" />
      <!-- Module database for cross-module type resolution in downstream binding projects -->
      <None Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingModuleName)Database.xml"
            Pack="true" PackagePath="buildTransitive/$(_SwiftBindingPackTfm)/"
            Condition="Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingModuleName)Database.xml')" />
    </ItemGroup>
  </Target>
</Project>
