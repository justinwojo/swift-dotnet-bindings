<Project>
  <!-- XML doc-file defaulting MUST precede the Microsoft.NET.Sdk import below, because
       Microsoft.NET.Sdk.BeforeCommon.targets derives $(DocumentationFile) from
       $(GenerateDocumentationFile) at EVALUATION time, in-place at that import. Setting
       GenerateDocumentationFile after the import (anywhere lower in this file) is too late —
       DocumentationFile is already finalized, so the generator's /// doc comments would
       silently never travel with the packed binding. This block runs after the csproj body
       (Sdk.targets is the bottom import) so IsPackable is fully resolved, yet before BeforeCommon
       — the only window that works.

       Scoped to a PACKABLE Swift-binding project (the binding library NuGet auto-includes the
       sibling $(AssemblyName).xml in lib/, surfacing IntelliSense for consumers). An SDK-direct
       app sets IsPackable=false, so it is excluded and never inherits the CS1591 noise. We gate
       PURELY on IsPackable, NOT on the presence of a SwiftFramework / SwiftAppleFrameworkTarget
       item: those items are populated by the _DiscoverSwiftFrameworks target at EXECUTION time
       (auto-discovery of a root *.xcframework), so they are still empty here at EVALUATION time —
       gating on them would silently skip doc-file generation for every binding that relies on
       auto-discovery instead of an explicit <SwiftFramework Include=...> item. Importing this SDK
       with IsPackable=true is itself the signal that this is a Swift binding (Sdk.props defaults
       IsPackable=true; only an SDK-direct app overrides it to false). CS1591 is suppressed because
       doc-comment coverage of the generated surface is partial. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <NoWarn Condition="'$(GenerateDocumentationFile)' == 'true'">$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Intermediate dir must be defined in .targets (not .props) so that
       $(IntermediateOutputPath) is fully resolved (e.g. obj/Debug/net10.0-ios/).
       In .props it evaluates to empty, causing output to land in project root. -->
  <PropertyGroup>
    <_SwiftBindingIntermediateDir>$(IntermediateOutputPath)swift-binding/</_SwiftBindingIntermediateDir>
    <!-- Deliberately NOT under $(IntermediateOutputPath): the per-TFM inner builds write here and
         the outer build reads it, so the path has to be one both agree on. Each inner build owns
         exactly ONE file — its own TFM's fragment — so cross-targeting builds, which run their
         inner builds concurrently, never write the same path; the outer build then combines the
         fragments into the single README the package ships. -->
    <_SwiftBindingReadmeStageDir>$(BaseIntermediateOutputPath)swift-binding-readme/</_SwiftBindingReadmeStageDir>
    <_SwiftBindingTfmReadmeFragment>$(_SwiftBindingReadmeStageDir)$(TargetFramework).api-surface.md</_SwiftBindingTfmReadmeFragment>
    <_SwiftBindingStagedReadme>$(_SwiftBindingReadmeStageDir)README.md</_SwiftBindingStagedReadme>
  </PropertyGroup>

  <!-- Bridge the optional generator-timeout properties to the generator process as environment
       variables. Computed in .targets (NOT .props) so a value the consumer sets in its project
       body is visible. Passed via <Exec EnvironmentVariables=...> on the generator invocations,
       where it augments/overrides the inherited environment — so the project property wins over an
       ambient (emergency) shell SWIFTBINDINGS_*_TIMEOUT_SECONDS. Built with no stray separators so
       MSBuild never sees an empty list entry; empty overall when neither property is set, in which
       case the Exec simply inherits the parent environment and the generator applies its defaults. -->
  <PropertyGroup>
    <_SwiftGeneratorEnv></_SwiftGeneratorEnv>
    <_SwiftGeneratorEnv Condition="'$(SwiftWrapperCompileTimeoutSeconds)' != ''">SWIFTBINDINGS_SWIFTC_TIMEOUT_SECONDS=$(SwiftWrapperCompileTimeoutSeconds)</_SwiftGeneratorEnv>
    <_SwiftGeneratorEnv Condition="'$(SwiftInterfaceParserTimeoutSeconds)' != '' AND '$(_SwiftGeneratorEnv)' != ''">$(_SwiftGeneratorEnv);SWIFTBINDINGS_PARSER_TIMEOUT_SECONDS=$(SwiftInterfaceParserTimeoutSeconds)</_SwiftGeneratorEnv>
    <_SwiftGeneratorEnv Condition="'$(SwiftInterfaceParserTimeoutSeconds)' != '' AND '$(_SwiftGeneratorEnv)' == ''">SWIFTBINDINGS_PARSER_TIMEOUT_SECONDS=$(SwiftInterfaceParserTimeoutSeconds)</_SwiftGeneratorEnv>
  </PropertyGroup>

  <!-- Platform detection from $(TargetFramework). Lives here, not in Sdk.props,
       because Sdk.props is imported before the project body — for single-TFM
       projects (the dotnet new swift-binding default), $(TargetFramework) is
       empty at that point and the .Contains() checks all fail, leaving every
       downstream property empty and tripping SWIFTBIND010. Sdk.targets is
       imported after the project body, so $(TargetFramework) is set whether
       it came from <TargetFramework> or a multi-TFM inner build. -->
  <PropertyGroup>
    <!-- Auto-detect platform from TFM (maccatalyst before macos to avoid substring overlap) -->
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('maccatalyst'))">maccatalyst</_SwiftBindingPlatform>
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('tvos'))">tvos</_SwiftBindingPlatform>
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('macos'))">macos</_SwiftBindingPlatform>
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('ios'))">ios</_SwiftBindingPlatform>
    <!-- Fail fast for unsupported TFMs (e.g. net10.0, net10.0-android, typos).
         No fallback assignment — _SwiftBindingPlatform stays empty so downstream
         properties also stay empty, making the invalid state visible if SWIFTBIND010
         is ever bypassed. -->
    <_SwiftBindingPlatformUnsupported Condition="'$(_SwiftBindingPlatform)' == ''">true</_SwiftBindingPlatformUnsupported>

    <!-- Whether platform has separate simulator + device slices -->
    <_SwiftBindingHasSimulatorSlice Condition="'$(_SwiftBindingPlatform)' == 'ios' OR '$(_SwiftBindingPlatform)' == 'tvos'">true</_SwiftBindingHasSimulatorSlice>

    <!-- NuGet RID for native pack layout -->
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingPlatform)' == 'macos'">osx-arm64</_SwiftBindingNuGetRid>
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingPlatform)' == 'tvos'">tvos-arm64</_SwiftBindingNuGetRid>
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">maccatalyst-arm64</_SwiftBindingNuGetRid>
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingNuGetRid)' == ''">ios-arm64</_SwiftBindingNuGetRid>

    <!-- Device slice directory in wrapper xcframework -->
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingPlatform)' == 'macos'">macos-arm64</_SwiftBindingDeviceSliceId>
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingPlatform)' == 'tvos'">tvos-arm64</_SwiftBindingDeviceSliceId>
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">ios-arm64-maccatalyst</_SwiftBindingDeviceSliceId>
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingDeviceSliceId)' == ''">ios-arm64</_SwiftBindingDeviceSliceId>

    <!-- Simulator slice directory (only for iOS/tvOS) -->
    <_SwiftBindingSimulatorSliceId Condition="'$(_SwiftBindingPlatform)' == 'tvos'">tvos-arm64-simulator</_SwiftBindingSimulatorSliceId>
    <_SwiftBindingSimulatorSliceId Condition="'$(_SwiftBindingSimulatorSliceId)' == '' AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'">ios-arm64-simulator</_SwiftBindingSimulatorSliceId>

    <!-- macOS/Catalyst have no simulator — only set default for iOS/tvOS -->
    <SwiftPlatformTarget Condition="'$(SwiftPlatformTarget)' == '' AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'">simulator</SwiftPlatformTarget>

    <!-- Apple-framework target mode: minimum deployment target for swift-api-digester.
         Platform-specific floors match .NET 10 minimums. -->
    <SwiftAppleFrameworkMinDeploymentVersion Condition="'$(SwiftAppleFrameworkMinDeploymentVersion)' == '' AND '$(_SwiftBindingPlatform)' == 'maccatalyst'">15.0</SwiftAppleFrameworkMinDeploymentVersion>
    <SwiftAppleFrameworkMinDeploymentVersion Condition="'$(SwiftAppleFrameworkMinDeploymentVersion)' == '' AND '$(_SwiftBindingPlatform)' == 'macos'">12.0</SwiftAppleFrameworkMinDeploymentVersion>
    <SwiftAppleFrameworkMinDeploymentVersion Condition="'$(SwiftAppleFrameworkMinDeploymentVersion)' == ''">15.0</SwiftAppleFrameworkMinDeploymentVersion>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 0a: Detect Apple-framework target mode                          -->
  <!-- MSBuild prohibits @(Item) in PropertyGroup Conditions outside Targets  -->
  <!-- (MSB4099). This target sets _SwiftBindingTargetKind at execution time;  -->
  <!-- downstream targets use task-level Conditions (not Target-level).        -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_DetectSwiftBindingTargetKind" BeforeTargets="_ValidateSwiftPackageItems;_DiscoverSwiftFrameworks;_ResolveAppleFrameworkPaths;_ComputeSwiftFingerprint">
    <PropertyGroup Condition="'@(SwiftAppleFrameworkTarget)' != ''">
      <_SwiftBindingTargetKind>AppleFramework</_SwiftBindingTargetKind>
      <!-- Direct mode doesn't support multi-arch wrapper (single -s swiftinterface).
           Override the default 'all' to the active platform target. -->
      <SwiftWrapperArchitectures Condition="'$(SwiftWrapperArchitectures)' == 'all' AND '$(SwiftPlatformTarget)' != ''">$(SwiftPlatformTarget)</SwiftWrapperArchitectures>
      <SwiftWrapperArchitectures Condition="'$(SwiftWrapperArchitectures)' == 'all' AND '$(SwiftPlatformTarget)' == ''">device</SwiftWrapperArchitectures>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 0: Validate no SwiftPackage items (v2 stub)                     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftPackageItems" BeforeTargets="_DiscoverSwiftFrameworks">
    <Error Condition="'$(_SwiftBindingPlatformUnsupported)' == 'true'"
           Code="SWIFTBIND010"
           Text="Unsupported TargetFramework '$(TargetFramework)' for Swift bindings. Use an Apple platform TFM: net10.0-ios, net10.0-macos, net10.0-tvos, or net10.0-maccatalyst." />
    <Error Condition="'@(SwiftPackage)' != ''"
           Code="SWIFTBIND100"
           Text="SwiftPackage items are not yet supported. Use SwiftFramework items with a pre-built xcframework." />

    <Error Condition="'@(SwiftAppleFrameworkTarget)' != '' AND '@(SwiftFramework)' != ''"
           Code="SWIFTBIND011"
           Text="SwiftAppleFrameworkTarget and SwiftFramework cannot be used in the same project. Use one or the other." />

    <Error Condition="@(SwiftAppleFrameworkTarget->Count()) &gt; 1"
           Code="SWIFTBIND015"
           Text="The SDK supports one Apple framework per project. Found: @(SwiftAppleFrameworkTarget, ', '). Create separate binding projects for each framework." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 1: Auto-discover xcframeworks (in .targets, not .props)         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_DiscoverSwiftFrameworks" BeforeTargets="_ComputeSwiftFingerprint">
    <!-- Auto-discover only if user hasn't declared any.
         Uses find -type d because *.xcframework are directories, not files,
         and MSBuild glob patterns only match files. -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework' AND '@(SwiftFramework)' == ''"
          Command="find &quot;$(MSBuildProjectDirectory)&quot; -maxdepth 1 -type d -name '*.xcframework' 2>/dev/null || true"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="SwiftFramework" />
    </Exec>

    <!-- Validation: no frameworks found (skip in Apple-framework mode) -->
    <Error Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework' AND '@(SwiftFramework)' == ''"
           Code="SWIFTBIND001"
           Text="No xcframework found. Copy an xcframework into the project directory or add &lt;SwiftFramework Include=&quot;path/to/Library.xcframework&quot; /&gt;." />

    <!-- Validation: multiple auto-discovered frameworks (v1 supports one per project) -->
    <Error Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework' AND @(SwiftFramework->Count()) &gt; 1"
           Code="SWIFTBIND002"
           Text="The SDK supports one xcframework per project. Found: @(SwiftFramework, ', '). Create separate binding projects for each xcframework." />

    <!-- Validation: xcframework path exists -->
    <Error Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework' AND !Exists('%(SwiftFramework.Identity)')"
           Code="SWIFTBIND003"
           Text="xcframework not found: '%(SwiftFramework.Identity)'." />

    <!-- Third-party ObjC binding (SwiftFramework path) requires IsBindingProject in the body.
         The SwiftFramework path's PATH-2 sibling of the SWIFTBIND021 guard (which covers the
         Apple-system-framework PATH-1 case in _ResolveAppleFrameworkPaths). When a user binds a
         third-party ObjC xcframework, two body properties engage the two pipelines:
           <SwiftFrameworkType>ObjC</SwiftFrameworkType>  routes our generator down the ObjC path
           <IsBindingProject>true</IsBindingProject>      engages the .NET iOS bgen pipeline
         IsBindingProject is read by Microsoft.iOS.Sdk at evaluation time (before this target, and
         before our own Sdk.props), so it MUST come from the csproj body — we cannot set it from a
         target. Without it, _IncludeGeneratedSwiftBindings still injects the generated
         ApiDefinition.cs as an ObjcBindingApiDefinition item, but bgen never runs to consume it, so
         the build silently produces an empty (0-type) binding assembly. Fail closed with the same
         actionable guidance as SWIFTBIND021 rather than ship that empty assembly. -->
    <Error Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework' AND '@(SwiftFramework)' != '' AND '$(SwiftFrameworkType)' == 'ObjC' AND '$(IsBindingProject)' != 'true'"
           Code="SWIFTBIND004"
           Text="xcframework '@(SwiftFramework)' is configured for ObjC binding (SwiftFrameworkType=ObjC), but &lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt; is missing from the csproj body. The .NET iOS workload reads IsBindingProject at evaluation time to engage the bgen pipeline — without it, the generated ApiDefinition.cs will not be processed and the build will produce an empty binding assembly. Add &lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt; to the same PropertyGroup that declares SwiftFrameworkType." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 1b: Auto-discover xcframeworks from ProjectReference dirs       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- For multi-framework libraries, users declare ProjectReference to sibling
       binding projects. This target discovers the xcframeworks in those project
       directories so the generator can resolve cross-module types without
       requiring redundant SwiftFrameworkDependency declarations.
       Uses find -type d because *.xcframework are directories, not files.
       Deduplicates against explicit SwiftFrameworkDependency items by name.

       Also captures user-authored ProjectReference items into _UserProjectReference
       at this early stage — before _ResolveSwiftAutoDetectedDependencies injects
       additional auto-detected ProjectReferences — so downstream targets can
       distinguish user intent from auto-injected refs. -->
  <Target Name="_DiscoverProjectReferenceDependencies"
          BeforeTargets="_ComputeSwiftFingerprint"
          DependsOnTargets="_DiscoverSwiftFrameworks"
          Condition="'@(ProjectReference)' != ''">

    <!-- Capture user-authored refs before any other target mutates @(ProjectReference).
         Exclude ObjC refs (the '.ObjC.' naming convention is generated by the binding
         generator for a mixed framework's companion csproj — {Module}.ObjC.{Platform}.csproj —
         but a user might also name one that way). -->
    <ItemGroup>
      <_UserProjectReference Include="@(ProjectReference)"
                             Condition="!$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>

    <!-- Shell variables use %24 (MSBuild percent-escape for $) to avoid
         MSBuild property evaluation of $VAR patterns. Same pattern as
         _ResolveSwiftAutoDetectedDependencies. -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework'"
          Command="EXPLICIT=&quot;@(SwiftFrameworkDependency->'%(Filename)', ';')&quot;; \
echo &quot;@(_UserProjectReference->'%(RootDir)%(Directory)', '%0A')&quot; | while IFS= read -r DIR; do \
  [ -z &quot;%24DIR&quot; ] &amp;&amp; continue; \
  find &quot;%24DIR&quot; -maxdepth 1 -type d -name '*.xcframework' 2>/dev/null | while IFS= read -r XCF; do \
    NAME=`basename &quot;%24XCF&quot; .xcframework`; \
    case &quot;;%24EXPLICIT;&quot; in *&quot;;%24NAME;&quot;*) continue ;; esac; \
    echo &quot;%24XCF&quot;; \
  done; \
done; true"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_AutoFrameworkDependency" />
    </Exec>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 1c: Resolve Apple-framework SDK paths                           -->
  <!-- Discovers Xcode SDK path, swiftinterface, and TBD for the module.      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ResolveAppleFrameworkPaths"
          BeforeTargets="_ComputeSwiftFingerprint"
          DependsOnTargets="_DetectSwiftBindingTargetKind">

    <!-- All tasks gated on AppleFramework mode (task-level, not target-level,
         because _SwiftBindingTargetKind is set at execution time). -->

    <!-- Default metadata: Module defaults to Include, LibraryPath defaults to @rpath pattern.
         Use Condition on child elements (not Update) to avoid MSB4096 batching issues
         with metadata that may not yet be defined on all items. -->
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <SwiftAppleFrameworkTarget Update="@(SwiftAppleFrameworkTarget)">
        <Module Condition="'%(SwiftAppleFrameworkTarget.Module)' == ''">%(Identity)</Module>
      </SwiftAppleFrameworkTarget>
    </ItemGroup>
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <SwiftAppleFrameworkTarget Update="@(SwiftAppleFrameworkTarget)">
        <LibraryPath Condition="'%(SwiftAppleFrameworkTarget.LibraryPath)' == ''">@rpath/%(SwiftAppleFrameworkTarget.Module).framework/%(SwiftAppleFrameworkTarget.Module)</LibraryPath>
        <MinDeploymentVersion Condition="'%(SwiftAppleFrameworkTarget.MinDeploymentVersion)' == ''">$(SwiftAppleFrameworkMinDeploymentVersion)</MinDeploymentVersion>
      </SwiftAppleFrameworkTarget>
    </ItemGroup>

    <!-- Resolve the effective minimum deployment version for the current slice.
         The legacy <MinDeploymentVersion> field on <SwiftAppleFrameworkTarget> is a
         single value applied across every TFM, which produces invalid target triples
         on slices whose version train differs from the user-supplied value. The
         clearest case is iOS-flavored values on macOS: iOS 16.1 ≠ macOS 16.1 (the
         macOS train is 13.x-26.x), so 'arm64-apple-macos16.1' is rejected by
         swift-api-digester. Per-platform overrides (<MinIOSVersion>, <MinMacOSVersion>,
         <MinTvOSVersion>, <MinMacCatalystVersion>) let consumers express the
         framework's actual per-platform minimums; the matching one for the current
         slice wins over the legacy field. Falls back to the legacy MinDeploymentVersion
         (which itself falls back to $(SwiftAppleFrameworkMinDeploymentVersion), the
         platform-keyed project default set above). -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftEffectiveMinDeploymentVersion>%(SwiftAppleFrameworkTarget.MinDeploymentVersion)</_SwiftEffectiveMinDeploymentVersion>
      <_SwiftEffectiveMinDeploymentVersion Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '%(SwiftAppleFrameworkTarget.MinIOSVersion)' != ''">%(SwiftAppleFrameworkTarget.MinIOSVersion)</_SwiftEffectiveMinDeploymentVersion>
      <_SwiftEffectiveMinDeploymentVersion Condition="'$(_SwiftBindingPlatform)' == 'macos' AND '%(SwiftAppleFrameworkTarget.MinMacOSVersion)' != ''">%(SwiftAppleFrameworkTarget.MinMacOSVersion)</_SwiftEffectiveMinDeploymentVersion>
      <_SwiftEffectiveMinDeploymentVersion Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '%(SwiftAppleFrameworkTarget.MinTvOSVersion)' != ''">%(SwiftAppleFrameworkTarget.MinTvOSVersion)</_SwiftEffectiveMinDeploymentVersion>
      <_SwiftEffectiveMinDeploymentVersion Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst' AND '%(SwiftAppleFrameworkTarget.MinMacCatalystVersion)' != ''">%(SwiftAppleFrameworkTarget.MinMacCatalystVersion)</_SwiftEffectiveMinDeploymentVersion>
    </PropertyGroup>

    <!-- Compute xcrun SDK name from platform + target -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftXcrunSdk Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator'">iphonesimulator</_SwiftXcrunSdk>
      <_SwiftXcrunSdk Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' != 'simulator'">iphoneos</_SwiftXcrunSdk>
      <_SwiftXcrunSdk Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator'">appletvsimulator</_SwiftXcrunSdk>
      <_SwiftXcrunSdk Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' != 'simulator'">appletvos</_SwiftXcrunSdk>
      <_SwiftXcrunSdk Condition="'$(_SwiftBindingPlatform)' == 'macos'">macosx</_SwiftXcrunSdk>
      <_SwiftXcrunSdk Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">macosx</_SwiftXcrunSdk>
    </PropertyGroup>

    <!-- Resolve Xcode SDK path -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'"
          Command="xcrun --sdk $(_SwiftXcrunSdk) --show-sdk-path 2>/dev/null"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftAppleFrameworkSdkPath" />
    </Exec>

    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND ('$(_SwiftAppleFrameworkSdkPath)' == '' OR !Exists('$(_SwiftAppleFrameworkSdkPath)'))"
           Code="SWIFTBIND012"
           Text="Cannot resolve Xcode SDK path for '$(_SwiftXcrunSdk)'. Install Xcode or set the active developer directory with xcode-select." />

    <!-- Compute swiftinterface slice name.
         Device SDK ships arm64e-apple-ios.swiftinterface;
         Simulator SDK ships arm64-apple-ios-simulator.swiftinterface.
         For an explicit x86_64-only consumer (Intel iOS/tvOS sim), pin the
         x86_64-apple-ios-simulator / x86_64-apple-tvos-simulator slice; the
         arm64-fallback PropertyGroup below covers SDKs that ship only arm64. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-ios-simulator</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(_SwiftInterfaceSlice)' == ''">arm64-apple-ios-simulator</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' != 'simulator'">arm64e-apple-ios</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-tvos-simulator</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(_SwiftInterfaceSlice)' == ''">arm64-apple-tvos-simulator</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' != 'simulator'">arm64e-apple-tvos</_SwiftInterfaceSlice>
      <!-- macOS / Mac Catalyst: prefer the x86_64 interface slice for an x86_64-only
           (Intel) consumer; arm64e is the default for arm64 and fat builds. The
           slice files are arch-portable at the API-text level, so the Exists()
           fallback after the interface path is resolved reverts to arm64e if the
           SDK ships no x86_64 slice. -->
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'macos' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-macos</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'macos' AND '$(_SwiftInterfaceSlice)' == ''">arm64e-apple-macos</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-ios-macabi</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst' AND '$(_SwiftInterfaceSlice)' == ''">arm64e-apple-ios-macabi</_SwiftInterfaceSlice>
    </PropertyGroup>

    <!-- Resolve swiftinterface and TBD paths.
         Mac Catalyst frameworks live under System/iOSSupport/System/Library/Frameworks/
         (the macOS SDK hosts them in the iOSSupport overlay). Some frameworks (e.g.
         WeatherKit, CryptoKit) are only in the regular System/Library/Frameworks/ path,
         so we try iOSSupport first and fall back to the standard path. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftAppleFrameworkModule>%(SwiftAppleFrameworkTarget.Module)</_SwiftAppleFrameworkModule>
      <_SwiftAppleFrameworkSdkSubpath Condition="'$(_SwiftBindingPlatform)' != 'maccatalyst'">System/Library/Frameworks</_SwiftAppleFrameworkSdkSubpath>
      <_SwiftAppleFrameworkSdkSubpath Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">System/iOSSupport/System/Library/Frameworks</_SwiftAppleFrameworkSdkSubpath>
      <_SwiftAppleFrameworkDir>$(_SwiftAppleFrameworkSdkPath)/$(_SwiftAppleFrameworkSdkSubpath)/$(_SwiftAppleFrameworkModule).framework</_SwiftAppleFrameworkDir>
    </PropertyGroup>
    <!-- Mac Catalyst fallback: if the framework isn't in iOSSupport, try the regular macOS path.
         Check for the Modules/ subdirectory rather than the framework dir itself — some frameworks
         (e.g., MusicKit) ship an empty stub framework at the iOSSupport path with only a Versions/
         subdirectory and no swiftmodule, so Exists($dir) is true but the swiftinterface is absent.
         The regular macOS SDK path usually carries both the macos and ios-macabi swiftmodule slices.
         For ObjC-only frameworks (Matter, etc.) there is no swiftmodule, so also fall back when
         the iOSSupport overlay has no module.modulemap — the regular path has the modulemap. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftBindingPlatform)' == 'maccatalyst'
                              AND !Exists('$(_SwiftAppleFrameworkDir)/Modules/$(_SwiftAppleFrameworkModule).swiftmodule')
                              AND !Exists('$(_SwiftAppleFrameworkDir)/Modules/module.modulemap')">
      <_SwiftAppleFrameworkSdkSubpath>System/Library/Frameworks</_SwiftAppleFrameworkSdkSubpath>
      <_SwiftAppleFrameworkDir>$(_SwiftAppleFrameworkSdkPath)/$(_SwiftAppleFrameworkSdkSubpath)/$(_SwiftAppleFrameworkModule).framework</_SwiftAppleFrameworkDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftAppleFrameworkInterface>$(_SwiftAppleFrameworkDir)/Modules/$(_SwiftAppleFrameworkModule).swiftmodule/$(_SwiftInterfaceSlice).swiftinterface</_SwiftAppleFrameworkInterface>
      <_SwiftAppleFrameworkTbd>$(_SwiftAppleFrameworkDir)/$(_SwiftAppleFrameworkModule).tbd</_SwiftAppleFrameworkTbd>
      <_SwiftAppleFrameworkModulemap>$(_SwiftAppleFrameworkDir)/Modules/module.modulemap</_SwiftAppleFrameworkModulemap>
    </PropertyGroup>
    <!-- x86_64 interface fallback: an Intel consumer selected an x86_64 slice, but
         this framework ships only the arm64/arm64e slice — revert to it (the textual
         interface is arch-portable, so it drives the same API surface). Runs after
         the interface path is resolved so Exists() can probe the real on-disk file.
         iOS/tvOS simulator fall back to arm64-apple-{ios,tvos}-simulator; macOS and
         Mac Catalyst fall back to arm64e-apple-macos / arm64e-apple-ios-macabi. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(SwiftTargetArchitectures)' == 'x86_64'
                              AND !Exists('$(_SwiftAppleFrameworkInterface)')">
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'macos'">arm64e-apple-macos</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">arm64e-apple-ios-macabi</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator'">arm64-apple-ios-simulator</_SwiftInterfaceSlice>
      <_SwiftInterfaceSlice Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator'">arm64-apple-tvos-simulator</_SwiftInterfaceSlice>
      <_SwiftAppleFrameworkInterface>$(_SwiftAppleFrameworkDir)/Modules/$(_SwiftAppleFrameworkModule).swiftmodule/$(_SwiftInterfaceSlice).swiftinterface</_SwiftAppleFrameworkInterface>
    </PropertyGroup>

    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND !Exists('$(_SwiftAppleFrameworkDir)')"
           Code="SWIFTBIND013"
           Text="Apple framework '$(_SwiftAppleFrameworkModule)' not found in SDK at '$(_SwiftAppleFrameworkDir)'. Verify the framework name and Xcode version." />

    <!-- Detect Swift vs ObjC framework type.
         Swift frameworks ship a .swiftinterface under Modules/<Name>.swiftmodule/.
         ObjC-only frameworks (Matter, etc.) ship Modules/module.modulemap with no swiftmodule.
         Mixed frameworks (Swift API + ObjC headers) have BOTH — treat as Swift since the
         Swift interface drives the generator. The user can override with <SwiftFrameworkType>
         to force ObjC mode. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == ''">
      <_SwiftAppleFrameworkType Condition="Exists('$(_SwiftAppleFrameworkInterface)')">Swift</_SwiftAppleFrameworkType>
      <_SwiftAppleFrameworkType Condition="'$(_SwiftAppleFrameworkType)' == '' AND Exists('$(_SwiftAppleFrameworkModulemap)')">ObjC</_SwiftAppleFrameworkType>
    </PropertyGroup>

    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'Swift' AND !Exists('$(_SwiftAppleFrameworkInterface)')"
           Code="SWIFTBIND014"
           Text="Swift interface not found at '$(_SwiftAppleFrameworkInterface)'. The framework may not have a Swift module for this platform/architecture." />

    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == ''"
           Code="SWIFTBIND017"
           Text="Apple framework '$(_SwiftAppleFrameworkModule)' has neither a Swift interface ('$(_SwiftAppleFrameworkInterface)') nor an ObjC module.modulemap ('$(_SwiftAppleFrameworkModulemap)') at the resolved SDK path. The framework may not be available for this platform/architecture, or it uses an older umbrella-header-only layout not supported by SDK direct mode." />

    <!-- ObjC AppleFramework mode requires THREE properties in the csproj body:
           <SwiftFrameworkType>ObjC</SwiftFrameworkType>     — engages our ObjC pipeline
           <IsBindingProject>true</IsBindingProject>          — engages the .NET iOS bgen pipeline
           <SwiftAppleFrameworkTarget Include="..." />         — selects the framework module
         Both properties must be in the body (or earlier — Directory.Build.props, globals).
         IsBindingProject in particular is consumed at PROPS time by Microsoft.iOS.Sdk's
         Xamarin.Shared.props (gates binding-project defaults), so it must be observable
         before that import. Setting it from this target — or from a PropertyGroup in our
         Sdk.props gated on SwiftFrameworkType — is too late, because both the body and our
         Sdk.props execute AFTER Microsoft.NET.Sdk.props (which pulls in the iOS workload).
         Fail fast with actionable guidance if either is missing, instead of letting the
         build silently miss the bgen pipeline. -->
    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC' AND '$(SwiftFrameworkType)' != 'ObjC'"
           Code="SWIFTBIND018"
           Text="Apple framework '$(_SwiftAppleFrameworkModule)' is ObjC-only (no Swift interface). Add &lt;SwiftFrameworkType&gt;ObjC&lt;/SwiftFrameworkType&gt; AND &lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt; to your project's PropertyGroup. Both must be declared in the csproj body (not from a target) so the .NET iOS workload's binding-project pipeline engages before this target runs." />

    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC' AND '$(SwiftFrameworkType)' == 'ObjC' AND '$(IsBindingProject)' != 'true'"
           Code="SWIFTBIND021"
           Text="Apple framework '$(_SwiftAppleFrameworkModule)' is configured for ObjC binding (SwiftFrameworkType=ObjC), but &lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt; is missing from the csproj body. The .NET iOS workload reads IsBindingProject at evaluation time to engage the bgen pipeline — without it, generated ApiDefinition.cs files will not be processed and the build will produce an empty binding assembly. Add &lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt; to the same PropertyGroup that declares SwiftFrameworkType." />

    <!-- Catch the opposite mistake: user declared SwiftFrameworkType=ObjC but the framework has a
         Swift interface. Refuse to silently mis-route to bgen on a Swift framework. -->
    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'Swift' AND '$(SwiftFrameworkType)' == 'ObjC'"
           Code="SWIFTBIND019"
           Text="Apple framework '$(_SwiftAppleFrameworkModule)' has a Swift interface, but &lt;SwiftFrameworkType&gt;ObjC&lt;/SwiftFrameworkType&gt; was declared. Remove SwiftFrameworkType=ObjC to use the Swift binding pipeline, or pick a framework that is ObjC-only." />

    <!-- Resolve the platform version that threads into the generator and the fingerprint.
         The consumer-settable <SwiftAppleFrameworkPlatformVersion> property wins over MSBuild's
         <TargetPlatformVersion>, because on .NET 10 library projects <TargetPlatformVersion>
         silently picks the oldest installed TPV on multi-workload machines — producing stale
         TFMs in generator output. Falling back to $(TargetPlatformVersion) preserves existing
         behavior; failing closed when both are empty prevents silent drift between generator
         output and the shipped nupkg layout. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(SwiftAppleFrameworkPlatformVersion)' == ''">
      <SwiftAppleFrameworkPlatformVersion>$(TargetPlatformVersion)</SwiftAppleFrameworkPlatformVersion>
    </PropertyGroup>

    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(SwiftAppleFrameworkPlatformVersion)' == ''"
           Code="SWIFTBIND016"
           Text="Cannot resolve platform version for Apple-framework direct mode. Set &lt;SwiftAppleFrameworkPlatformVersion&gt; to the canonical SDK version (e.g. '26.2') or use a versioned TargetFramework (e.g. net10.0-ios26.0)." />

    <!-- Compute swift-api-digester target triple. Uses _SwiftEffectiveMinDeploymentVersion
         so per-platform overrides (MinMacOSVersion/MinIOSVersion/...) flow through.
         An explicit x86_64 consumer (osx-x64, maccatalyst-x64, iossimulator-x64,
         tvossimulator-x64) gets an x86_64 triple; arm64 covers everything else. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)-simulator</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(_SwiftDigesterTarget)' == ''">arm64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)-simulator</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' != 'simulator'">arm64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-tvos$(_SwiftEffectiveMinDeploymentVersion)-simulator</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator' AND '$(_SwiftDigesterTarget)' == ''">arm64-apple-tvos$(_SwiftEffectiveMinDeploymentVersion)-simulator</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' != 'simulator'">arm64-apple-tvos$(_SwiftEffectiveMinDeploymentVersion)</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'macos' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-macos$(_SwiftEffectiveMinDeploymentVersion)</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'macos' AND '$(_SwiftDigesterTarget)' == ''">arm64-apple-macos$(_SwiftEffectiveMinDeploymentVersion)</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst' AND '$(SwiftTargetArchitectures)' == 'x86_64'">x86_64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)-macabi</_SwiftDigesterTarget>
      <_SwiftDigesterTarget Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst' AND '$(_SwiftDigesterTarget)' == ''">arm64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)-macabi</_SwiftDigesterTarget>

      <!-- Mac Catalyst: swift-api-digester needs -F for both iOSSupport overlay (UIKit
           etc.) and regular frameworks path (frameworks not in iOSSupport). -->
      <_SwiftDigesterExtraFlags Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">-F "$(_SwiftAppleFrameworkSdkPath)/System/iOSSupport/System/Library/Frameworks" -F "$(_SwiftAppleFrameworkSdkPath)/System/Library/Frameworks"</_SwiftDigesterExtraFlags>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 1d: Synthesize xcframework for ObjC AppleFramework mode         -->
  <!-- ObjC Apple system frameworks (Matter, etc.) ship as a single .framework -->
  <!-- per-slice under the SDK, never as a packaged xcframework. The generator -->
  <!-- and downstream resolvers expect an xcframework directory layout. Build  -->
  <!-- one in $(IntermediateOutputPath) by hand: Info.plist + a single slice    -->
  <!-- referencing the SDK framework directly (cp -R so the modulemap +        -->
  <!-- headers + .tbd land inside, but no Mach-O binary — Apple system          -->
  <!-- frameworks have no binary, only a .tbd link stub).                       -->
  <!--                                                                          -->
  <!-- xcodebuild -create-xcframework would be the obvious tool here, but it    -->
  <!-- rejects .tbd-only frameworks ("unable to read the file at ...") because  -->
  <!-- it expects a Mach-O binary it can lipo-inspect. Hand-synthesizing the    -->
  <!-- directory layout (Info.plist + slice dir) is the documented workaround.  -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_SynthesizeAppleFrameworkXcframework"
          DependsOnTargets="_DetectSwiftBindingTargetKind;_ResolveAppleFrameworkPaths"
          BeforeTargets="_ComputeSwiftFingerprint">

    <!-- All tasks gated on AppleFramework+ObjC mode at task level. Target-level
         Conditions evaluate BEFORE DependsOnTargets run, so we cannot gate on
         $(_SwiftAppleFrameworkType) at the target level — it would always be
         empty. Mirrors the pattern used by _ResolveAppleFrameworkPaths above. -->

    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC'">
      <!-- Output xcframework location -->
      <_SwiftAppleFrameworkSynthXcfw>$(_SwiftBindingIntermediateDir)$(_SwiftAppleFrameworkModule).xcframework</_SwiftAppleFrameworkSynthXcfw>

      <!-- Plist platform string ("ios", "tvos", "macos") -->
      <_AFW_SynthPlatform Condition="'$(_SwiftBindingPlatform)' == 'ios' OR '$(_SwiftBindingPlatform)' == 'maccatalyst'">ios</_AFW_SynthPlatform>
      <_AFW_SynthPlatform Condition="'$(_SwiftBindingPlatform)' == 'tvos'">tvos</_AFW_SynthPlatform>
      <_AFW_SynthPlatform Condition="'$(_SwiftBindingPlatform)' == 'macos'">macos</_AFW_SynthPlatform>

      <!-- Slice directory name. Matches the SDK's _SwiftBindingDeviceSliceId /
           _SwiftBindingSimulatorSliceId conventions so downstream pack/resolve
           paths line up. -->
      <_AFW_SynthSliceId Condition="'$(SwiftPlatformTarget)' == 'simulator'">$(_SwiftBindingSimulatorSliceId)</_AFW_SynthSliceId>
      <_AFW_SynthSliceId Condition="'$(SwiftPlatformTarget)' != 'simulator'">$(_SwiftBindingDeviceSliceId)</_AFW_SynthSliceId>

      <!-- SupportedPlatformVariant: "simulator" for sim, "maccatalyst" for catalyst, empty otherwise.
           Apple's Info.plist convention omits the key for plain device slices. -->
      <_AFW_SynthVariant Condition="'$(SwiftPlatformTarget)' == 'simulator'">simulator</_AFW_SynthVariant>
      <_AFW_SynthVariant Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">maccatalyst</_AFW_SynthVariant>
    </PropertyGroup>

    <!-- Wipe stale synthesized xcframework. Cheap (small tree) and avoids
         leaving half-populated slice dirs if the user upgrades Xcode and the
         framework's Headers/Modules layout changes. -->
    <RemoveDir Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC'"
               Directories="$(_SwiftAppleFrameworkSynthXcfw)" />
    <MakeDir Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC'"
             Directories="$(_SwiftAppleFrameworkSynthXcfw)/$(_AFW_SynthSliceId)" />

    <!-- Copy the SDK's framework directory into the synthesized slice. cp -R
         preserves the symlink structure inside .framework bundles (Versions/A,
         Headers, Modules, etc.). The .tbd link stub comes along — the generator
         uses it for ABI resolution; no Mach-O binary is needed because system
         frameworks are provided by the OS at runtime. -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC'"
          Command="cp -R &quot;$(_SwiftAppleFrameworkDir)&quot; &quot;$(_SwiftAppleFrameworkSynthXcfw)/$(_AFW_SynthSliceId)/&quot;"
          StandardOutputImportance="low" StandardErrorImportance="high" />

    <!-- Synthesize Info.plist with a single AvailableLibrary entry.
         The SupportedPlatformVariant key is omitted for plain device slices
         (matches Apple convention; XCFrameworkResolver.SelectSlice treats
         null/missing as device). -->
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC'">
      <_AFW_SynthPlistLines Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;" />
      <_AFW_SynthPlistLines Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
      <_AFW_SynthPlistLines Include="&lt;plist version=&quot;1.0&quot;&gt;" />
      <_AFW_SynthPlistLines Include="&lt;dict&gt;" />
      <_AFW_SynthPlistLines Include="    &lt;key&gt;AvailableLibraries&lt;/key&gt;" />
      <_AFW_SynthPlistLines Include="    &lt;array&gt;" />
      <_AFW_SynthPlistLines Include="        &lt;dict&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;key&gt;LibraryIdentifier&lt;/key&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;string&gt;$(_AFW_SynthSliceId)&lt;/string&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;key&gt;LibraryPath&lt;/key&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;string&gt;$(_SwiftAppleFrameworkModule).framework&lt;/string&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;key&gt;SupportedArchitectures&lt;/key&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;array&gt;" />
      <_AFW_SynthPlistLines Include="                &lt;string&gt;arm64&lt;/string&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;/array&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;key&gt;SupportedPlatform&lt;/key&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;string&gt;$(_AFW_SynthPlatform)&lt;/string&gt;" />
      <_AFW_SynthPlistLines Include="            &lt;key&gt;SupportedPlatformVariant&lt;/key&gt;"
                            Condition="'$(_AFW_SynthVariant)' != ''" />
      <_AFW_SynthPlistLines Include="            &lt;string&gt;$(_AFW_SynthVariant)&lt;/string&gt;"
                            Condition="'$(_AFW_SynthVariant)' != ''" />
      <_AFW_SynthPlistLines Include="        &lt;/dict&gt;" />
      <_AFW_SynthPlistLines Include="    &lt;/array&gt;" />
      <_AFW_SynthPlistLines Include="    &lt;key&gt;CFBundlePackageType&lt;/key&gt;" />
      <_AFW_SynthPlistLines Include="    &lt;string&gt;XFWK&lt;/string&gt;" />
      <_AFW_SynthPlistLines Include="    &lt;key&gt;XCFrameworkFormatVersion&lt;/key&gt;" />
      <_AFW_SynthPlistLines Include="    &lt;string&gt;1.0&lt;/string&gt;" />
      <_AFW_SynthPlistLines Include="&lt;/dict&gt;" />
      <_AFW_SynthPlistLines Include="&lt;/plist&gt;" />
    </ItemGroup>

    <WriteLinesToFile Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC'"
                      File="$(_SwiftAppleFrameworkSynthXcfw)/Info.plist"
                      Lines="@(_AFW_SynthPlistLines)"
                      Overwrite="true" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 1e: Emit [assembly: LinkWith] for ObjC AppleFramework mode      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- ObjC Apple system frameworks (Matter, etc.) have no Swift wrapper
       xcframework whose Mach-O can carry the framework dependency through
       to the consuming app's native link step. Without an explicit signal,
       mtouch/mlaunch never threads `-framework Matter` into the link line,
       and the consumer build fails with "Undefined symbols: _MTRAttributePathKey, ...".
       Swift mode is already covered: its wrapper xcframework's binary carries
       LC_LINKER_OPTION load commands that the static linker honors transitively.

       LinkWithAttribute is the .NET-for-iOS-documented mechanism for a binding
       assembly to declare native link dependencies. The parameterless ctor +
       Frameworks="<Name>" tells the linker to add `-framework <Name>` without
       bundling a native library — exactly what an Apple system framework needs.
       The attribute is baked into the binding DLL, so every consumer (direct
       or transitive via ProjectReference / PackageReference) picks it up
       automatically without per-app MtouchExtraArgs.

       Defined as a Target (not a top-level ItemGroup) because the
       SwiftAppleFrameworkTarget.Module metadata is defaulted by
       _ResolveAppleFrameworkPaths (falls back to %(Identity)), and
       _SwiftAppleFrameworkType is detected there too. Both must run first.
       BeforeTargets="GetAssemblyAttributes" places this ahead of
       GenerateAssemblyInfo's WriteCodeFragment pass that emits the attributes.
       Mirrors Target 1d's gating pattern: depend on the resolver targets,
       gate the inner ItemGroup on the resolved state.

       Cache-invalidation sentinel: the upstream
       CreateGeneratedAssemblyInfoInputsCacheFile hashes @(AssemblyAttribute)
       as `%(Identity)%(_Parameter1)…%(_Parameter8)` only — named metadata
       like our `Frameworks` is NOT in the hash. Without a companion item
       whose hashed parameters carry the Module name, renaming Module on an
       existing project would leave the previous Frameworks value baked into
       the generated AssemblyInfo on incremental rebuilds. The accompanying
       AssemblyMetadata("SwiftBindings.LinkWith.Module", "<Module>") puts the
       Module into _Parameter2 so the cache hash changes whenever Module
       changes, forcing AssemblyInfo regeneration. The sentinel attribute is
       small, harmless, and doubles as useful provenance (developers can
       reflect on it to see which framework a binding DLL links against). -->
  <Target Name="_EmitObjCAppleFrameworkLinkWith"
          DependsOnTargets="_DetectSwiftBindingTargetKind;_ResolveAppleFrameworkPaths"
          BeforeTargets="GetAssemblyAttributes;BeforeCompile">
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC'">
      <AssemblyAttribute Include="ObjCRuntime.LinkWithAttribute"
                         Condition="'%(SwiftAppleFrameworkTarget.Module)' != ''">
        <Frameworks>%(SwiftAppleFrameworkTarget.Module)</Frameworks>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                         Condition="'%(SwiftAppleFrameworkTarget.Module)' != ''">
        <_Parameter1>SwiftBindings.LinkWith.Module</_Parameter1>
        <_Parameter2>%(SwiftAppleFrameworkTarget.Module)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2: Fingerprint-based incremental build                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ComputeSwiftFingerprint">
    <PropertyGroup>
      <_SwiftStampFile>$(_SwiftBindingIntermediateDir)swift-binding.stamp</_SwiftStampFile>
    </PropertyGroup>
    <MakeDir Directories="$(_SwiftBindingIntermediateDir)" />

    <!--
      Compute fingerprint by hashing:
      1. Outer Info.plist (slice metadata changes)
      2. All framework binaries (extensionless Mach-O inside *.framework/)
      3. All public .swiftinterface files (API surface changes)
      4. Optional supplementary inputs: SymbolGraph, BridgeHints, SwiftInterface files
      5. All generation-affecting properties (SDK version, platform, architecture, namespace, package ID)
      6. Dependency xcframework contents (Info.plist + binaries)
      Shell pipeline because framework binaries have no extension (*.dylib glob misses them).
      Sorted for deterministic output regardless of filesystem traversal order.
    -->
    <!-- XCFramework mode fingerprint -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework'"
          Command="(
      find &quot;%(SwiftFramework.Identity)&quot; \( \
        -name &quot;Info.plist&quot; -o \
        -name &quot;*.swiftinterface&quot; -not -name &quot;*.private.swiftinterface&quot; \
      \) -type f -exec shasum -a 256 {} \; &amp;&amp; \
      find &quot;%(SwiftFramework.Identity)&quot; -path &quot;*.framework/*&quot; \
        -not -name &quot;Info.plist&quot; -not -path &quot;*/Modules/*&quot; \
        -not -path &quot;*/_CodeSignature/*&quot; -type f -exec shasum -a 256 {} \; &amp;&amp; \
      for f in &quot;%(SwiftFramework.SymbolGraph)&quot; &quot;%(SwiftFramework.BridgeHints)&quot; &quot;%(SwiftFramework.SwiftInterface)&quot;; do \
        if [ -n &quot;%24f&quot; ] &amp;&amp; [ -e &quot;%24f&quot; ]; then shasum -a 256 &quot;%24f&quot;; fi; \
      done; \
      echo &quot;@(SwiftFrameworkDependency, '%0A')&quot; | while IFS= read -r dep; do \
        if [ -n &quot;%24dep&quot; ] &amp;&amp; [ -d &quot;%24dep&quot; ]; then \
          find &quot;%24dep&quot; \( -name &quot;Info.plist&quot; -o -name &quot;*.swiftinterface&quot; -not -name &quot;*.private.swiftinterface&quot; \) -type f -exec shasum -a 256 {} \; ; \
          find &quot;%24dep&quot; -path &quot;*.framework/*&quot; -not -name &quot;Info.plist&quot; -not -path &quot;*/Modules/*&quot; -not -path &quot;*/_CodeSignature/*&quot; -type f -exec shasum -a 256 {} \; ; \
        fi; \
      done; \
      echo &quot;@(_AutoFrameworkDependency, '%0A')&quot; | while IFS= read -r dep; do \
        if [ -n &quot;%24dep&quot; ] &amp;&amp; [ -d &quot;%24dep&quot; ]; then \
          find &quot;%24dep&quot; \( -name &quot;Info.plist&quot; -o -name &quot;*.swiftinterface&quot; -not -name &quot;*.private.swiftinterface&quot; \) -type f -exec shasum -a 256 {} \; ; \
          find &quot;%24dep&quot; -path &quot;*.framework/*&quot; -not -name &quot;Info.plist&quot; -not -path &quot;*/Modules/*&quot; -not -path &quot;*/_CodeSignature/*&quot; -type f -exec shasum -a 256 {} \; ; \
        fi; \
      done; \
      echo &quot;@(SwiftModuleDatabase, '%0A')&quot; | while IFS= read -r db; do \
        if [ -n &quot;%24db&quot; ] &amp;&amp; [ -f &quot;%24db&quot; ]; then shasum -a 256 &quot;%24db&quot;; fi; \
      done; \
      echo &quot;@(SwiftFrameworkDependency->'%(ModuleDatabasePath)', '%0A')&quot; | while IFS= read -r db; do \
        if [ -n &quot;%24db&quot; ] &amp;&amp; [ -f &quot;%24db&quot; ]; then shasum -a 256 &quot;%24db&quot;; fi; \
      done; \
      echo &quot;$(_SwiftBindingSdkVersion) $(_SwiftBindingPlatform) $(SwiftPlatformTarget) $(SwiftWrapperArchitectures) $(SwiftTargetArchitectures) %(SwiftFramework.NamespacePattern) $(PackageId) $(AssemblyName) $(SwiftRuntimeVersion) %(SwiftFramework.SymbolGraph) %(SwiftFramework.BridgeHints) %(SwiftFramework.SwiftInterface) $(SwiftGenerateDocComments) $(SwiftAutoDetectDependencies) $(SwiftAppleSupplementPrototypeDir) $(SwiftFrameworkType) $(SwiftAppleSupplementVersion) @(SwiftFrameworkDependency, '|') @(_AutoFrameworkDependency, '|') @(SwiftLinkFramework, '|') @(SwiftLinkLibrary, '|')&quot; \
    ) | sort | shasum -a 256 | cut -d' ' -f1"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftNewFingerprint" />
    </Exec>

    <!-- Apple-framework mode fingerprint: hash swiftinterface (Swift) or
         modulemap+headers (ObjC) + TBD + SDK path + metadata. The Swift and
         ObjC branches are unified into one shasum pipeline; nonexistent
         inputs (e.g. swiftinterface for an ObjC framework) are skipped via
         `[ -f ]` guards so the fingerprint stays well-defined for both modes.
         _SwiftAppleFrameworkType is bumped into the hash so an accidental
         user switch between Swift and ObjC modes for the same framework
         re-runs the generator instead of silently reusing stale output.
         Cross-module databases are hashed too (mirroring xcframework mode):
         Apple-direct generation feeds these to the generator's module-database
         flag (e.g. RealityKit consuming RealityFoundationDatabase.xml), so a change to a declared
         SwiftModuleDatabase or a SwiftFrameworkDependency's ModuleDatabasePath
         must invalidate the binding. (ProjectReference-discovered databases are
         collected after this fingerprint runs and remain unhashed here, same as
         xcframework mode — they exist only on incremental builds.) -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'"
          Command="(
      if [ -f &quot;$(_SwiftAppleFrameworkInterface)&quot; ]; then shasum -a 256 &quot;$(_SwiftAppleFrameworkInterface)&quot;; fi ; \
      if [ -f &quot;$(_SwiftAppleFrameworkTbd)&quot; ]; then shasum -a 256 &quot;$(_SwiftAppleFrameworkTbd)&quot;; fi ; \
      if [ -f &quot;$(_SwiftAppleFrameworkModulemap)&quot; ]; then shasum -a 256 &quot;$(_SwiftAppleFrameworkModulemap)&quot;; fi ; \
      if [ -d &quot;$(_SwiftAppleFrameworkDir)/Headers&quot; ]; then find -L &quot;$(_SwiftAppleFrameworkDir)/Headers&quot; -type f -name '*.h' -exec shasum -a 256 {} \; ; fi ; \
      echo &quot;@(SwiftModuleDatabase, '%0A')&quot; | while IFS= read -r db; do \
        if [ -n &quot;%24db&quot; ] &amp;&amp; [ -f &quot;%24db&quot; ]; then shasum -a 256 &quot;%24db&quot;; fi; \
      done; \
      echo &quot;@(SwiftFrameworkDependency->'%(ModuleDatabasePath)', '%0A')&quot; | while IFS= read -r db; do \
        if [ -n &quot;%24db&quot; ] &amp;&amp; [ -f &quot;%24db&quot; ]; then shasum -a 256 &quot;%24db&quot;; fi; \
      done; \
      echo &quot;$(_SwiftAppleFrameworkSdkPath) $(_SwiftBindingSdkVersion) $(_SwiftBindingPlatform) $(SwiftPlatformTarget) $(SwiftWrapperArchitectures) $(SwiftTargetArchitectures) $(_SwiftAppleFrameworkModule) $(_SwiftAppleFrameworkType) %(SwiftAppleFrameworkTarget.LibraryPath) $(_SwiftEffectiveMinDeploymentVersion) $(PackageId) $(AssemblyName) $(SwiftRuntimeVersion) $(SwiftAppleFrameworkPlatformVersion) $(SwiftAppleSupplementPrototypeDir) %(SwiftAppleFrameworkTarget.NamespacePattern) $(SwiftAppleSupplementVersion)&quot; \
    ) | sort | shasum -a 256 | cut -d' ' -f1"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftNewFingerprint" />
    </Exec>

    <!-- Read existing stamp and compare -->
    <ReadLinesFromFile File="$(_SwiftStampFile)"
                       Condition="Exists('$(_SwiftStampFile)')">
      <Output TaskParameter="Lines" ItemName="_SwiftOldFingerprintLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_SwiftBindingUpToDate
          Condition="'$(_SwiftNewFingerprint)' == '@(_SwiftOldFingerprintLines)'">true</_SwiftBindingUpToDate>
    </PropertyGroup>

    <!-- Deliberately does NOT write the stamp here. Writing the fingerprint before
         generation runs is fail-open: a failed generate would leave a fresh stamp, so
         the next build with unchanged inputs sees it as current and skips regeneration,
         certifying partial/failed output. The stamp is written only after a successful
         generate (see _GenerateSwiftBindings / _GenerateSwiftBindingsAppleFramework). -->
  </Target>

  <!--
    Guard: SwiftAppleSupplementPrototypeDir must land under $(IntermediateOutputPath)
    (i.e. obj/ for the current TFM) so a `dotnet clean` removes it. An absolute path
    outside obj/ survives clean and risks ending up committed to source control.
    Warn rather than error — the property accepts user-supplied paths and power users
    may intentionally pin to a shared workspace.
  -->
  <Target Name="_ValidateSwiftAppleSupplementPrototypeDir"
          Condition="'$(SwiftAppleSupplementPrototypeDir)' != ''">
    <PropertyGroup>
      <_SwiftPrototypeResolved>$([System.IO.Path]::GetFullPath('$(SwiftAppleSupplementPrototypeDir)'))</_SwiftPrototypeResolved>
      <_SwiftObjResolved>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)'))</_SwiftObjResolved>
    </PropertyGroup>
    <Warning Condition="!$(_SwiftPrototypeResolved.StartsWith($(_SwiftObjResolved)))"
             Code="SWIFTBIND036"
             Text="SwiftAppleSupplementPrototypeDir '$(_SwiftPrototypeResolved)' is outside the project's intermediate output directory ('$(_SwiftObjResolved)'). 'dotnet clean' will not remove the prototype project, and emitted sources may be committed accidentally. Prefer a path under $(IntermediateOutputPath)." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2c: Dump Apple-framework ABI via swift-api-digester             -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_DumpAppleFrameworkAbi"
          DependsOnTargets="_ComputeSwiftFingerprint;_ValidateSwiftAppleSupplementPrototypeDir;_ResolveAppleFrameworkPaths">

    <!-- Gated on _SwiftAppleFrameworkType == 'Swift'. ObjC-only frameworks
         (Matter, etc.) have no Swift module for swift-api-digester to consume —
         the generator instead reads the clang-imported AST via the synthesized
         xcframework's module.modulemap. -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'Swift' AND '$(_SwiftBindingUpToDate)' != 'true'"
          Command="xcrun swift-api-digester -dump-sdk -module $(_SwiftAppleFrameworkModule) -target $(_SwiftDigesterTarget) -sdk &quot;$(_SwiftAppleFrameworkSdkPath)&quot; $(_SwiftDigesterExtraFlags) -o &quot;$(_SwiftBindingIntermediateDir)$(_SwiftAppleFrameworkModule).abi.json&quot;"
          StandardOutputImportance="low" StandardErrorImportance="high" />

    <!-- Validate the digester actually loaded the module. swift-api-digester exits
         with status 0 even when the target triple is rejected (e.g. invalid macOS
         version) — it just writes a placeholder abi.json whose top-level "name" is
         "NO_MODULE" and "children" is empty. Without this guard, the build proceeds
         and Swift.Bindings.dll later raises "BUILD_LIBRARY_FOR_DISTRIBUTION=YES"
         which is misdiagnostic: the .swiftinterface is fine, the digester invocation
         is the problem. Surface a clear error pointing at the triple and the
         per-platform metadata fix. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'Swift' AND '$(_SwiftBindingUpToDate)' != 'true'">
      <_SwiftAbiJsonPath>$(_SwiftBindingIntermediateDir)$(_SwiftAppleFrameworkModule).abi.json</_SwiftAbiJsonPath>
    </PropertyGroup>
    <!-- Match the literal placeholder field swift-api-digester writes on failure
         ("name": "NO_MODULE"), not a bare NO_MODULE substring — a Swift symbol
         named NO_MODULE anywhere in a valid dump would otherwise false-positive. -->
    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'Swift' AND '$(_SwiftBindingUpToDate)' != 'true' AND Exists('$(_SwiftAbiJsonPath)')"
          Command="grep -Eq '&quot;name&quot;[[:space:]]*:[[:space:]]*&quot;NO_MODULE&quot;' &quot;$(_SwiftAbiJsonPath)&quot; &amp;&amp; echo true || echo false"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftAbiJsonIsDegenerate" />
    </Exec>
    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'Swift' AND '$(_SwiftBindingUpToDate)' != 'true' AND '$(_SwiftAbiJsonIsDegenerate)' == 'true'"
           Code="SWIFTBIND038"
           Text="swift-api-digester produced an empty module dump for '$(_SwiftAppleFrameworkModule)' at target '$(_SwiftDigesterTarget)'. The target triple is likely invalid for this platform (macOS, iOS, tvOS, and Mac Catalyst use different version trains — e.g. iOS 16.1 is not a valid macOS version; macOS is on 13.x-26.x). Add per-platform metadata to the &lt;SwiftAppleFrameworkTarget&gt; item — &lt;MinIOSVersion&gt;, &lt;MinMacOSVersion&gt;, &lt;MinTvOSVersion&gt;, &lt;MinMacCatalystVersion&gt; — or set &lt;MinDeploymentVersion&gt; to a value valid on every targeted platform. The .swiftinterface is fine; this is a digester-invocation issue, not a BUILD_LIBRARY_FOR_DISTRIBUTION problem." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2d: Generate bindings for Apple-framework (direct mode)         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_GenerateSwiftBindingsAppleFramework"
          BeforeTargets="ResolveProjectReferences"
          DependsOnTargets="_SynthesizeAppleFrameworkXcframework;_DumpAppleFrameworkAbi;_CollectSwiftModuleDatabases">

    <!-- F62 wiring tripwire: stamp that this unconditional Apple-framework generate hook
         fired. It shares the ResolveProjectReferences anchor with _GenerateSwiftBindings,
         so a shared-anchor rename is already caught by that target's stamp; this dedicated
         stamp additionally catches an independent rename of THIS hook's anchor. It is the
         real codegen hook in AppleFramework mode (where _GenerateSwiftBindings is a no-op),
         so _AssertSwiftBindingHookWiring asserts this stamp only under AppleFramework mode. -->
    <PropertyGroup>
      <_SwiftHookRan_GenerateSwiftBindingsAppleFramework>true</_SwiftHookRan_GenerateSwiftBindingsAppleFramework>
    </PropertyGroup>

    <!-- Build direct-mode generator command (gated on fingerprint + Swift mode).
         ObjC mode uses the second PropertyGroup below (xcframework + objc flags). -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'Swift' AND '$(_SwiftBindingUpToDate)' != 'true'">
      <_SwiftGenCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -a "$(_SwiftBindingIntermediateDir)$(_SwiftAppleFrameworkModule).abi.json"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -d "$(_SwiftAppleFrameworkTbd)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -t "$(_SwiftAppleFrameworkTbd)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -s "$(_SwiftAppleFrameworkInterface)"</_SwiftGenCmd>
      <!-- Escape leading @ for CLI response-file handling (\@ → @) -->
      <_SwiftGenCmd Condition="$([System.String]::Copy('%(SwiftAppleFrameworkTarget.LibraryPath)').StartsWith('@'))">$(_SwiftGenCmd) -l "\%(SwiftAppleFrameworkTarget.LibraryPath)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="!$([System.String]::Copy('%(SwiftAppleFrameworkTarget.LibraryPath)').StartsWith('@'))">$(_SwiftGenCmd) -l "%(SwiftAppleFrameworkTarget.LibraryPath)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --platform $(_SwiftBindingPlatform)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftGenCmd) --platform-target $(SwiftPlatformTarget)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --platform-version $(SwiftAppleFrameworkPlatformVersion)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --swift-runtime-version $(SwiftRuntimeVersion)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftGenCmd>
      <!-- Apple direct mode shares the wrapper CPU-arch decision with xcframework mode
           (constraints.md "Wrapper CPU-arch decision is shared, not per-call-site"). Without
           this flag the generator falls back to a single arm64 wrapper compile and the resulting
           xcframework's simulator slice advertises only arm64, so an iossimulator-x64 /
           tvossimulator-x64 / osx-x64 / maccatalyst-x64 consumer fails NativeReference lookup
           with "No matching framework found … SupportedArchitectures: x86_64". SwiftTargetArchitectures
           is already echoed into the Apple fingerprint below, so flipping arm64 ↔ auto ↔ x86_64
           correctly invalidates _SwiftWrapperSkip. -->
      <_SwiftGenCmd Condition="'$(SwiftTargetArchitectures)' != ''">$(_SwiftGenCmd) --target-architectures $(SwiftTargetArchitectures)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(PackageId)' != ''">$(_SwiftGenCmd) --package-id "$(PackageId)"</_SwiftGenCmd>
      <!-- Root the ILLink descriptor under this project's own assembly (see _GenerateSwiftBindings). -->
      <_SwiftGenCmd Condition="'$(AssemblyName)' != ''">$(_SwiftGenCmd) --assembly-name "$(AssemblyName)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftAppleFrameworkTarget.NamespacePattern)' != ''">$(_SwiftGenCmd) --namespace-pattern "%(SwiftAppleFrameworkTarget.NamespacePattern)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(SwiftAppleSupplementPrototypeDir)' != ''">$(_SwiftGenCmd) --apple-supplement-prototype-dir "$(SwiftAppleSupplementPrototypeDir)"</_SwiftGenCmd>
      <!-- Cross-framework dependency module databases (e.g., RealityKit consuming
           RealityFoundation's RealityFoundationDatabase.xml). Without this, the
           generator can't resolve umbrella references back to their source module
           and emits qualified type names rooted at the wrong namespace. -->
      <_SwiftGenCmd Condition="'@(_SwiftModuleDatabaseFile)' != ''">$(_SwiftGenCmd) @(_SwiftModuleDatabaseFile->' --module-database "%(Identity)"', '')</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --apple-version $(SwiftAppleSupplementVersion)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --sdk-mode -v $(SwiftGeneratorVerbosity)</_SwiftGenCmd>
    </PropertyGroup>

    <!-- ObjC framework: feed the synthesized xcframework + the objc flag.
         The generator's ObjC pipeline reads the slice's Headers/ and
         module.modulemap via clang. swift-api-digester and the swiftinterface/tbd
         do not apply. The generator's ObjCMetadataPropsEmitter writes a starter
         binding-metadata.props with extracted plist values; the SDK synthesis
         block below INTENTIONALLY overwrites it for AppleFramework mode with
         the authoritative SDK-side values (user-declared MinDeploymentVersion
         from SwiftAppleFrameworkTarget item metadata, $(Version) from the
         consumer project, filesystem-probed wrapper presence). For Apple system
         frameworks the generator has no real package version or plist to read,
         so the SDK values are the ground truth. The _SwiftBindingFrameworkType
         field in the emitted props lets downstream consumers distinguish Swift
         vs ObjC modes without re-probing. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftAppleFrameworkType)' == 'ObjC' AND '$(_SwiftBindingUpToDate)' != 'true'">
      <_SwiftGenCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --xcframework "$(_SwiftAppleFrameworkSynthXcfw)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --objc</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --platform $(_SwiftBindingPlatform)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftGenCmd) --platform-target $(SwiftPlatformTarget)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --platform-version $(SwiftAppleFrameworkPlatformVersion)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --swift-runtime-version $(SwiftRuntimeVersion)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(PackageId)' != ''">$(_SwiftGenCmd) --package-id "$(PackageId)"</_SwiftGenCmd>
      <!-- Root the ILLink descriptor under this project's own assembly (see _GenerateSwiftBindings). -->
      <_SwiftGenCmd Condition="'$(AssemblyName)' != ''">$(_SwiftGenCmd) --assembly-name "$(AssemblyName)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftAppleFrameworkTarget.NamespacePattern)' != ''">$(_SwiftGenCmd) --namespace-pattern "%(SwiftAppleFrameworkTarget.NamespacePattern)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'@(_SwiftModuleDatabaseFile)' != ''">$(_SwiftGenCmd) @(_SwiftModuleDatabaseFile->' --module-database "%(Identity)"', '')</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --apple-version $(SwiftAppleSupplementVersion)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --sdk-mode -v $(SwiftGeneratorVerbosity)</_SwiftGenCmd>
    </PropertyGroup>

    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftBindingUpToDate)' != 'true'"
          Command="$(_SwiftGenCmd)" ConsoleToMSBuild="true"
          EnvironmentVariables="$(_SwiftGeneratorEnv)"
          StandardOutputImportance="low" StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true" />

    <!-- Write binding-metadata.props for downstream SDK targets.
         The generator in direct mode does not emit this file, so the SDK
         synthesizes it from known values. Wrapper status is determined by
         checking whether the generator produced the xcframework directory.

         This step is NOT gated on _SwiftBindingUpToDate: GetNativeManifest is
         called from every consumer build (including ProjectReference
         consumers whose own fingerprint is unrelated to this binding's), so
         binding-metadata.props must be present even when the generator was
         skipped as up-to-date. A missing props file would make
         GetNativeManifest return nothing, silently dropping the wrapper
         xcframework NativeReference from the consumer's app bundle and
         surfacing as a DllNotFoundException at runtime. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_WrapperModule>$(_SwiftAppleFrameworkModule)SwiftBindings</_AFW_WrapperModule>
      <_AFW_WrapperPath>$(_SwiftBindingIntermediateDir)$(_AFW_WrapperModule).xcframework</_AFW_WrapperPath>
      <_AFW_BridgeModule>$(_SwiftAppleFrameworkModule)Bridge</_AFW_BridgeModule>
      <_AFW_BridgePath>$(_SwiftBindingIntermediateDir)$(_AFW_BridgeModule).xcframework</_AFW_BridgePath>
    </PropertyGroup>

    <!-- Heal a second-slice swap that a SIGKILL interrupted mid-commit. The
         _CompileAppleFramework{,Bridge}Second*Slice targets commit the merged fat
         xcframework by parking the live tree at a '.superseded' sibling, moving the
         merged tree into place, then dropping the aside (see those targets). An
         interrupt between the two moves leaves the primary path empty with the
         original parked at '.superseded'. The fingerprint stamp is written during
         generation — BEFORE the swap — so the next build is "up-to-date", the
         second-slice merge/swap is skipped (gated on _SwiftBindingUpToDate), and the
         presence probe just below (which is NOT up-to-date gated) would otherwise see
         no xcframework, record _SwiftBindingHas*XCFramework False, and drop the
         consumer NativeReference -> DllNotFoundException. Recovery runs here, BEFORE
         that probe and on EVERY build, to close that window.

         WRAPPER and BRIDGE are handled ASYMMETRICALLY because their failure contracts
         differ:
         - WRAPPER: a missing wrapper is CATASTROPHIC (the whole binding DllNotFounds)
           and there is no graceful-degrade guard. The parked '.superseded' is a
           complete, working single-slice wrapper — valid for the current platform —
           so RESTORE it (mv back). The fat second slice rebuilds on the next
           out-of-date build. This mirrors WrapperXCFrameworkMerger.MergeFatSlices'
           '.superseded' recovery. (We restore the parked single-slice original, NOT
           the staging 'merged.xcframework', because a kill mid-`xcodebuild` can leave
           staging partial while the parked original is always intact.)
         - BRIDGE: the parked '.superseded' is only ever the pre-swap single-slice
           bridge (the 2-slice fat lives solely in staging until the swap completes).
           On a simulator-bearing platform a single-slice bridge is, by deliberate
           policy, DROPPED (SWIFTBIND052 below: a primary-only bridge makes a
           device/opposite-sim consumer fail at BUILD time, which is worse than the
           non-fatal runtime DllNotFound of dropping it). So restoring it would just
           be undone by that guard. The correct recovery is therefore to leave the
           bridge MISSING — the ungated presence probe records HasBridgeXCFramework
           False and SwiftUI bridge views degrade per the SWIFTBIND052 contract until
           the next out-of-date build rebuilds the full 2-slice bridge — and only
           CLEAN the orphaned '.superseded' so it does not leak on disk. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_WrapperNeedsRecovery Condition="Exists('$(_AFW_WrapperPath).superseded') AND !Exists('$(_AFW_WrapperPath)')">true</_AFW_WrapperNeedsRecovery>
      <_AFW_BridgeNeedsRecovery Condition="Exists('$(_AFW_BridgePath).superseded') AND !Exists('$(_AFW_BridgePath)')">true</_AFW_BridgeNeedsRecovery>
    </PropertyGroup>
    <Warning Condition="'$(_AFW_WrapperNeedsRecovery)' == 'true'"
             Code="SWIFTBIND053"
             Text="Wrapper xcframework '$(_AFW_WrapperModule)' was missing while a '.superseded' sibling was present — a prior build's second-slice swap was interrupted (process killed mid-commit). Restoring the superseded xcframework so the wrapper-presence flag and consumer NativeReference stay intact; the fat second slice rebuilds on the next out-of-date build." />
    <Warning Condition="'$(_AFW_BridgeNeedsRecovery)' == 'true'"
             Code="SWIFTBIND053"
             Text="SwiftUI bridge xcframework '$(_AFW_BridgeModule)' was missing while a '.superseded' sibling was present — a prior build's second bridge-slice swap was interrupted (process killed mid-commit). The parked bridge is single-slice only, which a simulator-bearing platform drops per SWIFTBIND052, so it is left missing (SwiftUI bridge views DllNotFound until the next out-of-date build rebuilds the full bridge); clearing the stale aside. The wrapper and main bindings are unaffected." />
    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND Exists('$(_AFW_WrapperPath).superseded')"
          Command="if [ ! -d &quot;$(_AFW_WrapperPath)&quot; ]; then mv &quot;$(_AFW_WrapperPath).superseded&quot; &quot;$(_AFW_WrapperPath)&quot;; else rm -rf &quot;$(_AFW_WrapperPath).superseded&quot;; fi"
          StandardOutputImportance="low" />
    <RemoveDir Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND Exists('$(_AFW_BridgePath).superseded')"
               Directories="$(_AFW_BridgePath).superseded" />

    <!-- Native MSBuild emission — the prior heredoc-based Exec tripped MSBuild's
         expression parser on the embedded <Import ... Condition="Exists(...)" />
         literal (MSB4184 at Command parse time), blocking every Apple-framework
         build. WriteLinesToFile stays inside the evaluator and avoids any shell
         escaping / %24 gymnastics. Wrapper presence and slice count come from
         filesystem probing on items rather than embedded `find`/`wc` in a heredoc. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_HasWrapper Condition="Exists('$(_AFW_WrapperPath)')">True</_AFW_HasWrapper>
      <_AFW_HasWrapper Condition="!Exists('$(_AFW_WrapperPath)')">False</_AFW_HasWrapper>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_AFW_HasWrapper)' == 'True'">
      <_AFW_WrapperSliceDir Include="$([System.IO.Directory]::GetDirectories('$(_AFW_WrapperPath)', '*-*'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_WrapperSliceCount>@(_AFW_WrapperSliceDir->Count())</_AFW_WrapperSliceCount>
    </PropertyGroup>

    <!-- SwiftUI bridge detection (Apple direct mode). The generator compiles the bridge
         primary slice inline alongside the wrapper (BindingsGeneratorCommand Apple-direct
         path), so a <Module>Bridge.xcframework on disk here means generated SwiftUI bridge
         views are present and their @_cdecl trampolines were built. _SwiftBindingHasBridgeSwift
         keys off the generated .SwiftUIBridge.swift; _SwiftBindingHasBridgeXCFramework off the
         compiled xcframework. Both feed the bridge NativeReference / consumer-targets / pack
         wiring (the SwiftFramework path populates these via the compile-bridge-only flag; Apple mode
         has no source xcframework, so the SDK probes the filesystem like it does for the
         wrapper). Slice count is corrected after _CompileAppleFrameworkSecondBridgeSlice. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_BridgeModule>$(_SwiftAppleFrameworkModule)Bridge</_AFW_BridgeModule>
      <_AFW_BridgePath>$(_SwiftBindingIntermediateDir)$(_AFW_BridgeModule).xcframework</_AFW_BridgePath>
      <_AFW_HasBridge Condition="Exists('$(_AFW_BridgePath)')">True</_AFW_HasBridge>
      <_AFW_HasBridge Condition="!Exists('$(_AFW_BridgePath)')">False</_AFW_HasBridge>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_BridgeSwiftFile Include="$(_SwiftBindingIntermediateDir)*.SwiftUIBridge.swift" />
    </ItemGroup>
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_AFW_HasBridge)' == 'True'">
      <_AFW_BridgeSliceDir Include="$([System.IO.Directory]::GetDirectories('$(_AFW_BridgePath)', '*-*'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_HasBridgeSwift Condition="'@(_AFW_BridgeSwiftFile)' != ''">True</_AFW_HasBridgeSwift>
      <_AFW_HasBridgeSwift Condition="'@(_AFW_BridgeSwiftFile)' == ''">False</_AFW_HasBridgeSwift>
      <_AFW_BridgeSliceCount>@(_AFW_BridgeSliceDir->Count())</_AFW_BridgeSliceCount>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_AFW_MetadataLines Include="&lt;Project&gt;" />
      <_AFW_MetadataLines Include="  &lt;PropertyGroup&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingModuleName&gt;$(_SwiftAppleFrameworkModule)&lt;/_SwiftBindingModuleName&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingMinimumOSVersion&gt;$(_SwiftEffectiveMinDeploymentVersion)&lt;/_SwiftBindingMinimumOSVersion&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingPackageVersion&gt;$(Version)&lt;/_SwiftBindingPackageVersion&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingIsVersionPlaceholder&gt;False&lt;/_SwiftBindingIsVersionPlaceholder&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingHasWrapperXCFramework&gt;$(_AFW_HasWrapper)&lt;/_SwiftBindingHasWrapperXCFramework&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingWrapperModuleName&gt;$(_AFW_WrapperModule)&lt;/_SwiftBindingWrapperModuleName&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingWrapperSliceCount&gt;$(_AFW_WrapperSliceCount)&lt;/_SwiftBindingWrapperSliceCount&gt;" />
      <!-- _SwiftBindingFrameworkType lets downstream consumers (e.g., binding
           projects that import this metadata for cross-module wiring) tell
           Swift, Mixed, and ObjC AppleFramework modes apart without re-probing
           the project for SwiftFrameworkType. Empty == Swift (the default). -->
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingFrameworkType&gt;$(_SwiftAppleFrameworkType)&lt;/_SwiftBindingFrameworkType&gt;" />
      <!-- SwiftUI bridge wiring (Apple direct mode). Mirrors the wrapper flags above so
           the bridge NativeReference, consumer-targets fragment, and pack include all
           activate. HasBridgeSwift reflects generated .SwiftUIBridge.swift; HasBridgeXCFramework
           reflects the compiled <Module>Bridge.xcframework. The slice count is rewritten by
           _CompileAppleFrameworkSecondBridgeSlice once the device/fat-sim slice is merged. -->
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingHasBridgeSwift&gt;$(_AFW_HasBridgeSwift)&lt;/_SwiftBindingHasBridgeSwift&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingHasBridgeXCFramework&gt;$(_AFW_HasBridge)&lt;/_SwiftBindingHasBridgeXCFramework&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingBridgeModuleName&gt;$(_AFW_BridgeModule)&lt;/_SwiftBindingBridgeModuleName&gt;" />
      <_AFW_MetadataLines Include="    &lt;_SwiftBindingBridgeSliceCount&gt;$(_AFW_BridgeSliceCount)&lt;/_SwiftBindingBridgeSliceCount&gt;" />
      <_AFW_MetadataLines Include="  &lt;/PropertyGroup&gt;" />
      <_AFW_MetadataLines Include="  &lt;Import Project=&quot;apple-supplement.props&quot; Condition=&quot;Exists('apple-supplement.props')&quot; /&gt;" />
      <_AFW_MetadataLines Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'"
                      File="$(_SwiftBindingIntermediateDir)binding-metadata.props"
                      Lines="@(_AFW_MetadataLines)"
                      Overwrite="true" />

    <!-- Stamp the fingerprint only AFTER a successful Apple-framework generate. The
         generator Exec above has no ContinueOnError, so a failed generate aborts before
         this write and the next build re-runs generation instead of skipping it. -->
    <WriteLinesToFile File="$(_SwiftStampFile)"
                      Lines="$(_SwiftNewFingerprint)"
                      Overwrite="true"
                      Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(_SwiftBindingUpToDate)' != 'true' AND '$(_SwiftStampFile)' != ''" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2e: Compile second wrapper slice for Apple-framework pack       -->
  <!-- Apple-framework direct mode compiles one wrapper slice (default:       -->
  <!-- simulator for iOS/tvOS). NuGet pack requires both device + simulator   -->
  <!-- slices. This target compiles the other slice and rebuilds the           -->
  <!-- xcframework with both via xcodebuild -create-xcframework.              -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_CompileAppleFrameworkSecondWrapperSlice"
          AfterTargets="_GenerateSwiftBindingsAppleFramework"
          DependsOnTargets="_GenerateSwiftBindingsAppleFramework">

    <!-- Only fire for Apple-framework mode on platforms with simulators (iOS/tvOS),
         when a wrapper was produced and the build is not up-to-date. -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'
                              AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'
                              AND '$(_SwiftBindingUpToDate)' != 'true'">
      <_AFW_WrapperModule>$(_SwiftAppleFrameworkModule)SwiftBindings</_AFW_WrapperModule>
      <_AFW_XCF>$(_SwiftBindingIntermediateDir)$(_AFW_WrapperModule).xcframework</_AFW_XCF>
      <_AFW_NeedsSecondSlice>false</_AFW_NeedsSecondSlice>
      <!-- Check if the xcframework exists but only has one slice. This is an
           existence-only gate by design: if the first-slice xcframework is present
           we DO need to fold in the second slice. Whether its binary is actually a
           sound Mach-O is validated separately, right before create-xcframework
           below (the SWIFTBIND043 guard) — flipping this gate to false on a corrupt
           first slice would silently skip the merge and leave the malformed
           xcframework at the canonical path for a downstream step to consume. -->
      <_AFW_NeedsSecondSlice Condition="Exists('$(_AFW_XCF)')">true</_AFW_NeedsSecondSlice>
    </PropertyGroup>

    <!-- Determine which slice we already have and which we need.
         Default SwiftPlatformTarget for iOS/tvOS is 'simulator', so we need 'device'. -->
    <PropertyGroup Condition="'$(_AFW_NeedsSecondSlice)' == 'true'">
      <!-- Compute the "other" SDK and target triple -->
      <_AFW_OtherSdk Condition="'$(_SwiftBindingPlatform)' == 'ios'">iphoneos</_AFW_OtherSdk>
      <_AFW_OtherSdk Condition="'$(_SwiftBindingPlatform)' == 'tvos'">appletvos</_AFW_OtherSdk>
      <_AFW_OtherSdk Condition="'$(SwiftPlatformTarget)' != 'simulator'
                                AND '$(_SwiftBindingPlatform)' == 'ios'">iphonesimulator</_AFW_OtherSdk>
      <_AFW_OtherSdk Condition="'$(SwiftPlatformTarget)' != 'simulator'
                                AND '$(_SwiftBindingPlatform)' == 'tvos'">appletvsimulator</_AFW_OtherSdk>

      <_AFW_OtherTarget Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator'">arm64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)</_AFW_OtherTarget>
      <_AFW_OtherTarget Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' != 'simulator'">arm64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)-simulator</_AFW_OtherTarget>
      <_AFW_OtherTarget Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator'">arm64-apple-tvos$(_SwiftEffectiveMinDeploymentVersion)</_AFW_OtherTarget>
      <_AFW_OtherTarget Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' != 'simulator'">arm64-apple-tvos$(_SwiftEffectiveMinDeploymentVersion)-simulator</_AFW_OtherTarget>

      <!-- When the second slice IS the simulator (device-first config: SwiftPlatformTarget=device),
           Apple system frameworks ship arm64+x86_64 sim slices, so the wrapper second slice must
           be fat too — otherwise iossimulator-x64 / tvossimulator-x64 consumers fail
           NativeReference resolution. The generator already writes both .arm64.s and .x86_64.s
           thunk sources regardless of platform target, so the second arch is just one more
           swiftc + clang pass plus a lipo -create. The fat-fold fires whenever the user's wrapper
           contract covers x86_64 — auto / all / empty (defaults to auto), or an explicit list that
           includes x86_64 (e.g. arm64,x86_64). A single-arch pin (arm64 alone, or x86_64 alone)
           pins the wrapper contract on the user's side and skips the fold. -->
      <_AFW_OtherIsFatSim>false</_AFW_OtherIsFatSim>
      <_AFW_OtherIsFatSim Condition="('$(_AFW_OtherSdk)' == 'iphonesimulator' OR '$(_AFW_OtherSdk)' == 'appletvsimulator')
                                     AND ('$(SwiftTargetArchitectures)' == ''
                                          OR '$(SwiftTargetArchitectures)' == 'auto'
                                          OR '$(SwiftTargetArchitectures)' == 'all'
                                          OR $(SwiftTargetArchitectures.Contains('x86_64')))">true</_AFW_OtherIsFatSim>

      <_AFW_OtherSecondTarget Condition="'$(_AFW_OtherIsFatSim)' == 'true' AND '$(_SwiftBindingPlatform)' == 'ios'">x86_64-apple-ios$(_SwiftEffectiveMinDeploymentVersion)-simulator</_AFW_OtherSecondTarget>
      <_AFW_OtherSecondTarget Condition="'$(_AFW_OtherIsFatSim)' == 'true' AND '$(_SwiftBindingPlatform)' == 'tvos'">x86_64-apple-tvos$(_SwiftEffectiveMinDeploymentVersion)-simulator</_AFW_OtherSecondTarget>

      <!-- The slice directory name in the xcframework -->
      <_AFW_OtherSliceId Condition="'$(SwiftPlatformTarget)' == 'simulator'">$(_SwiftBindingDeviceSliceId)</_AFW_OtherSliceId>
      <_AFW_OtherSliceId Condition="'$(SwiftPlatformTarget)' != 'simulator'">$(_SwiftBindingSimulatorSliceId)</_AFW_OtherSliceId>
    </PropertyGroup>

    <!-- Resolve the SDK path for the other slice -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="xcrun --sdk $(_AFW_OtherSdk) --show-sdk-path 2>/dev/null"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_OtherSdkPath" />
    </Exec>

    <!-- Find the wrapper Swift source files -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="find &quot;$(_SwiftBindingIntermediateDir)&quot; -maxdepth 1 \( -name '*.Wrapper.swift' -o -name '*.Wrapper.Thunk.swift' \) | tr '\n' ' '"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_WrapperSwiftFiles" />
    </Exec>

    <!-- Build the second wrapper slice and merge both into a new xcframework.
         The original xcframework stays intact until the merge succeeds, so a
         failed compilation or merge doesn't leave the build in an unrecoverable
         state — the next build attempt can retry cleanly. -->
    <MakeDir Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
             Directories="$(_SwiftBindingIntermediateDir)_merge_slices/second/$(_AFW_WrapperModule).framework" />

    <!-- Find the first slice's framework dir from the ORIGINAL xcframework (still in place) -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="find &quot;$(_AFW_XCF)&quot; -maxdepth 2 -name '$(_AFW_WrapperModule).framework' -type d | head -1"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_FirstSliceFramework" />
    </Exec>

    <!-- Compile NativeThunk thunk files for the second slice.
         The generator's first-slice compile wrote .arm64.o objects for its own
         target (e.g. simulator); reusing them in the device link would embed
         simulator-platform LC_BUILD_VERSION and the symbols would still be
         missing at device runtime. Rebuild each .arm64.s (and .x86_64.s when
         fat-sim) against the second slice's target triple + SDK, writing to a
         per-arch subdir so the first-slice .o files are preserved. Mirrors
         NativeThunkCompiler.CompileThunkObjects.

         Remove the staging dir before rebuilding so leftovers from a prior
         failed run (which never reached the _merge_slices cleanup below) or
         thunks whose source .arm64.s has since been removed cannot be picked
         up by the trailing `find '*.o'` and silently linked into this slice. -->
    <PropertyGroup Condition="'$(_AFW_NeedsSecondSlice)' == 'true'">
      <_AFW_SecondSliceThunkDir>$(_SwiftBindingIntermediateDir)_merge_slices/second/thunks</_AFW_SecondSliceThunkDir>
      <_AFW_SecondSliceThunkArm64Dir>$(_AFW_SecondSliceThunkDir)/arm64</_AFW_SecondSliceThunkArm64Dir>
      <_AFW_SecondSliceThunkX64Dir>$(_AFW_SecondSliceThunkDir)/x86_64</_AFW_SecondSliceThunkX64Dir>
    </PropertyGroup>
    <RemoveDir Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
               Directories="$(_AFW_SecondSliceThunkDir)" />
    <MakeDir Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
             Directories="$(_AFW_SecondSliceThunkArm64Dir)" />
    <MakeDir Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
             Directories="$(_AFW_SecondSliceThunkX64Dir)" />

    <!-- arm64 thunks (always) -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="set -e; for f in `find &quot;$(_SwiftBindingIntermediateDir)&quot; -maxdepth 1 -name '*.arm64.s'`; do xcrun --sdk $(_AFW_OtherSdk) clang -c &quot;$f&quot; -target $(_AFW_OtherTarget) -isysroot &quot;$(_AFW_OtherSdkPath)&quot; -o &quot;$(_AFW_SecondSliceThunkArm64Dir)/`basename &quot;$f&quot; .s`.o&quot;; done; find &quot;$(_AFW_SecondSliceThunkArm64Dir)&quot; -maxdepth 1 -name '*.o' | tr '\n' ' '"
          ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="high">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_SecondSliceArm64ThunkObjects" />
    </Exec>

    <!-- x86_64 thunks (only when fat-sim) -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
          Command="set -e; for f in `find &quot;$(_SwiftBindingIntermediateDir)&quot; -maxdepth 1 -name '*.x86_64.s'`; do xcrun --sdk $(_AFW_OtherSdk) clang -c &quot;$f&quot; -target $(_AFW_OtherSecondTarget) -isysroot &quot;$(_AFW_OtherSdkPath)&quot; -o &quot;$(_AFW_SecondSliceThunkX64Dir)/`basename &quot;$f&quot; .s`.o&quot;; done; find &quot;$(_AFW_SecondSliceThunkX64Dir)&quot; -maxdepth 1 -name '*.o' | tr '\n' ' '"
          ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="high">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_SecondSliceX64ThunkObjects" />
    </Exec>

    <!-- When thunk .o files exist the linker needs -framework <OriginalModule>
         so that `bl` targets inside the thunk assembly (Tj dispatch thunks,
         type metadata accessors) resolve. Mirrors the thunkLinkerFlags branch
         in SwiftWrapperCompiler.InvokeSwiftCompiler. The arm64 set is the
         authoritative signal (x86_64 is a strict subset — see
         ModuleEmitter.cs's comment "x86_64 set may be a strict subset"). -->
    <PropertyGroup Condition="'$(_AFW_NeedsSecondSlice)' == 'true'">
      <_AFW_SecondSliceThunkFrameworkFlag Condition="'$(_AFW_SecondSliceArm64ThunkObjects.Trim())' != ''">-Xlinker -framework -Xlinker $(_SwiftAppleFrameworkModule) </_AFW_SecondSliceThunkFrameworkFlag>
    </PropertyGroup>

    <!-- Single-arch compile: emit the framework binary directly (default sim-first
         flow where the second slice is the device-arm64-only slice, or device-first
         flow when the user pinned SwiftTargetArchitectures). -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' != 'true'"
          Command="xcrun --sdk $(_AFW_OtherSdk) swiftc -emit-library -target $(_AFW_OtherTarget) -sdk &quot;$(_AFW_OtherSdkPath)&quot; -strict-concurrency=minimal -module-name $(_AFW_WrapperModule) $(_AFW_SecondSliceThunkFrameworkFlag)-Xlinker -install_name -Xlinker @rpath/$(_AFW_WrapperModule).framework/$(_AFW_WrapperModule) -o &quot;$(_SwiftBindingIntermediateDir)_merge_slices/second/$(_AFW_WrapperModule).framework/$(_AFW_WrapperModule)&quot; $(_AFW_WrapperSwiftFiles) $(_AFW_SecondSliceArm64ThunkObjects)"
          StandardOutputImportance="low" StandardErrorImportance="high" />

    <!-- Fat-sim compile: swiftc per-arch into per-arch staging dylibs, then lipo
         -create them into the framework binary. xcodebuild -create-xcframework
         (the merge below) detects the fat arches via lipo-inspect and names the
         slice dir accordingly (e.g. ios-arm64_x86_64-simulator); _ResyncWrapperSliceIds
         re-reads that name post-merge so validation/consumer-synth see the
         correct id. The install_name + linker flags must match across arches —
         lipo only combines per-arch slices; it does not reconcile load commands. -->
    <PropertyGroup Condition="'$(_AFW_OtherIsFatSim)' == 'true'">
      <_AFW_SecondSliceStagingDir>$(_SwiftBindingIntermediateDir)_merge_slices/second/staging</_AFW_SecondSliceStagingDir>
      <_AFW_SecondSliceArm64Lib>$(_AFW_SecondSliceStagingDir)/$(_AFW_WrapperModule).arm64</_AFW_SecondSliceArm64Lib>
      <_AFW_SecondSliceX64Lib>$(_AFW_SecondSliceStagingDir)/$(_AFW_WrapperModule).x86_64</_AFW_SecondSliceX64Lib>
    </PropertyGroup>
    <MakeDir Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
             Directories="$(_AFW_SecondSliceStagingDir)" />
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
          Command="xcrun --sdk $(_AFW_OtherSdk) swiftc -emit-library -target $(_AFW_OtherTarget) -sdk &quot;$(_AFW_OtherSdkPath)&quot; -strict-concurrency=minimal -module-name $(_AFW_WrapperModule) $(_AFW_SecondSliceThunkFrameworkFlag)-Xlinker -install_name -Xlinker @rpath/$(_AFW_WrapperModule).framework/$(_AFW_WrapperModule) -o &quot;$(_AFW_SecondSliceArm64Lib)&quot; $(_AFW_WrapperSwiftFiles) $(_AFW_SecondSliceArm64ThunkObjects)"
          StandardOutputImportance="low" StandardErrorImportance="high" />
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
          Command="xcrun --sdk $(_AFW_OtherSdk) swiftc -emit-library -target $(_AFW_OtherSecondTarget) -sdk &quot;$(_AFW_OtherSdkPath)&quot; -strict-concurrency=minimal -module-name $(_AFW_WrapperModule) $(_AFW_SecondSliceThunkFrameworkFlag)-Xlinker -install_name -Xlinker @rpath/$(_AFW_WrapperModule).framework/$(_AFW_WrapperModule) -o &quot;$(_AFW_SecondSliceX64Lib)&quot; $(_AFW_WrapperSwiftFiles) $(_AFW_SecondSliceX64ThunkObjects)"
          StandardOutputImportance="low" StandardErrorImportance="high" />
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
          Command="lipo -create &quot;$(_AFW_SecondSliceArm64Lib)&quot; &quot;$(_AFW_SecondSliceX64Lib)&quot; -output &quot;$(_SwiftBindingIntermediateDir)_merge_slices/second/$(_AFW_WrapperModule).framework/$(_AFW_WrapperModule)&quot;"
          StandardOutputImportance="low" StandardErrorImportance="high" />

    <!-- Write the second slice's embedded .framework/Info.plist before xcodebuild
         -create-xcframework merges it. `swiftc -emit-library` above only produces
         a Mach-O binary; the first slice carries an Info.plist written by
         SwiftWrapperCompiler.WriteFrameworkPlist in the generator, so without this
         step the merged xcframework's device slice ships without one and iOS
         rejects the app at install time with
         MICreateCFBundleEnforcingInfoPlistSize (com.apple.dt.CoreDeviceError 3002).
         Template mirrors SwiftWrapperCompiler.WriteFrameworkPlist; the only slice-
         specific field is CFBundleSupportedPlatforms. -->
    <PropertyGroup Condition="'$(_AFW_NeedsSecondSlice)' == 'true'">
      <_AFW_OtherPlatformName Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' == 'simulator'">iPhoneOS</_AFW_OtherPlatformName>
      <_AFW_OtherPlatformName Condition="'$(_SwiftBindingPlatform)' == 'ios' AND '$(SwiftPlatformTarget)' != 'simulator'">iPhoneSimulator</_AFW_OtherPlatformName>
      <_AFW_OtherPlatformName Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' == 'simulator'">AppleTVOS</_AFW_OtherPlatformName>
      <_AFW_OtherPlatformName Condition="'$(_SwiftBindingPlatform)' == 'tvos' AND '$(SwiftPlatformTarget)' != 'simulator'">AppleTVSimulator</_AFW_OtherPlatformName>
      <_AFW_OtherMinOsVersion>$(_SwiftEffectiveMinDeploymentVersion)</_AFW_OtherMinOsVersion>
    </PropertyGroup>

    <ItemGroup Condition="'$(_AFW_NeedsSecondSlice)' == 'true'">
      <_AFW_SecondSlicePlistLines Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;" />
      <_AFW_SecondSlicePlistLines Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
      <_AFW_SecondSlicePlistLines Include="&lt;plist version=&quot;1.0&quot;&gt;" />
      <_AFW_SecondSlicePlistLines Include="&lt;dict&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleIdentifier&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;string&gt;com.swiftbindings.$(_AFW_WrapperModule)&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleName&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;string&gt;$(_AFW_WrapperModule)&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleExecutable&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;string&gt;$(_AFW_WrapperModule)&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;CFBundlePackageType&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;string&gt;FMWK&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleVersion&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;string&gt;1.0&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleShortVersionString&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;string&gt;1.0&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;MinimumOSVersion&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;string&gt;$(_AFW_OtherMinOsVersion)&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleSupportedPlatforms&lt;/key&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;array&gt;" />
      <_AFW_SecondSlicePlistLines Include="        &lt;string&gt;$(_AFW_OtherPlatformName)&lt;/string&gt;" />
      <_AFW_SecondSlicePlistLines Include="    &lt;/array&gt;" />
      <_AFW_SecondSlicePlistLines Include="&lt;/dict&gt;" />
      <_AFW_SecondSlicePlistLines Include="&lt;/plist&gt;" />
    </ItemGroup>

    <WriteLinesToFile Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
                      File="$(_SwiftBindingIntermediateDir)_merge_slices/second/$(_AFW_WrapperModule).framework/Info.plist"
                      Lines="@(_AFW_SecondSlicePlistLines)"
                      Overwrite="true" />

    <!-- Drop any stale staging 'merged.xcframework' from a prior interrupted build
         BEFORE the create. xcodebuild -create-xcframework refuses to overwrite an
         existing output, so a leftover tree would otherwise hard-fail this merge;
         and (for the bridge's ContinueOnError create below) a stale tree would be
         mistaken for THIS build's success and committed. -->
    <RemoveDir Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
               Directories="$(_SwiftBindingIntermediateDir)_merge_slices/merged.xcframework" />

    <!-- Defense-in-depth: validate BOTH input framework binaries are real,
         non-empty Mach-O images before handing them to xcodebuild
         -create-xcframework. The _AFW_NeedsSecondSlice gate above only checks that
         the first-slice xcframework DIRECTORY exists, not that its binary is sound.
         A contended CI runner can leave a prior build's first-slice framework
         half-written (binary missing, or truncated after a killed swiftc); the
         existence-only gate then passes the corrupt slice straight into
         create-xcframework, which dies with an opaque exit 70. lipo -info is the
         deterministic Apple-native probe — it reads the Mach-O header / fat arch
         table and exits non-zero on a missing, empty, or non-Mach-O file. Surfacing
         the failure here converts the cryptic xcodebuild crash into an actionable
         diagnostic that names the bad input. -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="bad=''; for bin in &quot;$(_AFW_FirstSliceFramework)/$(_AFW_WrapperModule)&quot; &quot;$(_SwiftBindingIntermediateDir)_merge_slices/second/$(_AFW_WrapperModule).framework/$(_AFW_WrapperModule)&quot;; do if [ ! -s &quot;$bin&quot; ] || ! lipo -info &quot;$bin&quot; &gt;/dev/null 2&gt;&amp;1; then bad=&quot;$bad$bin &quot;; fi; done; if [ -n &quot;$bad&quot; ]; then echo &quot;INVALID: $bad&quot;; fi"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_InvalidWrapperBinaries" />
    </Exec>

    <Error Condition="'$(_AFW_NeedsSecondSlice)' == 'true' AND $(_AFW_InvalidWrapperBinaries.Contains('INVALID:'))"
           Code="SWIFTBIND043"
           Text="The Swift wrapper xcframework for '$(_AFW_WrapperModule)' has a missing or corrupt Mach-O binary, so the device/simulator slice merge cannot proceed: $(_AFW_InvalidWrapperBinaries). This usually means a wrapper compile was killed mid-write (e.g. a swiftc timeout on a contended CI runner). Delete the intermediate directory '$(_SwiftBindingIntermediateDir)' and rebuild; if it recurs, raise the wrapper compile timeout via &lt;SwiftWrapperCompileTimeoutSeconds&gt; (whole seconds)." />

    <!-- Merge both slices into a NEW staging xcframework (original still intact) -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="xcodebuild -create-xcframework -framework &quot;$(_AFW_FirstSliceFramework)&quot; -framework &quot;$(_SwiftBindingIntermediateDir)_merge_slices/second/$(_AFW_WrapperModule).framework&quot; -output &quot;$(_SwiftBindingIntermediateDir)_merge_slices/merged.xcframework&quot;"
          StandardOutputImportance="low" StandardErrorImportance="high" />

    <!-- Merge succeeded — now commit atomically and recoverably. Park the live
         xcframework at a '.superseded' sibling (instead of deleting it outright),
         move the merged fat tree into place, then drop the aside. A SIGKILL between
         the two moves leaves the complete original parked at '.superseded', which
         the recovery block in _GenerateSwiftBindingsAppleFramework restores on the
         next build (before the wrapper-presence probe) — so no window ever leaves
         the primary path empty AND unrecoverable (the state that drops the consumer
         NativeReference and yields DllNotFoundException). A failed move-in rolls the
         original back from '.superseded' and fails the build. Single Exec so the
         whole swap is one shell process, not two interruptible MSBuild tasks. -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="set -e; rm -rf &quot;$(_AFW_XCF).superseded&quot;; mv &quot;$(_AFW_XCF)&quot; &quot;$(_AFW_XCF).superseded&quot;; mv &quot;$(_SwiftBindingIntermediateDir)_merge_slices/merged.xcframework&quot; &quot;$(_AFW_XCF)&quot; || { mv &quot;$(_AFW_XCF).superseded&quot; &quot;$(_AFW_XCF)&quot;; exit 1; }; rm -rf &quot;$(_AFW_XCF).superseded&quot;"
          StandardOutputImportance="low" />

    <!-- Clean up staging directory -->
    <RemoveDir Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
               Directories="$(_SwiftBindingIntermediateDir)_merge_slices" />

    <!-- Update binding-metadata.props with correct slice count -->
    <Exec Condition="'$(_AFW_NeedsSecondSlice)' == 'true'"
          Command="SLICES=`find &quot;$(_AFW_XCF)&quot; -maxdepth 1 -type d -name '*-*' | wc -l | tr -d ' '`; \
sed -i '' &quot;s|_SwiftBindingWrapperSliceCount&gt;[0-9]*|_SwiftBindingWrapperSliceCount&gt;%24SLICES|&quot; &quot;$(_SwiftBindingIntermediateDir)binding-metadata.props&quot;"
          StandardOutputImportance="low" />

    <!-- Slice-id resync after the fat fold lives in _ResyncWrapperSliceIds
         (runs unconditionally per build via AfterTargets="_CompileAppleFrameworkSecondWrapperSlice").
         Keeping the resync there — rather than inline here — ensures incremental packs
         that skip this target (gated on _SwiftBindingUpToDate) still see the on-disk slice
         names instead of falling back to stale single-arch property defaults. -->
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2e': Compile second bridge slice for Apple-framework pack        -->
  <!-- The generator compiles the SwiftUI <Module>Bridge primary slice inline   -->
  <!-- (same arch coverage as the wrapper primary slice). Like the wrapper,     -->
  <!-- NuGet pack needs both device + simulator slices, so this target builds    -->
  <!-- the other slice and re-merges. It is a thunk-free analog of               -->
  <!-- _CompileAppleFrameworkSecondWrapperSlice: the bridge has no Tj dispatch    -->
  <!-- thunks or metadata-accessor assembly, so there is no per-arch thunk        -->
  <!-- rebuild and no -framework <OriginalModule> linker flag — the bridge's      -->
  <!-- `import SwiftUI` / `import <Framework>` auto-link the system frameworks    -->
  <!-- via the -sdk default search path (the same reason the wrapper second slice -->
  <!-- omits -F). It reuses the _AFW_Other* slice params the wrapper second-slice  -->
  <!-- target persisted this build: bridge presence implies wrapper presence, and  -->
  <!-- both gate on the same _SwiftBindingUpToDate, so they run in lockstep with    -->
  <!-- the wrapper computing those first (declared earlier, same AfterTargets).     -->
  <!-- The '$(_AFW_OtherSdk)' != '' guard degrades the bridge to a primary-only      -->
  <!-- slice if that ever fails to hold. The incomplete bridge is then dropped and   -->
  <!-- reported as SWIFTBIND052 — an error by default, or a warning under            -->
  <!-- SwiftBridgeRequired=false; see the diagnostic pair at the end of this target. -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_CompileAppleFrameworkSecondBridgeSlice"
          AfterTargets="_CompileAppleFrameworkSecondWrapperSlice"
          DependsOnTargets="_GenerateSwiftBindingsAppleFramework">

    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'
                              AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'
                              AND '$(_SwiftBindingUpToDate)' != 'true'">
      <_AFB_XCF>$(_AFW_BridgePath)</_AFB_XCF>
      <_AFB_NeedsSecondSlice>false</_AFB_NeedsSecondSlice>
      <!-- Only when the bridge xcframework was produced (framework has SwiftUI views)
           and the wrapper target computed the "other" slice params this build. -->
      <_AFB_NeedsSecondSlice Condition="Exists('$(_AFB_XCF)') AND '$(_AFW_OtherSdk)' != ''">true</_AFB_NeedsSecondSlice>
    </PropertyGroup>

    <!-- Glob the bridge Swift sources (no thunk sources exist for the bridge). -->
    <Exec Condition="'$(_AFB_NeedsSecondSlice)' == 'true'"
          Command="find &quot;$(_SwiftBindingIntermediateDir)&quot; -maxdepth 1 -name '*.SwiftUIBridge.swift' | tr '\n' ' '"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFB_BridgeSwiftFiles" />
    </Exec>

    <!-- Stage the second slice's framework dir; original xcframework stays intact
         until the merge succeeds. -->
    <MakeDir Condition="'$(_AFB_NeedsSecondSlice)' == 'true'"
             Directories="$(_SwiftBindingIntermediateDir)_bridge_merge_slices/second/$(_AFW_BridgeModule).framework" />

    <!-- Find the first slice's framework dir from the ORIGINAL bridge xcframework. -->
    <Exec Condition="'$(_AFB_NeedsSecondSlice)' == 'true'"
          Command="find &quot;$(_AFB_XCF)&quot; -maxdepth 2 -name '$(_AFW_BridgeModule).framework' -type d | head -1"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFB_FirstSliceFramework" />
    </Exec>

    <!-- Single-arch compile: emit the framework binary directly (default sim-first
         flow where the second slice is device-arm64-only, or device-first flow when
         the user pinned SwiftTargetArchitectures). No thunk objects, no
         -framework <OriginalModule> — bridge imports auto-link the system frameworks. -->
    <Exec Condition="'$(_AFB_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' != 'true'"
          Command="xcrun --sdk $(_AFW_OtherSdk) swiftc -emit-library -target $(_AFW_OtherTarget) -sdk &quot;$(_AFW_OtherSdkPath)&quot; -strict-concurrency=minimal -module-name $(_AFW_BridgeModule) -Xlinker -install_name -Xlinker @rpath/$(_AFW_BridgeModule).framework/$(_AFW_BridgeModule) -o &quot;$(_SwiftBindingIntermediateDir)_bridge_merge_slices/second/$(_AFW_BridgeModule).framework/$(_AFW_BridgeModule)&quot; $(_AFB_BridgeSwiftFiles)"
          StandardOutputImportance="low" StandardErrorImportance="high"
          ContinueOnError="true" />

    <!-- Fat-sim compile: swiftc per-arch into per-arch staging dylibs, then lipo
         -create into the framework binary (device-first flow where the second slice
         is the arm64+x86_64 simulator). Mirrors the wrapper fat-sim fold minus thunks. -->
    <PropertyGroup Condition="'$(_AFB_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'">
      <_AFB_SecondSliceStagingDir>$(_SwiftBindingIntermediateDir)_bridge_merge_slices/second/staging</_AFB_SecondSliceStagingDir>
      <_AFB_SecondSliceArm64Lib>$(_AFB_SecondSliceStagingDir)/$(_AFW_BridgeModule).arm64</_AFB_SecondSliceArm64Lib>
      <_AFB_SecondSliceX64Lib>$(_AFB_SecondSliceStagingDir)/$(_AFW_BridgeModule).x86_64</_AFB_SecondSliceX64Lib>
    </PropertyGroup>
    <MakeDir Condition="'$(_AFB_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
             Directories="$(_AFB_SecondSliceStagingDir)" />
    <Exec Condition="'$(_AFB_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
          Command="xcrun --sdk $(_AFW_OtherSdk) swiftc -emit-library -target $(_AFW_OtherTarget) -sdk &quot;$(_AFW_OtherSdkPath)&quot; -strict-concurrency=minimal -module-name $(_AFW_BridgeModule) -Xlinker -install_name -Xlinker @rpath/$(_AFW_BridgeModule).framework/$(_AFW_BridgeModule) -o &quot;$(_AFB_SecondSliceArm64Lib)&quot; $(_AFB_BridgeSwiftFiles)"
          StandardOutputImportance="low" StandardErrorImportance="high"
          ContinueOnError="true" />
    <Exec Condition="'$(_AFB_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
          Command="xcrun --sdk $(_AFW_OtherSdk) swiftc -emit-library -target $(_AFW_OtherSecondTarget) -sdk &quot;$(_AFW_OtherSdkPath)&quot; -strict-concurrency=minimal -module-name $(_AFW_BridgeModule) -Xlinker -install_name -Xlinker @rpath/$(_AFW_BridgeModule).framework/$(_AFW_BridgeModule) -o &quot;$(_AFB_SecondSliceX64Lib)&quot; $(_AFB_BridgeSwiftFiles)"
          StandardOutputImportance="low" StandardErrorImportance="high"
          ContinueOnError="true" />
    <Exec Condition="'$(_AFB_NeedsSecondSlice)' == 'true' AND '$(_AFW_OtherIsFatSim)' == 'true'"
          Command="lipo -create &quot;$(_AFB_SecondSliceArm64Lib)&quot; &quot;$(_AFB_SecondSliceX64Lib)&quot; -output &quot;$(_SwiftBindingIntermediateDir)_bridge_merge_slices/second/$(_AFW_BridgeModule).framework/$(_AFW_BridgeModule)&quot;"
          StandardOutputImportance="low" StandardErrorImportance="high"
          ContinueOnError="true" />

    <!-- Write the second slice's embedded Info.plist before xcodebuild merges it.
         Mirrors SwiftWrapperCompiler.WriteFrameworkPlist; reuses the wrapper target's
         _AFW_OtherPlatformName / _AFW_OtherMinOsVersion (same "other" slice). -->
    <ItemGroup Condition="'$(_AFB_NeedsSecondSlice)' == 'true'">
      <_AFB_SecondSlicePlistLines Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;" />
      <_AFB_SecondSlicePlistLines Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
      <_AFB_SecondSlicePlistLines Include="&lt;plist version=&quot;1.0&quot;&gt;" />
      <_AFB_SecondSlicePlistLines Include="&lt;dict&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleIdentifier&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;string&gt;com.swiftbindings.$(_AFW_BridgeModule)&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleName&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;string&gt;$(_AFW_BridgeModule)&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleExecutable&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;string&gt;$(_AFW_BridgeModule)&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;CFBundlePackageType&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;string&gt;FMWK&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleVersion&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;string&gt;1.0&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleShortVersionString&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;string&gt;1.0&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;MinimumOSVersion&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;string&gt;$(_AFW_OtherMinOsVersion)&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;key&gt;CFBundleSupportedPlatforms&lt;/key&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;array&gt;" />
      <_AFB_SecondSlicePlistLines Include="        &lt;string&gt;$(_AFW_OtherPlatformName)&lt;/string&gt;" />
      <_AFB_SecondSlicePlistLines Include="    &lt;/array&gt;" />
      <_AFB_SecondSlicePlistLines Include="&lt;/dict&gt;" />
      <_AFB_SecondSlicePlistLines Include="&lt;/plist&gt;" />
    </ItemGroup>

    <WriteLinesToFile Condition="'$(_AFB_NeedsSecondSlice)' == 'true'"
                      File="$(_SwiftBindingIntermediateDir)_bridge_merge_slices/second/$(_AFW_BridgeModule).framework/Info.plist"
                      Lines="@(_AFB_SecondSlicePlistLines)"
                      Overwrite="true" />

    <!-- Drop any stale staging 'merged.xcframework' from a prior interrupted build
         BEFORE the create. Because this create runs with ContinueOnError, the
         _AFB_MergeSucceeded check below is just Exists(merged.xcframework): a stale
         tree left by a prior kill would be mistaken for THIS build's success and
         committed over the working bridge. Removing it first makes Exists() reflect
         only this build's create. -->
    <RemoveDir Condition="'$(_AFB_NeedsSecondSlice)' == 'true'"
               Directories="$(_SwiftBindingIntermediateDir)_bridge_merge_slices/merged.xcframework" />

    <!-- Merge both slices into a NEW staging xcframework (original still intact).
         ContinueOnError so a bridge merge failure degrades non-fatally (the main
         bindings + wrapper still ship) instead of failing the whole build — but
         capture the exit code so the commit below can tell a real success from a
         failed run that happened to leave a partial 'merged.xcframework' behind. -->
    <Exec Condition="'$(_AFB_NeedsSecondSlice)' == 'true'"
          Command="xcodebuild -create-xcframework -framework &quot;$(_AFB_FirstSliceFramework)&quot; -framework &quot;$(_SwiftBindingIntermediateDir)_bridge_merge_slices/second/$(_AFW_BridgeModule).framework&quot; -output &quot;$(_SwiftBindingIntermediateDir)_bridge_merge_slices/merged.xcframework&quot;"
          StandardOutputImportance="low" StandardErrorImportance="high"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_AFB_MergeExitCode" />
    </Exec>

    <!-- Swap into place only if the merge SUCCEEDED. ContinueOnError above can
         leave a partial OR missing merge, so gate the destructive swap on BOTH
         the create's exit code being 0 AND the merged result existing — an
         Exists() check alone would treat a non-zero xcodebuild that wrote a
         partial 'merged.xcframework' as success and commit a torn tree over the
         working bridge. A failed bridge build then leaves the working
         primary-slice xcframework intact (non-fatal). The commit itself is atomic
         and recoverable (see the wrapper target's swap): park the live bridge
         xcframework aside, move the merged tree in, drop the aside; a mid-commit
         SIGKILL leaves the complete original at '.superseded' for
         _GenerateSwiftBindingsAppleFramework's recovery block to restore. -->
    <PropertyGroup Condition="'$(_AFB_NeedsSecondSlice)' == 'true'">
      <_AFB_MergeSucceeded Condition="'$(_AFB_MergeExitCode)' == '0' AND Exists('$(_SwiftBindingIntermediateDir)_bridge_merge_slices/merged.xcframework')">true</_AFB_MergeSucceeded>
    </PropertyGroup>
    <Exec Condition="'$(_AFB_MergeSucceeded)' == 'true'"
          Command="set -e; rm -rf &quot;$(_AFB_XCF).superseded&quot;; mv &quot;$(_AFB_XCF)&quot; &quot;$(_AFB_XCF).superseded&quot;; mv &quot;$(_SwiftBindingIntermediateDir)_bridge_merge_slices/merged.xcframework&quot; &quot;$(_AFB_XCF)&quot; || { mv &quot;$(_AFB_XCF).superseded&quot; &quot;$(_AFB_XCF)&quot;; exit 1; }; rm -rf &quot;$(_AFB_XCF).superseded&quot;"
          StandardOutputImportance="low" />

    <!-- Clean up staging directory. -->
    <RemoveDir Condition="'$(_AFB_NeedsSecondSlice)' == 'true'"
               Directories="$(_SwiftBindingIntermediateDir)_bridge_merge_slices" />

    <!-- Update binding-metadata.props with the corrected bridge slice count. -->
    <Exec Condition="'$(_AFB_MergeSucceeded)' == 'true'"
          Command="SLICES=`find &quot;$(_AFB_XCF)&quot; -maxdepth 1 -type d -name '*-*' | wc -l | tr -d ' '`; \
sed -i '' &quot;s|_SwiftBindingBridgeSliceCount&gt;[0-9]*|_SwiftBindingBridgeSliceCount&gt;%24SLICES|&quot; &quot;$(_SwiftBindingIntermediateDir)binding-metadata.props&quot;"
          StandardOutputImportance="low" />

    <!-- Invariant: on a simulator-bearing platform (iOS/tvOS) a *packaged* bridge MUST
         carry both the device and simulator slices — NuGet pack and a device/opposite-sim
         consumer's NativeReference resolution both require them. The generator builds only
         the primary (simulator) slice inline; this target adds the other. If that second
         slice never materialized — swiftc/lipo/merge failure (ContinueOnError above), the
         wrapper target not having computed _AFW_Other* this build, or an interrupted prior
         build — the bridge xcframework is left primary-only. Shipping a primary-only bridge
         is WORSE than shipping none: a device consumer would hit a build-time
         "no matching framework slice" error instead of the intended non-fatal runtime
         DllNotFound. So enforce the invariant by dropping any incomplete bridge: delete the
         xcframework and flip the metadata flags off, so every downstream gate (NativeReference,
         pack, GetNativeManifest, consumer-targets — all keyed on _SwiftBindingHasBridgeXCFramework
         and/or Exists) cleanly skips it. SwiftUI bridge views then DllNotFound at runtime (the
         documented SWIFTBIND052 degradation) while the wrapper and main bindings stay intact.
         Gated on _SwiftBindingHasSimulatorSlice so macOS / Mac Catalyst single-slice bridges
         (which are complete with one slice) are never dropped. Runs regardless of
         _AFB_NeedsSecondSlice / _AFB_MergeSucceeded so it also repairs the lockstep-degrade and
         stale-from-interrupt cases the per-attempt guards can't see. -->
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'
                          AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'
                          AND Exists('$(_AFW_BridgePath)')">
      <_AFB_FinalSliceDir Include="$([System.IO.Directory]::GetDirectories('$(_AFW_BridgePath)', '*-*'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'
                              AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'
                              AND Exists('$(_AFW_BridgePath)')">
      <_AFB_FinalSliceCount>@(_AFB_FinalSliceDir->Count())</_AFB_FinalSliceCount>
      <_AFB_BridgeIncomplete Condition="$(_AFB_FinalSliceCount) &lt; 2">true</_AFB_BridgeIncomplete>
    </PropertyGroup>
    <!-- Cleanup FIRST, diagnostic second. MSBuild abandons the remaining tasks in a target as
         soon as one raises an error, so emitting the SwiftBridgeRequired error above the
         RemoveDir/sed would leave the known-incomplete xcframework on disk with metadata still
         claiming _SwiftBindingHasBridgeXCFramework=True — precisely the primary-only bridge this
         target exists to remove, now preserved by the check meant to catch it. Dropping the
         artifact first means a forced continue (or a consumer running with the error demoted)
         still gets the safe degraded state rather than an unpackageable one. -->
    <RemoveDir Condition="'$(_AFB_BridgeIncomplete)' == 'true'"
               Directories="$(_AFW_BridgePath)" />
    <Exec Condition="'$(_AFB_BridgeIncomplete)' == 'true' AND Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')"
          Command="sed -i '' \
-e &quot;s|_SwiftBindingHasBridgeXCFramework&gt;[^&lt;]*|_SwiftBindingHasBridgeXCFramework&gt;False|&quot; \
-e &quot;s|_SwiftBindingBridgeSliceCount&gt;[0-9]*|_SwiftBindingBridgeSliceCount&gt;0|&quot; \
&quot;$(_SwiftBindingIntermediateDir)binding-metadata.props&quot;"
          StandardOutputImportance="low" />

    <!-- Same severity policy as the bridge-compile-failure site: an incomplete bridge and a
         failed bridge are one product outcome — the managed bridge session types are compiled
         into the shipped assembly and the native they call is not there. Reporting one as an
         error and the other as a warning would make SWIFTBIND052 mean two different contracts
         depending on which pipeline produced the binding. This site carries the more specific
         reason ("only N slices"), so when both would fire it is the one worth reading; the flag
         below suppresses the generic duplicate downstream. -->
    <PropertyGroup Condition="'$(_AFB_BridgeIncomplete)' == 'true'">
      <_SwiftBridgeFailureReported>true</_SwiftBridgeFailureReported>
    </PropertyGroup>
    <Error Condition="'$(_AFB_BridgeIncomplete)' == 'true'
                      AND $([System.String]::Equals('$(SwiftBridgeRequired)', 'true', StringComparison.OrdinalIgnoreCase))"
           Code="SWIFTBIND052"
           Text="SwiftUI bridge '$(_AFW_BridgeModule)' produced only $(_AFB_FinalSliceCount) slice(s); both device and simulator are required to package it. The incomplete bridge has been dropped, so the generated bridge session types would ship with no native behind them and throw DllNotFoundException at runtime. The main bindings and wrapper are unaffected. Check the build output above for the swiftc/lipo diagnostic. To ship without the bridge, set &lt;SwiftBridgeRequired&gt;false&lt;/SwiftBridgeRequired&gt; in your project file." />
    <Warning Condition="'$(_AFB_BridgeIncomplete)' == 'true'
                        AND !$([System.String]::Equals('$(SwiftBridgeRequired)', 'true', StringComparison.OrdinalIgnoreCase))"
             Code="SWIFTBIND052"
             Text="SwiftUI bridge '$(_AFW_BridgeModule)' produced only $(_AFB_FinalSliceCount) slice(s); both device and simulator are required to package it. Dropping the incomplete bridge — SwiftUI bridge views will throw DllNotFoundException at runtime, but the main bindings and wrapper are unaffected. Set &lt;SwiftBridgeRequired&gt;true&lt;/SwiftBridgeRequired&gt; to promote this to a build error." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2a-bis: Pre-build sibling Swift-binding ProjectReferences        -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Multi-framework libraries are bound as several binding projects where a
       higher module ProjectReferences a lower one (e.g. PaymentSheet → Core).
       The lower binding's module database and wrapper xcframework are produced by
       its OWN build, but ResolveProjectReferences — which builds the
       ProjectReferences — runs AFTER _GenerateSwiftBindings and
       _CompileSwiftWrapper. On a CLEAN first build the lower binding therefore
       hasn't been built yet, so _CollectSwiftModuleDatabases (Source 3) finds no
       *Database.xml — the generator emits unresolved cross-module references that
       fail with CS0234 at C# compile — and the wrapper -F search path is missing
       the sibling wrapper xcframework. Without a structural fix this only self-heals
       on the SECOND build (the dep is now present) — a first-run papercut.

       This target IS that structural fix; the ContinueOnError warning + multi-framework
       build hint below it is now the FALLBACK for the residual case (a sibling that
       cannot build standalone here), not the primary mechanism.

       Pre-builds the user-declared sibling ProjectReferences before the database
       scan and generate so the first build behaves like an incremental one.
       Subsequent ResolveProjectReferences sees each dep up-to-date and is a no-op.
       Serial (BuildInParallel=false) keeps a transitive A→B→C chain deterministic.
       (The Apple-framework analogue is unnecessary: sibling Apple-framework deps are
       always surfaced as a restored PackageReference whose buildTransitive .targets
       feeds _CollectSwiftModuleDatabases Source 1 — no in-tree pre-build to schedule.)

       Operates on @(_UserProjectReference) (captured by
       _DiscoverProjectReferenceDependencies; already excludes the '.ObjC.'
       companion csproj). Best-effort: ContinueOnError keeps a ProjectReference
       that can't build standalone here from blocking the build — the
       authoritative build still happens in ResolveProjectReferences and would
       surface the same error. -->
  <Target Name="_BuildSiblingSwiftBindingDeps"
          DependsOnTargets="_DetectSwiftBindingTargetKind;_DiscoverProjectReferenceDependencies"
          Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework' AND '@(_UserProjectReference)' != ''">
    <!-- PROPERTY-SET COALESCING (why these two tasks pass what they pass).
         MSBuild identifies a build request by (project, GLOBAL PROPERTY SET, targets) and caches
         the result per distinct set. ResolveProjectReferences — the authoritative build of the same
         sibling, later in this same build — invokes it with
             Properties="%(SetConfiguration);%(SetPlatform);%(SetTargetFramework)"
             RemoveProperties="%(GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
         plus — unioned in by the MSBuild task from per-item metadata — %(UndefineProperties), which
         _GetProjectReferenceTargetFrameworkProperties fills in with TargetFramework (single-TFM or
         already-negotiated reference) and with RuntimeIdentifier;SelfContained (any reference that is
         not explicitly IsRidAgnostic=false). That per-item metadata, NOT
         $(_GlobalPropertiesToRemoveFromProjectReferences), is where those three removals come from;
         the property itself only really grows OutputPath. It matters here because
         @(_UserProjectReference) is captured from @(ProjectReference) BEFORE that annotation runs, so
         this prep-build sees none of it and has to name the removals itself.

         Net: the authoritative set is the parent's globals verbatim, plus any authored/negotiated pin,
         minus TargetFramework/RuntimeIdentifier/SelfContained. Any property this prep-build adds that
         the authoritative call does NOT add — or fails to remove where it removes — makes the two
         requests DIFFERENT build instances, so the
         sibling is built TWICE — concurrently, on different nodes. For a Swift binding that means two
         generator runs and two ObjC bgen runs writing the SAME RID-less obj/<cfg>/<tfm>/<Module>/*.g.cs,
         which can interleave into a truncated file (observed as a CS1513 on a bgen-emitted .g.cs), on
         top of doubling every generate/wrapper/compile step.
         So this prep build deliberately passes NOTHING the authoritative call would not pass:
           - no Configuration=$(Configuration) default. It looks harmless because it equals the
             parent's own value, but `dotnet build -c X` makes Configuration a GLOBAL (both requests
             carry it, adding it is a no-op) while a plain `dotnet build` does NOT (adding it invents a
             global the authoritative request lacks → two instances). Unpinned siblings therefore
             inherit exactly what the parent inherited, which is also what ResolveProjectReferences
             gives them — so they land in the same obj/<cfg>/ that _CollectSwiftModuleDatabases
             Source 3 and the wrapper -F query scan with the same $(Configuration) fallback.
           - RemoveProperties instead of NoBuild=false. A no-build pack outer (dotnet pack with the
             no-build switch) sets NoBuild=true as a GLOBAL and the <MSBuild> task forwards it here;
             with Targets="Build"
             the sibling's own _CheckForBuildWithNoBuild guard would raise NETSDK1085, which
             ContinueOnError would swallow into a SKIPPED pre-build leaving a stale module database (the
             very failure this target exists to prevent). Removing the property neutralizes it exactly
             as pinning false did — the sibling evaluates NoBuild from its own file — but leaves the
             normal-case set (where no NoBuild global exists) byte-identical to the authoritative one,
             so the two requests coalesce into a single build instead of forking a second.
           - RuntimeIdentifier and SelfContained are removed for the same reason TargetFramework is:
             the authoritative call undefines both for every reference that is not explicitly
             IsRidAgnostic=false, which is the universal case here (binding csprojs never declare a
             RuntimeIdentifier). Leaving them in forks a second instance whenever the outer build
             carries either global. The two shapes fail differently and both are real: with
             SelfContained global, BOTH instances land in the same obj/<cfg>/<tfm>/ — the same-path,
             tear-capable fork this whole block exists to prevent; with RuntimeIdentifier global, the
             prep instance lands in a RID-scoped obj dir that _CollectSwiftModuleDatabases Source 3
             never scans, so the pre-build silently buys nothing.
             ACCEPTED RESIDUAL: a sibling that declares RuntimeIdentifier(s) in its own file is
             IsRidAgnostic=false, so the authoritative call FORWARDS the parent RID while this one
             strips it — that shape still forks. It is the pre-existing behavior, the two instances
             use different obj dirs (no tearing), and matching it would mean replicating the SDK's
             IsRidAgnostic negotiation before it has run.

         Pinned slice: honour an explicit ProjectReference SetTargetFramework/SetConfiguration/SetPlatform
         so a cross-TFM, cross-config or cross-platform pin builds (and is later discovered) under the same
         slice that _CollectSwiftModuleDatabases Source 3 and the wrapper -F query look for.
         SetTargetFramework/SetConfiguration/SetPlatform are MSBuild's canonical `TargetFramework=<tfm>` /
         `Configuration=<cfg>` / `Platform=<plat>` name=value forms (see Swift.Bindings.csproj's own
         Swift.Runtime reference), so they are passed through verbatim — re-prefixing would set the global
         property to the literal string and build the wrong (or no) slice. They are the same three
         metadata ResolveProjectReferences forwards, in the same order, so a pinned sibling coalesces too;
         an absent pin contributes an empty segment MSBuild ignores, leaving the inherited value in force.
         %(GlobalPropertiesToRemove) is likewise the same per-item removal list the authoritative call
         applies, so a user-authored removal on the ProjectReference is honoured identically here. -->
    <MSBuild Projects="@(_UserProjectReference)"
             Properties="%(_UserProjectReference.SetConfiguration);%(_UserProjectReference.SetPlatform);%(_UserProjectReference.SetTargetFramework)"
             RemoveProperties="NoBuild;RuntimeIdentifier;SelfContained;%(_UserProjectReference.GlobalPropertiesToRemove)"
             Targets="Build"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="Exists('%(_UserProjectReference.Identity)') AND '%(_UserProjectReference.SetTargetFramework)' != ''" />
    <!-- Unpinned: let each sibling build its OWN declared TargetFramework(s).
         A sibling Swift binding for the same platform shares the consumer's TFM,
         so its parent-TFM slice gets built; a plain (non-binding) helper
         ProjectReference builds its own TFM instead of being forced onto the
         consumer's Apple TFM (which would fail NETSDK1005). RemoveProperties is
         what actually strips the forwarded global TargetFramework — omitting it
         from Properties is not enough (the MSBuild task forwards the calling
         project's global TargetFramework otherwise), and it is also what the
         authoritative call ends up doing via the %(UndefineProperties) metadata
         _GetProjectReferenceTargetFrameworkProperties stamps on the reference,
         so removing it keeps the two sets equal rather than diverging them. A config-only or
         platform-only pin (no SetTargetFramework) still lands here and is honoured. -->
    <MSBuild Projects="@(_UserProjectReference)"
             Properties="%(_UserProjectReference.SetConfiguration);%(_UserProjectReference.SetPlatform)"
             RemoveProperties="TargetFramework;NoBuild;RuntimeIdentifier;SelfContained;%(_UserProjectReference.GlobalPropertiesToRemove)"
             Targets="Build"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="Exists('%(_UserProjectReference.Identity)') AND '%(_UserProjectReference.SetTargetFramework)' == ''" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2b: Collect module databases for cross-module resolution        -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_CollectSwiftModuleDatabases"
          BeforeTargets="_GenerateSwiftBindings"
          DependsOnTargets="_ComputeSwiftFingerprint;_DetectAppleFrameworkCrossModuleDeps;_BuildSiblingSwiftBindingDeps">

    <!-- Source 1: NuGet-provided SwiftModuleDatabase items (from consumed package .targets) -->
    <ItemGroup Condition="'@(SwiftModuleDatabase)' != ''">
      <_SwiftModuleDatabaseFile Include="@(SwiftModuleDatabase)"
                                Condition="Exists('%(Identity)')" />
    </ItemGroup>

    <!-- Source 2: Local SwiftFrameworkDependency items with explicit ModuleDatabasePath -->
    <ItemGroup Condition="'@(SwiftFrameworkDependency)' != ''">
      <_SwiftModuleDatabaseFile Include="%(SwiftFrameworkDependency.ModuleDatabasePath)"
                                Condition="'%(SwiftFrameworkDependency.ModuleDatabasePath)' != ''
                                           AND Exists('%(SwiftFrameworkDependency.ModuleDatabasePath)')" />
    </ItemGroup>

    <!-- Source 3: Module databases from ProjectReference intermediate dirs (incremental builds).
         On clean builds these don't exist yet (generated during dependency build), but on
         incremental builds they provide cross-module type resolution automatically.
         Honors per-reference SetConfiguration/SetTargetFramework metadata, falling back
         to the consumer's $(Configuration)/$(TargetFramework) when unset. Those metadata
         are MSBuild's canonical `Configuration=<cfg>`/`TargetFramework=<tfm>` name=value
         form, so the `Name=` prefix is stripped before composing the obj/<cfg>/<tfm>/ path
         (otherwise a TFM-pinned sibling's intermediate dir is never found here). -->
    <Exec Condition="'@(ProjectReference)' != ''"
          Command="echo &quot;@(ProjectReference->'%(RootDir)%(Directory)|%(SetConfiguration)|%(SetTargetFramework)', '%0A')&quot; | while IFS='|' read -r PROJDIR PR_CFG PR_TFM; do \
  [ -z &quot;%24PROJDIR&quot; ] &amp;&amp; continue; \
  CFG=&quot;%24{PR_CFG:-$(Configuration)}&quot;; \
  TFM=&quot;%24{PR_TFM:-$(TargetFramework)}&quot;; \
  CFG=&quot;%24{CFG#Configuration=}&quot;; \
  TFM=&quot;%24{TFM#TargetFramework=}&quot;; \
  DIR=&quot;%24{PROJDIR}obj/%24{CFG}/%24{TFM}/swift-binding/&quot;; \
  [ ! -d &quot;%24DIR&quot; ] &amp;&amp; continue; \
  find &quot;%24DIR&quot; -maxdepth 1 -name '*Database.xml' -type f 2>/dev/null; \
done; true"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SwiftModuleDatabaseFile" />
    </Exec>

    <!-- Deduplicate: Remove duplicate paths (diamond dependency, same DB from multiple sources) -->
    <RemoveDuplicates Inputs="@(_SwiftModuleDatabaseFile)">
      <Output TaskParameter="Filtered" ItemName="_SwiftModuleDatabaseFileDeduped" />
    </RemoveDuplicates>
    <ItemGroup>
      <_SwiftModuleDatabaseFile Remove="@(_SwiftModuleDatabaseFile)" />
      <_SwiftModuleDatabaseFile Include="@(_SwiftModuleDatabaseFileDeduped)" />
    </ItemGroup>

    <!-- Warn for explicit ModuleDatabasePath that doesn't exist -->
    <Warning Condition="'%(SwiftFrameworkDependency.ModuleDatabasePath)' != ''
                        AND !Exists('%(SwiftFrameworkDependency.ModuleDatabasePath)')"
             Code="SWIFTBIND073"
             Text="Module database not found: '%(SwiftFrameworkDependency.ModuleDatabasePath)'. Cross-module type resolution will be incomplete for '%(SwiftFrameworkDependency.Identity)'. Build the dependency project first, or remove the ModuleDatabasePath metadata." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 2c: Collect transitive native-framework deps for the clang -F path -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- A direct dependency's public umbrella header can #import a GRAND-dependency's
       headers (a direct dependency's public header pulls in a sibling framework's generated
       -Swift.h), so the generator's ObjC clang AST pass needs every transitively
       reachable framework on its -F path — not just this project's directly declared
       roots. Direct roots already reach the generator via SwiftFrameworkDependency and
       _AutoFrameworkDependency (appended in _GenerateSwiftBindings). This target adds
       the TRANSITIVE layer by querying each swift-binding ProjectReference's
       GetSwiftTransitiveFrameworkDependencies closure (the dependency-roots analogue of
       the GetSwiftFrameworkSearchPaths recursion the wrapper compile already relies on).
       Roots already passed directly are excluded by full path; the generator is the
       backstop for any path-form mismatch, skipping duplicate dependency module names. -->
  <Target Name="_CollectTransitiveFrameworkDependencies"
          BeforeTargets="_GenerateSwiftBindings"
          DependsOnTargets="_DiscoverSwiftFrameworks;_DiscoverProjectReferenceDependencies"
          Condition="'@(ProjectReference)' != ''">
    <ItemGroup>
      <_SwiftTransitiveDepFwkProjectReference Include="@(ProjectReference)"
          Condition="!$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>
    <MSBuild Projects="@(_SwiftTransitiveDepFwkProjectReference)"
             Targets="GetSwiftTransitiveFrameworkDependencies"
             Properties="%(_SwiftTransitiveDepFwkProjectReference.SetTargetFramework);%(_SwiftTransitiveDepFwkProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftTransitiveDepFwkProjectReference)' != '' AND '%(_SwiftTransitiveDepFwkProjectReference.SetTargetFramework)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftTransitiveFrameworkDependency" />
    </MSBuild>
    <MSBuild Projects="@(_SwiftTransitiveDepFwkProjectReference)"
             Targets="GetSwiftTransitiveFrameworkDependencies"
             Properties="%(_SwiftTransitiveDepFwkProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftTransitiveDepFwkProjectReference)' != '' AND '%(_SwiftTransitiveDepFwkProjectReference.SetTargetFramework)' == ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftTransitiveFrameworkDependency" />
    </MSBuild>
    <RemoveDuplicates Inputs="@(_SwiftTransitiveFrameworkDependency)"
                      Condition="'@(_SwiftTransitiveFrameworkDependency)' != ''">
      <Output TaskParameter="Filtered" ItemName="_SwiftTransitiveFrameworkDependencyDeduped" />
    </RemoveDuplicates>
    <!-- Drop roots already supplied directly (compared by absolute path). -->
    <ItemGroup Condition="'@(_SwiftTransitiveFrameworkDependencyDeduped)' != ''">
      <_SwiftTransitiveFrameworkDependencyNew Include="@(_SwiftTransitiveFrameworkDependencyDeduped)"
          Exclude="@(SwiftFrameworkDependency->'%(FullPath)');@(_AutoFrameworkDependency)" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 3: Invoke generator (gated on fingerprint)                      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_GenerateSwiftBindings"
          BeforeTargets="ResolveProjectReferences"
          DependsOnTargets="_ComputeSwiftFingerprint;_ValidateSwiftAppleSupplementPrototypeDir">
    <!--
      No Target-level Condition on @(SwiftFramework): MSBuild evaluates Target
      Conditions at evaluation time, but SwiftFramework items may only exist at
      execution time (populated by _DiscoverSwiftFrameworks). A Target Condition
      would prevent the DependsOnTargets chain from firing, so discovery would
      never run. Instead, gate the tasks inside on @(SwiftFramework).

      Similarly, the fingerprint gate is on tasks, not the Target, because
      MSBuild evaluates Target Conditions using evaluation-phase property values.
      Properties set during execution (in _ComputeSwiftFingerprint) are only
      visible to task-level Conditions, not target-level Conditions.
    -->
    <!-- F62 wiring tripwire: stamp that this unconditional hook fired. The late
         _AssertSwiftBindingHookWiring target fails closed if the stamp is missing —
         e.g. a future .NET/workload rename of the BeforeTargets anchor
         (ResolveProjectReferences) would silently disconnect this generate hook,
         and MSBuild reports no error for an AfterTargets/BeforeTargets that names a
         nonexistent target. -->
    <PropertyGroup>
      <_SwiftHookRan_GenerateSwiftBindings>true</_SwiftHookRan_GenerateSwiftBindings>
    </PropertyGroup>

    <PropertyGroup Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBindingUpToDate)' != 'true'">
      <_SwiftGenCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --xcframework "%(SwiftFramework.Identity)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --platform $(_SwiftBindingPlatform)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftGenCmd) --platform-target $(SwiftPlatformTarget)</_SwiftGenCmd>
      <!-- Tie the generated module initializer's RuntimeContract epoch to the SAME runtime version
           the implicit SwiftBindings.Runtime PackageReference targets ($(SwiftRuntimeVersion), the
           range floor in Sdk.props). Both Apple-framework paths pass this; omitting it here let a
           binding pinned to an older runtime restore cleanly yet hard-abort at module load because the
           emitted epoch fell back to the generator's baked default. Always populated (defaults to
           0.0.0-dev → epoch 0 → dev bypass), so it is unconditional like the Apple paths. -->
      <_SwiftGenCmd>$(_SwiftGenCmd) --swift-runtime-version $(SwiftRuntimeVersion)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftGenCmd>
      <_SwiftGenCmd>$(_SwiftGenCmd) --sdk-mode -v $(SwiftGeneratorVerbosity)</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(PackageId)' != ''">$(_SwiftGenCmd) --package-id "$(PackageId)"</_SwiftGenCmd>
      <!-- Assembly name the generated .cs compiles into. In SDK mode _IncludeGeneratedSwiftBindings
           folds the generated source into THIS project's own assembly ($(AssemblyName)), not a
           module-named one, so the emitted ILLink trimmer descriptor must root types under
           $(AssemblyName) or ILC matches nothing on NativeAOT. $(AssemblyName) is defaulted to
           $(MSBuildProjectName) in the .NET SDK props, so it is always populated here. -->
      <_SwiftGenCmd Condition="'$(AssemblyName)' != ''">$(_SwiftGenCmd) --assembly-name "$(AssemblyName)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.NamespacePattern)' != ''">$(_SwiftGenCmd) --namespace-pattern "%(SwiftFramework.NamespacePattern)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.SymbolGraph)' != ''">$(_SwiftGenCmd) --symbolgraph "%(SwiftFramework.SymbolGraph)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.BridgeHints)' != ''">$(_SwiftGenCmd) --bridge-hints "%(SwiftFramework.BridgeHints)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'%(SwiftFramework.SwiftInterface)' != ''">$(_SwiftGenCmd) -s "%(SwiftFramework.SwiftInterface)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="!$([System.String]::Equals('$(SwiftGenerateDocComments)', 'true', StringComparison.OrdinalIgnoreCase))">$(_SwiftGenCmd) --no-docs</_SwiftGenCmd>
      <_SwiftGenCmd Condition="!$([System.String]::Equals('$(SwiftAutoDetectDependencies)', 'true', StringComparison.OrdinalIgnoreCase))">$(_SwiftGenCmd) --no-auto-detect</_SwiftGenCmd>
      <!-- Append framework dependency flags for each SwiftFrameworkDependency item -->
      <_SwiftGenCmd Condition="'@(SwiftFrameworkDependency)' != ''">$(_SwiftGenCmd) @(SwiftFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Auto-discovered dependency frameworks from ProjectReference directories -->
      <_SwiftGenCmd Condition="'@(_AutoFrameworkDependency)' != ''">$(_SwiftGenCmd) @(_AutoFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Transitive dependency roots: a direct dependency's public headers can
           #import a grand-dependency's headers, which the generator's ObjC clang AST
           pass must resolve on -F. Collected by _CollectTransitiveFrameworkDependencies
           and deduped against the direct roots above. -->
      <_SwiftGenCmd Condition="'@(_SwiftTransitiveFrameworkDependencyNew)' != ''">$(_SwiftGenCmd) @(_SwiftTransitiveFrameworkDependencyNew->' --framework-dependency "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Author-declared system frameworks / libraries the wrapper link needs (e.g. a
           force-loaded static-archive source that depends on CoreVideo/Metal/libc++). Harmless
           in the generate pass (which skips wrapper compilation); the wrapper pass
           below is where they take effect. -->
      <_SwiftGenCmd Condition="'@(SwiftLinkFramework)' != ''">$(_SwiftGenCmd) @(SwiftLinkFramework->' --link-framework "%(Identity)"', '')</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'@(SwiftLinkLibrary)' != ''">$(_SwiftGenCmd) @(SwiftLinkLibrary->' --link-library "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Pass collected module databases for cross-module type resolution -->
      <_SwiftGenCmd Condition="'@(_SwiftModuleDatabaseFile)' != ''">$(_SwiftGenCmd) @(_SwiftModuleDatabaseFile->' --module-database "%(Identity)"', '')</_SwiftGenCmd>
      <!-- Force ObjC pipeline for ObjC-only framework type -->
      <_SwiftGenCmd Condition="'$(SwiftFrameworkType)' == 'ObjC'">$(_SwiftGenCmd) --objc</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(SwiftAppleSupplementPrototypeDir)' != ''">$(_SwiftGenCmd) --apple-supplement-prototype-dir "$(SwiftAppleSupplementPrototypeDir)"</_SwiftGenCmd>
      <_SwiftGenCmd Condition="'$(SwiftAppleSupplementVersion)' != ''">$(_SwiftGenCmd) --apple-version $(SwiftAppleSupplementVersion)</_SwiftGenCmd>
      <!-- Skip wrapper compilation — deferred to _CompileSwiftWrapper after ResolveProjectReferences -->
      <_SwiftGenCmd>$(_SwiftGenCmd) --skip-wrapper-compilation</_SwiftGenCmd>
    </PropertyGroup>

    <Exec Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBindingUpToDate)' != 'true'"
          Command="$(_SwiftGenCmd)" ConsoleToMSBuild="true"
          EnvironmentVariables="$(_SwiftGeneratorEnv)"
          StandardOutputImportance="low" StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true" />

    <!-- Stamp the fingerprint only AFTER a successful generate. The Exec above has no
         ContinueOnError, so a failed generate aborts the build before this write and the
         next build (unchanged inputs, no stamp) re-runs the generator. -->
    <WriteLinesToFile File="$(_SwiftStampFile)"
                      Lines="$(_SwiftNewFingerprint)"
                      Overwrite="true"
                      Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBindingUpToDate)' != 'true' AND '$(_SwiftStampFile)' != ''" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4: Import binding metadata from generated props file            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ImportSwiftBindingMetadata"
          AfterTargets="_GenerateSwiftBindings;_GenerateSwiftBindingsAppleFramework"
          Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">

    <!-- F62 wiring tripwire: stamp that the metadata-import hook fired. Its AfterTargets
         anchor is independent of the resolver's BeforeTargets anchor, so a silent
         disconnection HERE would leave _SwiftBindingDependencies unloaded while the
         resolver still runs and stamps — making the SWIFTBIND063 resolve check pass even
         though no dependency was ever imported. _AssertSwiftBindingHookWiring asserts this
         stamp (SWIFTBIND064) whenever binding metadata exists, which is exactly when this
         conditional target should have run. -->
    <PropertyGroup>
      <_SwiftHookRan_ImportSwiftBindingMetadata>true</_SwiftHookRan_ImportSwiftBindingMetadata>
    </PropertyGroup>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingPackageVersion/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingPackageVersion" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingMinimumOSVersion/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingMinimumOSVersion" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingModuleName/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingModuleName" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingIsVersionPlaceholder/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingIsVersionPlaceholder" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasWrapperXCFramework/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasWrapperXCFramework" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperModuleName/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingWrapperModuleName" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperSliceCount/text()">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingWrapperSliceCount" />
    </XmlPeek>

    <!-- Source native linkage (Static => wrapper force-loads the archive and is the sole runtime
         carrier; Gap 2) is read solely by _ComputeSwiftBindingSourceXcframeworkInclusion, which
         peeks it itself (it must stay self-contained so the generator-free GetNativeManifest path
         can depend on it). Importing it here too would be a second, drift-prone copy of the same
         peek+default, so it is intentionally not duplicated on this path. -->

    <!-- Read bridge metadata (may be absent for libraries without SwiftUI views) -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeSwift/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeSwift" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeModuleName" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeXCFramework" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeSliceCount/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeSliceCount" />
    </XmlPeek>

    <!-- Set PackageVersion from metadata (user can override) -->
    <PropertyGroup>
      <PackageVersion Condition="'$(PackageVersion)' == ''">$(_SwiftBindingPackageVersion)</PackageVersion>
      <SupportedOSPlatformVersion Condition="'$(SupportedOSPlatformVersion)' == ''">$(_SwiftBindingMinimumOSVersion)</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- Read auto-detected dependency metadata (may be absent for no-dep libraries) -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingDependencies/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingDependencies" />
    </XmlPeek>

    <!-- Warn on version placeholder (SWIFTBIND020) — only when user hasn't overridden PackageVersion -->
    <Warning Condition="'$(_SwiftBindingIsVersionPlaceholder)' == 'True' AND '$(PackageVersion)' == '$(_SwiftBindingPackageVersion)'"
             Code="SWIFTBIND020"
             Text="The xcframework version (1.0) appears to be an Xcode placeholder. Set &lt;PackageVersion&gt; explicitly in your project file." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4a': Resync wrapper slice IDs from disk (BOTH binding modes)     -->
  <!-- A slice dir's name embeds its lipo arches, so a fat-fold (or an         -->
  <!-- x86_64-primary build) lands the simulator slice at a name the static    -->
  <!-- property defaults at the top of this file do not predict:               -->
  <!--   • AppleFramework: xcodebuild -create-xcframework names a fat sim slice -->
  <!--     ios-arm64_x86_64-simulator (not ios-arm64-simulator).               -->
  <!--   • SwiftFramework: an x86_64-only / x86_64-primary wrapper lands its    -->
  <!--     sim slice at ios-x86_64-simulator (not ios-arm64-simulator), because -->
  <!--     SliceVariant.WithArchitecture stamps the slice id with the primary   -->
  <!--     CPU. The static ios-arm64-simulator default then misses on disk and  -->
  <!--     _ValidateSwiftBindingPackSlices hard-fails with a FALSE SWIFTBIND031 -->
  <!--     even though the wrapper is correctly built.                          -->
  <!-- The AppleFramework fat-fold source of truth                             -->
  <!-- (_CompileAppleFrameworkSecondWrapperSlice) is gated on                   -->
  <!-- _SwiftBindingUpToDate != 'true', so incremental packs skipped it and the -->
  <!-- guard fell back to stale defaults (SWIFTBIND032). Re-reading the real    -->
  <!-- dir names from disk on EVERY build keeps the in-memory ids honest for    -->
  <!-- both modes regardless of incremental state. The glob is arch-agnostic    -->
  <!-- (match by the '-simulator' suffix), so it is correct whether the primary -->
  <!-- arch is arm64, x86_64, or a fat fold of both.                           -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ResyncWrapperSliceIds"
          AfterTargets="_ImportSwiftBindingMetadata;_CompileAppleFrameworkSecondWrapperSlice;_CompileSwiftWrapper"
          BeforeTargets="_ValidateSwiftBindingPackSlices;_SynthesizeAppleFrameworkConsumerTargets"
          Condition="'$(_SwiftBindingWrapperModuleName)' != ''
                     AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework')">

    <PropertyGroup>
      <_AFW_ResyncXCF>$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework</_AFW_ResyncXCF>
    </PropertyGroup>

    <!-- Match by '-simulator' suffix so an arm64-only sim slice still resolves;
         non-sim leftover is the device id (single value for iOS/tvOS — no Intel device). -->
    <Exec Command="find &quot;$(_AFW_ResyncXCF)&quot; -maxdepth 1 -mindepth 1 -type d -name '*-simulator' -exec basename {} \;"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_ResyncSimSliceId" />
    </Exec>
    <Exec Command="find &quot;$(_AFW_ResyncXCF)&quot; -maxdepth 1 -mindepth 1 -type d ! -name '*-simulator' -exec basename {} \;"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AFW_ResyncDeviceSliceId" />
    </Exec>
    <PropertyGroup>
      <_SwiftBindingSimulatorSliceId Condition="'$(_AFW_ResyncSimSliceId.Trim())' != ''">$(_AFW_ResyncSimSliceId.Trim())</_SwiftBindingSimulatorSliceId>
      <_SwiftBindingDeviceSliceId Condition="'$(_AFW_ResyncDeviceSliceId.Trim())' != ''">$(_AFW_ResyncDeviceSliceId.Trim())</_SwiftBindingDeviceSliceId>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4b: Surface binding report skip counts as MSBuild warnings      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ReportSwiftBindingCoverage"
          AfterTargets="_ImportSwiftBindingMetadata"
          BeforeTargets="ResolveProjectReferences"
          Condition="Exists('$(_SwiftBindingIntermediateDir)binding-report.json')">

    <!-- Parse skip counts from the JSON report.
         The report is always pretty-printed (Newtonsoft Formatting.Indented),
         so each key-value pair is on its own line. awk extracts the numeric
         value via field splitting + numeric coercion ($2+0 strips trailing comma).
         Fallback to 0 if the key is absent. -->
    <Exec Command="awk '/&quot;SkippedTypes&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingSkippedTypes" />
    </Exec>
    <Exec Command="awk '/&quot;TotalTypes&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingTotalTypes" />
    </Exec>
    <Exec Command="awk '/&quot;SkippedMembers&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingSkippedMembers" />
    </Exec>
    <Exec Command="awk '/&quot;TotalMembers&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingTotalMembers" />
    </Exec>
    <!-- Emitted-member count. Every member that reaches the emitted counter has already
         cleared the module-internal / @_spi visibility gate, so this number is the callable
         public surface, not a raw member total. TotalMembers is NOT filtered that way (it
         counts every declaration the parser produced), which is why the message below states
         the emitted count on its own rather than as a fraction. -->
    <Exec Command="awk '/&quot;EmittedMembers&quot;:/{print $2+0}' &quot;$(_SwiftBindingIntermediateDir)binding-report.json&quot; || echo 0"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SwiftBindingEmittedMembers" />
    </Exec>

    <Warning Condition="'$(_SwiftBindingSkippedTypes)' != '0'"
             Code="SWIFTBIND060"
             Text="$(_SwiftBindingSkippedTypes) of $(_SwiftBindingTotalTypes) Swift types were skipped during binding generation. See $([System.IO.Path]::GetFullPath('$(_SwiftBindingIntermediateDir)binding-report.json', '$(MSBuildProjectDirectory)')) for details and workaround suggestions." />

    <!-- SWIFTBIND066, not SWIFTBIND061: the generator already owns SWIFTBIND061 for a
         completely different condition (a reverse-dispatch receiver degraded to a fail-fast
         stub, one warning per member). One code meaning two unrelated things makes a
         consumer's NoWarn suppress a defect they never saw. -->
    <Warning Condition="'$(_SwiftBindingSkippedMembers)' != '0'"
             Code="SWIFTBIND066"
             Text="$(_SwiftBindingSkippedMembers) of $(_SwiftBindingTotalMembers) Swift members were skipped during binding generation. See $([System.IO.Path]::GetFullPath('$(_SwiftBindingIntermediateDir)binding-report.json', '$(MSBuildProjectDirectory)')) for per-item skip reasons." />

    <!-- Emitted public surface, always reported. A module whose exports are almost entirely
         @_spi- or internal-annotated compiles to a package with nothing callable in it, and
         nothing in a green build says so today: skip counts describe what was dropped, not
         what survived. High importance so the number lands in a default-verbosity pack log
         and the ship/don't-ship call for a hollow module can be made deliberately. -->
    <Message Importance="high"
             Text="Swift bindings for '$(_SwiftBindingModuleName)': $(_SwiftBindingEmittedMembers) public member(s) emitted." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4a: Validate wrapper compilation result                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftWrapperCompilation"
          AfterTargets="_UpdateSwiftWrapperMetadata"
          Condition="'$(_SwiftBindingWrapperModuleName)' != '' AND '$(SwiftFrameworkType)' != 'ObjC'">

    <!-- The wrapper is unusable — either swiftc failed, or it compiled but the generated C# could
         not be reconciled against the symbols that survived (SWIFTBIND057). Both clear
         _SwiftBindingHasWrapperXCFramework, because the Exec above runs with
         ContinueOnError="WarnAndContinue" and swallows the generator's exit code; this metadata
         flag is the only signal that reaches the gate. Promote to error when SwiftWrapperRequired=true. -->
    <Error Condition="$([System.String]::Equals('$(SwiftWrapperRequired)', 'true', StringComparison.OrdinalIgnoreCase))
                      AND '$(_SwiftBindingHasWrapperXCFramework)' != 'True'"
           Code="SWIFTBIND051"
           Text="No usable Swift wrapper was produced for '$(_SwiftBindingWrapperModuleName)' — compilation failed, or the generated C# could not be reconciled against it. Constructor, destroy, and async wrappers will not be available — APIs that depend on them will throw DllNotFoundException at runtime. Check the build output above for the generator's diagnostic (for example SWIFTBIND057). To suppress this error, set &lt;SwiftWrapperRequired&gt;false&lt;/SwiftWrapperRequired&gt; in your project file." />

    <!-- When SwiftWrapperRequired=false, still warn so the failure is visible -->
    <Warning Condition="!$([System.String]::Equals('$(SwiftWrapperRequired)', 'true', StringComparison.OrdinalIgnoreCase))
                        AND '$(_SwiftBindingHasWrapperXCFramework)' != 'True'"
             Code="SWIFTBIND051"
             Text="No usable Swift wrapper was produced for '$(_SwiftBindingWrapperModuleName)' — compilation failed, or the generated C# could not be reconciled against it. Constructor, destroy, and async wrappers will not be available — APIs that depend on them will throw DllNotFoundException at runtime. Set &lt;SwiftWrapperRequired&gt;true&lt;/SwiftWrapperRequired&gt; to promote this to a build error." />

    <!-- An explicitly-requested architecture slice failed to build and was NOT folded into the fat
         wrapper. The generator restored the working primary (so HasWrapper stays True) and exited
         non-zero, but ContinueOnError="WarnAndContinue" on the compile-wrapper Exec swallows that exit
         code — so the violation is enforced here off the persisted metadata. ALWAYS an error,
         independent of SwiftWrapperRequired: requesting an explicit architecture list is opting into a
         contract, and silently shipping a narrower wrapper would drop the requested simulator/Intel
         slice at the consumer's RID. -->
    <Error Condition="'$(_SwiftBindingWrapperUnmetContractArchitectures)' != ''"
           Code="SWIFTBIND056"
           Text="Swift wrapper '$(_SwiftBindingWrapperModuleName)' was explicitly requested for architecture(s) [$(_SwiftBindingWrapperUnmetContractArchitectures)] via &lt;SwiftTargetArchitectures&gt;, but those slices failed to build and were not folded into the fat wrapper. The build is failed rather than silently shipping a narrower wrapper that drops the requested simulator/Intel slice. Resolve the per-architecture compile failure (a swiftc timeout on a contended runner is relieved by raising &lt;SwiftWrapperCompileTimeoutSeconds&gt;) and rebuild, or set &lt;SwiftTargetArchitectures&gt;auto&lt;/SwiftTargetArchitectures&gt; to allow a best-effort degrade." />

    <!-- When wrapper failed and user-authored ProjectReferences exist, provide
         two-pass build guidance. Uses _UserProjectReference (captured early in
         _DiscoverProjectReferenceDependencies) to avoid firing for auto-injected
         or ObjC refs where the hint is not relevant. -->
    <Message Condition="'$(_SwiftBindingHasWrapperXCFramework)' != 'True'
                        AND '@(_UserProjectReference)' != ''"
             Importance="high"
             Text="Hint: For multi-framework libraries, wrapper compilation may fail on the first build when dependency projects haven't been built yet. Build dependency projects first, then rebuild this project. See https://github.com/justinwojo/swift-dotnet-bindings/wiki/Multi-Framework-Libraries" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4b: Auto-resolve cross-module dependencies via ProjectReference -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ResolveSwiftAutoDetectedDependencies"
          AfterTargets="_ImportSwiftBindingMetadata"
          BeforeTargets="ResolveProjectReferences">

    <!--
      No Target-level Condition on $(_SwiftBindingDependencies): MSBuild evaluates
      Target Conditions at evaluation time, but _SwiftBindingDependencies is set at
      execution time by XmlPeek in _ImportSwiftBindingMetadata. Task-level Conditions
      see the execution-time value. Same pattern as _GenerateSwiftBindings fingerprint gate.

      Resolution logic lives in the generator's resolve-auto-deps verb
      (Configuration/AutoDepResolver.cs), not in an inline shell script. The verb:
        - parses the semicolon-delimited _SwiftBindingDependencies property
          (each entry ModuleName|PackageId|Version|XCFrameworkPath),
        - dedups against the explicit SwiftFrameworkDependency module names,
        - probes for a sibling .csproj (the consumer-project argument below passes
          this project's own path, so the name-independent probe can never return
          THIS project and inject a self-ProjectReference when a dependency
          xcframework happens to sit in the same directory), and
        - emits the FROZEN line grammar this target consumes below:
            PROJREF|<absolute-csproj>           -> injected as a ProjectReference
            WARN|<mod>|<pkg>|<ver>|<xcframework> -> surfaced as SWIFTBIND080
      The percent-encoded fields (%7C/%3B/%25) reach the verb verbatim; decode
      happens in C#. The PROJREF|/WARN| grammar is a behavioral contract — keep
      the verb, this ItemGroup, and the Warning in lockstep.

      F62 wiring tripwire: this hook has no target-level Condition (see above),
      so it always runs in xcframework mode. Stamp that it ran; the late
      _AssertSwiftBindingHookWiring target fails closed if the stamp is missing
      (e.g. a future AfterTargets rename silently disconnects this hook). -->
    <PropertyGroup>
      <_SwiftHookRan_ResolveSwiftAutoDetectedDependencies>true</_SwiftHookRan_ResolveSwiftAutoDetectedDependencies>
    </PropertyGroup>

    <Exec Condition="'$(_SwiftBindingDependencies)' != ''"
          Command="dotnet exec &quot;$(_SwiftBindingGeneratorDir)Swift.Bindings.dll&quot; --resolve-auto-deps --auto-dep-spec &quot;$(_SwiftBindingDependencies)&quot; --explicit-deps &quot;@(SwiftFrameworkDependency->'%(Filename)', ';')&quot; --consumer-project &quot;$(MSBuildProjectFullPath)&quot;"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SwiftAutoDepResult" />
    </Exec>

    <!-- Inject ProjectReference for each resolved sibling project -->
    <ItemGroup Condition="'$(_SwiftBindingDependencies)' != ''">
      <ProjectReference Include="$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Substring(8))"
                         Condition="$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').StartsWith('PROJREF|'))" />
    </ItemGroup>

    <!-- Emit SWIFTBIND080 warnings for unresolved dependencies -->
    <!-- WARN fields are pipe-delimited: WARN|module|packageId|version|xcframeworkPath
         Field [2] (packageId) and field [3] (version) are DELIBERATELY NOT rendered into the
         remedy text. An auto-detected dependency is discovered from this binding's own binary
         (otool -L) and carries only a module name and an xcframework path — nothing in that run
         observes the sibling's package identity — so the generator falls back to the CLI default
         `{Module}.Swift.{Platform}` and version `0.0.0`. Printing those told the user to add a
         PackageReference on a package that does not exist (e.g. `FBAEMKit.Swift.iOS 0.0.0`), which
         is worse than saying "we don't know": it looks authoritative and is unfollowable. The
         fields stay in the grammar because the resolver's name-derived probes are built from them;
         only the human-facing text drops them for honest placeholders. -->
    <Warning Condition="'$(_SwiftBindingDependencies)' != '' AND $([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').StartsWith('WARN|'))"
             Code="SWIFTBIND080"
             Text="Cross-module dependency on Swift module '$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[1])' detected, but no sibling binding project for it was found next to '$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[4])'. Reference whatever project or package binds that xcframework, by adding one of:%0A%0A  For local source builds:%0A    &lt;ProjectReference Include=&quot;&lt;path to the binding project for $([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[1])&gt;.csproj&quot; /&gt;%0A%0A  For NuGet package consumption (both items required — SwiftFrameworkDependency for build-time framework resolution, PackageReference for NuGet restore):%0A    &lt;SwiftFrameworkDependency Include=&quot;$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[4])&quot;%0A                              PackageId=&quot;&lt;id of the package that ships $([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[1])&gt;&quot; PackageVersion=&quot;&lt;its version&gt;&quot; /&gt;%0A    &lt;PackageReference Include=&quot;&lt;id of the package that ships $([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[1])&gt;&quot;%0A                      Version=&quot;&lt;its version&gt;&quot; /&gt;%0A%0AThe package id and version above are placeholders: an auto-detected dependency carries only the module name and the xcframework path, so this SDK cannot know which package ships '$([System.String]::Copy('%(_SwiftAutoDepResult.Identity)').Split('|')[1])'." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4b'': Declared-dependency managed-reference guard                 -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--
    SwiftFrameworkDependency is a NATIVE-ONLY item: it contributes the dependency's
    xcframework (headers, module database, link path) to generation and nothing else.
    It deliberately injects no PackageReference (see the note in Sdk.props explaining
    why an ItemGroup there cannot observe body-declared items), so the managed assembly
    carrying the dependency's C# types is NOT on this project's compile.

    That is invisible until the generated C# happens to name one of those types — a
    parameter, return, or a diagnostic tombstone that renders the projected type name
    verbatim — at which point the build fails with an opaque CS0246 pointing at
    generated code the consumer did not write. SWIFTBIND080 covers the AUTO-DETECTED
    half of this problem, but it is deduped against explicitly-declared dependencies:
    declaring the item is treated as proof the consumer handled it, and the explicitly-
    declared case therefore has no diagnostic at all.

    This guard closes that blind spot at the point of declaration rather than waiting
    for a type name to leak: a dependency declared with a PackageId is by construction
    meant for NuGet consumption, and the SDK's contract for that is BOTH items. Fail
    closed and name the fix. A dependency that genuinely only needs native linkage can
    say so with NativeOnly="true" and is then exempt.

    A managed reference counts as present when the PackageId matches a PackageReference,
    a ProjectReference file name, or a ProjectReference file name's leading segment — the
    generated binding project is named {PackageId}.Swift.{Platform}.csproj, so the raw
    file name will not match on a local source build.
  -->
  <Target Name="_AssertSwiftFrameworkDependencyManagedReference"
          BeforeTargets="CoreCompile"
          Condition="'@(SwiftFrameworkDependency)' != ''
                     AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' == 'true'">

    <ItemGroup>
      <!-- Every identity that can stand for "the sibling binding's managed assembly is
           on this compile". ProjectReference contributes both its file name and that
           name's leading dot-segment. -->
      <_SwiftManagedRefIdentity Include="@(PackageReference)" />
      <_SwiftManagedRefIdentity Include="@(ProjectReference->'%(Filename)')" />
      <_SwiftManagedRefIdentity Include="$([System.String]::Copy('%(ProjectReference.Filename)').Split('.')[0])" />
      <!-- Strip the generated binding project's `.Swift.{Platform}` tail so a DOTTED PackageId
           still matches. The leading-dot-segment identity above only recovers a single-segment
           id: for PackageId `A.B.C` referencing `A.B.C.Swift.iOS.csproj`, the raw file name is
           `A.B.C.Swift.iOS` and the first segment is `A` — neither equals `A.B.C`, so the
           dependency reads as unreferenced and SWIFTBIND081 fires on a correctly-wired project.
           The tail is exactly the documented generated-name convention described above, so
           removing it recovers the PackageId whatever its segment count. -->
      <_SwiftManagedRefIdentity Include="$([System.Text.RegularExpressions.Regex]::Replace('%(ProjectReference.Filename)', '\.Swift\.[^.]+$', ''))" />

      <_SwiftDeclaredManagedDep Include="@(SwiftFrameworkDependency)"
                                Condition="'%(SwiftFrameworkDependency.PackageId)' != ''
                                           AND '%(SwiftFrameworkDependency.NativeOnly)' != 'true'" />
      <_SwiftDeclaredDepPackageId Include="@(_SwiftDeclaredManagedDep->'%(PackageId)')" />
      <_SwiftDeclaredDepWithoutManagedRef Include="@(_SwiftDeclaredDepPackageId)"
                                          Exclude="@(_SwiftManagedRefIdentity)" />
    </ItemGroup>

    <Error Condition="'@(_SwiftDeclaredDepWithoutManagedRef)' != ''"
           Code="SWIFTBIND081"
           Text="SwiftFrameworkDependency '%(_SwiftDeclaredDepWithoutManagedRef.Identity)' is declared with no managed reference. SwiftFrameworkDependency resolves the dependency's xcframework for native generation only — it does NOT put the dependency's C# assembly on this project's compile, so any generated member that names one of its types fails with CS0246 in generated code. Add the matching managed reference (both items are required):%0A%0A  For NuGet package consumption:%0A    &lt;PackageReference Include=&quot;%(_SwiftDeclaredDepWithoutManagedRef.Identity)&quot; Version=&quot;...&quot; /&gt;%0A%0A  For local source builds:%0A    &lt;ProjectReference Include=&quot;../%(_SwiftDeclaredDepWithoutManagedRef.Identity)/%(_SwiftDeclaredDepWithoutManagedRef.Identity).Swift.&lt;platform&gt;.csproj&quot; /&gt;%0A%0AIf this dependency is genuinely native-only and none of its types can reach the generated C#, mark the item NativeOnly=&quot;true&quot; to opt out of this check." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4b': Wiring tripwire                                              -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--
    MSBuild reports NO error when an AfterTargets/BeforeTargets attribute names a
    target that does not exist — the hook is silently dropped. A future .NET SDK or
    workload that renames a build anchor (e.g. ResolveProjectReferences,
    _GenerateSwiftBindings) would therefore disconnect a Swift binding hook
    with zero diagnostics, and a binding would build but skip generation, metadata
    import, or dependency resolution — failing far downstream, or shipping broken.

    This tripwire fails the build CLOSED instead. Each external-target hook stamps a
    _SwiftHookRan_<Target> property when it fires; this late target — anchored on
    CoreCompile, which is always preceded by ResolveProjectReferences in the standard
    build graph — asserts the expected stamps are present and names the SPECIFIC
    disconnected hook if one is missing. One assertion per hook, so the diagnostic
    pinpoints exactly which anchor drifted.

    False-positive discipline: each assertion only fires when the hook was genuinely
    expected to run. The two unconditional generate hooks are asserted whenever they
    apply (the generic one always; the AppleFramework one only in AppleFramework mode,
    where it — not the no-op generic hook — does the real codegen). The two
    metadata-dependent hooks (import + resolve) are gated on binding-metadata.props
    existing, which is exactly when a connected hook must have run — so a build that
    legitimately produced no metadata never false-positives.

    Skipped under design-time builds (IDEs run a restricted target subset) AND under any
    CoreCompile entered outside a real build graph. The tripwire's stamp is set by
    _GenerateSwiftBindings (anchored BeforeTargets="ResolveProjectReferences"); a standalone
    `dotnet build -t:CoreCompile` skips ResolveProjectReferences, so the stamp is legitimately
    absent and the assert would false-positive. DesignTimeBuild is empty (not 'true') in both
    that misfire and a real full build, so it cannot distinguish them — but BuildingProject is
    'false' standalone and 'true' in a full build (BuildOnlySettings, first in CoreBuildDependsOn,
    flips it true ahead of CoreCompile). Gating on the conjunction is Microsoft's canonical
    "real-build-only" idiom (Microsoft.Common.CurrentVersion.targets) and preserves fail-closed
    detection: a genuinely disconnected hook on an actual `-t:Build` still fires (BuildingProject
    is true there). See Regression-R4 finding C1.
  -->
  <Target Name="_AssertSwiftBindingHookWiring"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' == 'true'">

    <!-- _GenerateSwiftBindings is unconditional and anchored on ResolveProjectReferences,
         which always runs before CoreCompile; it MUST have stamped by now. A missing
         stamp means the generate hook's BeforeTargets anchor was renamed/removed. -->
    <Error Condition="'$(_SwiftHookRan_GenerateSwiftBindings)' != 'true'"
           Code="SWIFTBIND062"
           Text="Swift binding generation hook '_GenerateSwiftBindings' did not run before compilation — it is silently disconnected. This usually means its 'BeforeTargets=&quot;ResolveProjectReferences&quot;' anchor was renamed or removed by a .NET SDK / workload change (MSBuild does not error on an AfterTargets/BeforeTargets that names a nonexistent target). The binding would compile without generating any Swift bindings. Re-anchor _GenerateSwiftBindings to the current pre-ResolveProjectReferences target in Swift.Bindings.Sdk/Sdk/Sdk.targets." />

    <!-- In AppleFramework mode, _GenerateSwiftBindingsAppleFramework — not the no-op
         generic hook above — is the real codegen hook. It shares the ResolveProjectReferences
         anchor, but a dedicated stamp catches an independent rename of just THIS hook's anchor.
         Asserted only in AppleFramework mode, where the target's codegen actually applies. -->
    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'
                      AND '$(_SwiftHookRan_GenerateSwiftBindingsAppleFramework)' != 'true'"
           Code="SWIFTBIND065"
           Text="Swift Apple-framework binding generation hook '_GenerateSwiftBindingsAppleFramework' did not run before compilation in AppleFramework mode — it is silently disconnected. This usually means its 'BeforeTargets=&quot;ResolveProjectReferences&quot;' anchor was renamed or removed (MSBuild does not error on an AfterTargets/BeforeTargets that names a nonexistent target). The Apple-framework binding would compile without generating any Swift bindings. Re-anchor _GenerateSwiftBindingsAppleFramework to the current pre-ResolveProjectReferences target in Swift.Bindings.Sdk/Sdk/Sdk.targets." />

    <!-- If binding metadata was produced, _ImportSwiftBindingMetadata must have fired to
         load it (its AfterTargets anchor is independent of the resolver's, so the resolver
         stamping does NOT imply the import ran). A missing stamp here means the import hook
         is silently disconnected and _SwiftBindingDependencies was never populated. -->
    <Error Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')
                      AND '$(_SwiftHookRan_ImportSwiftBindingMetadata)' != 'true'"
           Code="SWIFTBIND064"
           Text="Swift binding metadata-import hook '_ImportSwiftBindingMetadata' did not run even though binding metadata was generated — it is silently disconnected. This usually means its 'AfterTargets=&quot;_GenerateSwiftBindings;_GenerateSwiftBindingsAppleFramework&quot;' anchor was renamed or removed (MSBuild does not error on an AfterTargets/BeforeTargets that names a nonexistent target). Binding metadata (module name, OS version, cross-module dependencies) would be silently dropped and downstream resolution would see no dependencies. Re-anchor the hook in Swift.Bindings.Sdk/Sdk/Sdk.targets." />

    <!-- If binding metadata was produced, the cross-module dependency resolver must also
         have fired. A missing stamp here means _ResolveSwiftAutoDetectedDependencies got
         silently disconnected (independent of the import hook checked above). Gated on the
         metadata file so builds that legitimately produced no metadata don't false-positive. -->
    <Error Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')
                      AND '$(_SwiftHookRan_ResolveSwiftAutoDetectedDependencies)' != 'true'"
           Code="SWIFTBIND063"
           Text="Swift cross-module dependency resolution hook '_ResolveSwiftAutoDetectedDependencies' did not run even though binding metadata was generated — it is silently disconnected. This usually means its 'BeforeTargets=&quot;ResolveProjectReferences&quot;' / 'AfterTargets=&quot;_ImportSwiftBindingMetadata&quot;' anchor was renamed or removed (MSBuild does not error on an AfterTargets/BeforeTargets that names a nonexistent target). Cross-module ProjectReference auto-injection and SWIFTBIND080 guidance would be silently skipped. Re-anchor the hook in Swift.Bindings.Sdk/Sdk/Sdk.targets." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4c: Build the mixed-framework ObjC companion                     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--
    A Mixed framework is ONE xcframework carrying both a Swift API and an ObjC class
    surface, so it ships as ONE NuGet package. The generator emits a managed-only ObjC
    companion csproj (…ObjC.<plat>.csproj) whose assembly is EMBEDDED into the Swift
    binding's package lib/ (see _ConfigureSwiftBindingPack) — never shipped as a separate
    package or promoted to a nuspec <dependency>. The companion is version-lockstep with the
    Swift binding (both derive from the same xcframework), so there is no independent product
    to version separately; a single package is the correct topology.

    The companion csproj is generated during build (_GenerateSwiftBindings), so it is NOT in
    the parent's NuGet restore graph. Restore it explicitly before Build.
    RemoveProperties="TargetFramework" keeps the parent's TFM
    from rewriting the companion's single-slice assets file (NuGet honours a forwarded global
    TargetFramework by writing ONLY that slice, dropping the companion's own); the companion
    pins its own single TFM, so Build/GetTargetPath resolve the right slice without us
    forwarding one. GetTargetPath (a no-op after Build) yields the built assembly path
    reliably — more robust than guessing bin.objc/<config>/<tfm>/<name>.dll.

    Reached two ways: AfterTargets="_GenerateSwiftBindings" on a normal build (so the companion
    compiles as part of every build, preserving compile-gate coverage), and via
    _ConfigureSwiftBindingPack's DependsOnTargets in NuGet's inner-pack subgraph (where
    _GenerateSwiftBindings does not run) so the assembly is available to embed. The companion
    imports Microsoft.NET.Sdk (not SwiftBindings.Sdk), so this never recurses. The second
    Restore/Build are incremental no-ops.
  -->
  <Target Name="_BuildMixedObjCCompanion"
          AfterTargets="_GenerateSwiftBindings">

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingFrameworkType/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingFrameworkType" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingObjCProjectName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingObjCProjectName" />
    </XmlPeek>

    <PropertyGroup>
      <_SwiftBindingCompanionCsproj>$(_SwiftBindingIntermediateDir)$(_SwiftBindingObjCProjectName)</_SwiftBindingCompanionCsproj>
      <!-- Reset to false first so a prior project's value can't leak across a multi-targeting /
           solution build into the _ReferenceMixedObjCCompanion ItemGroup condition (mirrors the
           _IncludeSourceXcframework reset in _ComputeSwiftBindingSourceXcframeworkInclusion). -->
      <_SwiftBindingHasCompanion>false</_SwiftBindingHasCompanion>
      <_SwiftBindingHasCompanion Condition="'$(_SwiftBindingFrameworkType)' == 'Mixed'
                                            AND '$(_SwiftBindingObjCProjectName)' != ''
                                            AND Exists('$(_SwiftBindingCompanionCsproj)')">true</_SwiftBindingHasCompanion>
    </PropertyGroup>

    <!-- All three invocations below MUST carry the SAME Properties/RemoveProperties. MSBuild keys a
         project instance on its global-property set, so a Build that differs from the neighbouring
         Restore/GetTargetPath by even one property forks a SECOND instance of the companion: the
         Restore and the GetTargetPath would then be answered by an instance the Build never ran in,
         and the companion is evaluated (and potentially built) twice for one binding. Keeping the
         three identical means one instance, restored, built and queried in that order. -->
    <MSBuild Condition="'$(_SwiftBindingHasCompanion)' == 'true'"
             Projects="$(_SwiftBindingCompanionCsproj)"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;NoBuild"
             Targets="Restore"
             BuildInParallel="false" />
    <!-- Removing NoBuild neutralizes the outer invocation's NoBuild global. A no-build pack (the SDK
         sets NoBuild=true as a GLOBAL property) forwards that global to this child <MSBuild> by
         default; with Targets="Build" the companion's own _CheckForBuildWithNoBuild guard would then
         raise NETSDK1085 and the package would never be produced (regression surfaced in SDK 0.14.0).
         NoBuild is a statement about the OUTER (binding) project reusing its built output; it was
         never meant to suppress this out-of-band companion build, whose assembly MUST exist to embed
         in lib/ and to satisfy the Swift surface's references. Dropping the inherited global lets the
         companion evaluate NoBuild from its own file (unset), so it builds incrementally (a no-op when
         up to date) regardless of how the outer was launched — the same neutralization pinning
         NoBuild=false gave, without introducing a property the sibling Restore/GetTargetPath calls
         lack (which is what would fork the second instance).
         Configuration=$(Configuration) is safe to pin here — unlike a ProjectReference, this csproj is
         generated into obj/ and is never reached by the normal project graph, so there is no
         authoritative build whose property set it has to match. -->
    <MSBuild Condition="'$(_SwiftBindingHasCompanion)' == 'true'"
             Projects="$(_SwiftBindingCompanionCsproj)"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;NoBuild"
             Targets="Build"
             BuildInParallel="false" />
    <MSBuild Condition="'$(_SwiftBindingHasCompanion)' == 'true'"
             Projects="$(_SwiftBindingCompanionCsproj)"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;NoBuild"
             Targets="GetTargetPath"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftBindingCompanionBuildOutput" />
    </MSBuild>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4ca: Reference the mixed ObjC companion for this project's compile -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Surfaces the ObjC companion's managed types into THIS SDK project's own compile. Two cases
       need it: (1) SDK-direct consumption (path b), where the SDK-importing project IS the binding
       and compiles its own C# against the ObjC types; and (2) a packable mixed binding whose own
       generated Swift surface references the ObjC types — its compile needs the companion too. In
       both, _BuildMixedObjCCompanion built the companion out-of-band, so an explicit assembly
       Reference is required. (PackageReference consumers — path a — get the companion from the
       package's lib/ via NuGet's auto-reference; ProjectReference consumers — path c — get it from
       the binding's {PackageId}.ProjectReference.targets.) For a packable binding the extra
       Reference is harmless: it copies the companion into the binding's bin/ (not packed, since
       NuGet does not pack CopyLocal references), while lib/ still embeds it exactly once via
       _ConfigureSwiftBindingPack. A <Reference> —
       unlike a <ProjectReference> — is never promoted to a nuspec <dependency>, so this preserves
       the one-xcframework → one-package contract while making `new Module.ObjCType()` resolve.
       Private=true (CopyLocal) ships the companion to the app output so it loads at runtime; NuGet
       pack does not pack CopyLocal references, so the companion is still embedded into lib/ exactly
       once (via _ConfigureSwiftBindingPack's TfmSpecificPackageFile), not twice.

       The injection is gated at the ItemGroup (not the target) because _SwiftBindingHasCompanion
       and @(_SwiftBindingCompanionBuildOutput) are set during _BuildMixedObjCCompanion's execution;
       a target-level Condition would be evaluated against evaluation-phase values and miss them
       (same reasoning as _GenerateSwiftBindings). Runs before ResolveProjectReferences so
       ResolveAssemblyReferences picks up the injected reference.

       DependsOnTargets — not just AfterTargets — on the producer is LOAD-BEARING, and the
       AfterTargets alone was a silent-miscompile bug. AfterTargets is a soft ordering: it says
       "if _BuildMixedObjCCompanion runs, run me after it", NOT "make sure it ran". This target
       has its own independent trigger (BeforeTargets="ResolveProjectReferences"), so it can be
       scheduled in a build request where the producer is not scheduled at all, and then it
       injects nothing. That is reachable whenever a mixed binding is referenced by more than one
       project:
         * MSBuild runs a target at most once per project CONFIGURATION, and one configuration
           serves a separate build request per requester (the app, and every sibling binding that
           ProjectReferences it).
         * A request that blocks on a nested <MSBuild> call YIELDS its node, and the scheduler
           then starts another queued request against the SAME configuration. _BuildMixedObjCCompanion
           is exactly such a call — it is blocked for the entire out-of-band companion
           Restore/Build/GetTargetPath, which is seconds, not milliseconds.
         * The interleaved request reaches ResolveProjectReferences, runs THIS target while the
           producer is still mid-flight (so @(_SwiftBindingCompanionBuildOutput) is still empty),
           injects nothing — and MSBuild caches that empty result for the whole configuration, so
           the original request never gets to run it either. The binding's own generated Swift
           surface then compiles without the ObjC companion on its reference set: ~70 CS0234s on
           a real mixed binding (observed on a 3-sibling ObjC+Swift graph), with no diagnostic,
           because SWIFTBIND041 below is deliberately scoped to non-packable projects.
       Naming the producer in DependsOnTargets removes the soft edge: whichever request runs this
       target first is the request that also drives (or waits on) the companion build, so the
       capture is always populated by the time the ItemGroup is evaluated. DependsOnTargets is the
       edge that guarantees the producer ran; AfterTargets is retained only so this target still
       fires when _BuildMixedObjCCompanion is driven on its own (a bare -t:_BuildMixedObjCCompanion
       entry, which is how the unit-test harness exercises it) rather than through
       ResolveProjectReferences. -->
  <Target Name="_ReferenceMixedObjCCompanion"
          DependsOnTargets="_BuildMixedObjCCompanion"
          AfterTargets="_BuildMixedObjCCompanion"
          BeforeTargets="ResolveProjectReferences">
    <ItemGroup Condition="'$(_SwiftBindingHasCompanion)' == 'true' AND '@(_SwiftBindingCompanionBuildOutput)' != ''">
      <Reference Include="@(_SwiftBindingCompanionBuildOutput)">
        <Private>true</Private>
      </Reference>
    </ItemGroup>

    <!-- Non-pack sibling of SWIFTBIND039 (the pack-time guard). Mixed metadata names an ObjC
         companion, but _BuildMixedObjCCompanion (this target's DependsOnTargets producer, which
         therefore HAS run by the time this fires) captured no built assembly to reference. Scoped
         to NON-packable projects (IsPackable != 'true'): that is the
         SDK-direct shape (path b), where the project IS the binding, compiles its own C# against the
         ObjC types, and is RUN rather than packed — so there is no later pack step to fail closed,
         and a silent no-op here surfaces as a confusing CS0246 in the consumer's own sources (or a
         runtime TypeLoadException). A packable binding (path a) deliberately stays a build no-op and
         defers to SWIFTBIND039 at pack time (see BuildMixedObjCCompanion_MixedButCompanionMissing_IsCleanNoOp).
         Uses the metadata-peeked FrameworkType/ObjCProjectName (set by _BuildMixedObjCCompanion)
         rather than _SwiftBindingHasCompanion so it can't misfire even if that flag ever leaked
         across a multi-targeting build. -->
    <Error Condition="'$(_SwiftBindingFrameworkType)' == 'Mixed'
                      AND '$(_SwiftBindingObjCProjectName)' != ''
                      AND '$(IsPackable)' != 'true'
                      AND '@(_SwiftBindingCompanionBuildOutput)' == ''"
           Code="SWIFTBIND041"
           Text="Mixed-framework binding metadata names an ObjC companion ($(_SwiftBindingObjCProjectName)) but no built companion assembly was captured to reference. An SDK-direct project compiles its own C# against the ObjC types, so without this reference those types are unresolved (CS0246) at compile time. Verify the companion csproj is emitted and that it restores+builds (_BuildMixedObjCCompanion); clean $(_SwiftBindingIntermediateDir) and rebuild if it is stale." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4cb: Inject SwiftBindings.Apple supplement reference            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Mirrors _BuildMixedObjCCompanion: reads properties the generator wrote into
       binding-metadata.props and either
         (a) adds a ProjectReference to the emitted prototype csproj when
             `_SwiftBindingAppleSupplementPrototypeCsproj` is set, or
         (b) adds a PackageReference to SwiftBindings.Apple with the
             `_SwiftBindingAppleSupplementVersion` the generator baked in.
       Both are gated on `_SwiftBindingNeedsAppleSupplement=True` so consumer
       projects that never resolved a supplement type stay untouched. The
       prototype form takes precedence because it preserves canonical assembly
       identity (same AssemblyName + namespace) while letting developers
       iterate on supplement sources without publishing a new NuGet package. -->
  <Target Name="_InjectAppleSupplementPrototype"
          AfterTargets="_ImportSwiftBindingMetadata"
          BeforeTargets="ResolveProjectReferences;CollectPackageReferences">

    <!-- The xcframework path inlines supplement signals directly into binding-metadata.props
         (via XCFrameworkMetadataExtractor). The direct Apple-framework path can't: Sdk.targets
         writes binding-metadata.props via shell heredoc and has no visibility into the
         generator's AppleSupplementReferences state, so it emits them to a sibling
         apple-supplement.props and `<Import>`s that file. XmlPeek reads raw XML and does NOT
         evaluate <Import>, so we have to query both files. binding-metadata.props is queried
         first; if the property is empty (direct path case), apple-supplement.props is the
         fallback source. Same pattern for all three properties. -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingNeedsAppleSupplement/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingNeedsAppleSupplement" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)apple-supplement.props"
             Query="/Project/PropertyGroup/_SwiftBindingNeedsAppleSupplement/text()"
             Condition="'$(_SwiftBindingNeedsAppleSupplement)' == '' AND Exists('$(_SwiftBindingIntermediateDir)apple-supplement.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingNeedsAppleSupplement" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingAppleSupplementVersion/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingAppleSupplementVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)apple-supplement.props"
             Query="/Project/PropertyGroup/_SwiftBindingAppleSupplementVersion/text()"
             Condition="'$(_SwiftBindingAppleSupplementVersion)' == '' AND Exists('$(_SwiftBindingIntermediateDir)apple-supplement.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingAppleSupplementVersion" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingAppleSupplementPrototypeCsproj/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingAppleSupplementPrototypeCsproj" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)apple-supplement.props"
             Query="/Project/PropertyGroup/_SwiftBindingAppleSupplementPrototypeCsproj/text()"
             Condition="'$(_SwiftBindingAppleSupplementPrototypeCsproj)' == '' AND Exists('$(_SwiftBindingIntermediateDir)apple-supplement.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingAppleSupplementPrototypeCsproj" />
    </XmlPeek>

    <!-- Prototype form: canonical identity preserved via matching AssemblyName/RootNamespace. -->
    <ItemGroup Condition="'$(_SwiftBindingNeedsAppleSupplement)' == 'True'
                           AND '$(_SwiftBindingAppleSupplementPrototypeCsproj)' != ''
                           AND Exists('$(_SwiftBindingAppleSupplementPrototypeCsproj)')">
      <ProjectReference Include="$(_SwiftBindingAppleSupplementPrototypeCsproj)" />
    </ItemGroup>

    <!-- PackageReference version refinement: open-ended version (e.g. "26.0.0" floor)
         because the Apple supplement is cross-major additive-only — consumers can always
         float forward onto a newer SDK train without breaking references. Uses `Update=`
         (not `Include=`) to overwrite the version metadata on the implicit
         PackageReference declared by Sdk.props instead of adding a second item with the
         same identity, which NuGet would flag as NU1504 (duplicate PackageReference) and
         which on multi-product sub-package graphs floods restore output with warnings.
         The same opt-out conditions used by Sdk.props gate this Update so consumers
         managing the reference manually keep that control: if a consumer sets
         DisableImplicitSwiftAppleReference=true or SwiftFrameworkType=ObjC and adds
         their own pinned `PackageReference Include="SwiftBindings.Apple" Version="X"`,
         `Update=` would otherwise rewrite their version to the generator-detected floor.
         The version guard prevents emitting an invalid version range if the generator
         ever skips `_SwiftBindingAppleSupplementVersion` or a hand-authored
         binding-metadata.props omits it — NuGet would otherwise fail with an opaque
         "invalid version range" error.

         The `Condition="'%(Identity)' == 'SwiftBindings.Apple'"` is load-bearing, not
         redundant. `<PackageReference Update="X" Version="Y" />` inside an `ItemGroup`
         that lives in a target body (execution-time, not project-evaluation-time) does
         NOT actually filter to the literal X — MSBuild applies the Version metadata to
         every PackageReference in scope, including ones it should never touch
         (SwiftBindings.Runtime, the SDK-injected Microsoft.NET.ILLink.Tasks). The
         resulting nuspec / dgspec then declares the wrong version range for those deps,
         which downstream consumers see as NU1605 package-downgrade restore failures.
         The metadata Condition forces per-item batching so the Update only fires for
         the Apple ref. Same shape works at evaluation time without the Condition; only
         target-body ItemGroups exhibit the wildcard behaviour. -->
    <ItemGroup Condition="'$(_SwiftBindingNeedsAppleSupplement)' == 'True'
                           AND '$(_SwiftBindingAppleSupplementPrototypeCsproj)' == ''
                           AND '$(_SwiftBindingAppleSupplementVersion)' != ''
                           AND '$(DisableImplicitSwiftAppleReference)' != 'true'
                           AND '$(SwiftFrameworkType)' != 'ObjC'">
      <PackageReference Update="SwiftBindings.Apple" Version="[$(_SwiftBindingAppleSupplementVersion),)"
                        Condition="'%(Identity)' == 'SwiftBindings.Apple'" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4cc: Auto-inject cross-Apple-framework PackageReference deps    -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--
    Apple-framework mode (SwiftAppleFrameworkTarget) only; no-op in xcframework
    mode (SwiftFramework). Parses the swiftinterface's `import` lines via the
    generator's `detect-apple-cross-module-deps` subcommand, resolves them
    against AppleFrameworkRegistry's packageId map, and injects a bounded
    PackageReference (range "[X.Y.Z,X.(Y+1).0)") for each detected
    SwiftBindings.Apple.<Module> dep edge.

    Why bounded: each Apple SDK train (Xcode minor release) ships a
    coordinated set of SwiftBindings.Apple.<Module> packages at the same Y.Z.
    The bounded range ensures cross-framework deps within a train resolve
    to a consistent set without floating into the next train. The generator
    computes the upper bound from `apple-version` so MSBuild doesn't need
    property-function math.

    Restore-time visibility: BeforeTargets="ResolveProjectReferences;CollectPackageReferences"
    fires during BOTH `dotnet restore` (CollectPackageReferences is part of
    the NuGet restore target chain) and `dotnet build`. PackageReference
    items injected here flow into project.assets.json at restore time and
    into the nuspec dependencies group at pack time.

    Opt out by setting <SwiftAutoDetectAppleFrameworkDependencies>false</SwiftAutoDetectAppleFrameworkDependencies>
    in the consumer csproj when manual cross-package deps are preferred.

    Dedup against any user-declared PackageReference OR ProjectReference of the
    same identity so removing the auto-injection isn't required when migrating an
    existing project; the user's pinned reference wins. Always injected as a
    PackageReference (never a ProjectReference) so the dep reaches the packed
    nuspec <dependencies> — a build-time ProjectReference resolves types but never
    enters the restore graph the nuspec group is built from.

    Outer-evaluation guard: a multi-TFM `dotnet pack` first evaluates the
    project at the outer level (TargetFramework empty). _ResolveAppleFrameworkPaths
    cannot run cleanly there — its xcrun shell-out is keyed off _SwiftXcrunSdk,
    which is only set on inner per-TFM evaluations (it derives from
    _SwiftBindingPlatform). Skipping the whole target (and its dependencies)
    when TargetFramework is empty avoids that. NuGet's pack then aggregates the
    inner evaluations' PackageReference items into the nuspec dependencies group.
  -->
  <Target Name="_DetectAppleFrameworkCrossModuleDeps"
          Condition="'$(TargetFramework)' != ''"
          BeforeTargets="ResolveProjectReferences;CollectPackageReferences"
          DependsOnTargets="_DetectSwiftBindingTargetKind;_ResolveAppleFrameworkPaths">

    <Exec Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND
                     '$(SwiftAutoDetectAppleFrameworkDependencies)' != 'false' AND
                     Exists('$(_SwiftAppleFrameworkInterface)')"
          Command="dotnet exec &quot;$(_SwiftBindingGeneratorDir)Swift.Bindings.dll&quot; --detect-apple-cross-module-deps &quot;$(_SwiftAppleFrameworkInterface)&quot; --apple-version $(SwiftAppleSupplementVersion)"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SwiftAppleAutoDepLine" />
    </Exec>

    <!-- Each line: MODULE|PACKAGE_ID|VERSION_RANGE.
         Materialize parsed metadata first so the per-line PackageId and VersionRange
         are addressable in the inject ItemGroup's Condition (MSBuild can't index
         a Split() result inside a Condition expression). -->
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftAppleAutoDep Include="%(_SwiftAppleAutoDepLine.Identity)"
                          Condition="'%(_SwiftAppleAutoDepLine.Identity)' != ''">
        <Module>$([System.String]::Copy('%(_SwiftAppleAutoDepLine.Identity)').Split('|')[0])</Module>
        <PackageId>$([System.String]::Copy('%(_SwiftAppleAutoDepLine.Identity)').Split('|')[1])</PackageId>
        <VersionRange>$([System.String]::Copy('%(_SwiftAppleAutoDepLine.Identity)').Split('|')[2])</VersionRange>
      </_SwiftAppleAutoDep>
    </ItemGroup>

    <!-- Build sentinel-wrapped semicolon lists of already-declared dependency
         identities so a single Contains(';<id>;') check matches whole identities
         only — without the leading/trailing ';' a partial match could swallow
         "SwiftBindings.Apple" vs. "SwiftBindings.Apple.RealityKit".

         Two lists, because the user may have wired the sibling either way and we
         must not double-declare it: PackageReference identities, and ProjectReference
         filenames (sans extension — a user-authored ProjectReference can use any path
         that resolves to the same project, and the conventional sibling csproj's
         filename IS the PackageId). -->
    <PropertyGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <_SwiftAppleAutoDepExisting>;@(PackageReference->'%(Identity)', ';');</_SwiftAppleAutoDepExisting>
      <_SwiftAppleAutoDepExistingProjectFiles>;@(ProjectReference->'%(Filename)', ';');</_SwiftAppleAutoDepExistingProjectFiles>
    </PropertyGroup>

    <!-- Inject one PackageReference per detected dep — ALWAYS a PackageReference,
         never a ProjectReference, regardless of whether the conventional sibling
         csproj exists in-tree. A ProjectReference resolves types at build time but
         does NOT propagate to the packed nuspec <dependencies> (NuGet builds that
         group from the restore graph, which a build-time-injected ProjectReference
         never enters), so an in-tree-built package — i.e. every shipped package, the
         swift-dotnet-packages mono-repo being exactly the in-tree case — would link a
         sibling dylib its nuspec never names → DllNotFound for the consumer. The
         mono-repo pre-packs sibling Apple frameworks into its local feed before
         building dependents, so the PackageReference restores in-tree too; if a
         sibling is genuinely unavailable, restore fails LOUD (NU1101) rather than
         silently shipping a broken package.

         Skip any dep the user already wired as a PackageReference OR a ProjectReference
         (their pin wins). The `'%(...PackageId)' != ''` guard drops empty-line garbage
         (xcframework mode produces no output but the ItemName collection may still hold
         a single empty item). The ProjectReference branch of that skip is paired with the
         SWIFTBIND044 warning below, because a ProjectReference cannot carry the bounded
         train range the way the suppressed PackageReference would. -->
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <PackageReference Include="%(_SwiftAppleAutoDep.PackageId)"
                        Version="%(_SwiftAppleAutoDep.VersionRange)"
                        Condition="'%(_SwiftAppleAutoDep.PackageId)' != '' AND
                                   !$(_SwiftAppleAutoDepExisting.Contains(';%(_SwiftAppleAutoDep.PackageId);')) AND
                                   !$(_SwiftAppleAutoDepExistingProjectFiles.Contains(';%(_SwiftAppleAutoDep.PackageId);'))" />
    </ItemGroup>

    <!-- Cross-train safety warning. When the user wired the detected sibling as an
         authored ProjectReference, the dedup above correctly suppresses the auto
         PackageReference (we must not double-declare) — but a ProjectReference CANNOT
         carry a version RANGE: NuGet packs it into the nuspec as an unbounded minimum
         (version="X.Y.Z"), so a consumer can float that dep into the next Apple SDK
         train and mix mismatched module ABIs. We warn rather than fail so existing
         in-tree ProjectReference wiring keeps building, but the maintainer of a SHIPPED
         Apple-framework package learns to switch to a bounded PackageReference. Skipped
         when the same id is ALSO a PackageReference (the user already pinned the range
         there, so the nuspec carries the bound regardless of the ProjectReference). A
         maintainer who wants the bound HARD-enforced in CI escalates this with
         <WarningsAsErrors>SWIFTBIND044</WarningsAsErrors> (standard MSBuild escalation) —
         so it stays enforceable on demand without us failing a deliberate user choice. -->

    <Warning Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND
                        '%(_SwiftAppleAutoDep.PackageId)' != '' AND
                        $(_SwiftAppleAutoDepExistingProjectFiles.Contains(';%(_SwiftAppleAutoDep.PackageId);')) AND
                        !$(_SwiftAppleAutoDepExisting.Contains(';%(_SwiftAppleAutoDep.PackageId);'))"
             Code="SWIFTBIND044"
             Text="Apple-framework binding references cross-module dependency '%(_SwiftAppleAutoDep.PackageId)' via a ProjectReference, which packs into the nuspec as an unbounded minimum version and lets consumers float across Apple SDK trains. For cross-train safety in a shipped package, reference it as &lt;PackageReference Include=&quot;%(_SwiftAppleAutoDep.PackageId)&quot; Version=&quot;%(_SwiftAppleAutoDep.VersionRange)&quot; /&gt; instead." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4d: Protocol target for dependency xcframework search paths     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Exposes this project's xcframework paths so that dependent projects
       can discover them via MSBuild task during _CompileSwiftWrapper.

       Returns the TRANSITIVE Swift framework search-path closure, not just this
       project's own outputs. A consumer's wrapper compile (swiftc on the emitted
       @_cdecl wrapper) does `import DirectDep`; when the prebuilt .swiftmodule was
       produced by a different compiler version, swiftc rebuilds DirectDep from its
       textual .swiftinterface, and any module that interface imports (a grand-dependency
       framework pulled in by the direct dependency's own interface) must be on the -F
       search path or swiftc fails "no such module '<GrandDep>'". So this query must
       surface, in addition to the
       project's own source + wrapper xcframeworks:
         1. the project's own declared SwiftFrameworkDependency roots (as ABSOLUTE
            paths — FullPath resolves them relative to THIS project's directory so a
            consumer in a different directory still gets a valid path), and
         2. recursively, the same closure from this project's own swift-binding
            ProjectReferences (the project graph is a DAG; MSBuild caches per-project
            target results so diamonds resolve once).
       Path duplicates are deduped at the consumption site; same-named modules from
       different physical xcframeworks remain a diagnosable error in the generator's
       module-name dedup, not silently masked here. -->
  <Target Name="GetSwiftFrameworkSearchPaths"
          DependsOnTargets="_DiscoverSwiftFrameworks;_ImportSwiftBindingMetadata"
          Returns="@(_SwiftBindingFrameworkSearchPath)">
    <!-- Recurse this project's own swift-binding ProjectReferences. Companion
         csprojs (named '.ObjC.') use Microsoft.NET.Sdk and have no such target;
         ContinueOnError tolerates any non-binding ProjectReference. Split by
         SetTargetFramework/SetConfiguration exactly as _CompileSwiftWrapper does,
         so a cross-TFM- or cross-config-pinned sibling is queried under the slice
         it was built with. -->
    <ItemGroup>
      <_SwiftTransitiveDepProjectReference Include="@(ProjectReference)"
          Condition="'@(ProjectReference)' != '' AND !$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>
    <MSBuild Projects="@(_SwiftTransitiveDepProjectReference)"
             Targets="GetSwiftFrameworkSearchPaths"
             Properties="%(_SwiftTransitiveDepProjectReference.SetTargetFramework);%(_SwiftTransitiveDepProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftTransitiveDepProjectReference)' != '' AND '%(_SwiftTransitiveDepProjectReference.SetTargetFramework)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftTransitiveFrameworkSearchPath" />
    </MSBuild>
    <MSBuild Projects="@(_SwiftTransitiveDepProjectReference)"
             Targets="GetSwiftFrameworkSearchPaths"
             Properties="%(_SwiftTransitiveDepProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftTransitiveDepProjectReference)' != '' AND '%(_SwiftTransitiveDepProjectReference.SetTargetFramework)' == ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftTransitiveFrameworkSearchPath" />
    </MSBuild>
    <ItemGroup>
      <_SwiftBindingFrameworkSearchPath Include="%(SwiftFramework.Identity)" />
      <_SwiftBindingFrameworkSearchPath Include="$(MSBuildProjectDirectory)/$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework"
                                        Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True'" />
      <_SwiftBindingFrameworkSearchPath Include="@(SwiftFrameworkDependency->'%(FullPath)')"
                                        Condition="'@(SwiftFrameworkDependency)' != ''" />
      <_SwiftBindingFrameworkSearchPath Include="@(_SwiftTransitiveFrameworkSearchPath)"
                                        Condition="'@(_SwiftTransitiveFrameworkSearchPath)' != ''" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4d-1b: Transitive native-framework dependency-root closure       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Returns the TRANSITIVE closure of native-framework dependency ROOTS (the
       original third-party xcframeworks), not just this project's directly
       declared ones. The generator's ObjC clang AST pass parses the bound
       framework's umbrella header, which #imports its direct dependencies' public
       headers; those headers can in turn #import a GRAND-dependency's headers
       (e.g. a direct dependency's public header pulls in a sibling framework's
       generated -Swift.h). clang therefore needs every transitively reachable
       framework on its -F search path, not only the roots this project declares.

       This is the dependency-ROOTS analogue of GetSwiftFrameworkSearchPaths
       (which returns the broader -F closure the wrapper *compile* needs, including
       wrapper and own xcframeworks). Here we deliberately return ONLY the original
       dependency xcframeworks, because each is fed back to the generator as a
       framework-dependency argument, which it resolves as a real dependency module
       (clang -F search path plus cross-module type resolution) — a wrapper or own
       xcframework must never appear in that role.

       Returns, as ABSOLUTE paths (FullPath resolves a child's relative dependency
       against the CHILD's directory, so a consumer in a different directory still
       gets a valid path):
         1. this project's own declared SwiftFrameworkDependency roots, plus its
            auto-discovered ProjectReference xcframeworks (_AutoFrameworkDependency), and
         2. recursively, the same closure from this project's own swift-binding
            ProjectReferences (the project graph is a DAG; MSBuild caches per-project
            target results so diamonds resolve once).
       Path duplicates are deduped at the consumption site; the generator additionally
       skips duplicate dependency module names, so a root reachable both directly and
       transitively collapses safely. -->
  <Target Name="GetSwiftTransitiveFrameworkDependencies"
          DependsOnTargets="_DiscoverSwiftFrameworks;_DiscoverProjectReferenceDependencies"
          Returns="@(_SwiftBindingTransitiveFrameworkDependency)">
    <!-- Recurse this project's own swift-binding ProjectReferences. Companion
         csprojs (named '.ObjC.') use Microsoft.NET.Sdk and have no such target;
         ContinueOnError tolerates any non-binding ProjectReference. Split by
         SetTargetFramework/SetConfiguration exactly as GetSwiftFrameworkSearchPaths
         does, so a cross-TFM- or cross-config-pinned sibling is queried under the
         slice it was built with. -->
    <ItemGroup>
      <_SwiftTransitiveDepFwkProjectReference Include="@(ProjectReference)"
          Condition="'@(ProjectReference)' != '' AND !$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>
    <MSBuild Projects="@(_SwiftTransitiveDepFwkProjectReference)"
             Targets="GetSwiftTransitiveFrameworkDependencies"
             Properties="%(_SwiftTransitiveDepFwkProjectReference.SetTargetFramework);%(_SwiftTransitiveDepFwkProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftTransitiveDepFwkProjectReference)' != '' AND '%(_SwiftTransitiveDepFwkProjectReference.SetTargetFramework)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftBindingTransitiveFrameworkDependency" />
    </MSBuild>
    <MSBuild Projects="@(_SwiftTransitiveDepFwkProjectReference)"
             Targets="GetSwiftTransitiveFrameworkDependencies"
             Properties="%(_SwiftTransitiveDepFwkProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftTransitiveDepFwkProjectReference)' != '' AND '%(_SwiftTransitiveDepFwkProjectReference.SetTargetFramework)' == ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftBindingTransitiveFrameworkDependency" />
    </MSBuild>
    <ItemGroup>
      <_SwiftBindingTransitiveFrameworkDependency Include="@(SwiftFrameworkDependency->'%(FullPath)')"
                                                  Condition="'@(SwiftFrameworkDependency)' != ''" />
      <_SwiftBindingTransitiveFrameworkDependency Include="@(_AutoFrameworkDependency)"
                                                  Condition="'@(_AutoFrameworkDependency)' != ''" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4d-2: Protocol target for the ObjC companion assembly           -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- A mixed (ObjC+Swift) binding builds TWO managed assemblies: the Swift
       binding and an ObjC companion (Name.ObjC.iOS.dll) compiled from the
       generated ApiDefinition.cs. This exposes the companion assembly path so
       a dependent project can discover it during _ReferenceCrossModuleObjCCompanions.
       _BuildMixedObjCCompanion populates _SwiftBindingCompanionBuildOutput via
       GetTargetPath for a Mixed framework and leaves it empty otherwise, so a
       pure-Swift binding returns nothing. The fail-closed for a Mixed binding
       whose companion failed to build is enforced upstream in the binding's own
       build (SWIFTBIND041 in _ReferenceMixedObjCCompanion), which runs before
       this query can ever be reached. -->
  <Target Name="GetSwiftObjCCompanionAssembly"
          DependsOnTargets="_ImportSwiftBindingMetadata;_BuildMixedObjCCompanion"
          Returns="@(_SwiftBindingCompanionBuildOutput)" />

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4d-3: Surface cross-module ObjC companion assemblies            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- A ProjectReference to a Swift binding surfaces only that binding's Swift
       assembly; its ObjC companion is referenced privately by its own project
       and does not flow transitively. When a consumer's public Swift surface
       inherits from an ObjC type defined in a DIFFERENT binding's companion
       (e.g. a cross-module renamed-ObjC superclass), the consumer's compile
       needs that companion on its reference set or it fails with CS0234/CS0246.

       Runs after ResolveProjectReferences (so each sibling — including any
       injected at execution time by _ResolveSwiftAutoDetectedDependencies — is
       built and its companion exists on disk) and before ResolveAssemblyReferences
       (so the injected Reference is resolved into the compile). Each
       swift-binding ProjectReference is queried for its companion via
       GetSwiftObjCCompanionAssembly; results are path-deduped and added as
       private (copy-local) managed References. Companion csprojs (named
       '.ObjC.') are excluded because they use Microsoft.NET.Sdk and have no
       such target; non-mixed siblings return nothing. A plain managed Reference
       adds no native carrier and no package dependency — the companion still
       packs exactly once under its own binding's lib/. -->
  <Target Name="_ReferenceCrossModuleObjCCompanions"
          BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'@(ProjectReference)' != ''">

    <ItemGroup>
      <_SwiftCompanionQueryRef Include="@(ProjectReference)"
          Condition="!$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>

    <!-- Split by SetTargetFramework/SetConfiguration exactly as _CompileSwiftWrapper
         does, so a cross-TFM- or cross-config-pinned sibling is queried under the
         slice it was built with (its companion lives under obj/<cfg>/<tfm>/…). -->
    <MSBuild Projects="@(_SwiftCompanionQueryRef)"
             Targets="GetSwiftObjCCompanionAssembly"
             Properties="%(_SwiftCompanionQueryRef.SetTargetFramework);%(_SwiftCompanionQueryRef.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftCompanionQueryRef)' != '' AND '%(_SwiftCompanionQueryRef.SetTargetFramework)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftCrossModuleCompanion" />
    </MSBuild>
    <MSBuild Projects="@(_SwiftCompanionQueryRef)"
             Targets="GetSwiftObjCCompanionAssembly"
             Properties="%(_SwiftCompanionQueryRef.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftCompanionQueryRef)' != '' AND '%(_SwiftCompanionQueryRef.SetTargetFramework)' == ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SwiftCrossModuleCompanion" />
    </MSBuild>

    <ItemGroup Condition="'@(_SwiftCrossModuleCompanion)' != ''">
      <Reference Include="@(_SwiftCrossModuleCompanion->Distinct())">
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4e: Compile Swift wrapper after dependencies are built          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Runs AFTER ResolveProjectReferences so dependency wrapper xcframeworks
       are available on the -F search path. Uses compile-wrapper-only mode
       which skips parsing/generation and only compiles existing .swift files. -->
  <Target Name="_CompileSwiftWrapper"
          AfterTargets="ResolveProjectReferences"
          DependsOnTargets="_ImportSwiftBindingMetadata"
          Condition="'$(_SwiftBindingWrapperModuleName)' != '' AND '$(SwiftFrameworkType)' != 'ObjC'">

    <!--
      Wrapper compilation skip logic:
      * No ProjectReferences: safe to use source fingerprint (_SwiftBindingUpToDate)
      * Has ProjectReferences: always recompile, because dependency wrapper outputs
        are not included in the source fingerprint and may have changed.
        Wrapper compilation is fast (~2-5s) so this is acceptable.
    -->
    <PropertyGroup>
      <!-- Apple-framework mode: wrapper was compiled inline by the generator -->
      <_SwiftWrapperSkip Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">true</_SwiftWrapperSkip>
      <!-- Fingerprint-based skip also requires the wrapper xcframework to exist on disk
           AND the metadata to record a *completed* wrapper compile (HasWrapperXCFramework=True).
           _GenerateSwiftBindings writes the stamp but passes skip-wrapper-compilation, so a
           stamp-present/xcframework-absent state is legitimate (e.g. restore-time generation) and
           must force recompilation instead of a false up-to-date skip. The HasWrapper=True clause
           is load-bearing under parallel fan-in builds: when the SAME leaf csproj is scheduled in
           two ProjectInstances sharing one obj dir, SwiftWrapperCompiler creates the .xcframework
           directory EARLY (before the slices are compiled and before metadata flips to True). A
           bare Exists() skip here lets the second context fast-skip on that partial dir and then
           validate the still-False metadata — a spurious SWIFTBIND051. Requiring HasWrapper=True
           keeps the fast path for genuinely-complete (incremental) builds while routing a context
           that sees an in-flight peer's partial dir into _CompileSwiftWrapper, where the obj-dir
           lock serializes it behind the producer. -->
      <_SwiftWrapperSkip Condition="'$(_SwiftBindingUpToDate)' == 'true'
                                    AND '@(ProjectReference)' == ''
                                    AND '$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                                    AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework')">true</_SwiftWrapperSkip>
    </PropertyGroup>

    <!-- Filter out ObjC ProjectReferences (e.g. SomeLib.ObjC.iOS.csproj) which use
         Microsoft.NET.Sdk and don't have GetSwiftFrameworkSearchPaths target.
         The '.ObjC.' naming convention is generated by the binding generator for a mixed
         framework's companion csproj (named from _SwiftBindingObjCProjectName in
         binding-metadata.props), not user-chosen. -->
    <ItemGroup Condition="'@(ProjectReference)' != '' AND '$(_SwiftWrapperSkip)' != 'true'">
      <_SwiftBindingProjectReference Include="@(ProjectReference)"
          Condition="!$([System.String]::Copy('%(Identity)').Contains('.ObjC.'))" />
    </ItemGroup>

    <!-- Collect dependency xcframework paths from ProjectReferences.
         Split by SetTargetFramework so the sibling is queried under the SAME slice
         it was built with by _BuildSiblingSwiftBindingDeps — otherwise the query
         inherits the consumer's forwarded global TargetFramework, and a
         cross-TFM-pinned sibling's _SwiftBindingIntermediateDir (obj/<cfg>/<tfm>/…)
         resolves to the wrong slice so its wrapper xcframework is missed on the -F
         path. SetConfiguration is forwarded the same way (verbatim canonical
         `Configuration=<cfg>`) so a cross-config pin queries obj/<cfg>/ matching the
         slice _BuildSiblingSwiftBindingDeps built; when absent the query inherits the
         parent Configuration, which equals the sibling's default build config. Both
         batches feed the same _ResolvedDepXCFramework. -->
    <MSBuild Projects="@(_SwiftBindingProjectReference)"
             Targets="GetSwiftFrameworkSearchPaths"
             Properties="%(_SwiftBindingProjectReference.SetTargetFramework);%(_SwiftBindingProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftBindingProjectReference)' != '' AND '$(_SwiftWrapperSkip)' != 'true' AND '%(_SwiftBindingProjectReference.SetTargetFramework)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_ResolvedDepXCFramework" />
    </MSBuild>
    <MSBuild Projects="@(_SwiftBindingProjectReference)"
             Targets="GetSwiftFrameworkSearchPaths"
             Properties="%(_SwiftBindingProjectReference.SetConfiguration)"
             BuildInParallel="false"
             ContinueOnError="true"
             Condition="'@(_SwiftBindingProjectReference)' != '' AND '$(_SwiftWrapperSkip)' != 'true' AND '%(_SwiftBindingProjectReference.SetTargetFramework)' == ''">
      <Output TaskParameter="TargetOutputs" ItemName="_ResolvedDepXCFramework" />
    </MSBuild>

    <!-- Build the compile-wrapper-only command -->
    <PropertyGroup Condition="'@(SwiftFramework)' != '' AND '$(_SwiftWrapperSkip)' != 'true'">
      <_SwiftWrapperCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --compile-wrapper-only</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --xcframework "%(SwiftFramework.Identity)"</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --platform $(_SwiftBindingPlatform)</_SwiftWrapperCmd>
      <_SwiftWrapperCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftWrapperCmd) --platform-target $(SwiftPlatformTarget)</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftWrapperCmd>
      <!-- 'auto' (default) fattens the wrapper to arm64+x86_64 only when the source slice ships
           x86_64, so one runtimes/<rid>/native/ tree serves Apple Silicon and Intel/Rosetta. -->
      <_SwiftWrapperCmd Condition="'$(SwiftTargetArchitectures)' != ''">$(_SwiftWrapperCmd) --target-architectures $(SwiftTargetArchitectures)</_SwiftWrapperCmd>
      <_SwiftWrapperCmd>$(_SwiftWrapperCmd) -v $(SwiftGeneratorVerbosity)</_SwiftWrapperCmd>
      <!-- Resolved ProjectReference dependency xcframework paths (preferred, absolute).
           GetSwiftFrameworkSearchPaths returns the transitive closure, so a deep or
           diamond dependency graph yields repeated paths — Distinct() keeps the -F set
           compact and order-stable (swiftc takes the first match per module). -->
      <_SwiftWrapperCmd Condition="'@(_ResolvedDepXCFramework)' != ''">$(_SwiftWrapperCmd) @(_ResolvedDepXCFramework->Distinct()->' --framework-dependency "%(Identity)"', '')</_SwiftWrapperCmd>
      <!-- Explicit SwiftFrameworkDependency search paths — always included alongside ProjectReference deps.
           Frameworks like an internal dependency may not have a binding project but are still required on the -F search path
           for wrapper compilation. Duplicates with _ResolvedDepXCFramework are harmless (just extra -F flags). -->
      <_SwiftWrapperCmd Condition="'@(SwiftFrameworkDependency)' != ''">$(_SwiftWrapperCmd) @(SwiftFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftWrapperCmd>
      <!-- System frameworks/libraries the wrapper link must declare explicitly. A companion's static
           archive can carry zero autolink hints (LC_LINKER_OPTION count 0), so force-load drags in
           objects that reference system frameworks (Metal, CoreVideo, …) with no way to discover them.
           These flags become LC_LOAD_DYLIB on the wrapper and dyld resolves them transitively at app load. -->
      <_SwiftWrapperCmd Condition="'@(SwiftLinkFramework)' != ''">$(_SwiftWrapperCmd) @(SwiftLinkFramework->' --link-framework "%(Identity)"', '')</_SwiftWrapperCmd>
      <_SwiftWrapperCmd Condition="'@(SwiftLinkLibrary)' != ''">$(_SwiftWrapperCmd) @(SwiftLinkLibrary->' --link-library "%(Identity)"', '')</_SwiftWrapperCmd>
    </PropertyGroup>

    <!-- Persist the generator invocation to a shell file so the lock wrapper can run it
         verbatim without quote-mangling the embedded "%(...)"-quoted paths. The file name carries
         a per-evaluation GUID so two concurrent ProjectInstances sharing this obj dir write (and
         exec) DISTINCT files — a single shared cmd file would let one context's truncate-rewrite
         tear the command another context is mid-`bash`-reading under the lock. The compiling
         context execs its own file; a context that no-ops via the in-lock recheck never reads it. -->
    <PropertyGroup Condition="'@(SwiftFramework)' != '' AND '$(_SwiftWrapperSkip)' != 'true'">
      <_SwiftWrapperCmdFile>$(_SwiftBindingIntermediateDir)compile-wrapper-cmd-$([System.Guid]::NewGuid().ToString('N')).sh</_SwiftWrapperCmdFile>
    </PropertyGroup>
    <WriteLinesToFile Condition="'@(SwiftFramework)' != '' AND '$(_SwiftWrapperSkip)' != 'true'"
                      File="$(_SwiftWrapperCmdFile)"
                      Lines="$(_SwiftWrapperCmd)" Overwrite="true" />

    <!-- Compile the wrapper under an obj-dir-scoped mutex. Under parallel fan-in builds the
         same leaf csproj can be scheduled in two ProjectInstances sharing this obj dir; the lock
         (and its in-lock completeness recheck) guarantees exactly one context runs the generator
         while the others block, then observe the published wrapper and no-op. The lock script
         removes the per-context cmd file when done. See scripts/compile-wrapper-locked.sh. -->
    <Exec Condition="'@(SwiftFramework)' != '' AND '$(_SwiftWrapperSkip)' != 'true'"
          Command="/bin/bash &quot;$(MSBuildThisFileDirectory)scripts/compile-wrapper-locked.sh&quot; &quot;$(_SwiftBindingIntermediateDir)wrapper-compile.lock&quot; &quot;$(_SwiftBindingIntermediateDir)binding-metadata.props&quot; &quot;$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework&quot; &quot;$(_SwiftWrapperCmdFile)&quot;"
          ConsoleToMSBuild="true"
          EnvironmentVariables="$(_SwiftGeneratorEnv)"
          StandardOutputImportance="low" StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4f: Re-read wrapper metadata after compilation                  -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- _CompileSwiftWrapper updates binding-metadata.props via
       UpdateMetadataPropsWrapperStatus. Re-read the updated values so
       downstream targets (_ValidateSwiftWrapperCompilation, _ResolveSwiftNativeReferences)
       see the correct wrapper status. -->
  <Target Name="_UpdateSwiftWrapperMetadata"
          AfterTargets="_CompileSwiftWrapper">
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasWrapperXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasWrapperXCFramework" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperSliceCount/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingWrapperSliceCount" />
    </XmlPeek>
    <!-- Re-peek the architecture-contract violation the generator persisted (empty when satisfied).
         _ValidateSwiftWrapperCompilation reads this to fail the build (SWIFTBIND056) when an explicitly
         requested arch slice didn't make it into the fat wrapper — the generator's non-zero exit alone
         is swallowed by ContinueOnError on the compile-wrapper Exec. The Query matches only a non-empty
         text node, so a satisfied (empty-element) contract leaves the property unset. -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperUnmetContractArchitectures/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingWrapperUnmetContractArchitectures" />
    </XmlPeek>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4g: Compile SwiftUI bridge after wrapper                        -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Compiles *.SwiftUIBridge.swift files into {Module}Bridge.xcframework.
       Bridge compilation is simpler than wrapper: no post-processing, no thunks.
       The Exec itself is non-fatal (ContinueOnError) so the main bindings still build;
       _ValidateSwiftBridgeCompilation decides the outcome afterwards, and by default
       (SwiftBridgeRequired=true) a failed bridge is a SWIFTBIND052 error, not a warning. -->
  <Target Name="_CompileSwiftUIBridge"
          AfterTargets="_UpdateSwiftWrapperMetadata"
          DependsOnTargets="_ImportSwiftBindingMetadata">

    <!-- Read bridge metadata from props (set during generation) -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeSwift/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeSwift" />
    </XmlPeek>

    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeModuleName" />
    </XmlPeek>

    <!-- Bridge compilation skip: same logic as wrapper — skip if fingerprint unchanged,
         no ProjectReferences, and the bridge xcframework already exists on disk (same
         stamp-present/output-absent guard used by _CompileSwiftWrapper). -->
    <PropertyGroup>
      <_SwiftBridgeSkip Condition="'$(_SwiftBindingHasBridgeSwift)' != 'True'">true</_SwiftBridgeSkip>
      <_SwiftBridgeSkip Condition="'$(SwiftFrameworkType)' == 'ObjC'">true</_SwiftBridgeSkip>
      <_SwiftBridgeSkip Condition="'$(_SwiftBridgeSkip)' != 'true'
                                   AND '$(_SwiftBindingUpToDate)' == 'true'
                                   AND '@(ProjectReference)' == ''
                                   AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework')">true</_SwiftBridgeSkip>
    </PropertyGroup>

    <!-- Build the compile-bridge-only command -->
    <PropertyGroup Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBridgeSkip)' != 'true'">
      <_SwiftBridgeCmd>dotnet exec "$(_SwiftBindingGeneratorDir)Swift.Bindings.dll"</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --compile-bridge-only</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --xcframework "%(SwiftFramework.Identity)"</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) -o "$(_SwiftBindingIntermediateDir)"</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --platform $(_SwiftBindingPlatform)</_SwiftBridgeCmd>
      <_SwiftBridgeCmd Condition="'$(SwiftPlatformTarget)' != ''">$(_SwiftBridgeCmd) --platform-target $(SwiftPlatformTarget)</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) --wrapper-architectures $(SwiftWrapperArchitectures)</_SwiftBridgeCmd>
      <!-- 'auto' (default) fattens the bridge to arm64+x86_64 exactly when the wrapper is, so the
           {Module}Bridge.xcframework serves Apple Silicon and Intel/Rosetta from one native tree.
           Must mirror _CompileSwiftWrapper or a fat wrapper would ship with an arm64-only bridge. -->
      <_SwiftBridgeCmd Condition="'$(SwiftTargetArchitectures)' != ''">$(_SwiftBridgeCmd) --target-architectures $(SwiftTargetArchitectures)</_SwiftBridgeCmd>
      <_SwiftBridgeCmd>$(_SwiftBridgeCmd) -v $(SwiftGeneratorVerbosity)</_SwiftBridgeCmd>
      <!-- Dependency framework search paths — must mirror _CompileSwiftWrapper exactly
           (2186/2190): include the resolved ProjectReference xcframeworks AND every
           explicit SwiftFrameworkDependency unconditionally. A bridge can depend on a
           framework that has no binding project (e.g. an internal dependency xcframework) at the same time as a
           ProjectReference dep; gating SwiftFrameworkDependency on _ResolvedDepXCFramework
           being empty dropped that framework's -F path whenever both were present, failing
           bridge compilation (SWIFTBIND052) so bridge views threw DllNotFound at runtime.
           Duplicates between the two lists are harmless extra -F flags. -->
      <_SwiftBridgeCmd Condition="'@(_ResolvedDepXCFramework)' != ''">$(_SwiftBridgeCmd) @(_ResolvedDepXCFramework->Distinct()->' --framework-dependency "%(Identity)"', '')</_SwiftBridgeCmd>
      <_SwiftBridgeCmd Condition="'@(SwiftFrameworkDependency)' != ''">$(_SwiftBridgeCmd) @(SwiftFrameworkDependency->' --framework-dependency "%(Identity)"', '')</_SwiftBridgeCmd>
    </PropertyGroup>

    <Exec Condition="'@(SwiftFramework)' != '' AND '$(_SwiftBridgeSkip)' != 'true'"
          Command="$(_SwiftBridgeCmd)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4h: Re-read bridge metadata after compilation                   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_UpdateSwiftBridgeMetadata"
          AfterTargets="_CompileSwiftUIBridge">
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingHasBridgeXCFramework" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeSliceCount/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SwiftBindingBridgeSliceCount" />
    </XmlPeek>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 4i: Validate bridge compilation result                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftBridgeCompilation"
          AfterTargets="_UpdateSwiftBridgeMetadata"
          Condition="'$(_SwiftBindingHasBridgeSwift)' == 'True' AND '$(SwiftFrameworkType)' != 'ObjC'">

    <!-- The bridge Exec runs with ContinueOnError="WarnAndContinue" and swallows the
         generator's exit code, so this metadata flag is the only signal that reaches the gate
         — the same shape as SWIFTBIND051 for the wrapper. Promote to error when
         SwiftBridgeRequired=true (the default).

         Why an error and not a warning: the managed *.SwiftUIBridge.cs session types are
         already in the Compile set and end up in the shipped assembly whether or not the
         native compiled, so a failed bridge produces a package with public, IntelliSense-
         visible constructors that throw DllNotFoundException on first use. Elsewhere the
         binding pipeline sets its metadata flags to a "will be produced" signal and guards the
         emitted <NativeReference> with Exists(), because under the two-pass flow the wrapper
         and bridge xcframeworks do not exist yet at emission time and a later pass fulfills
         them. That reasoning holds for a *reference* — a reference to something not yet built
         is fine — but not for types compiled into the assembly: nothing later removes them, and
         the Exists() guard means a permanently missing native no-ops silently at the
         consumer's build instead of failing. A warning here already proved ignorable. -->
    <Error Condition="$([System.String]::Equals('$(SwiftBridgeRequired)', 'true', StringComparison.OrdinalIgnoreCase))
                      AND '$(_SwiftBindingHasBridgeXCFramework)' != 'True'"
           Code="SWIFTBIND052"
           Text="SwiftUI bridge compilation failed for '$(_SwiftBindingBridgeModuleName)'. The generated bridge session types are compiled into this assembly and will throw DllNotFoundException at runtime, so the package would ship a public API that cannot work. The main bindings are unaffected. Check the build output above for the generator's diagnostic. To ship without the bridge, set &lt;SwiftBridgeRequired&gt;false&lt;/SwiftBridgeRequired&gt; in your project file." />

    <!-- When SwiftBridgeRequired=false, still warn so the failure is visible. Skipped when the
         Apple-direct incomplete-slice site already reported: that path drops the bridge and
         rewrites the metadata flag to False, so this target would otherwise re-report the same
         failure under the same code with a vaguer reason ("compilation failed" for a bridge that
         compiled but came out primary-only). -->
    <Warning Condition="!$([System.String]::Equals('$(SwiftBridgeRequired)', 'true', StringComparison.OrdinalIgnoreCase))
                        AND '$(_SwiftBindingHasBridgeXCFramework)' != 'True'
                        AND '$(_SwiftBridgeFailureReported)' != 'true'"
             Code="SWIFTBIND052"
             Text="SwiftUI bridge compilation failed for '$(_SwiftBindingBridgeModuleName)'. Bridge views will throw DllNotFoundException at runtime. The main bindings are unaffected. Set &lt;SwiftBridgeRequired&gt;true&lt;/SwiftBridgeRequired&gt; to promote this to a build error." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 5: Include generated .cs files in compilation                   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_IncludeGeneratedSwiftBindings"
          AfterTargets="_ImportSwiftBindingMetadata"
          BeforeTargets="ResolveProjectReferences"
          Condition="Exists('$(_SwiftBindingIntermediateDir)')">

    <!-- Swift/Mixed: include generated C# files, excluding ObjC binding definitions
         which belong to the separate ObjC binding project (.csproj with IsBindingProject).
         ObjCArrayOverloads.cs and ObjCCategoryStatics.cs are excluded for the same reason: they
         extend the partial classes bgen generates in the ObjC companion, so compiling them into the
         Swift assembly would reference types that are not there. -->
    <ItemGroup Condition="'$(SwiftFrameworkType)' != 'ObjC'">
      <Compile Include="$(_SwiftBindingIntermediateDir)*.cs"
               Exclude="$(_SwiftBindingIntermediateDir)ApiDefinition.cs;$(_SwiftBindingIntermediateDir)StructsAndEnums.cs;$(_SwiftBindingIntermediateDir)ObjCArrayOverloads.cs;$(_SwiftBindingIntermediateDir)ObjCCategoryStatics.cs" />
    </ItemGroup>

    <!-- ObjC-only: include as binding items instead of Compile -->
    <ItemGroup Condition="'$(SwiftFrameworkType)' == 'ObjC'">
      <ObjcBindingApiDefinition Include="$(_SwiftBindingIntermediateDir)ApiDefinition.cs"
                                 Condition="Exists('$(_SwiftBindingIntermediateDir)ApiDefinition.cs')" />
      <ObjcBindingCoreSource Include="$(_SwiftBindingIntermediateDir)StructsAndEnums.cs"
                              Condition="Exists('$(_SwiftBindingIntermediateDir)StructsAndEnums.cs')" />
      <ObjcBindingCoreSource Include="$(_SwiftBindingIntermediateDir)BgenDelegates.cs"
                              Condition="Exists('$(_SwiftBindingIntermediateDir)BgenDelegates.cs')" />
      <!-- Array overloads for selectors taking a C array of value types. A plain Compile item, NOT
           a bgen input: it forwards to the [Internal] pointer+count members bgen generates from the
           ApiDefinition, which do not exist during bgen's own api-definition contract compile. -->
      <Compile Include="$(_SwiftBindingIntermediateDir)ObjCArrayOverloads.cs"
               Condition="Exists('$(_SwiftBindingIntermediateDir)ObjCArrayOverloads.cs')" />
      <!-- Receiver-free overloads of a category's class members. A plain Compile item for the same
           reason: it adds partial parts to the static classes bgen generates from the ApiDefinition,
           which do not exist during bgen's own api-definition contract compile. -->
      <Compile Include="$(_SwiftBindingIntermediateDir)ObjCCategoryStatics.cs"
               Condition="Exists('$(_SwiftBindingIntermediateDir)ObjCCategoryStatics.cs')" />
    </ItemGroup>

    <!-- Embed the generator-emitted trimmer descriptor as a linker descriptor so the IL trimmer
         (PublishTrimmed without AOT — e.g. a Mono Release build that member-trims our assembly via
         TrimMode=full) auto-discovers and honors it, exactly as Swift.Runtime, SwiftBindings.Apple,
         and the CLI-generated binding csproj embed theirs. ILC (NativeAOT) does NOT auto-discover
         embedded descriptors from an assembly, so the loose copy is additionally rooted via IlcArg
         in the PublishAot-gated targets below. Embedding here is the single place that covers all
         three SDK-path shapes — SDK-built binding packages, SDK-direct apps, and Apple-framework-
         direct bindings — since they all fold their generated types in through this target. Without
         it the descriptor was inert outside NativeAOT for every SDK-built binding. Exists()-guarded:
         a binding with no open-generic ISwiftObject emits no descriptor. -->
    <ItemGroup Condition="Exists('$(_SwiftBindingIntermediateDir)ILLink.Descriptors.xml')">
      <EmbeddedResource Include="$(_SwiftBindingIntermediateDir)ILLink.Descriptors.xml">
        <LogicalName>ILLink.Descriptors.xml</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 5·guard: Fail loud on an ObjC ApiDefinition without bgen mode    -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- The empty-DLL trap (issue #43). A project that carries an
       @(ObjcBindingApiDefinition) item — whether the consumer hand-declared it
       (a bgen ApiDefinition.cs from objective-sharpie or a prior generator run)
       or _IncludeGeneratedSwiftBindings injected our generator's ApiDefinition.cs
       — produces types ONLY if the .NET iOS binding generator (bgen) runs over it.
       bgen is engaged solely by <IsBindingProject>true</IsBindingProject>, which
       Microsoft.iOS.Sdk reads at evaluation time. Without it, the ObjcBindingApiDefinition
       item is silently ignored: `dotnet build` returns 0 and ships an empty (~5.6 KB,
       0-type) assembly, and the consumer only discovers the binding is empty at
       reference-resolution time.

       SWIFTBIND004/SWIFTBIND021 already guard the SDK-generated ObjC flows, but both
       additionally key off $(SwiftFrameworkType) == 'ObjC' AND the presence of a
       SwiftFramework / SwiftAppleFrameworkTarget item — so a hand-rolled csproj that
       declares ObjcBindingApiDefinition directly (no SwiftFramework item, and often no
       SwiftFrameworkType) slips past both. This guard keys off the SYMPTOM — an
       ObjcBindingApiDefinition item present — instead of the SDK configuration
       properties, so it fires for every shape that would ship the empty assembly.

       The gate is IsBindingProject alone, NOT SwiftFrameworkType: bgen runs off
       IsBindingProject regardless of SwiftFrameworkType. The mixed-framework ObjC
       companion csproj (ObjCBindingProjectEmitter) is exactly this shape —
       ObjcBindingApiDefinition present, IsBindingProject=true, and deliberately NO
       SwiftFrameworkType=ObjC — and is a fully working binding; adding
       'OR $(SwiftFrameworkType) != ObjC' to the condition would false-trip it. The
       mixed-framework MAIN Swift csproj has ApiDefinition.cs on disk but never adds it
       as an ObjcBindingApiDefinition item, so keying off the item (not the file on disk)
       also leaves it untouched.

       Runs before CoreCompile (so the empty assembly is never produced) and after
       _IncludeGeneratedSwiftBindings (so generator-injected items are visible too);
       hand-declared items are present from evaluation. Gated on the real-build idiom
       (DesignTimeBuild != true AND BuildingProject == true — the same guard the
       _AssertSwiftBindingHookWiring tripwire uses) so a design-time IDE build or an
       isolated `dotnet build -t:CoreCompile` — where ObjcBindingApiDefinition injection
       may not have run — cannot false-trip. Error, not warning: an empty binding
       assembly is never intentional, and no legitimate flow carries an
       ObjcBindingApiDefinition item with IsBindingProject unset. (The mixed companion
       imports Microsoft.NET.Sdk, not SwiftBindings.Sdk, so this guard is not even
       present in its build — but keying on IsBindingProject alone keeps the condition
       correct regardless.) -->
  <Target Name="_ValidateObjCBindingProjectMode"
          AfterTargets="_IncludeGeneratedSwiftBindings"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' == 'true'">
    <Error Condition="'@(ObjcBindingApiDefinition)' != '' AND '$(IsBindingProject)' != 'true'"
           Code="SWIFTBIND005"
           Text="This project declares an ObjC binding (ObjcBindingApiDefinition item '@(ObjcBindingApiDefinition)'), but &lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt; is missing from the csproj body. The .NET iOS binding generator (bgen) reads IsBindingProject at evaluation time; without it the ApiDefinition is never processed and the build silently produces an empty (0-type) binding assembly. Add &lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt; to your project's PropertyGroup. If you are binding an xcframework through the SwiftBindings generator, also add &lt;SwiftFrameworkType&gt;ObjC&lt;/SwiftFrameworkType&gt; in the same PropertyGroup so the ObjC ApiDefinition is generated. The 'dotnet new swift-binding' template sets both correctly." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 5a: Root the NativeAOT trimmer descriptor (SDK-direct path)      -->
  <!--                                                                         -->
  <!-- In SDK-direct mode the app IS the binding: Target 5 above folds the     -->
  <!-- generated .cs (incl. open-generic ISwiftObject types) into the app's    -->
  <!-- OWN assembly ($(AssemblyName)), then the app publishes NativeAOT. No    -->
  <!-- PackageReference to a binding exists on this path, so the packed        -->
  <!-- buildTransitive consumer .targets that roots the descriptor for the     -->
  <!-- PackageReference path is never imported — ILC would never see the       -->
  <!-- descriptor and would trim the open generics' reflection metadata.       -->
  <!-- Root the generator-emitted descriptor here instead. Its                 -->
  <!-- <assembly fullname> is $(AssemblyName) (the generator is invoked with   -->
  <!-- the assembly-name option set to $(AssemblyName) in SDK mode), so it     -->
  <!-- names the exact assembly the types compile into and the roots actually  -->
  <!-- bind. Gated on                                                          -->
  <!-- PublishAot + Exists so it is inert for a non-AOT publish and for a      -->
  <!-- packable binding-library build (no ILC runs there). This roots the      -->
  <!-- loose copy for the ILC/NativeAOT path only; the IL-trimmer path         -->
  <!-- (PublishTrimmed without AOT) is covered by the EmbeddedResource that    -->
  <!-- _IncludeGeneratedSwiftBindings (Target 5) folds into the assembly, which -->
  <!-- the IL trimmer auto-discovers — mirroring SwiftBindings.Runtime.targets. -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_RootSwiftBindingTrimmerDescriptor"
          AfterTargets="_IncludeGeneratedSwiftBindings"
          BeforeTargets="ResolveProjectReferences"
          Condition="Exists('$(_SwiftBindingIntermediateDir)')">
    <ItemGroup Condition="'$(PublishAot)' == 'true' AND Exists('$(_SwiftBindingIntermediateDir)ILLink.Descriptors.xml')">
      <TrimmerRootDescriptor Include="$(_SwiftBindingIntermediateDir)ILLink.Descriptors.xml" />
      <IlcArg Include="--descriptor:$(_SwiftBindingIntermediateDir)ILLink.Descriptors.xml" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 5b: Include SPM resource bundle stubs in app bundle             -->
  <!-- SPM-generated resource_bundle_accessor.swift searches Bundle.main for  -->
  <!-- named bundles. Empty stub directories prevent fatalError at runtime.   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_IncludeSwiftResourceBundleStubs"
          AfterTargets="_IncludeGeneratedSwiftBindings"
          BeforeTargets="ResolveProjectReferences"
          Condition="Exists('$(_SwiftBindingIntermediateDir)_resource-bundles.txt')">

    <ReadLinesFromFile File="$(_SwiftBindingIntermediateDir)_resource-bundles.txt">
      <Output TaskParameter="Lines" ItemName="_SwiftResourceBundleName" />
    </ReadLinesFromFile>

    <ItemGroup>
      <BundleResource Include="$(_SwiftBindingIntermediateDir)%(_SwiftResourceBundleName.Identity).bundle/**"
                      LinkBase="%(_SwiftResourceBundleName.Identity).bundle"
                      Condition="'%(_SwiftResourceBundleName.Identity)' != ''" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Remove BgenDelegates.cs from Compile — it is only for bgen input       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_RemoveBgenDelegatesFromCompile"
          BeforeTargets="CoreCompile"
          Condition="'$(SwiftFrameworkType)' == 'ObjC'">
    <ItemGroup>
      <Compile Remove="$(_SwiftBindingIntermediateDir)BgenDelegates.cs" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Compute the source-xcframework inclusion decision (Gap 2)              -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Single source of truth for "should this binding reference/pack the original source
       xcframework's native" across the three SDK consumers below (_ResolveSwiftNativeReferences,
       GetNativeManifest, _ConfigureSwiftBindingPack), the MSBuild mirror of the C#
       NativePackagingPolicy helper. The source is dropped only when it is a static archive
       (force-loaded into the wrapper, the sole runtime carrier — referencing it too would
       double-register its ObjC classes) AND the wrapper xcframework exists on disk NOW.

       Computed at execution time, NOT persisted at generation: the generator writes the
       linkage fact in a pass that skips wrapper compilation, then _CompileSwiftWrapper
       materializes the wrapper later, so a gen-time "include source" flag would be stale. The
       Exists() carrier check therefore reflects live disk state. Self-contained (its own
       XmlPeek, no _ImportSwiftBindingMetadata dependency) so GetNativeManifest — which
       deliberately avoids pulling the generator pipeline — can depend on it too. Each consumer
       lists this in DependsOnTargets (never a target-level Condition, which would read at
       evaluation phase before this runs) and orders it after wrapper compilation. -->
  <Target Name="_ComputeSwiftBindingSourceXcframeworkInclusion">
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingSourceNativeLinkage/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SBInclSourceLinkage" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_SBInclWrapperModule" />
    </XmlPeek>
    <PropertyGroup>
      <!-- This target is the sole reader of _SwiftBindingSourceNativeLinkage in the SDK; absent
           linkage defaults to Dynamic (keep the source) — the conservative, never-drop default. -->
      <_SBInclSourceLinkage Condition="'$(_SBInclSourceLinkage)' == ''">Dynamic</_SBInclSourceLinkage>
      <!-- Reset to the include-default first so a prior project's value can't leak across a
           multi-targeting build, then flip to false only for the static-with-wrapper case. -->
      <_SwiftBindingIncludeSourceXcframework>true</_SwiftBindingIncludeSourceXcframework>
      <_SwiftBindingIncludeSourceXcframework
          Condition="'$(_SBInclSourceLinkage)' == 'Static'
                     AND Exists('$(_SwiftBindingIntermediateDir)$(_SBInclWrapperModule).xcframework')">false</_SwiftBindingIncludeSourceXcframework>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 6: Inject NativeReference items for the xcframeworks            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ResolveSwiftNativeReferences"
          BeforeTargets="ResolveNativeReferences"
          DependsOnTargets="_DiscoverSwiftFrameworks;_ImportSwiftBindingMetadata;_UpdateSwiftWrapperMetadata;_UpdateSwiftBridgeMetadata;_ComputeSwiftBindingSourceXcframeworkInclusion">

    <ItemGroup Condition="'@(SwiftFramework)' != ''">
      <!-- Source xcframework: dropped when the source native is a static archive AND the wrapper
           xcframework exists on disk — the wrapper force-loads the archive and is then the sole
           runtime carrier, so referencing the source here too would embed/register the same ObjC
           classes twice (duplicate-class warnings, doubled binary). See Gap 2. The decision is
           computed once by _ComputeSwiftBindingSourceXcframeworkInclusion (this target's
           DependsOnTargets) so it can't drift from GetNativeManifest and the pack item; its
           Exists() carrier check keeps the source as the sole carrier when the wrapper is absent
           (SwiftWrapperRequired=false soft-failure, skipped pass, cleaned output). -->
      <NativeReference Include="%(SwiftFramework.Identity)"
                       Condition="'$(_SwiftBindingIncludeSourceXcframework)' == 'true'">
        <Kind>Framework</Kind>
      </NativeReference>
      <NativeReference Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework"
                       Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                  AND '$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                                  AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
      <NativeReference Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework"
                       Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                  AND '$(_SwiftBindingHasBridgeXCFramework)' == 'True'
                                  AND !$(TargetFramework.Contains('-macos'))
                                  AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
    </ItemGroup>

    <!-- Non-pack sibling of SWIFTBIND040 (the pack-time guard). Same invariant: dropping the source
         xcframework is only safe when a wrapper actually carries the native. The source-drop reads
         live disk (Exists(wrapper), via _ComputeSwiftBindingSourceXcframeworkInclusion) while the
         wrapper NativeReference above reads the persisted _SwiftBindingHasWrapperXCFramework — a
         stale wrapper dir on disk plus a metadata refresh that recorded HasWrapper=False would drop
         the source AND skip the wrapper, leaving an SDK-direct consumer (path b) with no native
         carrier and a DllNotFoundException at runtime. Fail closed on the violated invariant here,
         exactly as pack does, rather than building an app that crashes on first call. -->
    <Error Condition="'@(SwiftFramework)' != ''
                      AND '$(_SwiftBindingIncludeSourceXcframework)' == 'false'
                      AND '$(_SwiftBindingHasWrapperXCFramework)' != 'True'"
           Code="SWIFTBIND040"
           Text="Source xcframework was dropped for static linkage (a wrapper exists on disk) but no wrapper xcframework was referenced (_SwiftBindingHasWrapperXCFramework is not 'True'). The app would build with no Swift native payload and DllNotFoundException at runtime. This indicates stale wrapper artifacts or a metadata-refresh gap: clean $(_SwiftBindingIntermediateDir) and rebuild so the wrapper is recompiled and its presence re-recorded." />

    <!-- Add NativeReference for each dependency xcframework (local build only) -->
    <ItemGroup Condition="'@(SwiftFrameworkDependency)' != ''">
      <NativeReference Include="%(SwiftFrameworkDependency.Identity)"
                       Condition="Exists('%(SwiftFrameworkDependency.Identity)')">
        <Kind>Framework</Kind>
      </NativeReference>
    </ItemGroup>

    <!-- Apple-framework mode: no source xcframework (system framework provided by OS),
         the wrapper xcframework and (when SwiftUI views were bridged) the
         <Module>Bridge.xcframework need to be bundled. The bridge carries the
         @_cdecl trampolines the generated SwiftUI bridge C# P/Invokes via
         [LibraryImport("<Module>Bridge")]; without it those calls DllNotFound at
         runtime. Bridge bundling is gated on _SwiftBindingHasBridgeXCFramework
         (false for frameworks with no SwiftUI views) and stays independent of the
         wrapper so a non-fatal bridge build failure can't drop the wrapper.
         The native-macOS exclusion (!Contains('-macos')) is required because the
         SwiftUI bridge is UIKit-only: its macOS slice compiles to an empty Mach-O,
         and referencing it makes the consumer fail with Xamarin MT158. Mac Catalyst
         keeps the bridge — its TFM (net*-maccatalyst) does not contain "-macos". -->
    <ItemGroup Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'">
      <NativeReference Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework"
                       Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                                  AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
      <NativeReference Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework"
                       Condition="'$(_SwiftBindingHasBridgeXCFramework)' == 'True'
                                  AND '$(_SwiftBindingBridgeModuleName)' != ''
                                  AND !$(TargetFramework.Contains('-macos'))
                                  AND Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework')">
        <Kind>Framework</Kind>
      </NativeReference>
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 6a: GetNativeManifest — propagate NativeReference through       -->
  <!--            ProjectReference for consuming projects                     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- MSBuild's ResolveProjectReferences calls GetNativeManifest on each
       ProjectReference and captures the output into the consumer's
       NativeReference items. This is the built-in .NET iOS mechanism for
       transitive native framework propagation.

       Without this, consuming projects that use <ProjectReference> (instead
       of NuGet) must manually add NativeReference items for the source and
       wrapper xcframeworks — which is fragile (silent omission on clean
       builds if using static ItemGroup with Exists() conditions).

       This target reads metadata directly from binding-metadata.props
       (which was written during the Build that completed before this call)
       rather than depending on _ImportSwiftBindingMetadata, which would
       pull in the entire generator pipeline. -->
  <Target Name="GetNativeManifest"
          DependsOnTargets="_DiscoverSwiftFrameworks;_ComputeSwiftBindingSourceXcframeworkInclusion"
          Returns="@(_SwiftBindingNativeManifest)">

    <!-- Read wrapper metadata from the props file generated during Build -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasWrapperXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_HasWrapper" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingWrapperModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_WrapperModule" />
    </XmlPeek>

    <!-- Source native linkage drives the source-drop decision, but it is computed once by
         _ComputeSwiftBindingSourceXcframeworkInclusion (this target's DependsOnTargets) into
         $(_SwiftBindingIncludeSourceXcframework) — no local linkage peek needed here. -->

    <!-- Read bridge metadata -->
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingHasBridgeXCFramework/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_HasBridge" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_SwiftBindingIntermediateDir)binding-metadata.props"
             Query="/Project/PropertyGroup/_SwiftBindingBridgeModuleName/text()"
             Condition="Exists('$(_SwiftBindingIntermediateDir)binding-metadata.props')">
      <Output TaskParameter="Result" PropertyName="_GNM_BridgeModule" />
    </XmlPeek>

    <!-- All paths must be absolute — relative paths resolve against the CONSUMER
         project, not this library project, when flowing through GetNativeManifest. -->
    <ItemGroup>
      <!-- Source xcframework (skip in Apple-framework mode — system framework provided by OS).
           Also dropped for a static-archive source WHEN the wrapper xcframework exists: the
           wrapper force-loads the archive and is the sole carrier, so flowing the source through
           the consumer's manifest too would double-register its ObjC classes (Gap 2). The shared
           _ComputeSwiftBindingSourceXcframeworkInclusion decision keeps the source when the wrapper
           is absent so the ProjectReference consumer still gets a native carrier. The same on-disk
           property gates _ResolveSwiftNativeReferences and the pack item — the three SDK consumers
           that run with the wrapper's fate already settled on disk. The frozen NuGet/PR .targets the
           C# emitters write can't read this property (they're consumed on a different machine before
           the deferred wrapper compile runs), so they always emit the source ref under a wrapper-absent
           fallback guard instead of baking this drop — see NativePackagingPolicy.ResolveConsumerSourceReferenceMode. -->
      <_SwiftBindingNativeManifest Include="$([System.IO.Path]::GetFullPath('%(SwiftFramework.Identity)'))"
                                   Condition="'@(SwiftFramework)' != ''
                                              AND '$(_SwiftBindingIncludeSourceXcframework)' == 'true'">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>

      <!-- Wrapper xcframework (generated during Build) -->
      <_SwiftBindingNativeManifest Include="$(MSBuildProjectDirectory)/$(_SwiftBindingIntermediateDir)$(_GNM_WrapperModule).xcframework"
                                   Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                              AND '$(_GNM_HasWrapper)' == 'True'
                                              AND Exists('$(_SwiftBindingIntermediateDir)$(_GNM_WrapperModule).xcframework')">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>

      <!-- Bridge xcframework (generated during Build). Excluded on native macOS:
           the UIKit-only bridge has an empty macOS slice → MT158. Catalyst keeps it. -->
      <_SwiftBindingNativeManifest Include="$(MSBuildProjectDirectory)/$(_SwiftBindingIntermediateDir)$(_GNM_BridgeModule).xcframework"
                                   Condition="'$(SwiftFrameworkType)' != 'ObjC'
                                              AND '$(_GNM_HasBridge)' == 'True'
                                              AND !$(TargetFramework.Contains('-macos'))
                                              AND Exists('$(_SwiftBindingIntermediateDir)$(_GNM_BridgeModule).xcframework')">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>

      <!-- Dependency xcframeworks -->
      <_SwiftBindingNativeManifest Include="$([System.IO.Path]::GetFullPath('%(SwiftFrameworkDependency.Identity)'))"
                                   Condition="'@(SwiftFrameworkDependency)' != '' AND Exists('%(SwiftFrameworkDependency.Identity)')">
        <Kind>Framework</Kind>
      </_SwiftBindingNativeManifest>
    </ItemGroup>

    <!-- Non-pack sibling of SWIFTBIND040 (the pack-time guard), for the ProjectReference consumer
         (path c). Same invariant: a static source is only safe to drop when a wrapper carries the
         native. The source-drop reads live disk (_SwiftBindingIncludeSourceXcframework) while the
         wrapper manifest entry reads the persisted _GNM_HasWrapper — a stale wrapper dir plus a
         metadata refresh that recorded HasWrapper=False would flow NEITHER the source NOR the
         wrapper through the manifest, leaving the ProjectReference consumer with no native carrier
         and a DllNotFoundException at runtime. Fail closed here, exactly as pack does. -->
    <Error Condition="'@(SwiftFramework)' != ''
                      AND '$(_SwiftBindingIncludeSourceXcframework)' == 'false'
                      AND '$(_GNM_HasWrapper)' != 'True'"
           Code="SWIFTBIND040"
           Text="Source xcframework was dropped for static linkage (a wrapper exists on disk) but no wrapper xcframework was flowed through GetNativeManifest (_GNM_HasWrapper is not 'True'). A ProjectReference consumer would build with no Swift native payload and DllNotFoundException at runtime. This indicates stale wrapper artifacts or a metadata-refresh gap in the referenced binding: clean its $(_SwiftBindingIntermediateDir) and rebuild so the wrapper is recompiled and its presence re-recorded." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 6b: Validate dependency metadata before pack                    -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftDependencyMetadata"
          BeforeTargets="_ConfigureSwiftBindingPack"
          Condition="'$(IsPackable)' == 'true' AND '@(SwiftFrameworkDependency)' != ''">

    <!-- Fail-closed at pack time: SwiftFrameworkDependency carries PackageId/PackageVersion
         to identify which NuGet package owns the underlying xcframework. Missing metadata
         blocks pack validation here; it does not by itself wire the NuGet dependency —
         consumers also need a sibling <PackageReference> (or <ProjectReference> for local
         source builds) on the same package. The IsPackable gate on the containing target
         keeps this error scoped to pack; a plain build is unaffected. -->
    <Error Condition="'%(SwiftFrameworkDependency.PackageId)' == '' OR '%(SwiftFrameworkDependency.PackageVersion)' == ''"
           Code="SWIFTBIND040"
           Text="SwiftFrameworkDependency '%(SwiftFrameworkDependency.Identity)' is missing PackageId or PackageVersion metadata. Add PackageId and PackageVersion so this dependency can be validated at pack time, and ensure a matching &lt;PackageReference Include='...PackageId...' Version='...PackageVersion...' /&gt; (or &lt;ProjectReference&gt; for local source builds) is declared so NuGet restores the dependent package. Otherwise exclude the SwiftFrameworkDependency before pack." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7a: Validate wrapper slices before pack                         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateSwiftBindingPackSlices"
          BeforeTargets="_ConfigureSwiftBindingPack"
          Condition="'$(IsPackable)' == 'true' AND '$(TargetFramework)' != '' AND ('@(SwiftFramework)' != '' OR '@(SwiftAppleFrameworkTarget)' != '') AND '$(SwiftFrameworkType)' != 'ObjC'">

    <!-- Guard 1: property check (only for platforms with simulator + device slices) -->
    <Error Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework' AND '$(SwiftWrapperArchitectures)' != 'all' AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'"
           Code="SWIFTBIND030"
           Text="NuGet packages require both device and simulator wrapper slices. Remove &lt;SwiftWrapperArchitectures&gt;simulator&lt;/SwiftWrapperArchitectures&gt; or set it to 'all' before packing." />

    <!-- Apple-framework mode: _CompileAppleFrameworkSecondWrapperSlice handles
         building the second slice. Validate that both slices actually exist. -->
    <Error Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework'
                      AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'
                      AND '$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                      AND (!Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingSimulatorSliceId)/')
                           OR !Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingDeviceSliceId)/'))"
           Code="SWIFTBIND032"
           Text="Apple-framework wrapper xcframework is missing device ($(_SwiftBindingDeviceSliceId)) or simulator ($(_SwiftBindingSimulatorSliceId)) slice after second-slice compilation. Investigate the _CompileAppleFrameworkSecondWrapperSlice target output." />

    <!-- Guard 2a: artifact check for platforms with simulator — verify both slice directories exist -->
    <Error Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework'
                      AND '$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                      AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'
                      AND (!Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingSimulatorSliceId)/')
                           OR !Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingDeviceSliceId)/'))"
           Code="SWIFTBIND031"
           Text="Wrapper xcframework is missing device or simulator slice. The source xcframework may not contain both platform slices. Verify your xcframework includes both device ($(_SwiftBindingDeviceSliceId)) and simulator ($(_SwiftBindingSimulatorSliceId)) slices, or set &lt;IsPackable&gt;false&lt;/IsPackable&gt; for local-only use." />

    <!-- Guard 2b: artifact check for single-slice platforms — verify device slice exists -->
    <Error Condition="'$(_SwiftBindingTargetKind)' != 'AppleFramework'
                      AND '$(_SwiftBindingHasWrapperXCFramework)' == 'True'
                      AND '$(_SwiftBindingHasSimulatorSlice)' != 'true'
                      AND !Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/$(_SwiftBindingDeviceSliceId)/')"
           Code="SWIFTBIND031"
           Text="Wrapper xcframework is missing the $(_SwiftBindingDeviceSliceId) slice. Verify your xcframework includes the correct platform slice, or set &lt;IsPackable&gt;false&lt;/IsPackable&gt; for local-only use." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7a': Validate pure-ObjC pack shape (the sidecar lane)            -->
  <!--                                                                         -->
  <!-- Guard-coverage boundary. _ValidateSwiftBindingPackSlices above is       -->
  <!-- explicitly '$(SwiftFrameworkType)' != 'ObjC', and SWIFTBIND038 in       -->
  <!-- _ConfigureSwiftBindingPack is gated on                                  -->
  <!-- _SwiftBindingHasWrapperXCFramework == 'True' — never true for a         -->
  <!-- pure-ObjC binding, which compiles no Swift wrapper. So before this      -->
  <!-- target NO guard covered the pure-ObjC lane at all: a pack that lost its -->
  <!-- native payload shipped green and failed at the consumer's link/dyld.    -->
  <!-- That is the issue-#39 silent-broken-nupkg shape in the one lane the     -->
  <!-- issue-#39 guard cannot see.                                             -->
  <!--                                                                         -->
  <!-- What carries the native on this lane: a pure-ObjC binding is a real     -->
  <!-- Microsoft.iOS binding project (IsBindingProject=true), so the workload's -->
  <!-- _CreateBindingResourcePackage packs every @(NativeReference) xcframework -->
  <!-- into the classic sidecar $(TargetDir)$(TargetName).resources[.zip], and  -->
  <!-- Xamarin.Shared.Sdk.targets packs it to lib/<tfm>/. The consumer's       -->
  <!-- _ExpandNativeReferences finds it next to the restored assembly          -->
  <!-- (_ReferencesWithNativeReferencesToExpand) and ResolveNativeReferences   -->
  <!-- extracts, embeds and signs the frameworks. No buildTransitive/ and no   -->
  <!-- runtimes/ are involved — see src/docs/Design/objc-binding-consumption.md. -->
  <!--                                                                         -->
  <!-- CompressBindingResourcePackage defaults to 'auto', so the sidecar is    -->
  <!-- either a .zip or a .resources DIRECTORY; both are accepted here.        -->
  <!--                                                                         -->
  <!-- The assertion is a MATCH against the source, never a fixed minimum:     -->
  <!-- every slice directory present in a bound xcframework must still be      -->
  <!-- present in the sidecar. A vendor that legitimately ships a device-only   -->
  <!-- (or otherwise partial) xcframework is packed faithfully and does not     -->
  <!-- trip the guard — what fails is a sidecar that LOST a slice the source    -->
  <!-- had, which is the copy-step defect this exists to catch.                 -->
  <!-- Slice ids are compared verbatim and no id shape is assumed (vendors      -->
  <!-- spell the simulator slice ios-arm64_x86_64-simulator, never our          -->
  <!-- $(_SwiftBindingSimulatorSliceId) wrapper convention), so nothing here    -->
  <!-- needs to know which slice is which. If a source xcframework is not       -->
  <!-- readable on disk at pack time there is nothing to match against; the     -->
  <!-- sidecar-presence checks still apply and the per-slice comparison is      -->
  <!-- skipped for that framework rather than guessing.                         -->
  <!--                                                                         -->
  <!-- Checked set = every xcframework the workload packs into THIS sidecar,   -->
  <!-- not just the primary: @(SwiftFramework) plus the                        -->
  <!-- @(SwiftFrameworkDependency)- and @(NativeReference)-derived ones that    -->
  <!-- _ResolveSwiftNativeReferences contributes (Target 6 above). Otherwise a  -->
  <!-- multi-native pack could drop a dependency framework from the sidecar and -->
  <!-- still pass. Dependency/NativeReference entries are filtered on Exists()  -->
  <!-- because that is exactly the condition under which they become            -->
  <!-- NativeReference items and reach the sidecar; @(SwiftFramework) is        -->
  <!-- checked unconditionally so a vanished primary is still caught.           -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_ValidateObjCBindingPackShape"
          DependsOnTargets="_DiscoverSwiftFrameworks;_ImportSwiftBindingMetadata"
          BeforeTargets="_ConfigureSwiftBindingPack"
          Condition="'$(IsPackable)' == 'true' AND '$(TargetFramework)' != '' AND '@(SwiftFramework)' != '' AND '$(SwiftFrameworkType)' == 'ObjC'">

    <PropertyGroup>
      <_ObjCBindingResourceBase>$(TargetDir)$(TargetName).resources</_ObjCBindingResourceBase>
      <_ObjCBindingResourceBase Condition="'$(TargetDir)' == ''">$([System.IO.Path]::GetDirectoryName('$(TargetPath)'))/$(TargetName).resources</_ObjCBindingResourceBase>
    </PropertyGroup>

    <!-- Everything the workload packs into this sidecar (see the header comment): the
         primary bound framework(s) unconditionally, dependency/NativeReference-derived
         xcframeworks when they exist on disk (the same Exists() condition Target 6 uses
         to promote them). Filtered to .xcframework and de-duplicated by full path so a
         framework named through two item types is checked once. -->
    <ItemGroup>
      <_ObjCSidecarNativeRaw Include="@(SwiftFramework)" />
      <_ObjCSidecarNativeRaw Include="@(SwiftFrameworkDependency)"
                             Condition="Exists('%(SwiftFrameworkDependency.FullPath)')" />
      <_ObjCSidecarNativeRaw Include="@(NativeReference)"
                             Condition="Exists('%(NativeReference.FullPath)')" />
      <_ObjCSidecarXcfw Include="@(_ObjCSidecarNativeRaw)"
                        Condition="'%(_ObjCSidecarNativeRaw.Extension)' == '.xcframework'" />
      <_ObjCSidecarNative Include="@(_ObjCSidecarXcfw->'%(FullPath)'->Distinct())" />
    </ItemGroup>

    <!-- One shell pass: list the sidecar (zip or directory), then per bound xcframework
         report 'absent' (not in the sidecar at all) or '<slice>:missing-from-sidecar' for
         every slice directory the SOURCE xcframework has and the sidecar copy does not.
         Emits nothing when the shape is healthy, so the Errors below stay inert. -->
    <!-- Shell command substitution is written with backticks, NOT $(…): MSBuild would
         evaluate a $( … ) as a property/property-function before the shell ever sees it. -->
    <!-- Both sidecar shapes are read and UNIONED rather than preferring the zip: a
         compress-mode flip (or an interrupted compress) can leave a stale/empty
         Test.resources.zip beside a healthy Test.resources/, and preferring the zip
         would fail a pack whose real payload is fine. The union is then filtered to
         xcframework entries, so a present-but-empty sidecar (an interrupted or zero-entry
         archive — note `unzip -Z1` prints "Empty zipfile." on stdout for one) reports the
         same missing-payload failure as no sidecar at all: same consumer outcome, and the
         listing chatter can never be mistaken for content. Names are matched literally in awk (index()==1,
         string ==) — never as grep regexes, because framework names contain '.' and a
         name like Foo must not match FooBar. Paths and slice ids are quoted/globbed so
         spaces in either are safe. -->
    <Exec Command="BASE=&quot;$(_ObjCBindingResourceBase)&quot;; \
ZIPLIST=&quot;&quot;; DIRLIST=&quot;&quot;; \
if [ -f &quot;$BASE.zip&quot; ]; then ZIPLIST=`unzip -Z1 &quot;$BASE.zip&quot; 2&gt;/dev/null`; fi; \
if [ -d &quot;$BASE&quot; ]; then DIRLIST=`cd &quot;$BASE&quot; &amp;&amp; find . | sed 's|^\./||'`; fi; \
LIST=`{ echo &quot;$ZIPLIST&quot;; echo &quot;$DIRLIST&quot;; } | grep -F '.xcframework/'`; \
if [ -z &quot;$LIST&quot; ]; then echo MISSING_SIDECAR; exit 0; fi; \
ISSUES=&quot;&quot;; \
for XCFW in @(_ObjCSidecarNative->'&quot;%(Identity)&quot;', ' '); do \
  FW=`basename &quot;$XCFW&quot; .xcframework`; \
  SLICES=`echo &quot;$LIST&quot; | awk -v fw=&quot;$FW.xcframework/&quot; 'index($0, fw) == 1 { rest = substr($0, length(fw) + 1); n = index(rest, &quot;/&quot;); if (n &gt; 1) print substr(rest, 1, n - 1); else if (n == 0 &amp;&amp; rest != &quot;&quot;) print rest }' | sort -u`; \
  if [ -z &quot;$SLICES&quot; ]; then ISSUES=&quot;$ISSUES $FW:absent&quot;; continue; fi; \
  [ -d &quot;$XCFW&quot; ] || continue; \
  for SDIR in &quot;$XCFW&quot;/*/; do \
    [ -d &quot;$SDIR&quot; ] || continue; \
    S=`basename &quot;$SDIR&quot;`; \
    echo &quot;$SLICES&quot; | awk -v s=&quot;$S&quot; '$0 == s { f = 1 } END { exit f ? 0 : 1 }' || ISSUES=&quot;$ISSUES $FW/$S:missing-from-sidecar&quot;; \
  done; \
done; \
echo &quot;$ISSUES&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ObjCBindingPackShapeIssues" />
    </Exec>

    <Error Condition="'$(_ObjCBindingPackShapeIssues)' != '' AND $(_ObjCBindingPackShapeIssues.Contains('MISSING_SIDECAR'))"
           Code="SWIFTBIND074"
           Text="Pure-ObjC binding pack is missing its native payload: there is no binding resource package at '$(_ObjCBindingResourceBase)' or '$(_ObjCBindingResourceBase).zip', or the one that exists carries no xcframework. On this lane the sidecar is the ONLY carrier of the native xcframework (no buildTransitive/ consumer .targets is emitted and no runtimes/ is packed), so the resulting nupkg would restore managed-only and fail at the consumer's link/dyld with missing ObjC symbols. Verify the project is a real binding project (&lt;IsBindingProject&gt;true&lt;/IsBindingProject&gt;), that &lt;NoBindingEmbedding&gt; is not disabled, and that the build produced the sidecar next to $(TargetName).dll before packing." />

    <Error Condition="'$(_ObjCBindingPackShapeIssues)' != '' AND '$(_ObjCBindingPackShapeIssues.Trim())' != '' AND !$(_ObjCBindingPackShapeIssues.Contains('MISSING_SIDECAR'))"
           Code="SWIFTBIND074"
           Text="Pure-ObjC binding resource package at '$(_ObjCBindingResourceBase)[.zip]' does not match the xcframeworks it was built from — $(_ObjCBindingPackShapeIssues.Trim()) ('&lt;Name&gt;:absent' = that xcframework is not in the sidecar at all; '&lt;Name&gt;/&lt;slice&gt;:missing-from-sidecar' = the source xcframework has that slice and the packed copy lost it). The sidecar is the only native carrier on this lane, so a consumer building for the dropped slice restores the package and then fails to link. This is a packaging defect, not a vendor one: a source xcframework that genuinely ships fewer slices packs faithfully and does not reach this message. Find the copy step that dropped the slice, or set &lt;IsPackable&gt;false&lt;/IsPackable&gt; for local-only use." />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7b: Synthesize consumer .targets for Apple-framework packs      -->
  <!-- In SDK mode the generator skips ConsumerTargetsEmitter (the SDK IS     -->
  <!-- the project system). For NuGet pack, _ConfigureSwiftBindingPack needs  -->
  <!-- $(PackageId).targets to exist. Synthesize it here from SDK metadata.   -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_SynthesizeAppleFrameworkConsumerTargets"
          AfterTargets="_ImportSwiftBindingMetadata"
          BeforeTargets="ResolveProjectReferences"
          Condition="'@(SwiftAppleFrameworkTarget)' != ''
                     AND '$(_SwiftBindingModuleName)' != ''
                     AND ('$(_SwiftBindingUpToDate)' != 'true'
                          OR !Exists('$(_SwiftBindingIntermediateDir)$(PackageId).targets'))">

    <!-- Pre-compute all dynamic identifiers to avoid nested $() in the heredoc -->
    <PropertyGroup>
      <_SanitizedModule>$(_SwiftBindingModuleName.Replace('.','_').Replace('-','_').Replace(' ','_'))</_SanitizedModule>
      <_CT_ResolveTarget>_Resolve$(_SwiftBindingModuleName.Replace('.','_').Replace('-','_').Replace(' ','_'))NativeReferences</_CT_ResolveTarget>
      <_CT_InjectedProp>_SwiftBinding_$(_SwiftBindingModuleName.Replace('.','_').Replace('-','_').Replace(' ','_'))_Injected</_CT_InjectedProp>
      <_CT_ValidateTarget>_Validate$(_SwiftBindingModuleName.Replace('.','_').Replace('-','_').Replace(' ','_'))PlatformVersion</_CT_ValidateTarget>
    </PropertyGroup>

    <!-- Use a second heredoc for the WRAPPER fragment to avoid &apos; inside
         single-quoted shell strings (which would terminate the quote early
         and break the Exists() condition path for NuGet consumers). The BRIDGE
         fragment mirrors it: when SwiftUI views were bridged, the consumer's
         $(PackageId).targets must also NativeReference the bundled
         <Module>Bridge.xcframework so [LibraryImport("<Module>Bridge")] P/Invokes
         resolve in Direct-mode NuGet consumption. Both fragments carry an Exists()
         guard, so a per-RID slice without the xcframework is a no-op. -->
    <Exec Command="WRAPPER=&quot;&quot;; \
if [ &quot;$(_SwiftBindingHasWrapperXCFramework)&quot; = &quot;True&quot; ]; then \
  read -r -d '' WRAPPER &lt;&lt;'WRAPPEREOF'
      &lt;NativeReference Include=&quot;%24(MSBuildThisFileDirectory)../../runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingWrapperModuleName).xcframework&quot;
                       Condition=&quot;Exists('%24(MSBuildThisFileDirectory)../../runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingWrapperModuleName).xcframework')&quot;&gt;
        &lt;Kind&gt;Framework&lt;/Kind&gt;
      &lt;/NativeReference&gt;
WRAPPEREOF
fi; \
BRIDGE=&quot;&quot;; \
if [ &quot;$(_SwiftBindingHasBridgeXCFramework)&quot; = &quot;True&quot; ]; then \
  read -r -d '' BRIDGE &lt;&lt;'BRIDGEEOF'
      &lt;!-- Native-macOS exclusion: the UIKit-only SwiftUI bridge has an empty macOS
           slice; referencing it makes a native-macOS consumer fail with MT158. The
           %24(TargetFramework) check is evaluated in the CONSUMER build. Catalyst
           keeps the bridge — net*-maccatalyst does not contain &quot;-macos&quot;. --&gt;
      &lt;NativeReference Include=&quot;%24(MSBuildThisFileDirectory)../../runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingBridgeModuleName).xcframework&quot;
                       Condition=&quot;Exists('%24(MSBuildThisFileDirectory)../../runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingBridgeModuleName).xcframework') AND !%24(TargetFramework.Contains('-macos'))&quot;&gt;
        &lt;Kind&gt;Framework&lt;/Kind&gt;
      &lt;/NativeReference&gt;
BRIDGEEOF
fi; \
cat &gt; &quot;$(_SwiftBindingIntermediateDir)$(PackageId).targets&quot; &lt;&lt;TARGETSEOF
&lt;Project&gt;
  &lt;PropertyGroup&gt;
    &lt;SwiftBindingsInteropMode Condition=&quot;'\%24(SwiftBindingsInteropMode)' == ''&quot;&gt;Auto&lt;/SwiftBindingsInteropMode&gt;
  &lt;/PropertyGroup&gt;
  &lt;PropertyGroup Condition=&quot;'\%24(SwiftBindingsInteropMode)' == 'Auto' AND '\%24(PublishAot)' == 'true'&quot;&gt;
    &lt;SwiftBindingsInteropMode&gt;Direct&lt;/SwiftBindingsInteropMode&gt;
  &lt;/PropertyGroup&gt;
  &lt;PropertyGroup Condition=&quot;'\%24(SwiftBindingsInteropMode)' == 'Auto'&quot;&gt;
    &lt;SwiftBindingsInteropMode&gt;Safe&lt;/SwiftBindingsInteropMode&gt;
  &lt;/PropertyGroup&gt;
  &lt;PropertyGroup Condition=&quot;'\%24(SwiftBindingsInteropMode)' == 'Direct'&quot;&gt;
    &lt;NoWarn&gt;\%24(NoWarn);SB0001&lt;/NoWarn&gt;
  &lt;/PropertyGroup&gt;
  &lt;!-- maccatalyst-x64 Mono JIT instability workaround.
       Defaults to Mono interpreter — JIT has four confirmed crash classes on this RID.
       Public docs: https://github.com/justinwojo/swift-dotnet-bindings/wiki/Known-Limitations
       Opt out: &lt;SwiftBindingsMacCatalystX64UseJit&gt;true&lt;/SwiftBindingsMacCatalystX64UseJit&gt; --&gt;
  &lt;PropertyGroup Condition=&quot;'\%24(RuntimeIdentifier)' == 'maccatalyst-x64' AND '\%24(SwiftBindingsMacCatalystX64UseJit)' != 'true'&quot;&gt;
    &lt;MtouchInterpreter Condition=&quot;'\%24(MtouchInterpreter)' == ''&quot;&gt;all&lt;/MtouchInterpreter&gt;
    &lt;UseInterpreter Condition=&quot;'\%24(UseInterpreter)' == ''&quot;&gt;true&lt;/UseInterpreter&gt;
  &lt;/PropertyGroup&gt;
  &lt;Target Name=&quot;_SwiftBindingsAnnounceMacCatalystX64Workaround&quot;
          BeforeTargets=&quot;Build&quot;
          Condition=&quot;'\%24(RuntimeIdentifier)' == 'maccatalyst-x64'
                     AND '\%24(SwiftBindingsMacCatalystX64UseJit)' != 'true'
                     AND '\%24(_SwiftBindingsMacCatalystX64WorkaroundAnnounced)' != 'true'&quot;&gt;
    &lt;PropertyGroup&gt;
      &lt;_SwiftBindingsMacCatalystX64WorkaroundAnnounced&gt;true&lt;/_SwiftBindingsMacCatalystX64WorkaroundAnnounced&gt;
    &lt;/PropertyGroup&gt;
    &lt;Message Importance=&quot;high&quot;
             Text=&quot;SwiftBindings: maccatalyst-x64 defaults MtouchInterpreter and UseInterpreter to interpreter mode (current: MtouchInterpreter='\%24(MtouchInterpreter)', UseInterpreter='\%24(UseInterpreter)') — the Mono x64 JIT has four confirmed crash classes on this RID (upstream-issue-04). Docs: https://github.com/justinwojo/swift-dotnet-bindings/wiki/Known-Limitations. Set &amp;lt;SwiftBindingsMacCatalystX64UseJit&amp;gt;true&amp;lt;/SwiftBindingsMacCatalystX64UseJit&amp;gt; to opt back into the JIT path (will crash until upstream fix lands).&quot; /&gt;
  &lt;/Target&gt;
  &lt;Target Name=&quot;$(_CT_ResolveTarget)&quot;
          BeforeTargets=&quot;ResolveNativeReferences&quot;
          Condition=&quot;'\%24($(_CT_InjectedProp))' != 'true'&quot;&gt;
    &lt;PropertyGroup&gt;
      &lt;$(_CT_InjectedProp)&gt;true&lt;/$(_CT_InjectedProp)&gt;
    &lt;/PropertyGroup&gt;
    &lt;ItemGroup&gt;
%24WRAPPER
%24BRIDGE
    &lt;/ItemGroup&gt;
  &lt;/Target&gt;
  &lt;ItemGroup&gt;
    &lt;SwiftBindingFramework Include=&quot;$(_SwiftBindingModuleName)&quot;&gt;
      &lt;SourcePackage&gt;$(PackageId)&lt;/SourcePackage&gt;
    &lt;/SwiftBindingFramework&gt;
  &lt;/ItemGroup&gt;
  &lt;ItemGroup&gt;
    &lt;SwiftModuleDatabase Include=&quot;\%24(MSBuildThisFileDirectory)$(_SwiftBindingModuleName)Database.xml&quot;
                         Condition=&quot;Exists('\%24(MSBuildThisFileDirectory)$(_SwiftBindingModuleName)Database.xml')&quot;&gt;
      &lt;ModuleName&gt;$(_SwiftBindingModuleName)&lt;/ModuleName&gt;
      &lt;SourcePackage&gt;$(PackageId)&lt;/SourcePackage&gt;
    &lt;/SwiftModuleDatabase&gt;
  &lt;/ItemGroup&gt;
  &lt;!-- NativeAOT trimmer-descriptor delivery (Apple-framework-direct PackageReference, ILC path
       only). The descriptor is packed loose beside this file in buildTransitive/$(_SwiftBindingPackTfm)/
       by _ConfigureSwiftBindingPack; ILC does not auto-discover the descriptor embedded in a referenced
       assembly, so root the loose copy via an IlcArg descriptor entry (plus a TrimmerRootDescriptor for
       the IL-trimmer sub-pass ILC runs internally). The standalone IL-trimmer path (PublishTrimmed
       without AOT) is covered by the descriptor embedded in the referenced binding assembly, which the
       trimmer auto-discovers, so this PublishAot-gated group is correct. The descriptor's
       &lt;assembly fullname&gt; is set under $(AssemblyName) (the generator assembly-name option) so it
       matches the packed managed DLL. Top-level ItemGroup is correct: the descriptor is a static package
       file present at the consumer's evaluation. Exists()-guarded so a binding with no open generics
       (no descriptor packed) no-ops. --&gt;
  &lt;ItemGroup Condition=&quot;'\%24(PublishAot)' == 'true' AND Exists('\%24(MSBuildThisFileDirectory)ILLink.Descriptors.xml')&quot;&gt;
    &lt;TrimmerRootDescriptor Include=&quot;\%24(MSBuildThisFileDirectory)ILLink.Descriptors.xml&quot; /&gt;
    &lt;IlcArg Include=&quot;--descriptor:\%24(MSBuildThisFileDirectory)ILLink.Descriptors.xml&quot; /&gt;
  &lt;/ItemGroup&gt;
  &lt;Target Name=&quot;$(_CT_ValidateTarget)&quot; BeforeTargets=&quot;Build&quot;
          Condition=&quot;'\%24(SupportedOSPlatformVersion)' != '' AND \%24([System.Version]::Parse('\%24(SupportedOSPlatformVersion)').CompareTo(\%24([System.Version]::Parse('$(_SwiftBindingMinimumOSVersion)')))) &amp;lt; 0&quot;&gt;
    &lt;Warning Text=&quot;$(PackageId) requires $(_SwiftBindingPlatform) $(_SwiftBindingMinimumOSVersion)+, but SupportedOSPlatformVersion is '\%24(SupportedOSPlatformVersion)'.&quot;
             Code=&quot;SWIFTBIND011&quot; /&gt;
  &lt;/Target&gt;
&lt;/Project&gt;
TARGETSEOF"
          StandardOutputImportance="low" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7b': Compute per-RID staged-source-xcframework paths            -->
  <!--                                                                         -->
  <!-- Source xcframeworks ship every slice (iOS, tvOS, macOS, watchOS, …)    -->
  <!-- per RID; the slicer drops slices the current RID can't consume so the  -->
  <!-- per-RID runtimes/<rid>/native/ directory only contains slices that RID -->
  <!-- can actually use. Properties have to be set in a separate target so    -->
  <!-- both the slicer Target and the pack Target see them — Inputs/Outputs   -->
  <!-- are evaluated before the body of the same target runs.                 -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_SetSlicePaths"
          DependsOnTargets="_DiscoverSwiftFrameworks"
          Condition="'@(SwiftFramework)' != ''">
    <PropertyGroup>
      <_SwiftBindingSourceXcfwName>$([System.IO.Path]::GetFileName('%(SwiftFramework.Identity)'))</_SwiftBindingSourceXcfwName>
      <_StagedSourceXcfwBaseDir>$(_SwiftBindingIntermediateDir)sliced/$(_SwiftBindingNuGetRid)/</_StagedSourceXcfwBaseDir>
      <_StagedSourceXcfwDir>$(_StagedSourceXcfwBaseDir)$(_SwiftBindingSourceXcfwName)/</_StagedSourceXcfwDir>
      <_StagedSourceXcfwStamp>$(_SwiftBindingIntermediateDir)sliced/$(_SwiftBindingNuGetRid).stamp</_StagedSourceXcfwStamp>
    </PropertyGroup>
    <!--
      Materialize per-framework _CodeSignature/CodeResources file list. Used by
      _SliceSourceXcframework as an Input alongside the generation fingerprint stamp:
      _ComputeSwiftFingerprint deliberately excludes _CodeSignature/* from its hash,
      but the slicer preserves signatures via ditto. Without this glob, re-signing
      the source xcframework in place wouldn't invalidate the cached slice and we'd
      ship stale signatures. Wildcard expansion happens here at task time (well-supported)
      so the slicer's Inputs attribute can reference a concrete @(_SourceXcfwSigFiles).
    -->
    <ItemGroup>
      <_SourceXcfwSigFiles Include="%(SwiftFramework.Identity)/**/_CodeSignature/CodeResources" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7b'': Slice the source xcframework for the current RID          -->
  <!--                                                                         -->
  <!-- Inputs use $(_SwiftStampFile) (already updated whenever the source     -->
  <!-- xcframework or generation-affecting properties change, by              -->
  <!-- _ComputeSwiftFingerprint) and the generator binary itself (so an      -->
  <!-- emitter-only change invalidates cached slices, same pattern as         -->
  <!-- _GenerateAppleTypeSources in Swift.Bindings.Apple.csproj).             -->
  <!--                                                                         -->
  <!-- _ComputeSwiftFingerprint deliberately excludes _CodeSignature/* from   -->
  <!-- its hash, but the slicer preserves per-framework signatures via ditto. -->
  <!-- Glob CodeResources files explicitly so a re-signed-in-place source     -->
  <!-- xcframework invalidates the staged slice and we don't ship stale sigs. -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Pure-ObjC packs don't ship runtimes/ at all (the sidecar resources.zip carries the
       native), so slicing for a directory that is never packed is pure cost — skipped here
       rather than at the pack item. Unlike the static-archive drop above, this decision is a
       stable property read from persisted metadata, so a target-level Condition is safe (it
       does not depend on _ComputeSwiftBindingSourceXcframeworkInclusion's live-disk probe). -->
  <Target Name="_SliceSourceXcframework"
          DependsOnTargets="_ImportSwiftBindingMetadata;_SetSlicePaths;_ComputeSwiftFingerprint"
          BeforeTargets="_ConfigureSwiftBindingPack"
          Condition="'$(IsPackable)' == 'true' AND '$(TargetFramework)' != '' AND '@(SwiftFramework)' != '' AND '$(SwiftFrameworkType)' != 'ObjC'"
          Inputs="$(_SwiftStampFile);$(_SwiftBindingGeneratorDir)Swift.Bindings.dll;@(_SourceXcfwSigFiles)"
          Outputs="$(_StagedSourceXcfwStamp)">
    <MakeDir Directories="$(_StagedSourceXcfwBaseDir)" />
    <RemoveDir Directories="$(_StagedSourceXcfwDir)" Condition="Exists('$(_StagedSourceXcfwDir)')" />
    <Exec Command="dotnet exec &quot;$(_SwiftBindingGeneratorDir)Swift.Bindings.dll&quot; --slice-xcframework --xcframework &quot;%(SwiftFramework.Identity)&quot; --rid $(_SwiftBindingNuGetRid) -o &quot;$(_StagedSourceXcfwDir)&quot;"
          ConsoleToMSBuild="true" />
    <Touch Files="$(_StagedSourceXcfwStamp)" AlwaysCreate="true" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7b''': Stage the generated API-surface doc as the package README -->
  <!--                                                                         -->
  <!-- A binding package otherwise ships with no readme at all, so nuget.org   -->
  <!-- shows a consumer nothing about what the package contains. The generator -->
  <!-- already writes {namespace}.api-surface.md — the member table derived    -->
  <!-- from what it actually emitted — so that IS the readme: it cannot drift  -->
  <!-- from the shipped API the way a hand-written one does.                   -->
  <!--                                                                         -->
  <!-- Two targets, because the two halves live in different builds. The stage -->
  <!-- runs per-TFM (that is where the generator output lives) and writes THAT -->
  <!-- TFM's fragment; the combine-and-name half must run in the OUTER build,  -->
  <!-- because PackageReadmeFile is read by GenerateNuspec there and an        -->
  <!-- inner-build property never reaches it.                                  -->
  <!--                                                                         -->
  <!-- A run that binds several Swift modules emits one doc each; they are     -->
  <!-- concatenated rather than one being picked, so the readme describes the  -->
  <!-- whole package.                                                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_StageSwiftBindingApiSurfaceReadme"
          BeforeTargets="_ConfigureSwiftBindingPack"
          Condition="'$(IsPackable)' == 'true' AND '$(TargetFramework)' != ''
                     AND '$(SwiftBindingPackApiSurfaceReadme)' != 'false'">
    <ItemGroup>
      <_SwiftBindingApiSurfaceDoc Include="$(_SwiftBindingIntermediateDir)*.api-surface.md" />
    </ItemGroup>

    <!-- Unconditional, and BEFORE the write: obj/ survives between packs, so a generation that
         now emits no surface doc has to clear this TFM's fragment rather than leave the previous
         run's for the outer build to find. Staleness here would ship a readme describing an API
         the package no longer contains. -->
    <Delete Files="$(_SwiftBindingTfmReadmeFragment)" />

    <MakeDir Directories="$(_SwiftBindingReadmeStageDir)"
             Condition="'@(_SwiftBindingApiSurfaceDoc)' != ''" />
    <Exec Condition="'@(_SwiftBindingApiSurfaceDoc)' != ''"
          Command="cat @(_SwiftBindingApiSurfaceDoc->'&quot;%(FullPath)&quot;', ' ') &gt; &quot;$(_SwiftBindingTfmReadmeFragment)&quot;" />
  </Target>

  <!-- Runs immediately before NuGet collects the package files. _GetPackageFiles belongs to the
       build that produces the nuspec, and it comes after _WalkEachTargetPerFramework in
       GenerateNuspecDependsOn — so every inner build has already staged its fragment by the time
       this combines them, in both the single- and multi-TFM shapes.

       The fragments are enumerated from the project's DECLARED target frameworks, not by globbing
       the stage directory: that fixes both the order (a cross-targeting pack's readme reads in the
       order the project lists its TFMs, not in whatever order the filesystem hands back) and the
       membership (a TFM dropped from the project since the last pack leaves its fragment behind on
       disk, and enumerating declarations ignores it). The combined file is deleted first for the
       same staleness reason the fragments are.

       Both halves are deliberately conservative. A project that names its own readme, or ships
       a README.md of its own, keeps it: taking that over would be surprising, and packing two
       files to the package root is NU5118. The PackageReadmeFile property is set only when a
       fragment actually exists, because naming an absent readme is a hard NU5039 error — so
       a binding whose generator emitted no surface doc simply packs without a readme.

       IncludeContentInPack=false skips _GetPackageFiles entirely, which would leave the readme
       named but unpacked (NU5039 again), so that configuration opts out too. -->
  <Target Name="_SetSwiftBindingPackageReadme"
          BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' == 'true'
                     AND '$(PackageReadmeFile)' == ''
                     AND '$(IncludeContentInPack)' != 'false'
                     AND '$(SwiftBindingPackApiSurfaceReadme)' != 'false'
                     AND !Exists('$(MSBuildProjectDirectory)/README.md')">
    <ItemGroup>
      <_SwiftBindingReadmeTfm Include="$(TargetFrameworks)" Condition="'$(TargetFrameworks)' != ''" />
      <_SwiftBindingReadmeTfm Include="$(TargetFramework)" Condition="'$(TargetFrameworks)' == ''" />
      <_SwiftBindingReadmeFragment
          Include="@(_SwiftBindingReadmeTfm->'$(_SwiftBindingReadmeStageDir)%(Identity).api-surface.md')" />
      <_SwiftBindingReadmeFragmentPresent Include="@(_SwiftBindingReadmeFragment)"
                                          Condition="Exists('%(Identity)')" />
    </ItemGroup>

    <Delete Files="$(_SwiftBindingStagedReadme)" />
    <Exec Condition="'@(_SwiftBindingReadmeFragmentPresent)' != ''"
          Command="cat @(_SwiftBindingReadmeFragmentPresent->'&quot;%(FullPath)&quot;', ' ') &gt; &quot;$(_SwiftBindingStagedReadme)&quot;" />

    <PropertyGroup Condition="'@(_SwiftBindingReadmeFragmentPresent)' != ''">
      <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup Condition="'@(_SwiftBindingReadmeFragmentPresent)' != ''">
      <None Include="$(_SwiftBindingStagedReadme)" Pack="true" PackagePath="" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Target 7c: Configure NuGet pack layout                                 -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--
    Target Condition deliberately omits any check on @(SwiftFramework) or
    @(SwiftAppleFrameworkTarget). NuGet's inner-pack call to
    _GetTfmSpecificContentForPackage evaluates $(TargetsForTfmSpecificContentInPackage)
    on a restricted subgraph that does NOT include _ComputeSwiftFingerprint — the
    only hook that fires _DiscoverSwiftFrameworks. If we gate this target on the
    dynamically-populated @(SwiftFramework) item, MSBuild evaluates that Condition
    to false in inner-pack (the item hasn't been discovered yet), the entire target
    — including DependsOnTargets — is skipped, and the resulting nupkg ships with
    only the managed DLL: no runtimes/<rid>/native/, no buildTransitive/, no
    module database. (Issue #39: silent regression on auto-discovery bindings.)
    Stable-property Condition keeps us in the build graph; _DiscoverSwiftFrameworks
    explicitly in DependsOnTargets populates @(SwiftFramework) before the body's
    per-item Conditions are evaluated.
  -->
  <Target Name="_ConfigureSwiftBindingPack"
          DependsOnTargets="_DiscoverSwiftFrameworks;_ImportSwiftBindingMetadata;_SetSlicePaths;_ComputeSwiftBindingSourceXcframeworkInclusion;_BuildMixedObjCCompanion"
          Condition="'$(IsPackable)' == 'true' AND '$(TargetFramework)' != ''"
          Returns="@(TfmSpecificPackageFile)">

    <!--
      Compute a version-qualified TFM for NuGet pack paths.
      NuGet NU1012 requires platform version in framework-specific PackagePath entries
      (e.g. buildTransitive/net10.0-ios26.0/, not buildTransitive/net10.0-ios/).
      If the user specified a versionless TFM (e.g. net10.0-ios), the .NET SDK still
      resolves $(TargetPlatformVersion) from the installed workload. We detect the
      versionless form by checking if $(TargetFramework) ends with the bare platform
      identifier, and append the resolved version if so.

      In Apple-framework direct mode, the consumer-settable
      $(SwiftAppleFrameworkPlatformVersion) wins over $(TargetPlatformVersion) for the
      generator (see line ~213); use the same effective value here so the generator
      output, the fingerprint, and the pack layout never disagree on the version. On a
      multi-workload machine a versionless TFM with $(SwiftAppleFrameworkPlatformVersion)
      set to 26.2 would otherwise produce 26.2 metadata staged under
      buildTransitive/net10.0-ios26.0/ — the drift C2 eliminated for the generator path.
    -->
    <PropertyGroup>
      <_SwiftBindingEffectivePlatformVersion>$(TargetPlatformVersion)</_SwiftBindingEffectivePlatformVersion>
      <_SwiftBindingEffectivePlatformVersion
          Condition="'$(_SwiftBindingTargetKind)' == 'AppleFramework' AND '$(SwiftAppleFrameworkPlatformVersion)' != ''">$(SwiftAppleFrameworkPlatformVersion)</_SwiftBindingEffectivePlatformVersion>
      <_SwiftBindingPackTfm>$(TargetFramework)</_SwiftBindingPackTfm>
      <_SwiftBindingPackTfm
          Condition="'$(_SwiftBindingEffectivePlatformVersion)' != ''
                     AND $(TargetFramework.EndsWith('$(_SwiftBindingPlatform)'))">$(TargetFramework)$(_SwiftBindingEffectivePlatformVersion)</_SwiftBindingPackTfm>
    </PropertyGroup>

    <!-- Fail fast if we can't resolve a versioned TFM for pack. In Apple-framework
         direct mode SWIFTBIND016 already fires earlier when SwiftAppleFrameworkPlatformVersion
         is empty; this catches the xcframework-mode case and any direct-mode path that
         slipped past (defensive). -->
    <Error Condition="$(TargetFramework.EndsWith('$(_SwiftBindingPlatform)'))
                      AND '$(_SwiftBindingEffectivePlatformVersion)' == ''"
           Code="SWIFTBIND035"
           Text="Cannot resolve platform version for NuGet pack. Specify a versioned TargetFramework (e.g. net10.0-ios26.0), install the corresponding platform workload, or in Apple-framework direct mode set &lt;SwiftAppleFrameworkPlatformVersion&gt;." />

    <!--
      Guard: the managed DLL is added to lib/ by the .NET SDK's pack pipeline (not by our
      TfmSpecificPackageFile ItemGroup below). If a consumer config accidentally suppresses
      it (OutputType=Module, IncludeBuildOutput=false, or a missing compile), the resulting
      nupkg would ship with native xcframeworks in runtimes/ but nothing in lib/ — bindings
      at runtime would throw TypeLoadException. Verify the target assembly exists on disk
      so we fail at pack, not at the consumer's first DllImport.
    -->
    <Error Condition="'$(IncludeBuildOutput)' == 'false'"
           Code="SWIFTBIND037"
           Text="Swift binding packages must not set IncludeBuildOutput=false — the managed DLL must land under lib/$(_SwiftBindingPackTfm)/ so P/Invoke can resolve at runtime. Remove the IncludeBuildOutput override (or set it to true)." />
    <Error Condition="'$(TargetPath)' == '' OR !Exists('$(TargetPath)')"
           Code="SWIFTBIND037"
           Text="No managed build output resolved for pack. Expected '$(TargetPath)' to exist so NuGet can stage it under lib/$(_SwiftBindingPackTfm)/. Verify OutputType=Library and that the project actually produces a DLL for this TFM." />

    <!-- Arrange NuGet pack layout using TfmSpecificPackageFile for multi-TFM support.
         In multi-TFM projects, the .NET SDK's _WalkEachTargetPerFramework target invokes
         this target per-TFM via TargetsForTfmSpecificContentInPackage (set in Sdk.props)
         and collects TfmSpecificPackageFile items. Using None+Pack=true only works in
         single-TFM projects because _GetPackageFiles runs in the outer build context. -->
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_SwiftBindingIntermediateDir)$(PackageId).targets"
            PackagePath="buildTransitive/$(_SwiftBindingPackTfm)/"
            Condition="Exists('$(_SwiftBindingIntermediateDir)$(PackageId).targets')" />
      <!-- ILLink trimmer descriptor, packed loose beside $(PackageId).targets in
           buildTransitive/$(_SwiftBindingPackTfm)/ so the consumer-facing .targets (written by
           ConsumerTargetsEmitter, or synthesized in _SynthesizeAppleFrameworkConsumerTargets for
           Apple-framework targets) can root it via $(MSBuildThisFileDirectory)ILLink.Descriptors.xml
           for a downstream PackageReference NativeAOT publish. The generator emits the descriptor
           into the intermediate dir only when the module has ≥1 open-generic ISwiftObject, so the
           Exists() guard no-ops otherwise. Its <assembly fullname> is rooted under $(AssemblyName)
           (passed via the assembly-name generator option) so it matches the managed DLL packed
           under lib/. -->
      <TfmSpecificPackageFile Include="$(_SwiftBindingIntermediateDir)ILLink.Descriptors.xml"
            PackagePath="buildTransitive/$(_SwiftBindingPackTfm)/"
            Condition="Exists('$(_SwiftBindingIntermediateDir)ILLink.Descriptors.xml')" />
      <!-- Source xcframework, sliced down to slices the current RID can consume.
           Wrapper/bridge xcframeworks are already per-TFM (no duplication problem)
           and are packed raw below. _SliceSourceXcframework runs BeforeTargets this
           target so $(_StagedSourceXcfwDir) is populated by the time we enumerate it.
           Dropped for a static-archive source WHEN the wrapper xcframework exists: the
           wrapper force-loads the archive and is the sole carrier, so packing the source
           xcframework too would ship the same ObjC classes twice (Gap 2). The slice still
           stages (the gate is here, at the pack item — a target-level Condition on
           _SliceSourceXcframework would read the property at evaluation phase, before the
           decision is computed), but the staged slice is never packed. The shared
           _ComputeSwiftBindingSourceXcframeworkInclusion decision packs the source as the sole
           carrier when the wrapper is absent (SwiftWrapperRequired=false soft-failure) so the
           nupkg never ships with no native, and stays in lockstep with the reference sites.

           ALSO dropped for the pure-ObjC lane ($(SwiftFrameworkType) == 'ObjC'), where it is
           dead weight rather than a carrier. A pure-ObjC binding is a real Microsoft.iOS binding
           project (IsBindingProject=true), so the workload already packs its @(NativeReference)
           xcframeworks into the classic sidecar lib/<tfm>/$(AssemblyName).resources.zip, which
           the CONSUMER's build extracts, embeds and signs. Nothing on this lane ever reads
           runtimes/: ConsumerTargetsEmitter is unreachable on the pure-ObjC generator branch
           (BindingsGeneratorCommand returns after ObjCPipeline.Run) and
           _SynthesizeAppleFrameworkConsumerTargets is @(SwiftAppleFrameworkTarget)-only, so no
           $(PackageId).targets exists to emit a NativeReference into runtimes/ — the payload was
           a byte-for-byte duplicate of the sidecar with no reference pointing at it. The sidecar
           is the load-bearing copy and _ValidateObjCBindingPackShape (SWIFTBIND074) asserts it.
           Swift/mixed packs KEEP runtimes/: their packed consumer .targets NativeReference into
           exactly this path. See src/docs/Design/objc-binding-consumption.md. -->
      <TfmSpecificPackageFile Include="$(_StagedSourceXcfwDir)**"
            PackagePath="runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingSourceXcfwName)/"
            Condition="'@(SwiftFramework)' != ''
                       AND '$(SwiftFrameworkType)' != 'ObjC'
                       AND '$(_SwiftBindingIncludeSourceXcframework)' == 'true'" />
      <TfmSpecificPackageFile Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingWrapperModuleName).xcframework/**"
            PackagePath="runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingWrapperModuleName).xcframework/"
            Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True'" />
      <!-- Native-macOS exclusion: don't ship the UIKit-only bridge's empty macOS
           slice (it would MT158 if a consumer referenced it). Catalyst still packs
           its bridge — net*-maccatalyst does not contain "-macos". -->
      <TfmSpecificPackageFile Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingBridgeModuleName).xcframework/**"
            PackagePath="runtimes/$(_SwiftBindingNuGetRid)/native/$(_SwiftBindingBridgeModuleName).xcframework/"
            Condition="'$(_SwiftBindingHasBridgeXCFramework)' == 'True' AND !$(TargetFramework.Contains('-macos'))" />
      <!-- Module database for cross-module type resolution in downstream binding projects -->
      <TfmSpecificPackageFile Include="$(_SwiftBindingIntermediateDir)$(_SwiftBindingModuleName)Database.xml"
            PackagePath="buildTransitive/$(_SwiftBindingPackTfm)/"
            Condition="Exists('$(_SwiftBindingIntermediateDir)$(_SwiftBindingModuleName)Database.xml')" />
      <!-- Mixed framework: embed the ObjC companion's managed assembly into THIS package's
           lib/ so a single PackageReference delivers both the Swift and ObjC surfaces of the
           one xcframework. _BuildMixedObjCCompanion (DependsOnTargets) builds the companion and
           sets _SwiftBindingCompanionBuildOutput to its assembly path (via GetTargetPath). The
           companion is managed-only — its native ObjC class is force-loaded from the wrapper /
           source already shipped under runtimes/, so no native is duplicated. -->
      <TfmSpecificPackageFile Include="@(_SwiftBindingCompanionBuildOutput)"
            PackagePath="lib/$(_SwiftBindingPackTfm)/"
            Condition="'@(_SwiftBindingCompanionBuildOutput)' != ''" />
    </ItemGroup>

    <!--
      Sibling of SWIFTBIND037 (managed side). Fails loudly when persisted metadata
      says we built native artifacts but pack staged zero TfmSpecificPackageFile
      entries — the silent-broken-nupkg shape that issue #39 hit. With the target
      Condition correctly bounded above this guard cannot misfire on normal Apple
      framework or auto-discover packs; it exists to fail-closed if a future
      change re-gates the body on an item that isn't populated in inner-pack.
    -->
    <Error Condition="'$(_SwiftBindingHasWrapperXCFramework)' == 'True' AND '@(TfmSpecificPackageFile)' == ''"
           Code="SWIFTBIND038"
           Text="Pack produced no native runtime content for a Swift binding that built a wrapper xcframework (module: $(_SwiftBindingWrapperModuleName)). The resulting nupkg would ship managed-only and DllNotFoundException at consumer runtime. This indicates a regression in the pack target graph — verify _DiscoverSwiftFrameworks runs in the NuGet inner-pack subgraph (_GetTfmSpecificContentForPackage) and that _ConfigureSwiftBindingPack's per-item Conditions still match populated state." />

    <!-- Invariant: dropping the source xcframework is only safe when a wrapper xcframework is
         actually packed to carry the native. The drop decision (_ComputeSwiftBindingSourceXcframeworkInclusion)
         reads live disk — Exists(wrapper) — while the wrapper-pack item above reads the persisted
         _SwiftBindingHasWrapperXCFramework. A stale wrapper dir left on disk while the metadata refresh
         records HasWrapper=False would drop the source AND skip the wrapper, shipping a native-less
         package; SWIFTBIND038 cannot catch it because it is gated on HasWrapper=='True'. Fail closed on
         the violated invariant (source-dropped ⟹ wrapper-packed) instead of shipping broken. -->
    <Error Condition="'$(_SwiftBindingIncludeSourceXcframework)' == 'false' AND '$(_SwiftBindingHasWrapperXCFramework)' != 'True'"
           Code="SWIFTBIND040"
           Text="Source xcframework was dropped for static linkage (a wrapper exists on disk) but no wrapper xcframework was packed (_SwiftBindingHasWrapperXCFramework is not 'True'). The resulting nupkg would ship with no native payload and DllNotFoundException at consumer runtime. This indicates stale wrapper artifacts or a metadata-refresh gap: clean $(_SwiftBindingIntermediateDir) and regenerate so the wrapper is rebuilt and its presence re-recorded." />

    <!-- Mixed metadata names an ObjC companion, but _BuildMixedObjCCompanion captured no
         assembly to embed: fail loudly rather than silently ship a Swift-only package whose
         consumers would hit TypeLoadException on the ObjC types. ($(_SwiftBindingFrameworkType)
         and $(_SwiftBindingObjCProjectName) are set by _BuildMixedObjCCompanion, which ran via
         DependsOnTargets in this same invocation.) -->
    <Error Condition="'$(_SwiftBindingFrameworkType)' == 'Mixed'
                      AND '$(_SwiftBindingObjCProjectName)' != ''
                      AND '@(_SwiftBindingCompanionBuildOutput)' == ''"
           Code="SWIFTBIND039"
           Text="Mixed-framework binding metadata names an ObjC companion ($(_SwiftBindingObjCProjectName)) but no built companion assembly was captured to embed in lib/. The mixed framework ships as a single package with the companion embedded, so packing without it would ship the Swift surface but not the ObjC types. Re-run binding generation so the companion csproj is emitted, and verify it restores+builds (_BuildMixedObjCCompanion)." />
  </Target>
</Project>
