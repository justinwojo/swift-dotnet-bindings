<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-ios</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0169;CA1420;SB0001;SB0002;SB0003;SB0004</NoWarn>

    <!-- SDK internal paths -->
    <_SwiftBindingSdkVersion>0.1.0-preview.12</_SwiftBindingSdkVersion>
    <_SwiftBindingGeneratorDir>$(MSBuildThisFileDirectory)../tools/net10.0/any/</_SwiftBindingGeneratorDir>

    <!-- User-configurable -->
    <SwiftPlatformTarget Condition="'$(SwiftPlatformTarget)' == ''">simulator</SwiftPlatformTarget>
    <SwiftGeneratorVerbosity Condition="'$(SwiftGeneratorVerbosity)' == ''">1</SwiftGeneratorVerbosity>
    <!-- Default to both slices (device + simulator) so dotnet pack always works -->
    <!-- Fast-iteration users can override to 'simulator' for quicker dev builds -->
    <SwiftWrapperArchitectures Condition="'$(SwiftWrapperArchitectures)' == ''">all</SwiftWrapperArchitectures>
    <!-- Property-driven version floor — users can override to use newer runtime -->
    <SwiftRuntimeVersion Condition="'$(SwiftRuntimeVersion)' == ''">0.1.0-preview.8</SwiftRuntimeVersion>
    <!-- Auto-extract symbol graph for doc comments (set to false to disable) -->
    <SwiftGenerateDocComments Condition="'$(SwiftGenerateDocComments)' == ''">true</SwiftGenerateDocComments>
    <!-- Auto-detect framework dependencies from binary linkage (set to false to disable) -->
    <SwiftAutoDetectDependencies Condition="'$(SwiftAutoDetectDependencies)' == ''">true</SwiftAutoDetectDependencies>
  </PropertyGroup>

  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <!-- Implicit Swift.Runtime reference with minimum version floor -->
  <ItemGroup>
    <PackageReference Include="Swift.Runtime" Version="$(SwiftRuntimeVersion)"
                      Condition="'$(DisableImplicitSwiftRuntimeReference)' != 'true'" />
  </ItemGroup>

  <!-- Inject PackageReference for each SwiftFrameworkDependency with PackageId + PackageVersion.
       This must be in .props (evaluation-time) so NuGet restore picks up the references
       before the build targets run. Without both metadata values, the reference is skipped. -->
  <ItemGroup Condition="'@(SwiftFrameworkDependency)' != ''">
    <PackageReference Include="%(SwiftFrameworkDependency.PackageId)"
                      Version="%(SwiftFrameworkDependency.PackageVersion)"
                      Condition="'%(SwiftFrameworkDependency.PackageId)' != '' AND '%(SwiftFrameworkDependency.PackageVersion)' != ''" />
  </ItemGroup>

  <!-- NOTE: Auto-discovery is in Sdk.targets (after project body evaluation) -->
  <!-- so explicit <SwiftFramework> items in the project are seen first        -->
</Project>
