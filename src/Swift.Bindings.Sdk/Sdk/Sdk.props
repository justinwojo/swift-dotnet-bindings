<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <!-- No default TFM: consumers must declare TargetFramework or TargetFrameworks.
         A default here would conflict with multi-TFM projects because Sdk.props is
         evaluated before the project body (where TargetFrameworks is set).
         The 'dotnet new swift-binding' template provides the default for new projects. -->
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0169;CA1420;SB0001;SB0002;SB0003;SB0004</NoWarn>

    <!-- Exclude nested obj/ directories from default Compile globs.
         Microsoft.NET.Sdk only excludes $(BaseIntermediateOutputPath)/** (= obj/**),
         but SDK consumer projects may have sibling test projects with their own obj/
         directories (e.g. tests/obj/) whose auto-generated assembly info files would
         otherwise be globbed by **/*.cs and cause CS0579 duplicate attribute errors. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**</DefaultItemExcludes>

    <!-- SDK internal paths -->
    <_SwiftBindingSdkVersion>0.0.0-dev</_SwiftBindingSdkVersion>
    <_SwiftBindingGeneratorDir>$(MSBuildThisFileDirectory)../tools/net10.0/any/</_SwiftBindingGeneratorDir>

    <!-- NOTE: Platform detection (_SwiftBindingPlatform et al) lives in Sdk.targets,
         not here. Sdk.props is imported BEFORE the project body, so $(TargetFramework)
         is empty for single-TFM projects (the most common shape, including the
         dotnet new swift-binding template default). Multi-TFM inner builds happen to
         set TargetFramework as a global property and would work either way, but
         single-TFM is the case we ship for, so the detection runs in Sdk.targets
         after the project body has set the property. -->

    <!-- User-configurable -->
    <SwiftGeneratorVerbosity Condition="'$(SwiftGeneratorVerbosity)' == ''">1</SwiftGeneratorVerbosity>
    <!-- Default to both slices (device + simulator) so dotnet pack always works -->
    <!-- Fast-iteration users can override to 'simulator' for quicker dev builds -->
    <SwiftWrapperArchitectures Condition="'$(SwiftWrapperArchitectures)' == ''">all</SwiftWrapperArchitectures>
    <!-- Property-driven version floor — users can override to use newer runtime.
         SwiftRuntimeVersion is the exact version generated code depends on (stamped by
         VersionScope at pack time). SwiftRuntimePackageVersionRange is the NuGet version
         range used in PackageReference — a bare "0.8.0" is interpreted by NuGet as a
         minimum-only float, which would let consumers slide into 0.9.0 and break the
         compatibility boundary; the bounded range pins the minor floor instead. Both values
         derive from the same VersionScope stamp so SDK and standalone paths cannot drift. -->
    <SwiftRuntimeVersion Condition="'$(SwiftRuntimeVersion)' == ''">0.0.0-dev</SwiftRuntimeVersion>
    <SwiftRuntimePackageVersionRange Condition="'$(SwiftRuntimePackageVersionRange)' == ''">[0.0.0-dev,0.1.0)</SwiftRuntimePackageVersionRange>
    <!-- SwiftBindings.Apple supplement version (follows the Apple SDK train, not SwiftRuntimeVersion).
         Stamped by VersionScope at pack time; users can override for prototype workflows. Threaded
         through to both generator invocations via the apple-version option so future Apple train bumps
         need only a single input, instead of being hardcoded across CliOptions, BindingProjectEmitter,
         and XCFrameworkMetadataExtractor. -->
    <SwiftAppleSupplementVersion Condition="'$(SwiftAppleSupplementVersion)' == ''">0.0.0-dev</SwiftAppleSupplementVersion>
    <!-- Require wrapper compilation to succeed (set to false for libraries with known internal type issues) -->
    <SwiftWrapperRequired Condition="'$(SwiftWrapperRequired)' == ''">true</SwiftWrapperRequired>
    <!-- Auto-extract symbol graph for doc comments (set to false to disable) -->
    <SwiftGenerateDocComments Condition="'$(SwiftGenerateDocComments)' == ''">true</SwiftGenerateDocComments>
    <!-- Auto-detect framework dependencies from binary linkage (set to false to disable) -->
    <SwiftAutoDetectDependencies Condition="'$(SwiftAutoDetectDependencies)' == ''">true</SwiftAutoDetectDependencies>
    <!-- Apple-supplement prototype mode: when set, the generator emits a trimmed
         SwiftBindings.Apple.Prototype.csproj into this directory (plus .cs sources for the
         Apple-supplement types referenced by this run) and wires the generated consumer project
         to it via ProjectReference instead of a PackageReference. Lets developers iterate on
         supplement changes without waiting for a new NuGet publish. No default — users opt in
         explicitly by setting this property. No-op when the run resolves no supplement types. -->
    <SwiftAppleSupplementPrototypeDir Condition="'$(SwiftAppleSupplementPrototypeDir)' == ''"></SwiftAppleSupplementPrototypeDir>
    <!-- NOTE: SwiftAppleFrameworkMinDeploymentVersion default is set in Sdk.targets,
         alongside the rest of the platform-derived properties (see note above). -->

    <!-- Register our pack target for per-TFM content collection.
         This is how .NET SDK's NuGet pack discovers per-TFM pack items
         in multi-TFM projects (via _WalkEachTargetPerFramework). -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_ConfigureSwiftBindingPack</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- ObjC-only framework overrides: binding project, no Swift.Runtime, no unsafe -->
  <PropertyGroup Condition="'$(SwiftFrameworkType)' == 'ObjC'">
    <IsBindingProject>true</IsBindingProject>
    <DisableImplicitSwiftRuntimeReference>true</DisableImplicitSwiftRuntimeReference>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types -->
  <ItemGroup Condition="'$(SwiftFrameworkType)' != 'ObjC'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <!-- Implicit Swift.Runtime reference. Uses the bounded range (not bare version) so NuGet
       pins consumers inside the current minor and they can't silently slide across a
       compatibility boundary (see SwiftRuntimePackageVersionRange above). -->
  <ItemGroup>
    <PackageReference Include="SwiftBindings.Runtime" Version="$(SwiftRuntimePackageVersionRange)"
                      Condition="'$(DisableImplicitSwiftRuntimeReference)' != 'true'" />
  </ItemGroup>

  <!-- Implicit SwiftBindings.Apple reference.
       Must be declared here (props, evaluation-time) instead of in a target so NuGet restore
       picks it up before build. On a cold build, the generator has not yet run, so
       _InjectAppleSupplementPrototype in Sdk.targets cannot inject a PackageReference in time
       for restore; by the time it fires, restore has finished and CS0234 fires on any generated
       type referencing Swift.Foundation (or any other supplement namespace). Adding it here
       means the package is always restored, even for bindings that turn out not to need any
       supplement types — negligible cost (metadata + assemblies) for a silent-crash avoidance.
       Skipped for ObjC-only framework bindings (no Swift-only supplement types possible) and
       when DisableImplicitSwiftAppleReference opts out. Floor-only range matches the supplement
       policy: cross-major additive-only, so consumers can always float forward onto a newer
       Apple SDK train. _InjectAppleSupplementPrototype still handles the prototype-csproj branch
       (ProjectReference wins over PackageReference when both are present). -->
  <ItemGroup>
    <PackageReference Include="SwiftBindings.Apple" Version="[$(SwiftAppleSupplementVersion),)"
                      Condition="'$(DisableImplicitSwiftAppleReference)' != 'true'
                                 AND '$(SwiftFrameworkType)' != 'ObjC'" />
  </ItemGroup>

  <!-- Inject PackageReference for each SwiftFrameworkDependency with PackageId + PackageVersion.
       This must be in .props (evaluation-time) so NuGet restore picks up the references
       before the build targets run. Without both metadata values, the reference is skipped. -->
  <ItemGroup Condition="'@(SwiftFrameworkDependency)' != ''">
    <PackageReference Include="%(SwiftFrameworkDependency.PackageId)"
                      Version="%(SwiftFrameworkDependency.PackageVersion)"
                      Condition="'%(SwiftFrameworkDependency.PackageId)' != '' AND '%(SwiftFrameworkDependency.PackageVersion)' != ''" />
  </ItemGroup>

  <!-- NOTE: Auto-discovery is in Sdk.targets (after project body evaluation) -->
  <!-- so explicit <SwiftFramework> items in the project are seen first        -->
</Project>
