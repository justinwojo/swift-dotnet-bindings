<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <!-- No default TFM: consumers must declare TargetFramework or TargetFrameworks.
         A default here would conflict with multi-TFM projects because Sdk.props is
         evaluated before the project body (where TargetFrameworks is set).
         The 'dotnet new swift-binding' template provides the default for new projects. -->
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0169;CA1420;SB0001;SB0002;SB0003;SB0004</NoWarn>

    <!-- Exclude nested obj/ directories from default Compile globs.
         Microsoft.NET.Sdk only excludes $(BaseIntermediateOutputPath)/** (= obj/**),
         but SDK consumer projects may have sibling test projects with their own obj/
         directories (e.g. tests/obj/) whose auto-generated assembly info files would
         otherwise be globbed by **/*.cs and cause CS0579 duplicate attribute errors. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**</DefaultItemExcludes>

    <!-- SDK internal paths -->
    <_SwiftBindingSdkVersion>0.0.0-dev</_SwiftBindingSdkVersion>
    <_SwiftBindingGeneratorDir>$(MSBuildThisFileDirectory)../tools/net10.0/any/</_SwiftBindingGeneratorDir>

    <!-- Auto-detect platform from TFM (maccatalyst before macos to avoid substring overlap) -->
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('maccatalyst'))">maccatalyst</_SwiftBindingPlatform>
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('tvos'))">tvos</_SwiftBindingPlatform>
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('macos'))">macos</_SwiftBindingPlatform>
    <_SwiftBindingPlatform Condition="'$(_SwiftBindingPlatform)' == '' AND $(TargetFramework.Contains('ios'))">ios</_SwiftBindingPlatform>
    <!-- Fail fast for unsupported TFMs (e.g. net10.0, net10.0-android, typos).
         No fallback assignment — _SwiftBindingPlatform stays empty so downstream
         properties also stay empty, making the invalid state visible if SWIFTBIND010
         is ever bypassed. -->
    <_SwiftBindingPlatformUnsupported Condition="'$(_SwiftBindingPlatform)' == ''">true</_SwiftBindingPlatformUnsupported>

    <!-- Whether platform has separate simulator + device slices -->
    <_SwiftBindingHasSimulatorSlice Condition="'$(_SwiftBindingPlatform)' == 'ios' OR '$(_SwiftBindingPlatform)' == 'tvos'">true</_SwiftBindingHasSimulatorSlice>

    <!-- NuGet RID for native pack layout -->
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingPlatform)' == 'macos'">osx-arm64</_SwiftBindingNuGetRid>
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingPlatform)' == 'tvos'">tvos-arm64</_SwiftBindingNuGetRid>
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">maccatalyst-arm64</_SwiftBindingNuGetRid>
    <_SwiftBindingNuGetRid Condition="'$(_SwiftBindingNuGetRid)' == ''">ios-arm64</_SwiftBindingNuGetRid>

    <!-- Device slice directory in wrapper xcframework -->
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingPlatform)' == 'macos'">macos-arm64</_SwiftBindingDeviceSliceId>
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingPlatform)' == 'tvos'">tvos-arm64</_SwiftBindingDeviceSliceId>
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingPlatform)' == 'maccatalyst'">ios-arm64-maccatalyst</_SwiftBindingDeviceSliceId>
    <_SwiftBindingDeviceSliceId Condition="'$(_SwiftBindingDeviceSliceId)' == ''">ios-arm64</_SwiftBindingDeviceSliceId>

    <!-- Simulator slice directory (only for iOS/tvOS) -->
    <_SwiftBindingSimulatorSliceId Condition="'$(_SwiftBindingPlatform)' == 'tvos'">tvos-arm64-simulator</_SwiftBindingSimulatorSliceId>
    <_SwiftBindingSimulatorSliceId Condition="'$(_SwiftBindingSimulatorSliceId)' == '' AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'">ios-arm64-simulator</_SwiftBindingSimulatorSliceId>

    <!-- User-configurable -->
    <!-- macOS/Catalyst have no simulator — only set default for iOS/tvOS -->
    <SwiftPlatformTarget Condition="'$(SwiftPlatformTarget)' == '' AND '$(_SwiftBindingHasSimulatorSlice)' == 'true'">simulator</SwiftPlatformTarget>
    <SwiftGeneratorVerbosity Condition="'$(SwiftGeneratorVerbosity)' == ''">1</SwiftGeneratorVerbosity>
    <!-- Default to both slices (device + simulator) so dotnet pack always works -->
    <!-- Fast-iteration users can override to 'simulator' for quicker dev builds -->
    <SwiftWrapperArchitectures Condition="'$(SwiftWrapperArchitectures)' == ''">all</SwiftWrapperArchitectures>
    <!-- Property-driven version floor — users can override to use newer runtime -->
    <SwiftRuntimeVersion Condition="'$(SwiftRuntimeVersion)' == ''">0.0.0-dev</SwiftRuntimeVersion>
    <!-- Require wrapper compilation to succeed (set to false for libraries with known internal type issues) -->
    <SwiftWrapperRequired Condition="'$(SwiftWrapperRequired)' == ''">true</SwiftWrapperRequired>
    <!-- Auto-extract symbol graph for doc comments (set to false to disable) -->
    <SwiftGenerateDocComments Condition="'$(SwiftGenerateDocComments)' == ''">true</SwiftGenerateDocComments>
    <!-- Auto-detect framework dependencies from binary linkage (set to false to disable) -->
    <SwiftAutoDetectDependencies Condition="'$(SwiftAutoDetectDependencies)' == ''">true</SwiftAutoDetectDependencies>
    <!-- Apple-framework target mode: minimum deployment target for swift-api-digester.
         Platform-specific floors match .NET 10 minimums. maccatalyst before macos to
         avoid substring overlap. -->
    <SwiftAppleFrameworkMinDeploymentVersion Condition="'$(SwiftAppleFrameworkMinDeploymentVersion)' == '' AND $(TargetFramework.Contains('maccatalyst'))">15.0</SwiftAppleFrameworkMinDeploymentVersion>
    <SwiftAppleFrameworkMinDeploymentVersion Condition="'$(SwiftAppleFrameworkMinDeploymentVersion)' == '' AND $(TargetFramework.Contains('macos'))">12.0</SwiftAppleFrameworkMinDeploymentVersion>
    <SwiftAppleFrameworkMinDeploymentVersion Condition="'$(SwiftAppleFrameworkMinDeploymentVersion)' == '' AND $(TargetFramework.Contains('tvos'))">15.0</SwiftAppleFrameworkMinDeploymentVersion>
    <SwiftAppleFrameworkMinDeploymentVersion Condition="'$(SwiftAppleFrameworkMinDeploymentVersion)' == ''">15.0</SwiftAppleFrameworkMinDeploymentVersion>

    <!-- Register our pack target for per-TFM content collection.
         This is how .NET SDK's NuGet pack discovers per-TFM pack items
         in multi-TFM projects (via _WalkEachTargetPerFramework). -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_ConfigureSwiftBindingPack</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- ObjC-only framework overrides: binding project, no Swift.Runtime, no unsafe -->
  <PropertyGroup Condition="'$(SwiftFrameworkType)' == 'ObjC'">
    <IsBindingProject>true</IsBindingProject>
    <DisableImplicitSwiftRuntimeReference>true</DisableImplicitSwiftRuntimeReference>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types -->
  <ItemGroup Condition="'$(SwiftFrameworkType)' != 'ObjC'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <!-- Implicit Swift.Runtime reference with minimum version floor -->
  <ItemGroup>
    <PackageReference Include="SwiftBindings.Runtime" Version="$(SwiftRuntimeVersion)"
                      Condition="'$(DisableImplicitSwiftRuntimeReference)' != 'true'" />
  </ItemGroup>

  <!-- Inject PackageReference for each SwiftFrameworkDependency with PackageId + PackageVersion.
       This must be in .props (evaluation-time) so NuGet restore picks up the references
       before the build targets run. Without both metadata values, the reference is skipped. -->
  <ItemGroup Condition="'@(SwiftFrameworkDependency)' != ''">
    <PackageReference Include="%(SwiftFrameworkDependency.PackageId)"
                      Version="%(SwiftFrameworkDependency.PackageVersion)"
                      Condition="'%(SwiftFrameworkDependency.PackageId)' != '' AND '%(SwiftFrameworkDependency.PackageVersion)' != ''" />
  </ItemGroup>

  <!-- NOTE: Auto-discovery is in Sdk.targets (after project body evaluation) -->
  <!-- so explicit <SwiftFramework> items in the project are seen first        -->
</Project>
