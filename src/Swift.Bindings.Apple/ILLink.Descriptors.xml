<!-- Embedded linker descriptor for NativeAOT trimming.
     Automatically applied when consumers reference SwiftBindings.Apple.
     Preserves every manifest-generated VWT-opaque supplement type so its static
     ISwiftObject dispatch members remain a defense-in-depth fallback under ILC. The
     generated module initializer is the primary NativeAOT path: it registers metadata,
     NewFromPayload, and payload-semantics dispatch through concrete type references.
     AppleTypesCsEmitterTests reconcile this list against manifest.json so a newly added
     supplement type cannot silently ship without either half of the rooting contract. -->
<linker>
  <assembly fullname="SwiftBindings.Apple">
    <type fullname="Swift.CryptoKit.P256/Signing/ECDSASignature" preserve="all" />
    <type fullname="Swift.CryptoKit.P384/Signing/ECDSASignature" preserve="all" />
    <type fullname="Swift.CryptoKit.P521/Signing/ECDSASignature" preserve="all" />
    <type fullname="Swift.Foundation.Data" preserve="all" />
    <type fullname="Swift.Foundation.DateComponents" preserve="all" />
    <type fullname="Swift.Foundation.Locale/Collation" preserve="all" />
    <type fullname="Swift.Foundation.Locale/Currency" preserve="all" />
    <type fullname="Swift.Foundation.Locale/Language" preserve="all" />
    <type fullname="Swift.Foundation.Locale/LanguageCode" preserve="all" />
    <type fullname="Swift.Foundation.Locale/Region" preserve="all" />
    <type fullname="Swift.Foundation.Measurement`1" preserve="all" />
    <type fullname="Swift.Foundation.PersonNameComponents" preserve="all" />
    <type fullname="Swift.Foundation.AttributedString" preserve="all" />
    <type fullname="Swift.ManagedSettings.ActivityCategory" preserve="all" />
    <type fullname="Swift.ManagedSettings.Application" preserve="all" />
    <type fullname="Swift.ManagedSettings.WebDomain" preserve="all" />
  </assembly>
</linker>
