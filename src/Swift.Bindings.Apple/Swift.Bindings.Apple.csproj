<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Four Apple TFMs only. Plain net10.0 is intentionally omitted because
         Apple Swift-only types have no non-Apple target. -->
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst;net10.0-tvos;net10.0-macos</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>SwiftBindings.Apple</AssemblyName>
    <RootNamespace>Swift</RootNamespace>

    <!-- NuGet package metadata -->
    <PackageId>SwiftBindings.Apple</PackageId>
    <PackageVersion>0.0.0-dev</PackageVersion>
    <!-- Runtime dep declared as a floor-only range. The supplement is always brokered
         by SwiftBindings.Sdk, whose own bounded Runtime PackageReference (via Sdk.props
         SwiftRuntimePackageVersionRange) is the actual compatibility contract. Stamping
         only a floor here lets one shipped supplement nupkg ride forward across
         Runtime/SDK minor bumps without a no-op repack — VersionScope rewrites this
         value to [MAJOR.MINOR.PATCH,) at pack time. The in-tree dev sentinel below is
         deliberately a bounded range so a stray local pack without VersionScope still
         produces something NuGet won't blindly float into an incompatible 0.1.0. -->
    <SwiftRuntimePackageVersionRange>[0.0.0-dev,0.1.0)</SwiftRuntimePackageVersionRange>
    <Description>Managed projections for Apple Swift-only value types (Foundation.Locale.Language, ManagedSettings.Application, CryptoKit.P256.Signing.ECDSASignature, etc.) that have no Objective-C bridge. Versioned per Apple SDK train; cross-major additive-only.</Description>
    <Authors>Justin Wojciechowski</Authors>
    <PackageTags>swift;interop;bindings;apple;ios;macos;tvos;maccatalyst</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Minimum OS versions — mirror SwiftBindings.Runtime so dependency unification works cleanly. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('macos'))">12.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('tvos'))">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Runtime dependency: ProjectReference becomes a packed dep in the supplement nuspec.
       NuGet's _GetProjectReferenceVersions calls _GetProjectVersion on Swift.Runtime, which
       returns the bare $(PackageVersion) (e.g. "0.9.0") and emits an unbounded min-only dep.
       <Version>/<VersionOverride> metadata on <ProjectReference> is NOT read by this code
       path — verified against NuGet.Build.Tasks.Pack.targets — so we rewrite the resolved
       _ProjectReferencesWithVersions item after _GetProjectReferenceVersions to stamp the
       $(SwiftRuntimePackageVersionRange) value VersionScope produced (a floor-only
       [MAJOR.MINOR.PATCH,) range). The SDK-side range in Sdk.props is bounded and supplies
       the actual contract for consumers; the supplement only needs to declare a floor
       because it is always brokered by SwiftBindings.Sdk in the supported flow. -->
  <ItemGroup>
    <ProjectReference Include="../Swift.Runtime/src/Swift.Runtime.csproj" />
  </ItemGroup>
  <Target Name="_StampSwiftRuntimePackedVersionRange"
          AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(NuspecFile)' == '' and '$(SwiftRuntimePackageVersionRange)' != ''">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Swift.Runtime'">
        <ProjectVersion>$(SwiftRuntimePackageVersionRange)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

  <!-- NuGet pack items -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../legal/NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- NativeAOT trim-safety roots for hand-rolled ISwiftObject types migrated from Runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Apple-types generated sources. The emitter runs as a BeforeCompile step so
       the output lives in obj/ and never appears in git. manifest.json +
       sequential-layout-whitelist.json are the authoritative inputs; deleting a
       generated .cs file alone does not change the compile set because the
       emitter clears its output dir on every run.

       The *GeneratedDir is built INSIDE the target because $(IntermediateOutputPath)
       is not set at project-evaluation time — top-level PropertyGroups would capture
       an empty string and write directly next to the csproj. -->
  <PropertyGroup>
    <_AppleTypesManifestDir>$(MSBuildThisFileDirectory)..\Swift.Bindings.Sdk\tools\apple-types-manifest</_AppleTypesManifestDir>
    <_AppleTypesManifestJson>$(_AppleTypesManifestDir)\manifest.json</_AppleTypesManifestJson>
    <_AppleTypesSequentialLayoutWhitelist>$(_AppleTypesManifestDir)\sequential-layout-whitelist.json</_AppleTypesSequentialLayoutWhitelist>
    <_AppleTypesGeneratorProject>$(MSBuildThisFileDirectory)..\Swift.Bindings\src\Swift.Bindings.csproj</_AppleTypesGeneratorProject>
    <_AppleTypesGeneratorDir>$(MSBuildThisFileDirectory)..\Swift.Bindings\src</_AppleTypesGeneratorDir>
  </PropertyGroup>

  <Target Name="_ComputeAppleTypePaths">
    <PropertyGroup>
      <_AppleTypesGeneratedDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)AppleTypes'))</_AppleTypesGeneratedDir>
      <_AppleTypesStampFile>$(_AppleTypesGeneratedDir)\.stamp</_AppleTypesStampFile>
    </PropertyGroup>

    <!-- Collect emitter source files + csproj so an emitter-only change invalidates the
         stamp and regeneration runs. Without this, changes to AppleTypesCsEmitter or its
         helpers would be compiled into the generator but the stamp-gated target would
         short-circuit, leaving the consumer project compiling against stale .cs bodies. -->
    <ItemGroup>
      <_AppleTypesEmitterInput Include="$(_AppleTypesGeneratorDir)\**\*.cs" />
      <_AppleTypesEmitterInput Include="$(_AppleTypesGeneratorDir)\Swift.Bindings.csproj" />
    </ItemGroup>
  </Target>

  <Target Name="_GenerateAppleTypeSources"
          DependsOnTargets="_ComputeAppleTypePaths"
          BeforeTargets="CoreCompile"
          Inputs="$(_AppleTypesManifestJson);$(_AppleTypesSequentialLayoutWhitelist);@(_AppleTypesEmitterInput)"
          Outputs="$(_AppleTypesStampFile)">
    <MakeDir Directories="$(_AppleTypesGeneratedDir)" />
    <Exec Command="dotnet run --project &quot;$(_AppleTypesGeneratorProject)&quot; --configuration $(Configuration) -- --emit-apple-types-cs --apple-types-manifest &quot;$(_AppleTypesManifestJson)&quot; --apple-types-sequential-layout-whitelist &quot;$(_AppleTypesSequentialLayoutWhitelist)&quot; -o &quot;$(_AppleTypesGeneratedDir)&quot;" />
    <Touch Files="$(_AppleTypesStampFile)" AlwaysCreate="true" />
  </Target>

  <Target Name="_IncludeAppleTypeSources"
          DependsOnTargets="_ComputeAppleTypePaths;_GenerateAppleTypeSources"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(_AppleTypesGeneratedDir)\**\*.cs" Exclude="@(Compile)" />
      <FileWrites Include="$(_AppleTypesGeneratedDir)\**\*.cs;$(_AppleTypesStampFile)" />
    </ItemGroup>
  </Target>

</Project>
