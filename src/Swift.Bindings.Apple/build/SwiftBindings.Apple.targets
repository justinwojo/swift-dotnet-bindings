<!-- SwiftBindings.Apple NuGet package: consumer wiring for the
     SwiftBindingsAppleSupplement.xcframework shim framework.

     The framework is built by `nuke build-apple-supplement-xcframework`,
     packed into runtimes/native/SwiftBindingsAppleSupplement.xcframework/
     inside this NuGet, and surfaced here as a NativeReference so consumer
     apps get a copy in their .app/Frameworks/ bundle. SwiftFrameworkResolver
     (in SwiftBindings.Runtime) then routes
     `[LibraryImport("SwiftBindingsAppleSupplement")]` to it via the
     `@rpath/{name}.framework/{name}` search path.

     The xcframework already encodes per-platform slices internally — the
     device slices (ios-arm64, tvos-arm64) are arm64-only, and the
     simulator/host slices (macos, ios-simulator, tvos-simulator,
     ios-maccatalyst) are universal (arm64+x86_64) so x86_64 / Rosetta
     consumers resolve too. A single NativeReference is correct on every
     Apple TFM — the .NET Apple workload's xcframework handling picks the
     right slice for the consumer's RID at build time. -->
<Project>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/native/SwiftBindingsAppleSupplement.xcframework')">
    <NativeReference Include="$(MSBuildThisFileDirectory)../runtimes/native/SwiftBindingsAppleSupplement.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

</Project>
