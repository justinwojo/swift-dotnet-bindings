<!-- SwiftBindings.Apple NuGet package: consumer wiring for the
     SBApple.xcframework shim framework.

     The framework is built by `nuke build-apple-supplement-xcframework`,
     packed into runtimes/native/SBApple.xcframework/
     inside this NuGet, and surfaced here as a NativeReference so consumer
     apps get a copy in their .app/Frameworks/ bundle. SwiftFrameworkResolver
     (in SwiftBindings.Runtime) then routes
     `[LibraryImport("SBApple")]` to it via the
     `@rpath/{name}.framework/{name}` search path.

     The xcframework already encodes per-platform slices internally — the
     device slices (ios-arm64, tvos-arm64) are arm64-only, and the
     simulator/host slices (macos, ios-simulator, tvos-simulator,
     ios-maccatalyst) are universal (arm64+x86_64) so x86_64 / Rosetta
     consumers resolve too. A single NativeReference is correct on every
     Apple TFM — the .NET Apple workload's xcframework handling picks the
     right slice for the consumer's RID at build time. -->
<Project>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/native/SBApple.xcframework')">
    <NativeReference Include="$(MSBuildThisFileDirectory)../runtimes/native/SBApple.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- NativeAOT trimmer-descriptor delivery (ILC/PublishAot path ONLY). The IL trimmer
       (PublishTrimmed without AOT) auto-discovers the descriptor embedded as an EmbeddedResource
       in the SwiftBindings.Apple assembly, so that path needs nothing here. ILC, by contrast, does
       NOT auto-discover embedded descriptors from a referenced assembly — so root the loose copy
       packed beside this file (buildTransitive/ILLink.Descriptors.xml) via an IlcArg descriptor
       entry, plus a TrimmerRootDescriptor for the IL-trimmer sub-pass ILC runs internally (which
       likewise ignores the embedded copy). Both are gated on PublishAot + an Exists() guard,
       mirroring SwiftBindings.Runtime.targets — under pure PublishTrimmed neither is added because
       the embedded resource already covers it. The
       descriptor's <assembly fullname="SwiftBindings.Apple"> matches this package's <AssemblyName>,
       so the roots actually bind. The descriptor is a static package file present at consumer
       evaluation time, so a top-level ItemGroup (not a deferred target) is correct here. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' AND Exists('$(MSBuildThisFileDirectory)ILLink.Descriptors.xml')">
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
    <IlcArg Include="--descriptor:$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
  </ItemGroup>

</Project>
