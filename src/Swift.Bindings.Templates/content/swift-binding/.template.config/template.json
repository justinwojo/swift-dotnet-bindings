{
  "$schema": "http://json.schemastore.org/template",
  "author": "Justin Wojciechowski",
  "classifications": [ "iOS", "Swift", "Bindings", "Library" ],
  "identity": "Swift.Bindings.ProjectTemplate",
  "name": "Swift Binding Project",
  "shortName": "swift-binding",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ProjectName",
  "preferNameDirectory": true,
  "symbols": {
    "sdkVersion": {
      "type": "parameter",
      "datatype": "string",
      "description": "The Swift.Bindings.Sdk NuGet package version to use.",
      "defaultValue": "0.1.0-preview.5",
      "replaces": "0.1.0-preview.5"
    }
  }
}
