{
  "$schema": "http://json.schemastore.org/template",
  "author": "Justin Wojciechowski",
  "classifications": [ "Apple", "Swift", "Bindings", "Library" ],
  "identity": "Swift.Bindings.ProjectTemplate",
  "name": "Swift Binding Project",
  "shortName": "swift-binding",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ProjectName",
  "preferNameDirectory": true,
  "symbols": {
    "sdkVersion": {
      "type": "parameter",
      "datatype": "string",
      "description": "The SwiftBindings.Sdk NuGet package version to use.",
      "defaultValue": "0.0.0-dev",
      "replaces": "0.0.0-dev"
    },
    "platform": {
      "type": "parameter",
      "datatype": "choice",
      "description": "The target Apple platform.",
      "defaultValue": "ios",
      "choices": [
        { "choice": "ios", "description": "iOS (net10.0-ios)" },
        { "choice": "macos", "description": "macOS (net10.0-macos)" },
        { "choice": "tvos", "description": "tvOS (net10.0-tvos)" },
        { "choice": "maccatalyst", "description": "Mac Catalyst (net10.0-maccatalyst)" }
      ]
    },
    "tfm": {
      "type": "generated",
      "generator": "switch",
      "replaces": "net10.0-ios",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(platform == 'ios')", "value": "net10.0-ios" },
          { "condition": "(platform == 'macos')", "value": "net10.0-macos" },
          { "condition": "(platform == 'tvos')", "value": "net10.0-tvos" },
          { "condition": "(platform == 'maccatalyst')", "value": "net10.0-maccatalyst" }
        ]
      }
    }
  },
  "postActions": [
    {
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Next steps",
      "manualInstructions": [
        {
          "text": "\nNext steps:\n  1. Copy your .xcframework into the project directory\n     (or add <SwiftFramework Include=\"path/to/Library.xcframework\" /> to the .csproj)\n  2. Run 'dotnet build' to generate and compile the C# bindings\n  3. Reference this project from your .NET MAUI or iOS app\n\nFor more information, see: https://github.com/justinwojo/swift-dotnet-bindings/wiki/Getting-Started"
        }
      ]
    }
  ]
}
