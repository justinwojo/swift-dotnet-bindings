<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SwiftBindings.Templates</PackageId>
    <PackageVersion>0.0.0-dev</PackageVersion>
    <Description>dotnet new templates for Swift binding projects. Creates a project configured with the SwiftBindings.Sdk MSBuild SDK.</Description>
    <Authors>Justin Wojciechowski</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>swift;dotnet;bindings;template;ios;macos;tvos;maccatalyst</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageType>Template</PackageType>
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- Template packages don't build or include their own assembly -->
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>

    <!-- Suppress warning about no lib/ref assemblies -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../legal/NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
