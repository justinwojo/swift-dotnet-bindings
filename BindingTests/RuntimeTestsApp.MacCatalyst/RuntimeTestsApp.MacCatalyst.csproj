<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <BtTargetFramework Condition="'$(BtTargetFramework)' == ''">net10.0</BtTargetFramework>
    <TargetFramework>$(BtTargetFramework)-maccatalyst</TargetFramework>
    <!-- Keep the harness RID local to this app. A global RuntimeIdentifier also
         reaches every TFM restored by multi-targeted ProjectReferences, where an
         osx RID incorrectly requests a Mono macOS runtime for the mobile TFMs.
         BtRuntimeIdentifier selects the arm64/x64 cell without leaking that RID. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(BtRuntimeIdentifier)' != ''">$(BtRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">maccatalyst-arm64</RuntimeIdentifier>
    <!-- Wrapper xcframework slice id this RID consumes. Overridden to
         ios-x86_64-maccatalyst by the x64 cell. Gates the wrapper NativeReference. -->
    <BtNativeWrapperSlice Condition="'$(BtNativeWrapperSlice)' == ''">ios-arm64-maccatalyst</BtNativeWrapperSlice>
    <BtRuntimeEngine Condition="'$(BtRuntimeEngine)' == ''">coreclr</BtRuntimeEngine>
    <!-- Keep CoreCLR and NativeAOT output/intermediate products distinct even in Release. -->
    <OutputPath Condition="'$(BtTargetFramework)' == 'net11.0'">bin/$(BtRuntimeEngine)/$(Configuration)/</OutputPath>
    <IntermediateOutputPath Condition="'$(BtTargetFramework)' == 'net11.0'">obj/$(BtRuntimeEngine)/$(Configuration)/</IntermediateOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.swiftbindings.runtimetestsapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Test-host floor shared by the qualified Xcode 26/27 workloads.
         Runtime and Apple package deployment floors remain independently declared. -->
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <!-- Disable IL linker to avoid trim analysis errors with SupportedOSPlatformAttribute -->
    <MtouchLink>None</MtouchLink>
    <!-- Disable build-time codesign: native dylibs are injected post-build by the
         Nuke target. The Nuke target re-signs the bundle bottom-up after injection. -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <!-- Same warning suppressions as RuntimeTestsApp. CA1418: 'visionos' is
         missing from the .NET 10.0.107 analyzer's KnownPlatforms list on this
         TFM, so the generated [SupportedOSPlatform("visionos1.0")] trips it. -->
    <NoWarn>CS0169;CS0649;SB0001;SB0002;SB0008;CA1418;CA1422;IL2065;IL2075;IL2087;IL2091;IL2026;IL2104</NoWarn>
    <IncludeSwiftBindingsRuntimeNative>false</IncludeSwiftBindingsRuntimeNative>
    <!-- Source generator output persisted to obj/ for manifest extraction -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- ProjectReference does not import buildTransitive assets. Use the production
       final-app engine hook; Nuke owns native injection for these test apps. -->
  <Import Project="../../src/Swift.Runtime/src/build/SwiftBindings.Runtime.targets" />

  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types (SwiftSelf, SwiftError, etc.) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Runtime/src/Swift.Runtime.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
    <ProjectReference Include="../../src/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- See RuntimeTestsApp.Mac.csproj for the rationale on Swift.Bindings.Apple
         and the AppleIdentity probes. -->
    <ProjectReference Include="../../src/Swift.Bindings.Apple/Swift.Bindings.Apple.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
    <ProjectReference Include="../AppleIdentity.ConsumerA/AppleIdentity.ConsumerA.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
    <ProjectReference Include="../AppleIdentity.ConsumerB/AppleIdentity.ConsumerB.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
  </ItemGroup>

  <!-- Shared test infrastructure (portable — no iOS dependencies) -->
  <ItemGroup>
    <Compile Include="../RuntimeTestsApp/Infrastructure/TestBase.cs" />
    <Compile Include="../RuntimeTestsApp/Infrastructure/TestDescriptors.cs" />
    <Compile Include="../RuntimeTestsApp/Infrastructure/TestResults.cs" />
    <Compile Include="../RuntimeTestsApp/Infrastructure/TestLogger.cs" />
    <Compile Include="../RuntimeTestsApp/Infrastructure/TestRunFlags.cs" />
    <Compile Include="../RuntimeTestsApp/Infrastructure/LifetimeTracker.cs" />
    <Compile Include="../RuntimeTestsApp/Infrastructure/MallocProbe.cs" />
    <Compile Include="../RuntimeTestsApp/Infrastructure/MainQueueSynchronizationContext.cs" />
  </ItemGroup>

  <!-- Global usings shared with RuntimeTestsApp -->
  <ItemGroup>
    <Compile Include="../RuntimeTestsApp/GlobalUsings.cs" />
  </ItemGroup>

  <!-- Test classes (portable — reference SwiftBindingsTestLib types, not UIKit) -->
  <ItemGroup>
    <Compile Include="../RuntimeTestsApp/Async/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Closures/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Collisions/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Concurrency/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/EdgeCases/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/ErrorHandling/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Generics/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Lifetime/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Marshalling/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/MemoryManagement/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Metadata/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Operators/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Patterns/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Protocols/**/*.cs" />
    <Compile Include="../RuntimeTestsApp/Spike/**/*.cs" />
    <!-- SwiftUIBridge tests are gated by #if SWIFTUI_BRIDGE — safe to include but inactive -->
    <Compile Include="../RuntimeTestsApp/SwiftUIBridge/**/*.cs" />
    <!-- Types/ as a whole is iOS-shaped and deliberately not compiled here, but the SwiftUI
         value-factory tests carry the Catalyst half of their own contract: the construction
         shims are sliced out of macabi, so the factories must throw
         PlatformNotSupportedException rather than fail in the loader. That assertion only
         means something when it actually runs on Catalyst, hence the single-file include. -->
    <Compile Include="../RuntimeTestsApp/Types/SwiftUIValueConstructionTests.cs" />
  </ItemGroup>

  <!-- Extract test manifest from source generator output into a host-visible file. -->
  <Target Name="WriteTestManifest" AfterTargets="CoreCompile"
          Condition="Exists('$(IntermediateOutputPath)generated/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.TestDiscoveryGenerator/TestManifest.g.cs')">
    <Exec Command="grep '^//! ' '$(IntermediateOutputPath)generated/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.TestDiscoveryGenerator/TestManifest.g.cs' | sed 's|^//! ||' > '$(MSBuildProjectDirectory)/TestClasses.g.txt'" />
  </Target>

  <!-- Generated bindings (shared output/ dir — Catalyst clobbers other platforms, same as macOS/tvOS) -->
  <ItemGroup>
    <Compile Include="../output/SwiftBindingsTestLib.cs" Condition="Exists('../output/SwiftBindingsTestLib.cs')" />
    <Compile Include="../output/SwiftBindingsTestLib.Types.*.cs" />
    <Compile Include="../output/SwiftBindingsTestLibDependency.cs"
             Condition="Exists('../output/SwiftBindingsTestLibDependency.cs')" />
    <Compile Include="../output/SwiftBindingsTestLibDependency.Types.*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../output/SwiftBindingsTestLibDependency.cs')">
    <Using Include="SwiftBindingsTestLibDependency.IDependencyProtocol" Alias="IDependencyProtocol" />
  </ItemGroup>

  <!-- Main test library and dependency xcframeworks. These are rebuilt by
       the Nuke binding-tests target (catalyst flag) before each run. Additional
       native artifacts (async wrapper, runtime dylib) are injected by the Nuke
       target into the output directory. -->
  <ItemGroup>
    <NativeReference Include="../.build/SwiftBindingsTestLib.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="Exists('../.build/SwiftBindingsTestLibDependency.xcframework')">
    <NativeReference Include="../.build/SwiftBindingsTestLibDependency.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="../output/SwiftBindings.xcframework"
                     Condition="Exists('../output/SwiftBindings.xcframework/$(BtNativeWrapperSlice)')">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
  <Target Name="ValidateBindingTestsManagedTarget" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BtTargetFramework)' != 'net10.0' AND '$(BtTargetFramework)' != 'net11.0'"
           Text="BtTargetFramework must be net10.0 or net11.0." />
    <Error Condition="'$(BtTargetFramework)' == 'net11.0' AND '$(SwiftBindingsDeviceMonoAot)' == 'true'"
           Text=".NET 11 BindingTests does not support Mono; use the CoreCLR or NativeAOT lane." />
  </Target>
</Project>
