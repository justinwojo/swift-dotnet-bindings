<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.swiftbindings.runtimetestsapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Suppress warnings that are not actual errors -->
    <!-- CS0169: Field is never used (Buffer struct fields reserved for future use) -->
    <!-- CA1422: Obsolete API warnings (UIWindow, etc.) -->
    <!-- IL2075/IL2087: AOT trimming warnings (reflection use in tests) -->
    <!-- SB0001: direct-CallConvSwift caution on members the tests intentionally call and assert
         round-trip values for. The marker's predicate reads the Swift declaration before projection,
         so it also fires on shapes (open generics above all) that lower to a blittable extern and
         work; SB0009, the id for members with no sound call path at all, is deliberately NOT
         suppressed here — nothing in this app may call one. -->
    <!-- CS0108/CS0109: resolved by Session I4 virtual/override dispatch -->
    <!-- CS0649: protocol proxy vtable entries for closure-skipped methods (never assigned) -->
    <!-- CA1418: 'visionos' missing from the .NET 10.0.107 analyzer's KnownPlatforms list
         on the plain net10.0-ios TFM. See the matching note in CompileCheck.csproj. -->
    <NoWarn>CS0169;CS0649;SB0001;SB0002;SB0008;CA1418;CA1422;IL2065;IL2075;IL2087;IL2091;IL2026;IL2104</NoWarn>
    <!-- Source generator output persisted to obj/ for manifest extraction -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Avoid InstallNameTool failure with libSwiftBindingsRuntime.dylib.tmp -->
    <IncludeSwiftBindingsRuntimeNative>false</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <!-- Simulator (default): Mono JIT, no trimming -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <!-- Device (NativeAOT): PublishAot + code signing.
       Activated when publishing with -r ios-arm64 (Build.RuntimeTests.cs RunDevicePlatform path). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <CodesignKey>Apple Development: Justin Wojciechowski (KBKS29A36Q)</CodesignKey>
    <CodesignProvision>Wildcard Dev</CodesignProvision>
    <TeamIdentifierPrefix>TL2K6QUQEH</TeamIdentifierPrefix>
  </PropertyGroup>

  <!-- TrimmerRoots: only needed for NativeAOT device builds.
       Source generator eliminates reflection for test discovery, but Swift.Runtime types
       still need preservation for NativeAOT reflection fallback paths.
       Two descriptors: TrimmerRoots.xml carries app-specific roots (test infrastructure
       namespaces, protocol proxies referenced only by reflection); the source
       ILLink.Descriptors.xml from Swift.Runtime carries the Swift.Runtime + ValueTuple
       roots. Referenced here directly because buildTransitive only flows across
       PackageReference, not ProjectReference, and using the source file keeps it as the
       single point of truth shared with downstream NuGet consumers. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    <TrimmerRootDescriptor Include="../../src/Swift.Runtime/src/ILLink.Descriptors.xml" />
    <IlcArg Include="--descriptor:$(MSBuildProjectDirectory)/TrimmerRoots.xml" />
    <IlcArg Include="--descriptor:$(MSBuildProjectDirectory)/../../src/Swift.Runtime/src/ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist" />
  </ItemGroup>

  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types (SwiftSelf, SwiftError, etc.) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Runtime/src/Swift.Runtime.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
    <ProjectReference Include="../../src/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- SwiftBindings.Apple: supplement package. Referenced so the VWT-opaque emitted
         types (Foundation.Locale.Language, ManagedSettings.Application,
         CryptoKit.P256.Signing.ECDSASignature, …) can be exercised by the runtime tests
         against the live SDK. iOS-only TFM here matches RuntimeTestsApp; SwiftBindings.Apple
         also supports maccatalyst/tvos/macos for consumers that need them. -->
    <ProjectReference Include="../../src/Swift.Bindings.Apple/Swift.Bindings.Apple.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
    <!-- Two independent consumer libraries that each reference SwiftBindings.Apple and
         touch Foundation.Locale.Language. CrossAssemblyIdentityTests asserts typeof +
         TypeMetadata match across both assemblies, guarding against per-consumer
         duplicate emission. -->
    <ProjectReference Include="../AppleIdentity.ConsumerA/AppleIdentity.ConsumerA.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
    <ProjectReference Include="../AppleIdentity.ConsumerB/AppleIdentity.ConsumerB.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
  </ItemGroup>

  <!-- W-1 pure-ObjC clang-umbrella fixture: the generator's ObjC pass emits a bgen binding
       project (output-objc/ObjCUmbrella.ObjC.iOS.csproj). A single ProjectReference surfaces both
       the managed binding AND the fixture xcframework — the binding project carries its own
       NativeReference and propagates it transitively via IsBindingProject's built-in
       GetNativeManifest, so no <NativeReference>/.ProjectReference.targets is needed at the app
       level. Exists-gated so a non-iOS regen (which doesn't emit output-objc/) drops the reference. -->
  <ItemGroup Condition="Exists('../output-objc/ObjCUmbrella.ObjC.iOS.csproj')">
    <ProjectReference Include="../output-objc/ObjCUmbrella.ObjC.iOS.csproj" />
  </ItemGroup>

  <!-- Cross-module: SwiftBindingsTestLib.cs references IDependencyProtocol from the dependency namespace.
       Using a targeted alias avoids ambiguity with identically-named types (e.g., Functions) in both namespaces. -->
  <ItemGroup Condition="Exists('../output/SwiftBindingsTestLibDependency.cs')">
    <Using Include="SwiftBindingsTestLibDependency.IDependencyProtocol" Alias="IDependencyProtocol" />
  </ItemGroup>

  <!-- Include BindingTests bindings -->
  <ItemGroup>
    <Compile Include="../output/SwiftBindingsTestLib.cs" />
    <!-- One file per top-level type (generator file-per-type split); prelude is the .cs above. -->
    <Compile Include="../output/SwiftBindingsTestLib.Types.*.cs" />
    <Compile Include="../output/SwiftBindingsTestLibDependency.cs"
             Condition="Exists('../output/SwiftBindingsTestLibDependency.cs')" />
    <Compile Include="../output/SwiftBindingsTestLibDependency.Types.*.cs" />
  </ItemGroup>

  <!-- Include SwiftBindingsTestLib xcframework -->
  <ItemGroup>
    <NativeReference Include="../.build/SwiftBindingsTestLib.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include the dev-built SBApple (Apple supplement) xcframework. In a shipped
       NuGet flow this NativeReference is injected for consumers via
       src/Swift.Bindings.Apple/build/SwiftBindings.Apple.targets (packed into
       buildTransitive/); here we point at the in-repo artifact produced by
       `nuke build-apple-supplement-xcframework` so the runtime tests exercise the
       same Swift-side @_cdecl shims (KVO observe wrappers, AttributedString
       attribute getters, …) that the Apple supplement nupkg will ship. The
       Condition gate makes this opt-in to "the xcframework has been built", so a
       fresh clone that has never run the supplement build still compiles. -->
  <ItemGroup Condition="Exists('../../src/Swift.Bindings.Apple/native/SBApple.xcframework')">
    <NativeReference Include="../../src/Swift.Bindings.Apple/native/SBApple.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include dependency xcframework (cross-module testing) -->
  <ItemGroup Condition="Exists('../.build/SwiftBindingsTestLibDependency.xcframework')">
    <NativeReference Include="../.build/SwiftBindingsTestLibDependency.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include dependency wrapper framework (thunks + @_cdecl wrappers for dependency module) -->
  <ItemGroup Condition="Exists('../output/SwiftBindingsTestLibDependencySwiftBindings.xcframework/ios-arm64')
                         AND '$(RuntimeIdentifier)' == 'ios-arm64'">
    <NativeReference Include="../output/SwiftBindingsTestLibDependencySwiftBindings.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include SwiftBindings wrapper framework (async wrappers).
       Check for the specific platform slice to avoid "No matching framework" when
       a device-only xcframework is left over from a previous device build. -->
  <ItemGroup>
    <NativeReference Include="../output/SwiftBindings.xcframework"
                     Condition="('$(RuntimeIdentifier)' == 'iossimulator-arm64' AND Exists('../output/SwiftBindings.xcframework/ios-arm64-simulator'))
                                OR ('$(RuntimeIdentifier)' == 'ios-arm64' AND Exists('../output/SwiftBindings.xcframework/ios-arm64'))">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- SwiftBindingsRuntime framework (device only — simulator uses dylib injection).
       Built from src/Swift.Runtime/swift/SwiftBindingsRuntime.swift, packaged as xcframework
       so iOS can load it via @rpath/SwiftBindingsRuntime.framework/SwiftBindingsRuntime. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <NativeReference Include="../.build/SwiftBindingsRuntime.xcframework"
                     Condition="Exists('../.build/SwiftBindingsRuntime.xcframework/ios-arm64')">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Extract test manifest from source generator output into a host-visible file.
       Used by crash recovery orchestration to know the full test inventory. -->
  <Target Name="WriteTestManifest" AfterTargets="CoreCompile"
          Condition="Exists('$(IntermediateOutputPath)generated/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.TestDiscoveryGenerator/TestManifest.g.cs')">
    <Exec Command="grep '^//! ' '$(IntermediateOutputPath)generated/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.TestDiscoveryGenerator/TestManifest.g.cs' | sed 's|^//! ||' > '$(MSBuildProjectDirectory)/TestClasses.g.txt'" />
  </Target>

  <!-- SwiftUI bridge (conditional on generated output) -->
  <PropertyGroup Condition="Exists('../output/SwiftBindingsTestLib.SwiftUIBridge.cs')">
    <DefineConstants>$(DefineConstants);SWIFTUI_BRIDGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../output/SwiftBindingsTestLib.SwiftUIBridge.cs')">
    <Compile Include="../output/SwiftBindingsTestLib.SwiftUIBridge.cs" />
  </ItemGroup>
  <!-- UIKit-only fixtures (the Swift source is behind `#if canImport(UIKit)`, so the binding
       only exists on platforms that have UIKit — not macOS). -->
  <PropertyGroup Condition="Exists('../output/SwiftBindingsTestLib.Types.AppDelegateOptionRelay.cs')">
    <DefineConstants>$(DefineConstants);UIKIT_OPTION_KEYS</DefineConstants>
  </PropertyGroup>
  <!-- Simulator bridge framework -->
  <ItemGroup Condition="Exists('../SwiftBridge/SwiftBindingsTestLibBridge.framework')
                         AND '$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <NativeReference Include="../SwiftBridge/SwiftBindingsTestLibBridge.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- StoreKit 2 smoke test (Apple-framework direct-mode pipeline) — Option B.
       The snapshot lives in-tree at BindingTests/obj/StoreKit2Snapshot/ (gitignored
       via the top-level obj/ rule) and is regenerated either on-demand via
       `nuke regenerate-storekit-snapshot` or automatically as a conditional
       prerequisite of the binding-tests target when the
       enable-storekit-smoke flag is passed. See Build.RuntimeTests.cs
       RegenerateStoreKit2Snapshot() for the pipeline.

       The old path consumed StoreKit.Swift.iOS.dll via a raw Reference HintPath
       pointing at /tmp/storekit2-session4, which MSBuild could not invalidate when
       Swift.Runtime.dll changed — producing the stale-AOT footgun that SIGABRTs
       during xamarin_bridge_initialize. The in-tree path uses a real ProjectReference
       plus a conditional Import of the generator-emitted .ProjectReference.targets,
       so the incremental-build graph stays coherent across Swift.Runtime rebuilds.

       Opt in from the CLI:
         dotnet build RuntimeTestsApp.csproj
             -p:EnableStoreKitSmoke=true
             -p:SwiftBindingsRepoRoot=/path/to/swift-bindings

       Or more commonly via nuke (which plumbs SwiftBindingsRepoRoot automatically):
         nuke binding-tests with the enable-storekit-smoke flag

       Simulator-only for now; the snapshot's wrapper xcframework currently ships a
       single simulator slice (wrapper-architectures=simulator in the regen step). -->

  <PropertyGroup>
    <StoreKitSnapshotDir>$(MSBuildThisFileDirectory)../obj/StoreKit2Snapshot/</StoreKitSnapshotDir>
    <StoreKitSnapshotCsproj>$(StoreKitSnapshotDir)StoreKit.Swift.iOS.csproj</StoreKitSnapshotCsproj>
    <StoreKitSnapshotProjectRefTargets>$(StoreKitSnapshotDir)StoreKit.Swift.iOS.ProjectReference.targets</StoreKitSnapshotProjectRefTargets>
    <StoreKitSnapshotXcframework>$(StoreKitSnapshotDir)StoreKitSwiftBindings.xcframework</StoreKitSnapshotXcframework>
    <!-- Gate requires ALL of:
         (1) explicit $(EnableStoreKitSmoke)=true opt-in on the CLI / pipeline
         (2) iOS Simulator RID (only slice the snapshot's wrapper xcframework carries)
         (3) the generator-emitted snapshot csproj exists (regeneration has run)
         (4) the simulator slice of the wrapper xcframework exists
         (5) the generator-emitted ProjectReference.targets file exists (consumed
             by the conditional <Import> below — without it the wrapper
             NativeReference is silently skipped and the failure moves to runtime
             instead of the gate)
         Drop any one and the smoke test disappears from the build, which matches
         the #if STOREKIT_SMOKE wrapping in StoreKitSmokeTests.cs. -->
    <StoreKitSmokeEnabled Condition="'$(EnableStoreKitSmoke)' == 'true' AND '$(RuntimeIdentifier)' == 'iossimulator-arm64' AND Exists('$(StoreKitSnapshotCsproj)') AND Exists('$(StoreKitSnapshotXcframework)/ios-arm64-simulator') AND Exists('$(StoreKitSnapshotProjectRefTargets)')">true</StoreKitSmokeEnabled>
  </PropertyGroup>
  <!-- Loud failure when the user asked for the smoke test but the prerequisites
       aren't satisfied — silently dropping the test defeats the opt-in safety net. -->
  <Target Name="_StoreKitSmokeGateCheck" BeforeTargets="BeforeBuild"
          Condition="'$(EnableStoreKitSmoke)' == 'true' AND '$(StoreKitSmokeEnabled)' != 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'iossimulator-arm64'"
           Text="EnableStoreKitSmoke=true requires RuntimeIdentifier=iossimulator-arm64 (got '$(RuntimeIdentifier)'). The snapshot's wrapper xcframework only ships a simulator slice today." />
    <Error Condition="!Exists('$(StoreKitSnapshotCsproj)')"
           Text="EnableStoreKitSmoke=true but $(StoreKitSnapshotCsproj) does not exist. Run `nuke regenerate-storekit-snapshot` (or `nuke binding-tests --enable-storekit-smoke` which regenerates automatically)." />
    <Error Condition="!Exists('$(StoreKitSnapshotXcframework)/ios-arm64-simulator')"
           Text="EnableStoreKitSmoke=true but $(StoreKitSnapshotXcframework)/ios-arm64-simulator is missing. Rerun `nuke regenerate-storekit-snapshot` — the snapshot may have been partially regenerated." />
    <Error Condition="!Exists('$(StoreKitSnapshotProjectRefTargets)')"
           Text="EnableStoreKitSmoke=true but $(StoreKitSnapshotProjectRefTargets) is missing. The wrapper NativeReference is injected via this generator-emitted file; without it the smoke test would compile but fail at runtime. Rerun `nuke regenerate-storekit-snapshot`." />
  </Target>
  <PropertyGroup Condition="'$(StoreKitSmokeEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);STOREKIT_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(StoreKitSmokeEnabled)' == 'true'">
    <!-- Extern alias "StoreKitSwift": Microsoft.iOS's StoreKit ObjC bindings already
         provide a StoreKit.AppStore type, so a default-aliased reference collides
         (CS0433). The smoke test code picks Swift types via the StoreKitSwift alias.
         NOTE: Do NOT add "global" to <Aliases>. Tried that once and it caused a
         Mono startup SIGABRT in load_aot_module during
         xamarin_bridge_initialize — presumably the Microsoft.iOS ObjC type registrar
         walks every globally-visible type and collides with the Swift-side
         StoreKit.AppStore. The extern-alias-only binding hides these types from
         default discovery, which is exactly the point. -->
    <ProjectReference Include="$(StoreKitSnapshotCsproj)">
      <Aliases>StoreKitSwift</Aliases>
      <!-- Push IncludeSwiftBindingsRuntimeNative=false through the snapshot's
           own (transitive) Swift.Runtime ProjectReference. AdditionalProperties
           on a ProjectReference becomes the global property bag for the
           referenced build, and global properties cascade through transitive
           ProjectReferences — so this single line propagates the override all
           the way down to Swift.Runtime as it's loaded by the snapshot.

           This matches the AdditionalProperties on RuntimeTestsApp's own direct
           Swift.Runtime ProjectReference up top, so MSBuild dedupes both call
           sites onto the same Swift.Runtime build node. Without it, MSBuild
           would build Swift.Runtime twice with mismatched property bags and
           the second build's `nativelibraries/libSwiftBindingsRuntime.dylib.tmp`
           would never get renamed, breaking InstallNameTool's later resolve
           pass — exactly the failure mode the documented raw
           `dotnet build -p:EnableStoreKitSmoke=true -p:SwiftBindingsRepoRoot=...`
           command used to hit before this property landed here. With it, the
           smoke build no longer depends on Nuke layering an extra global
           `-p:IncludeSwiftBindingsRuntimeNative=false` on every dotnet
           invocation. -->
      <AdditionalProperties>IncludeSwiftBindingsRuntimeNative=false</AdditionalProperties>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>
  <!-- Import the generator-emitted ProjectReference consumer targets.
       NativeReference items do NOT propagate through ProjectReference in .NET Apple
       builds, so the snapshot csproj emits a .targets file we import here to inject
       the wrapper xcframework as a NativeReference at the consumer level.

       CRITICAL: the Import is gated on BOTH EnableStoreKitSmoke=true AND Exists() of
       the targets file, because MSBuild Imports evaluate at project load time —
       BEFORE any PropertyGroup logic runs — so we cannot use the derived
       $(StoreKitSmokeEnabled) property here. Without the Exists() guard a fresh
       non-smoke build on a clean tree (where BindingTests/obj/StoreKit2Snapshot/
       does not yet exist) would fail at evaluation with "imported project not found".
       With it, the non-smoke path sees an empty Condition and skips the Import
       entirely, exactly the behavior we want. -->
  <Import Project="$(StoreKitSnapshotProjectRefTargets)"
          Condition="'$(EnableStoreKitSmoke)' == 'true' AND Exists('$(StoreKitSnapshotProjectRefTargets)')" />

  <!-- CryptoKit smoke test (Apple-framework direct-mode pipeline). Mirrors the StoreKit
       block above but with two simplifications: (1) no extern alias — CryptoKit is a pure
       Swift framework and Microsoft.iOS does not ship a CryptoKit namespace, so the
       Swift-side types do not collide with anything in default discovery; (2) uses the
       canonical <Framework>Snapshot/ path produced by the generalized
       RegenerateAppleFrameworkSnapshot helper instead of StoreKit's legacy
       StoreKit2Snapshot/ name.

       Opt in via `nuke binding-tests` with the enable-cryptokit-smoke flag,
       which regenerates BindingTests/obj/CryptoKitSnapshot/ (gitignored) before the build.
       Simulator-only today; the snapshot ships a single ios-arm64-simulator wrapper slice. -->
  <PropertyGroup>
    <CryptoKitSnapshotDir>$(MSBuildThisFileDirectory)../obj/CryptoKitSnapshot/</CryptoKitSnapshotDir>
    <CryptoKitSnapshotCsproj>$(CryptoKitSnapshotDir)CryptoKit.Swift.iOS.csproj</CryptoKitSnapshotCsproj>
    <CryptoKitSnapshotProjectRefTargets>$(CryptoKitSnapshotDir)CryptoKit.Swift.iOS.ProjectReference.targets</CryptoKitSnapshotProjectRefTargets>
    <CryptoKitSnapshotXcframework>$(CryptoKitSnapshotDir)CryptoKitSwiftBindings.xcframework</CryptoKitSnapshotXcframework>
    <CryptoKitSmokeEnabled Condition="'$(EnableCryptoKitSmoke)' == 'true' AND '$(RuntimeIdentifier)' == 'iossimulator-arm64' AND Exists('$(CryptoKitSnapshotCsproj)') AND Exists('$(CryptoKitSnapshotXcframework)/ios-arm64-simulator') AND Exists('$(CryptoKitSnapshotProjectRefTargets)')">true</CryptoKitSmokeEnabled>
  </PropertyGroup>
  <Target Name="_CryptoKitSmokeGateCheck" BeforeTargets="BeforeBuild"
          Condition="'$(EnableCryptoKitSmoke)' == 'true' AND '$(CryptoKitSmokeEnabled)' != 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'iossimulator-arm64'"
           Text="EnableCryptoKitSmoke=true requires RuntimeIdentifier=iossimulator-arm64 (got '$(RuntimeIdentifier)'). The snapshot's wrapper xcframework only ships a simulator slice today." />
    <Error Condition="!Exists('$(CryptoKitSnapshotCsproj)')"
           Text="EnableCryptoKitSmoke=true but $(CryptoKitSnapshotCsproj) does not exist. Run `nuke regenerate-apple-snapshot --framework CryptoKit` (or `nuke binding-tests --enable-cryptokit-smoke` which regenerates automatically)." />
    <Error Condition="!Exists('$(CryptoKitSnapshotXcframework)/ios-arm64-simulator')"
           Text="EnableCryptoKitSmoke=true but $(CryptoKitSnapshotXcframework)/ios-arm64-simulator is missing. Rerun `nuke regenerate-apple-snapshot --framework CryptoKit` — the snapshot may have been partially regenerated." />
    <Error Condition="!Exists('$(CryptoKitSnapshotProjectRefTargets)')"
           Text="EnableCryptoKitSmoke=true but $(CryptoKitSnapshotProjectRefTargets) is missing. The wrapper NativeReference is injected via this generator-emitted file; without it the smoke test would compile but fail at runtime. Rerun `nuke regenerate-apple-snapshot --framework CryptoKit`." />
  </Target>
  <PropertyGroup Condition="'$(CryptoKitSmokeEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);CRYPTOKIT_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CryptoKitSmokeEnabled)' == 'true'">
    <!-- No <Aliases> — CryptoKit is Swift-only and does not collide with Microsoft.iOS. -->
    <ProjectReference Include="$(CryptoKitSnapshotCsproj)">
      <AdditionalProperties>IncludeSwiftBindingsRuntimeNative=false</AdditionalProperties>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>
  <!-- Same Exists()-gated Import rationale as the StoreKit block: MSBuild evaluates
       Imports at project load, before PropertyGroup logic runs, so we cannot use the
       derived $(CryptoKitSmokeEnabled) property and must guard on the raw opt-in
       property plus Exists() of the imported file. -->
  <Import Project="$(CryptoKitSnapshotProjectRefTargets)"
          Condition="'$(EnableCryptoKitSmoke)' == 'true' AND Exists('$(CryptoKitSnapshotProjectRefTargets)')" />

  <!-- WeatherKit smoke test (Apple-framework direct-mode pipeline). Mirrors the CryptoKit
       block: no extern alias (WeatherKit is pure Swift, no Microsoft.iOS namespace
       collision), canonical <Framework>Snapshot/ path, simulator-only slice.

       Opt in via `nuke binding-tests` with the enable-weatherkit-smoke flag,
       which regenerates BindingTests/obj/WeatherKitSnapshot/ (gitignored) before the build.
       The smoke test deliberately avoids any API that would hit the WeatherKit.entitlement
       or the network — it exercises WeatherError metadata + reflection-based
       availability propagation only. See WeatherKitSmokeTests.cs. -->
  <PropertyGroup>
    <WeatherKitSnapshotDir>$(MSBuildThisFileDirectory)../obj/WeatherKitSnapshot/</WeatherKitSnapshotDir>
    <WeatherKitSnapshotCsproj>$(WeatherKitSnapshotDir)WeatherKit.Swift.iOS.csproj</WeatherKitSnapshotCsproj>
    <WeatherKitSnapshotProjectRefTargets>$(WeatherKitSnapshotDir)WeatherKit.Swift.iOS.ProjectReference.targets</WeatherKitSnapshotProjectRefTargets>
    <WeatherKitSnapshotXcframework>$(WeatherKitSnapshotDir)WeatherKitSwiftBindings.xcframework</WeatherKitSnapshotXcframework>
    <WeatherKitSmokeEnabled Condition="'$(EnableWeatherKitSmoke)' == 'true' AND '$(RuntimeIdentifier)' == 'iossimulator-arm64' AND Exists('$(WeatherKitSnapshotCsproj)') AND Exists('$(WeatherKitSnapshotXcframework)/ios-arm64-simulator') AND Exists('$(WeatherKitSnapshotProjectRefTargets)')">true</WeatherKitSmokeEnabled>
  </PropertyGroup>
  <Target Name="_WeatherKitSmokeGateCheck" BeforeTargets="BeforeBuild"
          Condition="'$(EnableWeatherKitSmoke)' == 'true' AND '$(WeatherKitSmokeEnabled)' != 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'iossimulator-arm64'"
           Text="EnableWeatherKitSmoke=true requires RuntimeIdentifier=iossimulator-arm64 (got '$(RuntimeIdentifier)'). The snapshot's wrapper xcframework only ships a simulator slice today." />
    <Error Condition="!Exists('$(WeatherKitSnapshotCsproj)')"
           Text="EnableWeatherKitSmoke=true but $(WeatherKitSnapshotCsproj) does not exist. Run `nuke regenerate-apple-snapshot --framework WeatherKit` (or `nuke binding-tests --enable-weatherkit-smoke` which regenerates automatically)." />
    <Error Condition="!Exists('$(WeatherKitSnapshotXcframework)/ios-arm64-simulator')"
           Text="EnableWeatherKitSmoke=true but $(WeatherKitSnapshotXcframework)/ios-arm64-simulator is missing. Rerun `nuke regenerate-apple-snapshot --framework WeatherKit` — the snapshot may have been partially regenerated." />
    <Error Condition="!Exists('$(WeatherKitSnapshotProjectRefTargets)')"
           Text="EnableWeatherKitSmoke=true but $(WeatherKitSnapshotProjectRefTargets) is missing. The wrapper NativeReference is injected via this generator-emitted file; without it the smoke test would compile but fail at runtime. Rerun `nuke regenerate-apple-snapshot --framework WeatherKit`." />
  </Target>
  <PropertyGroup Condition="'$(WeatherKitSmokeEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);WEATHERKIT_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WeatherKitSmokeEnabled)' == 'true'">
    <!-- No <Aliases> — WeatherKit is Swift-only and does not collide with Microsoft.iOS. -->
    <ProjectReference Include="$(WeatherKitSnapshotCsproj)">
      <AdditionalProperties>IncludeSwiftBindingsRuntimeNative=false</AdditionalProperties>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(WeatherKitSnapshotProjectRefTargets)"
          Condition="'$(EnableWeatherKitSmoke)' == 'true' AND Exists('$(WeatherKitSnapshotProjectRefTargets)')" />

  <!-- TipKit smoke test (Apple-framework direct-mode pipeline). Mirrors the
       CryptoKit/WeatherKit blocks: no extern alias (TipKit is pure Swift, Microsoft.iOS
       ships no TipKit namespace — verified by grepping Microsoft.iOS.dll for "TipKit"),
       canonical <Framework>Snapshot/ path, simulator-only slice.

       Opt in via `nuke binding-tests` with the enable-tipkit-smoke
       flag, which regenerates BindingTests/obj/TipKitSnapshot/ before the build
       AND rebuilds SwiftBindingsTestLib with `-D TIPKIT_SMOKE` so the
       TipKitSmokeTip.swift fixture's concrete `TipKitSmokeMinimalTip: Tip`
       conformer lands in the dylib. The `-D` must thread through BOTH `swiftc`
       and `swift-frontend` (ABI JSON dump) via CompileModuleSlice — if either
       side drops the define, the compiled C# smoke test cannot reference the
       generator-emitted symbol and the simulator run fails at compile time.

       See TipKitSmokeTests.cs for the runtime assertions (PAT fallback
       reflection pin on the real TipKit.TipUICollectionReusableView.ViewStyle
       property, plus a latent-bug dispatch pin on the synthetic fixture). -->
  <PropertyGroup>
    <TipKitSnapshotDir>$(MSBuildThisFileDirectory)../obj/TipKitSnapshot/</TipKitSnapshotDir>
    <TipKitSnapshotCsproj>$(TipKitSnapshotDir)TipKit.Swift.iOS.csproj</TipKitSnapshotCsproj>
    <TipKitSnapshotProjectRefTargets>$(TipKitSnapshotDir)TipKit.Swift.iOS.ProjectReference.targets</TipKitSnapshotProjectRefTargets>
