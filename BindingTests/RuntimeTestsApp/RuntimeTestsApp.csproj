<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.swiftbindings.runtimetestsapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Suppress warnings that are not actual errors -->
    <!-- CS0169: Field is never used (Buffer struct fields reserved for future use) -->
    <!-- CA1422: Obsolete API warnings (UIWindow, etc.) -->
    <!-- IL2075/IL2087: AOT trimming warnings (reflection use in tests) -->
    <!-- SB0001: Mono JIT crash risk warnings (test code intentionally calls these methods) -->
    <!-- CS0108/CS0109: resolved by Session I4 virtual/override dispatch -->
    <!-- CS0649: protocol proxy vtable entries for closure-skipped methods (never assigned) -->
    <NoWarn>CS0169;CS0649;SB0001;SB0002;CA1422;IL2065;IL2075;IL2087;IL2091;IL2026;IL2104</NoWarn>
    <!-- Source generator output persisted to obj/ for manifest extraction -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Avoid InstallNameTool failure with libSwiftBindingsRuntime.dylib.tmp -->
    <IncludeSwiftBindingsRuntimeNative>false</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <!-- Simulator (default): Mono JIT, no trimming -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <!-- Device (NativeAOT): PublishAot + code signing.
       Activated when publishing with -r ios-arm64 (Build.RuntimeTests.cs RuntimeTestsDevice target). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <CodesignKey>Apple Development: Justin Wojciechowski (KBKS29A36Q)</CodesignKey>
    <CodesignProvision>Wildcard Dev</CodesignProvision>
    <TeamIdentifierPrefix>TL2K6QUQEH</TeamIdentifierPrefix>
  </PropertyGroup>

  <!-- TrimmerRoots: only needed for NativeAOT device builds.
       Source generator eliminates reflection for test discovery, but Swift.Runtime types
       still need preservation for NativeAOT reflection fallback paths. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    <IlcArg Include="--descriptor:$(MSBuildProjectDirectory)/TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist" />
  </ItemGroup>

  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types (SwiftSelf, SwiftError, etc.) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Runtime/src/Swift.Runtime.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
    <ProjectReference Include="../../src/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Cross-module: SwiftBindingsTestLib.cs references IDependencyProtocol from the dependency namespace.
       Using a targeted alias avoids ambiguity with identically-named types (e.g., Functions) in both namespaces. -->
  <ItemGroup Condition="Exists('../output/SwiftBindingsTestLibDependency.cs')">
    <Using Include="SwiftBindingsTestLibDependency.IDependencyProtocol" Alias="IDependencyProtocol" />
  </ItemGroup>

  <!-- Include BindingTests bindings -->
  <ItemGroup>
    <Compile Include="../output/SwiftBindingsTestLib.cs" />
    <Compile Include="../output/SwiftBindingsTestLibDependency.cs"
             Condition="Exists('../output/SwiftBindingsTestLibDependency.cs')" />
  </ItemGroup>

  <!-- Include SwiftBindingsTestLib xcframework -->
  <ItemGroup>
    <NativeReference Include="../.build/SwiftBindingsTestLib.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include dependency xcframework (cross-module testing) -->
  <ItemGroup Condition="Exists('../.build/SwiftBindingsTestLibDependency.xcframework')">
    <NativeReference Include="../.build/SwiftBindingsTestLibDependency.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include dependency wrapper framework (thunks + @_cdecl wrappers for dependency module) -->
  <ItemGroup Condition="Exists('../output/SwiftBindingsTestLibDependencySwiftBindings.xcframework/ios-arm64')
                         AND '$(RuntimeIdentifier)' == 'ios-arm64'">
    <NativeReference Include="../output/SwiftBindingsTestLibDependencySwiftBindings.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Include SwiftBindings wrapper framework (async wrappers).
       Check for the specific platform slice to avoid "No matching framework" when
       a device-only xcframework is left over from a previous device build. -->
  <ItemGroup>
    <NativeReference Include="../output/SwiftBindings.xcframework"
                     Condition="('$(RuntimeIdentifier)' == 'iossimulator-arm64' AND Exists('../output/SwiftBindings.xcframework/ios-arm64-simulator'))
                                OR ('$(RuntimeIdentifier)' == 'ios-arm64' AND Exists('../output/SwiftBindings.xcframework/ios-arm64'))">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- SwiftBindingsRuntime framework (device only — simulator uses dylib injection).
       Built from src/Swift.Runtime/swift/SwiftBindingsRuntime.swift, packaged as xcframework
       so iOS can load it via @rpath/SwiftBindingsRuntime.framework/SwiftBindingsRuntime. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <NativeReference Include="../.build/SwiftBindingsRuntime.xcframework"
                     Condition="Exists('../.build/SwiftBindingsRuntime.xcframework/ios-arm64')">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Extract test manifest from source generator output into a host-visible file.
       Used by crash recovery orchestration (Session 3) to know the full test inventory. -->
  <Target Name="WriteTestManifest" AfterTargets="CoreCompile"
          Condition="Exists('$(IntermediateOutputPath)generated/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.TestDiscoveryGenerator/TestManifest.g.cs')">
    <Exec Command="grep '^//! ' '$(IntermediateOutputPath)generated/SwiftBindings.TestDiscovery/SwiftBindings.TestDiscovery.TestDiscoveryGenerator/TestManifest.g.cs' | sed 's|^//! ||' > '$(MSBuildProjectDirectory)/TestClasses.g.txt'" />
  </Target>

  <!-- SwiftUI bridge (conditional on generated output) -->
  <PropertyGroup Condition="Exists('../output/SwiftBindingsTestLib.SwiftUIBridge.cs')">
    <DefineConstants>$(DefineConstants);SWIFTUI_BRIDGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../output/SwiftBindingsTestLib.SwiftUIBridge.cs')">
    <Compile Include="../output/SwiftBindingsTestLib.SwiftUIBridge.cs" />
  </ItemGroup>
  <!-- Simulator bridge framework -->
  <ItemGroup Condition="Exists('../SwiftBridge/SwiftBindingsTestLibBridge.framework')
                         AND '$(RuntimeIdentifier)' == 'iossimulator-arm64'">
    <NativeReference Include="../SwiftBridge/SwiftBindingsTestLibBridge.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <!-- Session 5 StoreKit 2 smoke test (Apple-framework direct-mode pipeline).
       Optional: gated on the Session 4 artifacts existing at /tmp/storekit2-session4.
       When present, we reference StoreKit.Swift.iOS.dll as a managed reference and
       embed StoreKitSwiftBindings.xcframework as a native framework. The test class
       itself is wrapped in #if STOREKIT_SMOKE so it simply disappears when the
       artifacts are missing (CI runs, fresh checkouts, etc.) — this keeps the gate
       zero-regression. To regenerate the artifacts, see the Session 4 reproducer in
       src/docs/0.8.0-storekit2-exploration.md. Simulator-only for now; the xcframework
       currently ships a single simulator slice. -->
  <PropertyGroup>
    <!-- Root directory for Session 4's StoreKit 2 direct-mode artifacts. Override by
         setting $(StoreKitSmokeRoot) in the environment or on the dotnet CLI:
           dotnet build -p:StoreKitSmokeRoot=/path/to/storekit2-session4
         The default matches the reproducer command in the Session 4 doc. -->
    <StoreKitSmokeRoot Condition="'$(StoreKitSmokeRoot)' == ''">/tmp/storekit2-session4</StoreKitSmokeRoot>
    <StoreKitSmokeDll>$(StoreKitSmokeRoot)/bin/Debug/net10.0-ios/StoreKit.Swift.iOS.dll</StoreKitSmokeDll>
    <StoreKitSmokeXcframework>$(StoreKitSmokeRoot)/StoreKitSwiftBindings.xcframework</StoreKitSmokeXcframework>
    <StoreKitSmokeEnabled Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64' AND Exists('$(StoreKitSmokeDll)') AND Exists('$(StoreKitSmokeXcframework)/ios-arm64-simulator')">true</StoreKitSmokeEnabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StoreKitSmokeEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);STOREKIT_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(StoreKitSmokeEnabled)' == 'true'">
    <!-- Extern alias "StoreKitSwift": Microsoft.iOS's StoreKit ObjC bindings already
         provide a StoreKit.AppStore type, so a default-aliased reference collides
         (CS0433). The smoke test code picks Swift types via the StoreKitSwift alias.
         NOTE: Do NOT add "global" to <Aliases>. Tried that during session 5 review
         and it caused a Mono startup SIGABRT in load_aot_module during
         xamarin_bridge_initialize — presumably the Microsoft.iOS ObjC type registrar
         walks every globally-visible type and collides with the Swift-side
         StoreKit.AppStore. The extern-alias-only binding hides these types from
         default discovery, which is exactly the point. -->
    <Reference Include="StoreKit.Swift.iOS">
      <HintPath>$(StoreKitSmokeDll)</HintPath>
      <Private>true</Private>
      <Aliases>StoreKitSwift</Aliases>
    </Reference>
    <NativeReference Include="$(StoreKitSmokeXcframework)">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
  <!-- Device bridge framework -->
  <ItemGroup Condition="Exists('../SwiftBridge/device/SwiftBindingsTestLibBridge.framework')
                         AND '$(RuntimeIdentifier)' == 'ios-arm64'">
    <NativeReference Include="../SwiftBridge/device/SwiftBindingsTestLibBridge.framework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>
</Project>
