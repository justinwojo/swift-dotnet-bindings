<linker>
  <assembly fullname="RuntimeTestsApp">
    <type fullname="RuntimeTestsApp.Infrastructure.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Application" preserve="all" />
    <type fullname="RuntimeTestsApp.AppDelegate" preserve="all" />
    <type fullname="RuntimeTestsApp.MainViewController" preserve="all" />
    <type fullname="RuntimeTestsApp.Marshalling.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Lifetime.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Metadata.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Closures.*" preserve="all" />
    <type fullname="RuntimeTestsApp.ErrorHandling.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Generics.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Operators.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Patterns.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Protocols.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Async.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Concurrency.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Collections.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Properties.*" preserve="all" />
    <type fullname="RuntimeTestsApp.SwiftUIBridge.*" preserve="all" />
    <!-- Directories previously missing from the device project -->
    <type fullname="RuntimeTestsApp.Collisions.*" preserve="all" />
    <type fullname="RuntimeTestsApp.CrossModule.*" preserve="all" />
    <type fullname="RuntimeTestsApp.EdgeCases.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Initializers.*" preserve="all" />
    <type fullname="RuntimeTestsApp.MemoryManagement.*" preserve="all" />
    <type fullname="RuntimeTestsApp.ObjCInterop.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Parameters.*" preserve="all" />

    <!-- NOTE: SwiftBindingsTestLib types cannot have preserve="methods" here because
         generated P/Invoke methods with CallConvSwift cause ILC Bus error.
         Generated types' NewFromPayload factories are registered at runtime via
         NewFromPayloadDispatcher when accessed through constrained code paths. -->

    <!-- Protocol proxy types referenced only by reflection in the Bug16/Bug17
         skip-tests. SwiftBindingsTestLib.cs is `<Compile Include>`'d directly
         into RuntimeTestsApp.dll, so these roots live in the RuntimeTestsApp
         assembly block, not a separate SwiftBindingsTestLib block (that would
         trip IL2007 — no such assembly exists at link time).

         We deliberately do NOT use `typeof(Proxy)` or `[DynamicDependency(typeof(Proxy))]`
         in the test bodies: under Mono JIT the resulting metadata edge poisons
         the generic-context init graph and crashes
         `OptionalGenericHolder<LargeValueStruct>.GetPeek` inside
         `mini_init_method_rgctx`. A descriptor-only root keeps NativeAOT trim
         happy without introducing the Mono-side compile-time edge. -->
    <type fullname="SwiftBindingsTestLib.SwiftInterop.Bug16SpiRequirementProtocolProxy" preserve="all" />
    <type fullname="SwiftBindingsTestLib.SwiftInterop.Bug17HiddenRequirementProtocolProxy" preserve="all" />
    <!-- F-2 availability-propagation runtime test (AvailabilityPropagationTests
         .TestF2_ProtocolProxyClassInheritsAvailability) reflects on the proxy
         class to verify it inherits @available platform attributes. Same trim
         shape as the Bug16/Bug17 entries above; same comment about the JIT-vs-AOT
         tradeoff applies. -->
    <type fullname="SwiftBindingsTestLib.SwiftInterop.AvailabilityGatedProtocolF2Proxy" preserve="all" />
  </assembly>

  <!-- Attribute types the SDK's default link-attributes XML instructs the trimmer to remove
       EVERY INSTANCE of, on the reasoning that they are compile-time-only. That reasoning does
       not hold here: several runtime tests reflect on exactly these attributes to prove what the
       GENERATOR emitted onto the binding — AvailabilityPropagationTests reads [SupportedOSPlatform]
       and [Obsolete] off generated members, and ValueProviderPatternTests asserts the ABSENCE of
       [Obsolete] on a DIM default. With the instances stripped, the present-tense assertions fail
       and the absent-tense one passes vacuously, so the suite would report a generator regression
       that never happened. Keeping the attribute TYPE keeps its instances (the override the
       trimmer's own IL2045 diagnostic prescribes), so the tests read the emitted metadata.

       Only the Mono full-AOT device lane runs ILLink over this app — the simulator sets
       MtouchLink=None and the NativeAOT lane links with ILC, which does not apply the removal —
       so this block is what that lane needs and a no-op cost on the others. -->
  <assembly fullname="System.Private.CoreLib">
    <type fullname="System.ObsoleteAttribute" />
    <type fullname="System.Runtime.Versioning.SupportedOSPlatformAttribute" />
    <type fullname="System.Runtime.Versioning.UnsupportedOSPlatformAttribute" />
    <!-- EntryPointCallConvPairingTests walks every generated P/Invoke's [LibraryImport] to pair
         its entry point with the declared calling convention — the check that catches a
         CallConvSwift/CallConvCdecl mismatch before it becomes a device crash. Stripped
         instances would make that walk find nothing and pass over an empty set. -->
    <type fullname="System.Runtime.InteropServices.LibraryImportAttribute" />
  </assembly>

  <!-- Swift.Runtime + System.ValueTuple roots are NOT defined here. They live in
       src/Swift.Runtime/src/ILLink.Descriptors.xml (the single source of truth for
       trimmer-sensitive Swift.Runtime surface) and are consumed by this project via
       a second TrimmerRootDescriptor + IlcArg pair in RuntimeTestsApp.csproj's
       ios-arm64 ItemGroup. Downstream NuGet consumers receive the same roots
       automatically through SwiftBindings.Runtime's buildTransitive .targets. -->
</linker>
