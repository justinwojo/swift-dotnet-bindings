    <!-- NOTE: SwiftBindingsTestLib types cannot have preserve="methods" here because
         generated P/Invoke methods with CallConvSwift cause ILC Bus error.
         Generated types' NewFromPayload factories are registered at runtime via
         NewFromPayloadDispatcher when accessed through constrained code paths. -->

    <!-- Protocol proxy types referenced only by reflection in the Bug16/Bug17
         skip-tests. SwiftBindingsTestLib.cs is `<Compile Include>`'d directly
         into RuntimeTestsApp.dll, so these roots live in the RuntimeTestsApp
         assembly block, not a separate SwiftBindingsTestLib block (that would
         trip IL2007 — no such assembly exists at link time).

         We deliberately do NOT use `typeof(Proxy)` or `[DynamicDependency(typeof(Proxy))]`
         in the test bodies: under Mono JIT the resulting metadata edge poisons
         the generic-context init graph and crashes
         `OptionalGenericHolder<LargeValueStruct>.GetPeek` inside
         `mini_init_method_rgctx`. A descriptor-only root keeps NativeAOT trim
         happy without introducing the Mono-side compile-time edge. -->
    <type fullname="SwiftBindingsTestLib.SwiftInterop.Bug16SpiRequirementProtocolProxy" preserve="all" />
    <type fullname="SwiftBindingsTestLib.SwiftInterop.Bug17HiddenRequirementProtocolProxy" preserve="all" />
  </assembly>

  <!-- Swift.Runtime + System.ValueTuple roots are NOT defined here. They live in
       src/Swift.Runtime/src/ILLink.Descriptors.xml (the single source of truth for
       trimmer-sensitive Swift.Runtime surface) and are consumed by this project via
       a second TrimmerRootDescriptor + IlcArg pair in RuntimeTestsApp.csproj's
       ios-arm64 ItemGroup. Downstream NuGet consumers receive the same roots
       automatically through SwiftBindings.Runtime's buildTransitive .targets. -->
</linker>
