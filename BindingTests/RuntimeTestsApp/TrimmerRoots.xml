<linker>
  <assembly fullname="RuntimeTestsApp">
    <type fullname="RuntimeTestsApp.Infrastructure.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Application" preserve="all" />
    <type fullname="RuntimeTestsApp.AppDelegate" preserve="all" />
    <type fullname="RuntimeTestsApp.MainViewController" preserve="all" />
    <type fullname="RuntimeTestsApp.Marshalling.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Lifetime.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Metadata.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Closures.*" preserve="all" />
    <type fullname="RuntimeTestsApp.ErrorHandling.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Generics.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Operators.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Patterns.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Protocols.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Async.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Concurrency.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Collections.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Properties.*" preserve="all" />
    <type fullname="RuntimeTestsApp.SwiftUIBridge.*" preserve="all" />
    <!-- Directories previously missing from the device project -->
    <type fullname="RuntimeTestsApp.Collisions.*" preserve="all" />
    <type fullname="RuntimeTestsApp.CrossModule.*" preserve="all" />
    <type fullname="RuntimeTestsApp.EdgeCases.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Initializers.*" preserve="all" />
    <type fullname="RuntimeTestsApp.MemoryManagement.*" preserve="all" />
    <type fullname="RuntimeTestsApp.ObjCInterop.*" preserve="all" />
    <type fullname="RuntimeTestsApp.Parameters.*" preserve="all" />

    <!-- NOTE: SwiftBindingsTestLib types cannot have preserve="methods" here because
         generated P/Invoke methods with CallConvSwift cause ILC Bus error.
         Generated types' NewFromPayload factories are registered at runtime via
         NewFromPayloadDispatcher when accessed through constrained code paths. -->

    <!-- Protocol proxy types referenced only by reflection in the Bug16/Bug17
         skip-tests. SwiftBindingsTestLib.cs is `<Compile Include>`'d directly
         into RuntimeTestsApp.dll, so these roots live in the RuntimeTestsApp
         assembly block, not a separate SwiftBindingsTestLib block (that would
         trip IL2007 — no such assembly exists at link time).

         We deliberately do NOT use `typeof(Proxy)` or `[DynamicDependency(typeof(Proxy))]`
         in the test bodies: under Mono JIT the resulting metadata edge poisons
         the generic-context init graph and crashes
         `OptionalGenericHolder<LargeValueStruct>.GetPeek` inside
         `mini_init_method_rgctx`. A descriptor-only root keeps NativeAOT trim
         happy without introducing the Mono-side compile-time edge. -->
    <type fullname="SwiftBindingsTestLib.SwiftInterop.Bug16SpiRequirementProtocolProxy" preserve="all" />
    <type fullname="SwiftBindingsTestLib.SwiftInterop.Bug17HiddenRequirementProtocolProxy" preserve="all" />
  </assembly>

  <!-- Preserve Swift.Runtime ISwiftObject type methods for NativeAOT reflection fallback.
       Use preserve="methods" (not "all") to avoid ILC Bus error from CallConvSwift P/Invoke members.
       Primary path uses NewFromPayloadDispatcher (no reflection), but reflection is the fallback
       for types not yet accessed through a constrained code path. -->
  <assembly fullname="Swift.Runtime">
    <!-- Core collection/wrapper types used in test suite -->
    <type fullname="Swift.SwiftString" preserve="methods" />
    <type fullname="Swift.SwiftArray`1" preserve="methods" />
    <type fullname="Swift.SwiftOptional`1" preserve="methods" />
    <type fullname="Swift.SwiftResult`2" preserve="methods" />
    <type fullname="Swift.SwiftDictionary`2" preserve="methods" />
    <type fullname="Swift.SwiftSet`1" preserve="methods" />
    <type fullname="Swift.AnyHashable" preserve="methods" />
    <!-- NOTE: Foundation/UIKit/AppKit stub types (URL, UIImage, DispatchQueue, etc.) intentionally
         excluded — preserve="methods" on them crashes ILC due to CallConvSwift P/Invoke members.
         These types use the NewFromPayloadDispatcher factory cache (no reflection needed) when
         accessed through constrained code paths. -->
    <!-- Existential containers -->
    <type fullname="Swift.Runtime.ExistentialContainer0" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer1" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer2" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer3" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer4" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer5" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer6" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer7" preserve="methods" />
    <type fullname="Swift.Runtime.ExistentialContainer8" preserve="methods" />
  </assembly>
  <!-- ValueTuple constructors and fields for tuple marshalling on NativeAOT.
       SwiftMarshal.MarshalTupleFromSwift<T> reflectively invokes the closed
       ValueTuple<...>(T1, T2, ...) constructor for tuples returned via
       Optional<(SwiftString, IntPtr)> and similar shapes. The inline
       [DynamicallyAccessedMembers] annotation on T does not propagate strongly
       enough through typeof(T) → Type to keep the matching ctor overload alive
       on every closed instantiation under ILC trimming; preserve="all" pins
       constructors and fields uniformly across instantiations.
       This descriptor is consumed only on the device build (`ios-arm64` /
       NativeAOT) — see the `<TrimmerRootDescriptor>` ItemGroup in
       RuntimeTestsApp.csproj guarded by RuntimeIdentifier == 'ios-arm64'.
       The Mono JIT simulator path is unaffected because TrimmerRoots.xml is
       not wired in for `iossimulator-arm64` and the simulator csproj sets
       `MtouchLink=None` (no trimming). -->
  <assembly fullname="System.Private.CoreLib">
    <type fullname="System.ValueTuple`1" preserve="all" />
    <type fullname="System.ValueTuple`2" preserve="all" />
    <type fullname="System.ValueTuple`3" preserve="all" />
    <type fullname="System.ValueTuple`4" preserve="all" />
    <type fullname="System.ValueTuple`5" preserve="all" />
    <type fullname="System.ValueTuple`6" preserve="all" />
    <type fullname="System.ValueTuple`7" preserve="all" />
    <type fullname="System.ValueTuple`8" preserve="all" />
  </assembly>
</linker>
