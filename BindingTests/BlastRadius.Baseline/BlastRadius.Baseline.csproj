<Project Sdk="Microsoft.NET.Sdk">
  <!-- Session 5 / M9 blast-radius smoke test.

       This project is the "control" side of the framework-linkage measurement:
       a minimal macOS console app that references SwiftBindings.Runtime but
       does NOT touch any Apple-supplement type. Its publish output is compared
       against BlastRadius.Consumer (same project plus one supplement reference)
       to see what native dylibs / Swift runtime symbols the supplement forces
       into the final binary.

       We target net10.0-macos (arm64) because every supplement type in the
       seeded manifest carries [UnsupportedOSPlatform("maccatalyst")]; macOS is
       the closest stand-in that still publishes as NativeAOT.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <ApplicationId>com.swiftbindings.blastradius.baseline</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <MtouchLink>None</MtouchLink>
    <EnableCodeSigning>false</EnableCodeSigning>
    <!-- Skip Swift.Runtime's native dylib relocation: we only need the managed assembly
         so `otool -L` can report what the linker pulls in. Mirrors RuntimeTestsApp.Mac. -->
    <IncludeSwiftBindingsRuntimeNative>false</IncludeSwiftBindingsRuntimeNative>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Runtime/src/Swift.Runtime.csproj"
                      AdditionalProperties="IncludeSwiftBindingsRuntimeNative=false" />
  </ItemGroup>
</Project>
