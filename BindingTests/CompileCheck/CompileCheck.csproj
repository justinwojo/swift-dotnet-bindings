<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- CS0169: unused private field (generated backing fields) -->
    <!-- CS0649: field never assigned (protocol proxy vtable entries for closure-skipped methods) -->
    <!-- CA1420: using features that require runtime marshalling (LibraryImport with Swift types) -->
    <!-- CA1418: 'visionos' is not yet in the .NET 10.0.107 analyzer's KnownPlatforms list,
         even though visionOS IS a recognized OSPlatform at runtime. The Apple-framework
         SDK TFMs (e.g. net10.0-ios26.2) carry the updated list; the plain net10.0-ios
         TFM used by CompileCheck still has the stale list. The emitted attribute is
         legitimate Swift metadata — suppress here so the F-5 visionOS lowering compiles
         under the test harness's TFM. -->
    <!-- CS0108/CS0109: resolved by Session I4 virtual/override dispatch -->
    <NoWarn>CS0169;CS0649;CA1418;CA1420</NoWarn>
  </PropertyGroup>
  <!-- LibraryImport requires DisableRuntimeMarshalling for Swift interop types (SwiftSelf, SwiftError, etc.) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Swift.Runtime/src/Swift.Runtime.csproj" />
    <ProjectReference Include="../../src/Swift.Bindings.Apple/Swift.Bindings.Apple.csproj" />
  </ItemGroup>
  <!-- W-1 pure-ObjC clang-umbrella fixture: the generator's ObjC pass emits a bgen binding
       project (output-objc/ObjCUmbrella.ObjC.iOS.csproj). Referencing it here makes the
       compile-only gate build the ObjC binding (bgen + ApiDefinition.cs compile) too. The
       binding project carries its own NativeReference to the fixture xcframework and surfaces it
       transitively via IsBindingProject's GetNativeManifest — no .ProjectReference.targets needed.
       Exists-gated: on non-iOS regens output-objc/ is absent and the reference is simply dropped. -->
  <ItemGroup Condition="Exists('../output-objc/ObjCUmbrella.ObjC.iOS.csproj')">
    <ProjectReference Include="../output-objc/ObjCUmbrella.ObjC.iOS.csproj" />
  </ItemGroup>
  <!-- Cross-module: SwiftBindingsTestLib.cs references IDependencyProtocol from the dependency namespace.
       Using a targeted alias avoids ambiguity with identically-named types (e.g., Functions) in both namespaces. -->
  <ItemGroup>
    <Using Include="SwiftBindingsTestLibDependency.IDependencyProtocol" Alias="IDependencyProtocol" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../output/SwiftBindingsTestLib.cs" />
    <!-- One file per top-level type (generator file-per-type split); prelude is the .cs above. -->
    <Compile Include="../output/SwiftBindingsTestLib.Types.*.cs" />
    <Compile Include="../output/SwiftBindingsTestLib.SwiftUIBridge.cs"
             Condition="Exists('../output/SwiftBindingsTestLib.SwiftUIBridge.cs')" />
    <Compile Include="../output/SwiftBindingsTestLibDependency.cs"
             Condition="Exists('../output/SwiftBindingsTestLibDependency.cs')" />
    <Compile Include="../output/SwiftBindingsTestLibDependency.Types.*.cs" />
  </ItemGroup>
</Project>
