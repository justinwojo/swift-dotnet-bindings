{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "AnalyzerTests",
        "BindingTests",
        "BindingTestsStrict",
        "BuildAsyncWrapper",
        "BuildBridge",
        "BuildXcframework",
        "Clean",
        "Compile",
        "CompileCheckBindings",
        "FetchLibraries",
        "RegenerateBindings",
        "RuntimeTestsDevice",
        "RuntimeTestsMacOS",
        "RuntimeTestsSimulator",
        "RuntimeUnitTests",
        "SmokeTest",
        "UnitTests",
        "ValidateLibraries"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "NukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the NUKE logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "ClassFilter": {
          "type": "string",
          "description": "Run only one test class"
        },
        "DeviceUdid": {
          "type": "string",
          "description": "Pre-booted simulator or device UDID"
        },
        "Fetch": {
          "type": "boolean",
          "description": "Run fetch-libraries before validation"
        },
        "Filter": {
          "type": "string",
          "description": "Filter libraries by name (case-insensitive)"
        },
        "FlakeDetect": {
          "type": "boolean",
          "description": "Flake detection mode (run each test 3x)"
        },
        "Force": {
          "type": "boolean",
          "description": "Force rebuild even if cached"
        },
        "IncludeDevice": {
          "type": "boolean",
          "description": "Include device slice in xcframework build"
        },
        "Jobs": {
          "type": "integer",
          "description": "Max parallel validation workers",
          "format": "int32"
        },
        "List": {
          "type": "boolean",
          "description": "Show library status without building"
        },
        "NuGetApiKey": {
          "type": "string",
          "default": "Secrets must be entered via 'nuke :secrets [profile]'"
        },
        "OutputDir": {
          "type": "string",
          "description": "NuGet output directory"
        },
        "Platform": {
          "type": "string",
          "description": "Target Apple platform (ios, macos, tvos)"
        },
        "Quick": {
          "type": "boolean",
          "description": "Reuse cached validation output"
        },
        "Serial": {
          "type": "boolean",
          "description": "Run sequentially (no parallelism)"
        },
        "SkipBuild": {
          "type": "boolean",
          "description": "Skip all builds, just install + run"
        },
        "SkipRegen": {
          "type": "boolean",
          "description": "Skip binding regeneration (incremental build)"
        },
        "Solution": {
          "type": "string",
          "description": "Path to a solution file that is automatically loaded"
        },
        "Strict": {
          "type": "boolean",
          "description": "Fail on non-zero generator exit (standalone use)"
        },
        "Tier": {
          "type": "integer",
          "description": "Validation tier (1, 2, or 0 for all)",
          "format": "int32"
        },
        "Timeout": {
          "type": "integer",
          "description": "Test timeout in seconds",
          "format": "int32"
        },
        "Verbose": {
          "type": "boolean",
          "description": "Show detailed compile errors"
        },
        "Version": {
          "type": "string",
          "description": "Package version for NuGet"
        }
      }
    },
    {
      "$ref": "#/definitions/NukeBuild"
    }
  ]
}
