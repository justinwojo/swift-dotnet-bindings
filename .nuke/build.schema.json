{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "AnalyzerTests",
        "BindingTests",
        "BuildAsyncWrapper",
        "BuildBridge",
        "BuildXcframework",
        "Clean",
        "Compile",
        "CompileCheckBindings",
        "Fetch",
        "Pack",
        "PackGate",
        "RegenerateAppleSnapshot",
        "RegenerateBindings",
        "RegenerateStoreKitSnapshot",
        "RuntimeUnitTests",
        "SmokeTest",
        "Test",
        "UnitTests",
        "Validate",
        "ValidateAppleTypesManifest",
        "ValidateBlastRadius"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "NukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the NUKE logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "AppleVersion": {
          "type": "string",
          "description": "Package version for SwiftBindings.Apple (defaults to --version when unset)"
        },
        "Catalyst": {
          "type": "boolean",
          "description": "Run on Mac Catalyst"
        },
        "ClassFilter": {
          "type": "string",
          "description": "Run only one test class"
        },
        "CompileOnly": {
          "type": "boolean",
          "description": "Compile-check generated bindings only; skip app build and test execution"
        },
        "Device": {
          "type": "boolean",
          "description": "Run on physical iOS device (NativeAOT)"
        },
        "DeviceUdid": {
          "type": "string",
          "description": "Pre-booted simulator or device UDID"
        },
        "EnableCryptoKitSmoke": {
          "type": "boolean",
          "description": "Opt in to the CryptoKit smoke tests (regenerates BindingTests/obj/CryptoKitSnapshot/ in-tree)"
        },
        "EnableLiveCommunicationKitSmoke": {
          "type": "boolean",
          "description": "Opt in to the LiveCommunicationKit smoke tests (regenerates BindingTests/obj/LiveCommunicationKitSnapshot/ in-tree)"
        },
        "EnableMusicKitSmoke": {
          "type": "boolean",
          "description": "Opt in to the MusicKit smoke tests (regenerates BindingTests/obj/MusicKitSnapshot/ in-tree)"
        },
        "EnableProximityReaderSmoke": {
          "type": "boolean",
          "description": "Opt in to the ProximityReader smoke tests (regenerates BindingTests/obj/ProximityReaderSnapshot/ in-tree)"
        },
        "EnableRoomPlanSmoke": {
          "type": "boolean",
          "description": "Opt in to the RoomPlan smoke tests (regenerates BindingTests/obj/RoomPlanSnapshot/ in-tree)"
        },
        "EnableStoreKitSmoke": {
          "type": "boolean",
          "description": "Opt in to the StoreKit 2 smoke tests (regenerates BindingTests/obj/StoreKit2Snapshot/ in-tree)"
        },
        "EnableTipKitSmoke": {
          "type": "boolean",
          "description": "Opt in to the TipKit smoke tests (regenerates BindingTests/obj/TipKitSnapshot/ in-tree)"
        },
        "EnableWeatherKitSmoke": {
          "type": "boolean",
          "description": "Opt in to the WeatherKit smoke tests (regenerates BindingTests/obj/WeatherKitSnapshot/ in-tree)"
        },
        "EnableWorkoutKitSmoke": {
          "type": "boolean",
          "description": "Opt in to the WorkoutKit smoke tests (regenerates BindingTests/obj/WorkoutKitSnapshot/ in-tree)"
        },
        "FetchFirst": {
          "type": "boolean",
          "description": "Run fetch before validation"
        },
        "Filter": {
          "type": "string",
          "description": "Filter libraries by name (case-insensitive)"
        },
        "FlakeDetect": {
          "type": "boolean",
          "description": "Flake detection mode (run each test 3x)"
        },
        "Force": {
          "type": "boolean",
          "description": "Force rebuild even if cached"
        },
        "Framework": {
          "type": "string",
          "description": "Apple framework name for regen-apple-snapshot (e.g. CryptoKit)"
        },
        "IncludeDevice": {
          "type": "boolean",
          "description": "Include device slice in xcframework build"
        },
        "Jobs": {
          "type": "integer",
          "description": "Max parallel validation workers",
          "format": "int32"
        },
        "List": {
          "type": "boolean",
          "description": "Show library status without building"
        },
        "Macos": {
          "type": "boolean",
          "description": "Run on macOS"
        },
        "NuGetApiKey": {
          "type": "string",
          "default": "Secrets must be entered via 'nuke :secrets [profile]'"
        },
        "OutputDir": {
          "type": "string",
          "description": "NuGet output directory"
        },
        "Platform": {
          "type": "string",
          "description": "Target Apple platform (ios, macos, tvos)"
        },
        "Quick": {
          "type": "boolean",
          "description": "Reuse cached validation output"
        },
        "Serial": {
          "type": "boolean",
          "description": "Run sequentially (no parallelism)"
        },
        "Sim": {
          "type": "boolean",
          "description": "Run in iOS Simulator (Mono JIT) — default when no platform flag is set"
        },
        "SkipBuild": {
          "type": "boolean",
          "description": "Skip all builds, just install + run"
        },
        "SkipRegen": {
          "type": "boolean",
          "description": "Skip binding regeneration (incremental build)"
        },
        "Solution": {
          "type": "string",
          "description": "Path to a solution file that is automatically loaded"
        },
        "Strict": {
          "type": "boolean",
          "description": "Fail on non-zero generator exit"
        },
        "Tier": {
          "type": "integer",
          "description": "Validation tier (1, 2, or 0 for all)",
          "format": "int32"
        },
        "Timeout": {
          "type": "integer",
          "description": "Test timeout in seconds",
          "format": "int32"
        },
        "Tvos": {
          "type": "boolean",
          "description": "Run on tvOS Simulator"
        },
        "Verbose": {
          "type": "boolean",
          "description": "Show detailed compile errors"
        },
        "Version": {
          "type": "string",
          "description": "Package version for NuGet"
        },
        "WriteBack": {
          "type": "boolean",
          "description": "Write probed VWT size/alignment/stride back into the manifest"
        }
      }
    },
    {
      "$ref": "#/definitions/NukeBuild"
    }
  ]
}
