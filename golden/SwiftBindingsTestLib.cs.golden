/// <summary>
/// Simple protocol with a name.
/// </summary>
public interface INameable
{
    string Name { get; }
}

/// <summary>
/// Proxy class that enables C# implementations of the Nameable protocol.
/// Can wrap either a C# implementation or receive Swift existential containers.
/// </summary>
public unsafe partial class NameableProxy : INameable, ISwiftObject, IDisposable, Swift.Runtime.ISwiftExistentialConvertible<ExistentialContainer1>
{
    /// <summary>Matches Swift Nameable_vtable layout</summary>
    [StructLayout(LayoutKind.Sequential)]
    private struct NameableSwiftVTable
    {
        public IntPtr csVTHandle;
        public IntPtr func_name_get;
    }
    
    /// <summary>Local vtable holding managed delegates</summary>
    private struct NameableLocalVTable
    {
        public delegate* unmanaged[Cdecl]<IntPtr, IntPtr, IntPtr> Func_name_get;
    }
    
    private static IntPtr _protocolWitnessTable;
    private static NameableSwiftVTable _swiftVTable;
    private static NameableLocalVTable _localVTable;
    private static GCHandle _localVTableHandle;
    private static bool _vtableInitialized;
    private static readonly object _vtableLock = new object();
    private readonly INameable? _csharpImpl;
    private readonly EveryProtocol? _everyProtocol;
    private ExistentialContainer1 _swiftContainer;
    static NameableProxy()
    {
        InitializeVtable();
    }
    
    private static void InitializeVtable()
    {
        lock (_vtableLock)
        {
            if (_vtableInitialized) return;
            
            _localVTable = new NameableLocalVTable
            {
                Func_name_get = &Receive_name_get,
            };
            
            _localVTableHandle = GCHandle.Alloc(_localVTable, GCHandleType.Pinned);
            
            _swiftVTable = new NameableSwiftVTable
            {
                csVTHandle = GCHandle.ToIntPtr(_localVTableHandle),
