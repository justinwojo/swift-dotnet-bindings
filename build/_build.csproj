<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;NU1901;NU1902;NU1903;NU1904</NoWarn>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nuke.Build" Version="10.1.0" />
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
  </ItemGroup>
  <!-- The x64-thunk-gate Driver is a standalone osx-x64 project published by the
       X64ThunkGate target; it is not part of the build assembly. Exclude its
       sources so the build project doesn't try to compile them. -->
  <ItemGroup>
    <Compile Remove="x64-thunk-gate\**\*.cs" />
  </ItemGroup>
  <!-- Link-compile the bounded-range helper so VersionScope (Sdk.props stamping)
       and BindingProjectEmitter (standalone csproj emission) share one source and
       cannot drift. No project reference: the build project stays generator-assembly-
       independent so `nuke pack` doesn't need a generator build. -->
  <ItemGroup>
    <Compile Include="..\src\Swift.Bindings\src\Emitter\RuntimeVersionRange.cs"
             Link="Helpers\RuntimeVersionRange.cs" />
    <!-- Link-compile the generator's canonical wrapper post-processor so the harness
         wrapper build (Build.BindingTests / Build.RuntimeTests) scrubs the generated
         Swift with the SAME oracle the generator-own wrapper compile uses, instead of a
         bespoke harness stripper. The file is self-contained (only System.Text.Regular-
         Expressions), so this keeps the build project generator-assembly-independent. -->
    <Compile Include="..\src\Swift.Bindings\src\Configuration\SwiftWrapperPostProcessor.cs"
             Link="Helpers\SwiftWrapperPostProcessor.cs" />
    <!-- SwiftWrapperPostProcessor.FindBlockEnd routes its brace walk through the shared
         string/comment-aware scanner; link-compile it too. Self-contained (only System), so the
         build project stays generator-assembly-independent. -->
    <Compile Include="..\src\Swift.Bindings\src\Configuration\StructuralBraceScanner.cs"
             Link="Helpers\StructuralBraceScanner.cs" />
  </ItemGroup>
</Project>
