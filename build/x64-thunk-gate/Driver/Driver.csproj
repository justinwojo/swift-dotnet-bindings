<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copyright (c) 2026 Justin Wojciechowski. Licensed under the MIT License. -->
  <!--
    Standalone osx-x64 driver for the x86_64 thunk-backend gate. Published
    self-contained and run under `arch -x86_64`. It P/Invokes the generated
    `thunk_*` symbols directly (manual cdecl decls in Program.cs) to assert the
    thunk ABI round-trips; it intentionally does NOT depend on Swift.Runtime.
    EntryPoint values come from ThunkSymbols.g.cs, which the gate generates by
    parsing the emitted FixtureLib.cs (no hard-coded FNV hashes here).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>X64ThunkGateDriver</AssemblyName>
  </PropertyGroup>

</Project>
